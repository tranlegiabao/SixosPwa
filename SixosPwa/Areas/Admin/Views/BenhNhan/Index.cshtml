@model SixosPwa.Areas.Admin.Models.BenhNhanListViewModel
@{
    ViewData["Title"] = "Bệnh nhân";
}

<style>
    /* Ẩn footer cố định trên màn hình Bệnh nhân để không đè lên thanh phân trang và menu */
    .admin-footer {
        display: none !important;
    }

    .btn-page-ajax {
        display: inline-grid;
        place-items: center;
        min-width: 30px;
        height: 30px;
        border-radius: 8px;
        color: var(--admin-blue, #2563eb);
        background: #eef3ff;
        border: none;
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
        transition: all .15s ease;
        padding: 0;
        user-select: none;
    }
    .btn-page-ajax:hover:not(:disabled) {
        background: #dbeafe;
        color: #1d4ed8;
    }
    .btn-page-ajax:disabled {
        color: #c4cad5;
        background: transparent;
        cursor: not-allowed;
        opacity: 0.6;
    }

    .table-loading-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(1.5px);
        z-index: 30;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .benh-nhan-table-scroll {
        max-height: 500px;
        overflow-y: auto;
        border-bottom: 1px solid var(--admin-line, #e2e8f0);
    }
    .benh-nhan-table-scroll thead th {
        position: sticky;
        top: 0;
        z-index: 10;
        background: #f1f5f9 !important;
        color: #475569 !important;
        box-shadow: inset 0 -2px 0 #cbd5e1;
    }

    .page-size-btn {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        min-width: 68px;
        height: 32px;
        padding: 2px 10px;
        font-size: 13px;
        font-weight: 700;
        color: #1e293b;
        background-color: #ffffff;
        border: 1.5px solid #cbd5e1;
        border-radius: 6px;
        cursor: pointer;
        transition: all .15s ease;
    }
    .page-size-btn:hover, .page-size-btn:focus, .page-size-btn[aria-expanded="true"] {
        border-color: #2563eb;
        background-color: #ffffff;
        color: #1e293b;
        box-shadow: 0 0 0 2.5px rgba(37, 99, 235, 0.15);
    }
    .page-size-dropdown-menu {
        min-width: 75px !important;
        padding: 4px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.18) !important;
        z-index: 1070 !important;
        margin-bottom: 6px !important;
    }
    .page-size-dropdown-menu .dropdown-item {
        font-size: 13px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 6px;
        text-align: center;
        color: #334155;
        cursor: pointer;
    }
    .page-size-dropdown-menu .dropdown-item:hover {
        background-color: #eff6ff;
        color: #2563eb;
    }
    .page-size-dropdown-menu .dropdown-item.active {
        background-color: #2563eb;
        color: #ffffff;
    }

    /* ==================== MỞ RỘNG KHÍT MÀN HÌNH (DESKTOP >= 992px) ==================== */
    @@media (min-width: 992px) {
        /* 1. Mở rộng chiều ngang & cố định chiều cao 1 màn hình */
        .admin-content {
            max-width: 100% !important;
            padding: 16px 20px 16px !important;
            display: flex !important;
            flex-direction: column !important;
            height: calc(100vh - 86px) !important;
            box-sizing: border-box !important;
            overflow: hidden !important;
        }

        /* 2. Thu gọn khoảng cách tiêu đề trang */
        .page-header-row {
            margin-bottom: 12px !important;
            flex-shrink: 0 !important;
        }

        /* 3. admin-panel thành flex-column chiếm trọn không gian còn lại */
        .admin-panel {
            flex: 1 1 0 !important;
            display: flex !important;
            flex-direction: column !important;
            min-height: 0 !important;
            border-radius: 12px !important;
        }

        /* 4. Thanh lọc và thống kê cố định */
        .filter-bar {
            flex-shrink: 0 !important;
        }
        .privacy-strip {
            flex-shrink: 0 !important;
        }
        #benhNhanTableMeta {
            flex-shrink: 0 !important;
            padding: 10px 20px !important;
        }

        /* 5. Khung bảng dữ liệu co giãn trọn vẹn phần thân giữa */
        .benh-nhan-table-scroll {
            flex: 1 1 0 !important;
            max-height: none !important;
            min-height: 180px !important;
            overflow-y: auto !important;
        }

        /* 6. Thanh phân trang ghim ở đáy panel */
        #benhNhanPaginationContainer {
            flex-shrink: 0 !important;
            background: #ffffff !important;
            border-top: 1px solid var(--admin-line, #e2e8f0) !important;
        }
    }
</style>

@* <div class="page-header-row">
    <div>
        <div class="page-kicker">DỮ LIỆU KHÁCH HÀNG</div>
        <h1 class="page-heading">Bệnh nhân</h1>
        <p class="page-description">Tra cứu hồ sơ đăng ký theo phạm vi đối tác. Màn hình này chỉ đọc.</p>
    </div>
    <span class="readonly-badge">Chỉ xem</span>
</div> *@

<div class="admin-panel">
    <form method="get" class="filter-bar" id="benhNhanFilterForm">
        <div class="search-control">
            <span>⌕</span>
            <input type="search" name="q" id="filterQ" value="@Model.Query" placeholder="Tìm mã, tên hoặc số điện thoại..." aria-label="Tìm bệnh nhân" autocomplete="off" />
        </div>
        <div class="search-control partner-filter">
            <span>⌕</span>
            <input type="search" name="maCoSo" id="filterMaCoSo" value="@Model.MaCoSo" placeholder="Mã cơ sở" aria-label="Lọc theo mã cơ sở" autocomplete="off" />
        </div>
        <input type="hidden" name="pageSize" id="filterPageSize" value="@Model.PageSize" />
        <button class="btn admin-btn-secondary" type="submit">Tìm kiếm</button>
        @if (!string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.MaCoSo))
        {
            <a asp-action="Index" class="clear-filter">Xóa lọc</a>
        }
    </form>

    <div class="privacy-strip">
        <span>◉</span>
        <div>
            <strong>Dữ liệu được bảo vệ</strong>
            <small>Số điện thoại được che một phần trong danh sách để giảm lộ thông tin cá nhân.</small>
        </div>
    </div>

    <div class="table-meta" id="benhNhanTableMeta">
        <span id="benhNhanCountLabel"><strong>@Model.TotalItems.ToString("N0")</strong> bệnh nhân</span>
        <span id="benhNhanCurrentPageInfo">Trang @Model.Page / @Model.TotalPages</span>
    </div>

    <div class="table-responsive position-relative benh-nhan-table-scroll" id="benhNhanTableScrollContainer">
        <div id="tableLoadingOverlay" class="table-loading-overlay" style="display: none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
        </div>
        <table class="table admin-table align-middle mb-0" id="benhNhanMainTable">
            <thead>
                <tr>
                    <th>Bệnh nhân</th>
                    <th>Liên hệ</th>
                    <th>Đối tác</th>
                    <th class="text-end">Mã hồ sơ</th>
                </tr>
            </thead>
            <tbody id="benhNhanTableBody">
                <partial name="_BenhNhanTableBody" model="Model" />
            </tbody>
        </table>
    </div>

    <!-- THANH PHÂN TRANG AJAX KÈM BỘ CHỌN SỐ DÒNG -->
    <div id="benhNhanPaginationContainer" style="@(Model.TotalItems > 0 ? "" : "display: none;")">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2 px-3 pb-3">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted" style="font-size: 12.5px; font-weight: 600;">Hiển thị:</span>
                <div class="btn-group dropup">
                    <button type="button" class="btn btn-sm page-size-btn dropdown-toggle d-flex align-items-center justify-content-between gap-2" data-bs-toggle="dropdown" aria-expanded="false" id="btnPageSizeDropdown">
                        <span id="currentSelectedPageSize">@Model.PageSize</span>
                    </button>
                    <ul class="dropdown-menu page-size-dropdown-menu shadow" style="min-width: 75px; z-index: 1070;">
                        <li><button type="button" class="dropdown-item @(Model.PageSize == 20 ? "active" : "")" data-value="20" onclick="doiSoLuongDong(20)">20</button></li>
                        <li><button type="button" class="dropdown-item @(Model.PageSize == 50 ? "active" : "")" data-value="50" onclick="doiSoLuongDong(50)">50</button></li>
                        <li><button type="button" class="dropdown-item @(Model.PageSize == 100 ? "active" : "")" data-value="100" onclick="doiSoLuongDong(100)">100</button></li>
                        <li><button type="button" class="dropdown-item @(Model.PageSize == 500 ? "active" : "")" data-value="500" onclick="doiSoLuongDong(500)">500</button></li>
                    </ul>
                </div>
                <input type="hidden" id="selectPageSize" value="@Model.PageSize" />
                <span class="text-muted" style="font-size: 12.5px; font-weight: 600;">/ trang</span>
            </div>
            <nav class="admin-pagination mb-0" aria-label="Phân trang" id="benhNhanPaginationNav" style="@(Model.TotalPages > 1 ? "" : "display: none;")">
                <button type="button" class="btn-page-ajax" id="btnPageFirst" onclick="chuyenTrang('first')" title="Trang đầu" @(Model.Page <= 1 ? "disabled" : "")>&laquo;</button>
                <button type="button" class="btn-page-ajax" id="btnPagePrev" onclick="chuyenTrang('prev')" title="Trang trước" @(Model.Page <= 1 ? "disabled" : "")>&lsaquo;</button>
                
                <span class="pagination-current" id="paginationCurrentText">Trang <strong>@Model.Page</strong>/<strong>@Model.TotalPages</strong></span>

                <button type="button" class="btn-page-ajax" id="btnPageNext" onclick="chuyenTrang('next')" title="Trang sau" @(Model.Page >= Model.TotalPages ? "disabled" : "")>&rsaquo;</button>
                <button type="button" class="btn-page-ajax" id="btnPageLast" onclick="chuyenTrang('last')" title="Trang cuối" @(Model.Page >= Model.TotalPages ? "disabled" : "")>&raquo;</button>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ==================== PHÂN TRANG AJAX CHO BỆNH NHÂN ====================
    let trangHienTai = @Model.Page;
    let tongSoTrang = @Model.TotalPages;
    let soLuongMoiTrang = @Model.PageSize;
    let dangTai = false;

    function doiSoLuongDong(val) {
        const ps = parseInt(val, 10);
        if ([20, 50, 100, 500].includes(ps)) {
            soLuongMoiTrang = ps;
            const filterPs = document.getElementById('filterPageSize');
            if (filterPs) filterPs.value = ps;
            const curLabel = document.getElementById('currentSelectedPageSize');
            if (curLabel) curLabel.innerText = ps;
            const selPs = document.getElementById('selectPageSize');
            if (selPs) selPs.value = ps;
            document.querySelectorAll('.page-size-dropdown-menu .dropdown-item').forEach(btn => {
                const btnVal = parseInt(btn.getAttribute('data-value'), 10);
                btn.classList.toggle('active', btnVal === ps);
            });
            taiDanhSachBenhNhan(1, true);
        }
    }

    function capNhatThanhPhanTrang(page, maxPages, totalItems, pageSize) {
        trangHienTai = page;
        tongSoTrang = maxPages;
        if (pageSize && [20, 50, 100, 500].includes(pageSize)) {
            soLuongMoiTrang = pageSize;
            const curLabel = document.getElementById('currentSelectedPageSize');
            if (curLabel) curLabel.innerText = pageSize;
            const selPs = document.getElementById('selectPageSize');
            if (selPs) selPs.value = pageSize;
            const filterPs = document.getElementById('filterPageSize');
            if (filterPs) filterPs.value = pageSize;
            document.querySelectorAll('.page-size-dropdown-menu .dropdown-item').forEach(btn => {
                const btnVal = parseInt(btn.getAttribute('data-value'), 10);
                btn.classList.toggle('active', btnVal === pageSize);
            });
        }

        const paginationContainer = document.getElementById('benhNhanPaginationContainer');
        const paginationNav = document.getElementById('benhNhanPaginationNav');
        const countLabel = document.getElementById('benhNhanCountLabel');
        const pageInfo = document.getElementById('benhNhanCurrentPageInfo');
        const currentText = document.getElementById('paginationCurrentText');
        const btnFirst = document.getElementById('btnPageFirst');
        const btnPrev = document.getElementById('btnPagePrev');
        const btnNext = document.getElementById('btnPageNext');
        const btnLast = document.getElementById('btnPageLast');

        if (countLabel) {
            countLabel.innerHTML = totalItems > 0 ? `<strong>${totalItems.toLocaleString('vi-VN')}</strong> bệnh nhân` : 'Không tìm thấy bệnh nhân';
        }
        if (pageInfo) {
            pageInfo.innerText = totalItems > 0 ? `Trang ${page} / ${maxPages}` : '';
        }

        if (totalItems > 0) {
            if (paginationContainer) paginationContainer.style.display = 'block';
            if (paginationNav) {
                paginationNav.style.display = maxPages > 1 ? 'flex' : 'none';
            }
            if (currentText) {
                currentText.innerHTML = `Trang <strong>${page}</strong>/<strong>${maxPages}</strong>`;
            }
            if (btnFirst) btnFirst.disabled = (page <= 1);
            if (btnPrev) btnPrev.disabled = (page <= 1);
            if (btnNext) btnNext.disabled = (page >= maxPages);
            if (btnLast) btnLast.disabled = (page >= maxPages);
        } else {
            if (paginationContainer) paginationContainer.style.display = 'none';
        }
    }

    async function taiDanhSachBenhNhan(page, updateUrl = true) {
        if (dangTai) return;
        dangTai = true;

        const overlay = document.getElementById('tableLoadingOverlay');
        if (overlay) overlay.style.display = 'flex';

        if (typeof showPageloader === 'function') {
            showPageloader();
        }

        const form = document.getElementById('benhNhanFilterForm');
        const params = new URLSearchParams(form ? new FormData(form) : '');
        params.set('page', page);
        params.set('pageSize', soLuongMoiTrang);

        const startTime = Date.now();

        try {
            const url = `/Admin/BenhNhan?${params.toString()}`;
            const resp = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (resp.ok) {
                const html = await resp.text();
                const tbody = document.getElementById('benhNhanTableBody');
                if (tbody) {
                    tbody.innerHTML = html;
                }

                const totalPagesHeader = resp.headers.get('X-Total-Pages');
                const totalItemsHeader = resp.headers.get('X-Total-Items');
                const currentPageHeader = resp.headers.get('X-Current-Page');
                const pageSizeHeader = resp.headers.get('X-Page-Size');

                const maxPages = totalPagesHeader ? parseInt(totalPagesHeader, 10) : 1;
                const totalItems = totalItemsHeader ? parseInt(totalItemsHeader, 10) : 0;
                const curPage = currentPageHeader ? parseInt(currentPageHeader, 10) : page;
                const curPageSize = pageSizeHeader ? parseInt(pageSizeHeader, 10) : soLuongMoiTrang;

                capNhatThanhPhanTrang(curPage, maxPages, totalItems, curPageSize);

                if (updateUrl && window.history && window.history.pushState) {
                    window.history.pushState({ page: curPage, pageSize: curPageSize }, '', url);
                }

                // Cuộn khung bảng lên đầu
                const scrollBox = document.getElementById('benhNhanTableScrollContainer');
                if (scrollBox) {
                    scrollBox.scrollTop = 0;
                }

                // Cuộn mượt lên đầu bảng nếu màn hình đang ở xa
                const tableMain = document.getElementById('benhNhanMainTable');
                if (tableMain) {
                    const rect = tableMain.getBoundingClientRect();
                    if (rect.top < 60) {
                        window.scrollTo({ top: window.scrollY + rect.top - 80, behavior: 'smooth' });
                    }
                }
            } else {
                if (typeof showToast === 'function') showToast('Lỗi tải danh sách bệnh nhân từ máy chủ.', 'error');
            }
        } catch (err) {
            console.error('Lỗi tải danh sách bệnh nhân:', err);
            if (typeof showToast === 'function') showToast('Lỗi kết nối khi tải danh sách bệnh nhân.', 'error');
        } finally {
            const elapsed = Date.now() - startTime;
            const remaining = Math.max(0, 200 - elapsed);
            setTimeout(() => {
                if (typeof hidePageloader === 'function') {
                    hidePageloader();
                }
                if (overlay) overlay.style.display = 'none';
                dangTai = false;
            }, remaining);
        }
    }

    function chuyenTrang(action) {
        let targetPage = trangHienTai;
        if (action === 'first') {
            targetPage = 1;
        } else if (action === 'prev') {
            targetPage = trangHienTai - 1;
        } else if (action === 'next') {
            targetPage = trangHienTai + 1;
        } else if (action === 'last') {
            targetPage = tongSoTrang;
        } else if (typeof action === 'number') {
            targetPage = action;
        } else {
            targetPage = parseInt(action, 10);
        }

        if (isNaN(targetPage) || targetPage < 1 || targetPage > tongSoTrang || targetPage === trangHienTai) {
            return;
        }
        taiDanhSachBenhNhan(targetPage, true);
    }

    // Xử lý tìm kiếm bằng AJAX khi bấm submit form
    const filterForm = document.getElementById('benhNhanFilterForm');
    if (filterForm) {
        filterForm.addEventListener('submit', function (e) {
            e.preventDefault();
            taiDanhSachBenhNhan(1, true);
        });
    }

    // Xử lý nút Back / Forward của trình duyệt
    window.addEventListener('popstate', function (event) {
        const urlParams = new URLSearchParams(window.location.search);
        const p = parseInt(urlParams.get('page') || '1', 10);
        const ps = parseInt(urlParams.get('pageSize') || '50', 10);
        if ([20, 50, 100, 500].includes(ps)) {
            soLuongMoiTrang = ps;
            const curLabel = document.getElementById('currentSelectedPageSize');
            if (curLabel) curLabel.innerText = ps;
            const selPs = document.getElementById('selectPageSize');
            if (selPs) selPs.value = ps;
            const filterPs = document.getElementById('filterPageSize');
            if (filterPs) filterPs.value = ps;
            document.querySelectorAll('.page-size-dropdown-menu .dropdown-item').forEach(btn => {
                const btnVal = parseInt(btn.getAttribute('data-value'), 10);
                btn.classList.toggle('active', btnVal === ps);
            });
        }
        taiDanhSachBenhNhan(p, false);
    });
</script>
}
