@model List<SixosPwa.Models.HoaDon>

@{
    ViewData["Title"] = "Lịch sử hóa đơn";
    var benhNhan = ViewBag.BenhNhan as SixosPwa.Models.BenhNhan;
}

<link rel="stylesheet" href="~/css/healthcare.css" />

<div class="health-header">
    <div class="container">
        <h1>💰 Lịch sử hóa đơn</h1>
        <div class="subtitle">@benhNhan?.HoTen - @benhNhan?.MaBenhNhan</div>
    </div>
</div>

<div class="container mt-4">
    <div class="mb-3">
        <a href="@Url.Action("Index", "BenhNhan")" class="btn btn-secondary">← Quay lại</a>
    </div>

    <div class="health-card">
        @if (Model.Any())
        {
            <table class="health-table">
                <thead>
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Ngày khám</th>
                        <th>Dịch vụ</th>
                        <th>Tổng tiền</th>
                        <th>Đã TT</th>
                        <th>Còn lại</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hd in Model)
                    {
                        <tr>
                            <td><strong>@hd.MaHoaDon</strong></td>
                            <td>@hd.NgayKham.ToString("dd/MM/yyyy")</td>
                            <td>@hd.DichVu</td>
                            <td>@hd.TongTien.ToString("N0") đ</td>
                            <td>@hd.DaThanhToan.ToString("N0") đ</td>
                            <td><strong>@hd.ConLai.ToString("N0") đ</strong></td>
                            <td>
                                @if (hd.TrangThai == "DaThanhToan")
                                {
                                    <span class="health-status success">✓ Đã thanh toán</span>
                                }
                                else if (hd.TrangThai == "ThanhToanMotPhan")
                                {
                                    <span class="health-status warning">◐ Thanh toán 1 phần</span>
                                }
                                else
                                {
                                    <span class="health-status danger">✗ Chưa thanh toán</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-3">
                @{
                    var tongTien = Model.Sum(h => h.TongTien);
                    var daThanhToan = Model.Sum(h => h.DaThanhToan);
                    var conLai = Model.Sum(h => h.ConLai);
                }
                <div class="row">
                    <div class="col-md-4">
                        <div class="health-card">
                            <small class="text-muted">Tổng tiền</small>
                            <h4>@tongTien.ToString("N0") đ</h4>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="health-card">
                            <small class="text-muted">Đã thanh toán</small>
                            <h4 class="text-success">@daThanhToan.ToString("N0") đ</h4>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="health-card">
                            <small class="text-muted">Còn lại</small>
                            <h4 class="text-danger">@conLai.ToString("N0") đ</h4>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="health-card-icon success mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.5rem;">
                    💰
                </div>
                <h5>Chưa có hóa đơn</h5>
                <p class="text-muted">Bạn chưa có hóa đơn khám bệnh nào.</p>
            </div>
        }
    </div>
</div>
