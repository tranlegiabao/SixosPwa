    <div class="ytv-content">
        <!-- Bootstrap Carousel for Slider -->
        <div id="mainSlider" class="carousel slide ytv-slider" data-bs-ride="carousel" data-bs-interval="3000">
            @{
                var topCSKCB = ViewData["TopCSKCB"] as List<SixosPwa.Models.TopCSKCBQC> ?? new List<SixosPwa.Models.TopCSKCBQC>();
            }
            @if (topCSKCB.Any())
            {
                <div class="carousel-indicators">
                    @for (int i = 0; i < topCSKCB.Count; i++)
                    {
                        <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                    }
                </div>
                <div class="carousel-inner">
                    @for (int i = 0; i < topCSKCB.Count; i++)
                    {
                        var item = topCSKCB[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="para-card-wrapper">
                                <div class="para-card" style="background-image: url('@(string.IsNullOrEmpty(item.Img) ? "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=800&q=80" : item.Img)');">
