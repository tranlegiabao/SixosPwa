    <div class="ytv-content">
        <!-- Bootstrap Carousel for Slider -->
        <div id="mainSlider" class="carousel slide ytv-slider" aria-roledescription="carousel" aria-label="Cơ sở nổi bật">
            @{
                var topCSKCB = ViewData["TopCSKCB"] as List<SixosPwa.Models.TopCSKCBQC> ?? new List<SixosPwa.Models.TopCSKCBQC>();

                string ToSlug(string text)
                {
                    if (string.IsNullOrEmpty(text)) return string.Empty;
                    
                    string normalized = text.Normalize(System.Text.NormalizationForm.FormD);
                    var sb = new System.Text.StringBuilder();
                    foreach (char c in normalized)
                    {
                        var unicodeCategory = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);
                        if (unicodeCategory != System.Globalization.UnicodeCategory.NonSpacingMark)
                        {
                            sb.Append(c);
                        }
                    }
                    string cleanText = sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
                    cleanText = cleanText.Replace("đ", "d").Replace("Đ", "D");
                    
                    var finalSb = new System.Text.StringBuilder();
                    foreach (char c in cleanText)
                    {
                        if (char.IsLetterOrDigit(c))
                        {
                            finalSb.Append(c);
                        }
                    }
                    return finalSb.ToString();
                }
            }
            @if (topCSKCB.Any())
            {
                <div class="carousel-indicators">
                    @for (int i = 0; i < topCSKCB.Count; i++)
                    {
                        <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                    }
                </div>
                <div class="carousel-inner">
                    @for (int i = 0; i < topCSKCB.Count; i++)
                    {
                        var item = topCSKCB[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="para-card-wrapper">
                                <div class="para-card" style="background-image: url('@(string.IsNullOrEmpty(item.Img) ? "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=800&q=80" : item.Img)');">
                                    <div class="para-card-content">
                                        <h3 class="para-card-title">@item.TenCoSo</h3>
                                        <div class="para-card-text">@Html.Raw(item.NoiDung)</div>
                                        <a href="/Home/DangKyOnline/@ToSlug(item.TenCoSo)" class="para-card-btn">Đăng ký khám</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#mainSlider" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon ytv-carousel-control-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
                    <span class="carousel-control-next-icon ytv-carousel-control-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }
            else
            {
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="para-card-wrapper">
                            <div class="para-card" style="background-image: url('https://img.freepik.com/free-photo/beautiful-young-female-doctor-looking-camera-office_1301-7807.jpg?w=1380');">
                                <div class="para-card-content">
                                    <h3 class="para-card-title">Bệnh viện đa khoa chất lượng cao</h3>
                                    <p class="para-card-text">Dịch vụ khám chữa bệnh hàng đầu với đội ngũ bác sĩ chuyên khoa giàu kinh nghiệm.</p>
                                    <a href="/Home/DanhSachCoSo-benhvien" class="para-card-btn">Đăng ký khám</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="para-card-wrapper">
                            <div class="para-card" style="background-image: url('https://img.freepik.com/free-photo/doctor-working-with-laptop-clinic_23-2149196328.jpg?w=1380');">
                                <div class="para-card-content">
                                    <h3 class="para-card-title">Chăm sóc sức khỏe gia đình bạn</h3>
                                    <p class="para-card-text">Đặt lịch nhanh chóng, tiết kiệm thời gian chờ đợi, nhận kết quả online tiện lợi.</p>
                                    <a href="/Home/DanhSachCoSo-benhvien" class="para-card-btn">Đăng ký khám</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="para-card-wrapper">
                            <div class="para-card" style="background-image: url('https://img.freepik.com/free-photo/modern-hospital-building_1127-2856.jpg?w=1380');">
                                <div class="para-card-content">
