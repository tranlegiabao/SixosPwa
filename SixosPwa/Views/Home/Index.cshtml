@{
    ViewData["Title"] = "Cổng Khám Sức Khỏe Định Kỳ";
}

<!-- TOAST THÔNG BÁO -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1080">
    <div id="bookingToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">
                🎉 Đăng ký lịch khám sức khỏe thành công!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="health-portal">
    <!-- BANNER XIN CHÀO & TÀI KHOẢN -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-gradient bg-primary text-white p-3 p-md-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-white text-primary fw-semibold px-3 py-2 rounded-pill mb-2">
                    🏥 Cổng thông tin Bệnh nhân & Khám Sức Khỏe
                </span>
                <h1 class="h3 fw-bold mb-1">Xin chào, <span class="text-warning">@ViewData["UserName"]</span>!</h1>
                <p class="mb-0 text-white-50">Mã bệnh nhân: <strong>BN-2026-8892</strong> | Trạng thái BHYT: <span class="text-warning">Còn hạn</span></p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-info fw-bold text-white rounded-pill px-4 shadow-sm" onclick="sendSmsDemo()">
                    💬 Gửi tin nhắn test
                </button>
                <button type="button" class="btn btn-warning fw-bold text-dark rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalDangKyKham">
                    ➕ Đăng ký Khám Mới
                </button>
                <a asp-controller="DangNhap" asp-action="DangXuat" class="btn btn-outline-light rounded-pill px-3">
                    🚪 Đăng xuất
                </a>
            </div>
        </div>
    </div>

    <!-- KHỐI 1: CHỈ SỐ SỨC KHỎE CÁ NHÂN -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100 border-start border-4 border-danger">
                <div class="text-danger mb-1 display-6">❤️</div>
                <div class="text-muted small">Huyết áp</div>
                <div class="fw-bold fs-5 text-dark">120/80 <small class="fs-6 text-muted">mmHg</small></div>
                <span class="badge bg-danger-subtle text-danger rounded-pill mt-2">Bình thường</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100 border-start border-4 border-primary">
                <div class="text-primary mb-1 display-6">🫀</div>
                <div class="text-muted small">Nhịp tim</div>
                <div class="fw-bold fs-5 text-dark">72 <small class="fs-6 text-muted">bpm</small></div>
                <span class="badge bg-primary-subtle text-primary rounded-pill mt-2">Tốt</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100 border-start border-4 border-success">
                <div class="text-success mb-1 display-6">⚖️</div>
                <div class="text-muted small">Chỉ số BMI</div>
                <div class="fw-bold fs-5 text-dark">21.5 <small class="fs-6 text-muted">(62kg)</small></div>
                <span class="badge bg-success-subtle text-success rounded-pill mt-2">Cân đối</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100 border-start border-4 border-warning">
                <div class="text-warning mb-1 display-6">🩸</div>
                <div class="text-muted small">Nhóm máu</div>
                <div class="fw-bold fs-5 text-dark">O Rh+</div>
                <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill mt-2">Đã lưu trữ</span>
            </div>
        </div>
    </div>

    <!-- KHỐI 2: LỊCH KHÁM SẮP TỚI & THÔNG BÁO -->
    <div class="row g-4 mb-4">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-primary">📅 Lịch Khám Sức Khỏe Sắp Tới</h5>
                    <span class="badge bg-success">Đã xác nhận</span>
                </div>
                <div class="card-body px-4">
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="fw-bold text-dark mb-1">Gói Khám Sức Khỏe Tổng Quát Định Kỳ</h6>
                                <p class="small text-muted mb-2">Bác sĩ: <strong>BS. CKI Trần Văn Nam</strong> &bull; Khoa Khám bệnh</p>
                                <div class="d-flex align-items-center gap-3 text-secondary small">
                                    <span>🕒 <strong>08:30 AM</strong></span>
                                    <span>📆 <strong>15/08/2026</strong></span>
                                    <span>📍 <strong>Phòng 302 - Lầu 3</strong></span>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                <button class="btn btn-sm btn-outline-primary rounded-pill w-100 mb-1" onclick="showAppointmentDetail()">Xem Phiếu Hẹn</button>
                                <button class="btn btn-sm btn-link text-danger text-decoration-none w-100" onclick="cancelAppointment()">Hủy Lịch</button>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-info py-2 px-3 mb-0 small rounded-3">
                        💡 <strong>Lưu ý trước khi khám:</strong> Vui lòng nhịn ăn sáng ít nhất 8 tiếng để thực hiện xét nghiệm máu chính xác nhất.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-3 px-4">
                    <h5 class="fw-bold mb-0 text-primary">🔔 Nhắc Nhở Y Tế & Dịch Vụ</h5>
                </div>
                <div class="card-body px-4">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item px-0 border-0 mb-2">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <h6 class="mb-1 fw-bold text-dark">💊 Đơn thuốc: Kháng sinh & Vitamin C</h6>
                                <small class="text-muted">18:00 Tối nay</small>
                            </div>
                            <p class="mb-1 small text-muted">Uống 1 viên sau khi ăn tối 30 phút.</p>
                        </div>
                        <div class="list-group-item px-0 border-0 mb-2">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <h6 class="mb-1 fw-bold text-dark">🧪 Kết quả Xét nghiệm Máu & Nước tiểu</h6>
                                <small class="text-success">Đã có KQ</small>
                            </div>
                            <p class="mb-1 small text-muted">Lần khám ngày 05/05/2026. Chỉ số Đường huyết ổn định.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KHỐI 3: CÁC GÓI KHÁM SỨC KHỎE NỔI BẬT -->
    <div class="mb-4">
        <h4 class="fw-bold text-dark mb-3">🩺 Danh Mục Gói Khám Sức Khỏe Định Kỳ</h4>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-lift">
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-primary-subtle text-primary rounded-pill w-fit mb-2">Gói Phổ Thông</span>
                        <h5 class="fw-bold text-dark">Khám Sức Khỏe Cơ Bản</h5>
                        <h4 class="text-primary fw-bold mb-3">1.500.000 <small class="fs-6 text-muted">VNĐ</small></h4>
                        <ul class="list-unstyled small text-muted mb-4 flex-grow-1">
                            <li class="mb-2">✅ Khám Nội tổng quát & Đo sinh hiệu</li>
                            <li class="mb-2">✅ Xét nghiệm Công thức máu 24 chỉ số</li>
                            <li class="mb-2">✅ Siêu âm tổng quát vùng bụng</li>
                            <li class="mb-2">✅ Chụp X-Quang phổi thẳng</li>
                        </ul>
                        <button type="button" class="btn btn-outline-primary rounded-pill w-100 fw-bold" onclick="selectPackage('Gói Khám Sức Khỏe Cơ Bản')">
                            Đăng ký gói này
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-primary border-2 shadow-sm rounded-4 h-100 position-relative hover-lift">
                    <span class="position-absolute top-0 end-0 bg-warning text-dark px-3 py-1 rounded-bl fw-bold small">NỔI BẬT BAN CHẠY</span>
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-success-subtle text-success rounded-pill w-fit mb-2">Gói Nâng Cao</span>
                        <h5 class="fw-bold text-dark">Khám Sức Khỏe Toàn Diện</h5>
                        <h4 class="text-success fw-bold mb-3">3.200.000 <small class="fs-6 text-muted">VNĐ</small></h4>
                        <ul class="list-unstyled small text-muted mb-4 flex-grow-1">
                            <li class="mb-2">✅ Tất cả danh mục của Gói Cơ bản</li>
                            <li class="mb-2">✅ Tầm soát nguy cơ Tim mạch & Mỡ máu</li>
                            <li class="mb-2">✅ Kiểm tra Chức năng Gan & Thận</li>
                            <li class="mb-2">✅ Tầm soát Ung thư tuyến giáp / Vú / Tiền liệt tuyến</li>
                        </ul>
                        <button type="button" class="btn btn-primary rounded-pill w-100 fw-bold shadow-sm" onclick="selectPackage('Gói Khám Sức Khỏe Toàn Diện')">
                            Đăng ký gói này
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-lift">
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-purple-subtle text-purple rounded-pill w-fit mb-2" style="background:#f3e8ff; color:#7e22ce;">Gói Vip</span>
                        <h5 class="fw-bold text-dark">Tầm Soát Chuyên Sâu VIP</h5>
                        <h4 class="text-purple fw-bold mb-3" style="color:#7e22ce;">5.800.000 <small class="fs-6 text-muted">VNĐ</small></h4>
                        <ul class="list-unstyled small text-muted mb-4 flex-grow-1">
                            <li class="mb-2">✅ Đầy đủ các xét nghiệm chuyên sâu</li>
                            <li class="mb-2">✅ Chụp Cộng hưởng từ MRI / CT-Scanner</li>
                            <li class="mb-2">✅ Nội soi dạ dày & đại tràng không đau</li>
                            <li class="mb-2">✅ Khám & Tư vấn 1-1 với Giáo sư / Tiến sĩ</li>
                        </ul>
                        <button type="button" class="btn btn-outline-dark rounded-pill w-100 fw-bold" onclick="selectPackage('Gói Tầm Soát VIP')">
                            Đăng ký gói này
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KHỐI 4: LỊCH SỬ KẾT QUẢ KHÁM BỆNH -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="fw-bold text-dark mb-0">📜 Lịch Sử Kết Quả Khám Bệnh</h5>
        </div>
        <div class="card-body px-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Phiếu</th>
                            <th>Ngày Khám</th>
                            <th>Loại Khám</th>
                            <th>Bác Sĩ Khám</th>
                            <th>Kết Luận Chẩn Đoán</th>
                            <th>Hồ Sơ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong class="text-primary">KSK-8812</strong></td>
                            <td>05/05/2026</td>
                            <td>Khám Tổng Quát 定期</td>
                            <td>BS. CKI Nguyễn Văn A</td>
                            <td><span class="badge bg-success-subtle text-success">Sức khỏe tốt, phổi trong</span></td>
                            <td><button class="btn btn-sm btn-light border" onclick="viewReport('KSK-8812')">📄 Xem Chi Tiết</button></td>
                        </tr>
                        <tr>
                            <td><strong class="text-primary">KSK-7741</strong></td>
                            <td>12/01/2026</td>
                            <td>Tầm Soát Tim Mạnh</td>
                            <td>BS. CKI Lê Thị B</td>
                            <td><span class="badge bg-warning-subtle text-warning-emphasis">Triglyceride nhẹ, tập thể dục</span></td>
                            <td><button class="btn btn-sm btn-light border" onclick="viewReport('KSK-7741')">📄 Xem Chi Tiết</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- KHỐI 5: TRẠNG THÁI PWA -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-light">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <span class="hello__dot"></span>
                <small class="text-muted" id="modeStandalone">Ứng dụng PWA Khám Sức Khỏe đang hoạt động hoàn hảo trên thiết bị của bạn.</small>
            </div>
            <small class="text-muted">HisSoft Medical PWA &copy; 2026</small>
        </div>
    </div>
</div>

<!-- MODAL ĐĂNG KÝ KHÁM MỚI -->
<div class="modal fade" id="modalDangKyKham" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalLabel">📋 Đặt Lịch Khám Sức Khỏe Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formBooking" onsubmit="event.preventDefault(); submitBooking();">
                    <div class="mb-3">
                        <label class="form-label font-semibold">Chọn Gói / Chuyên Khoa Khám</label>
                        <select class="form-select form-select-lg" id="cboGoiKham" required>
                            <option value="Gói Khám Sức Khỏe Cơ Bản">Gói Khám Sức Khỏe Cơ Bản (1.500.000đ)</option>
                            <option value="Gói Khám Sức Khỏe Toàn Diện" selected>Gói Khám Sức Khỏe Toàn Diện (3.200.000đ)</option>
                            <option value="Gói Tầm Soát VIP">Gói Tầm Soát VIP (5.800.000đ)</option>
                            <option value="Khám Chuyên Khoa Nội">Khám Chuyên Khoa Nội Tổng Quát</option>
                            <option value="Khám Mắt - Tai Mũi Họng">Khám Mắt - Tai Mũi Họng</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label font-semibold">Chọn Ngày Khám</label>
                            <input type="date" class="form-control form-control-lg" id="txtNgayKham" value="2026-08-15" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label font-semibold">Chọn Giờ Khám</label>
                            <select class="form-select form-select-lg" id="cboGioKham" required>
                                <option value="08:00 AM">08:00 AM</option>
                                <option value="09:00 AM" selected>09:00 AM</option>
                                <option value="10:00 AM">10:00 AM</option>
                                <option value="14:00 PM">14:00 PM</option>
                                <option value="15:00 PM">15:00 PM</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-semibold">Ghi Chú Triệu Chứng / Tiền Sử</label>
                        <textarea class="form-control" id="txtGhiChu" rows="2" placeholder="Ví dụ: Khám định kỳ công ty, tiền sử dị ứng thuốc..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm">
                        ✅ Xác Nhận Đăng Ký Lịch Khám
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function sendSmsDemo() {
            try {
                const response = await fetch('/Home/GuiTinNhan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: "test api gửi tin nhắn" })
                });

                const data = await response.json();
                if (data.success) {
                    const toastEl = document.getElementById('bookingToast');
                    document.getElementById('toastMessage').innerHTML = `💬 <strong>Gửi tin thành công!</strong><br/>${data.message}<br/><small class="text-white-50">${data.details}</small>`;
                    const toast = new bootstrap.Toast(toastEl);
                    toast.show();
                } else {
                    alert("Lỗi: " + data.message);
                }
            } catch (err) {
                console.error(err);
                alert("Lỗi kết nối máy chủ!");
            }
        }

        function selectPackage(packageName) {
            document.getElementById('cboGoiKham').value = packageName;
            var myModal = new bootstrap.Modal(document.getElementById('modalDangKyKham'));
            myModal.show();
        }

        function submitBooking() {
            const goiKham = document.getElementById('cboGoiKham').value;
            const ngayKham = document.getElementById('txtNgayKham').value;
            const gioKham = document.getElementById('cboGioKham').value;

            // Đóng Modal
            const modalEl = document.getElementById('modalDangKyKham');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            // Hiển thị Toast thông báo
            const toastEl = document.getElementById('bookingToast');
            document.getElementById('toastMessage').innerHTML = `🎉 <strong>Đăng ký thành công!</strong><br/>${goiKham} vào ${gioKham} ngày ${ngayKham}. Nhân viên y tế sẽ gọi xác nhận!`;
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        function showAppointmentDetail() {
            alert("📋 CHI TIẾT PHIẾU HẸN KHÁM:\n\n- Mã Phiếu: KSK-2026-9902\n- Gói Khám: Khám Sức Khỏe Tổng Quát\n- Thời gian: 08:30 AM - 15/08/2026\n- Địa điểm: Phòng 302, Lầu 3, Bệnh viện HisSoft.\n\nVui lòng mang theo CCCD và thẻ BHYT khi tới khám.");
        }

        function cancelAppointment() {
            if (confirm("Bạn có chắc chắn muốn hủy lịch khám này không?")) {
                alert("Đã hủy lịch khám thành công!");
            }
        }

        function viewReport(maPhieu) {
            alert(`📄 Đang mở Hồ sơ Kết quả Khám sức khỏe mã phiếu [${maPhieu}]...\nChỉ số sức khỏe bình thường, không phát hiện bất thường.`);
        }
    </script>
}

