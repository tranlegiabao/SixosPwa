@model List<SixosPwa.Models.DoiTac> 
@{ 
ViewData["Title"] = "Gửi Tin Nhắn Bệnh Nhân"; 
} 
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css" />
<style> 
.patient-search-control .ts-wrapper { width: 100%; }
.patient-search-control .ts-control { min-height: 38px; border-radius: 0.375rem; }
.sms-container { 
max-width: 1200px; 
margin: 0 auto; 
} 
.hover-lift { 
transition: transform 0.2s ease, box-shadow 0.2s ease; 
} 
.hover-lift:hover { 
transform: translateY(-2px); 
box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08) !important; 
}
.preview-phone { 
background: #f8fafc; 
border: 2px solid #e2e8f0; 
border-radius: 1.5rem; 
padding: 1.5rem 1rem; 
position: relative; 
box-shadow: inset 0 2px 4px rgba(0,0,0,0.02); 
} 
.preview-bubble { 
background: #e2e8f0; 
color: #1e293b; 
border-radius: 1rem 1rem 1rem 0; 
padding: 0.75rem 1rem; 
font-size: 0.9rem; 
max-width: 85%; 
margin-bottom: 0.5rem; 
position: relative; 
word-break: break-word; 
}
.preview-bubble-meta { 
font-size: 0.75rem; 
color: #64748b; 
margin-left: 0.25rem; 
margin-bottom: 1rem; 
} 
.tag-btn { 
font-size: 0.8rem; 
padding: 0.25rem 0.6rem; 
border-radius: 2rem; 
background: #e0e7ff; 
color: #4338ca; 
border: 1px solid #c7d2fe; 
transition: all 0.2s; 
} 
.tag-btn:hover { 
background: #c7d2fe; 
color: #312e81; 
}
.btn-brand-sms { 
background: linear-gradient(135deg, #3854A4 0%, #2e4589 100%); 
color: white; 
border: none; 
transition: opacity 0.2s; 
} 
.btn-brand-sms:hover { 
opacity: 0.9; 
color: white; 
} 
.form-control:focus, .form-select:focus { 
border-color: #3854A4; 
box-shadow: 0 0 0 0.25rem rgba(56, 84, 164, 0.15); 
} 
.patient-row { 
cursor: pointer; 
transition: background 0.15s; 
} 
.patient-row:hover { 
background-color: #f1f5f9; 
}
.patient-row.selected-row { 
background-color: #eff6ff; 
} 
/* Chat Bubble Styles */
.chat-bubble {
    padding: 10px 15px;
    border-radius: 18px;
    max-width: 75%;
    margin-bottom: 4px;
    font-size: 0.95rem;
    word-break: break-word;
    display: inline-block;
}
.chat-bubble.sent {
    background: linear-gradient(135deg, #3854A4 0%, #2e4589 100%);
    color: white;
    border-bottom-right-radius: 4px;
}
.chat-bubble.received {
    background: #e2e8f0;
    color: #1e293b;
    border-bottom-left-radius: 4px;
}
.chat-row {
    display: flex;
    flex-direction: column;
    margin-bottom: 12px;
}
.chat-row.sent {
    align-items: flex-end;
}
.chat-row.received {
    align-items: flex-start;
}
.chat-time {
    font-size: 0.7rem;
    color: #94a3b8;
    margin-top: 2px;
}
.nav-tabs .nav-link {
    color: #64748b;
}
.nav-tabs .nav-link.active {
    color: #3854A4 !important;
    border-bottom: 3px solid #3854A4 !important;
}
</style> 
<!-- TOAST THÔNG BÁO --> 
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1080"> 
<div id="smsToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true"> 
<div class="d-flex"> 
<div class="toast-body" id="smsToastMessage"> 
🎉 Gửi thành công tin nhắn! 
</div> 
<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button> 
</div> 
</div> 
</div>
<div class="sms-container py-2"> 
<!-- TIÊU ĐỀ & NÚT QUAY LẠI --> 
<div class="d-flex justify-content-between align-items-center mb-3"> 
<div> 
<a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary fw-semibold"> 
← Quay lại trang chủ 
</a> 
<h2 class="h3 fw-bold text-dark mt-1 mb-0">✉️ Quản lý Gửi Tin Nhắn Bệnh Nhân</h2> 
</div> 
</div> 
<!-- HÀNG ĐẦU TIÊN: THÔNG TIN ĐỐI TÁC & MẬT KHẨU & NÚT GỬI --> 
<div class="card border-0 shadow-sm rounded-4 mb-4"> 
<div class="card-body p-3 p-md-4"> 
<form id="smsConfigForm" onsubmit="event.preventDefault(); triggerSendSms();"> 
<div class="row g-3 align-items-end"> 
<!-- Đối tác --> 
<div class="col-md-4"> 
<label for="partnerSelect" class="form-label fw-bold text-secondary small">ĐỐI TÁC SMS</label> 
<div class="input-group"> 
<span class="input-group-text bg-light text-secondary border-end-0"><i class="bi bi-person-badge">🤝</i></span> 
<select class="form-select border-start-0 ps-1" id="partnerSelect" onchange="togglePartnerInput()" required>
@if (Model != null && Model.Any()) 
{ 
var isFirst = true; 
foreach (var dt in Model) 
{ 
if (isFirst) 
{ 
<option value="@dt.MaDT" data-brandname="@dt.BrandName" data-password="@dt.Password" selected>@dt.TenDT</option> 
isFirst = false; 
} 
else 
{ 
<option value="@dt.MaDT" data-brandname="@dt.BrandName" data-password="@dt.Password">@dt.TenDT</option> 
} 
} 
} 
else 
{ 
<option value="HisSoft SMS Gateway" selected>HisSoft SMS Gateway (Không có dữ liệu)</option> 
} 
<option value="custom">Tự cấu hình đối tác khác...</option> 
</select></div> 
<input type="text" class="form-control mt-2 d-none" id="customPartnerInput" placeholder="Nhập tên đối tác SMS tùy chỉnh" /> 
</div> 
<!-- Mật khẩu --> 
<div class="col-md-4"> 
<label for="smsPassword" class="form-label fw-bold text-secondary small">MẬT KHẨU API / ĐỐI TÁC</label> 
<div class="input-group"> 
<span class="input-group-text bg-light text-secondary border-end-0">🔑</span> 
<input type="password" class="form-control border-start-0 border-end-0 ps-1" id="smsPassword" placeholder="Nhập mật khẩu" required value="123456@demo" /> 
<button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePasswordVisibility()"> 
<span id="togglePasswordIcon">👁️</span> 
</button> 
</div> 
</div> 
<!-- Nút Gửi --> 
<div class="col-md-4"> 
<button type="submit" class="btn btn-brand-sms w-100 py-2 fw-bold rounded-3 hover-lift shadow-sm d-flex align-items-center justify-content-center gap-2" id="btnSendSms"> 
<span class="spinner-border spinner-border-sm d-none" role="status" id="sendSpinner"></span> 
<span id="sendIcon">✈️</span> 
<span id="sendBtnText">Gửi Tin Nhắn Hàng Loạt</span> 
</button>
</div> 
</div> 
</form> 
</div> 
</div> 
<!-- KHU VỰC TIẾN TRÌNH GỬI TIN (ẨN MẶC ĐỊNH) --> 
<div class="card border-0 shadow-sm rounded-4 mb-4 d-none" id="sendingProgressCard"> 
<div class="card-body p-3"> 
<div class="d-flex justify-content-between align-items-center mb-2"> 
<span class="fw-bold text-primary" id="progressStatusText">Đang chuẩn bị gửi...</span> 
<span class="badge bg-primary" id="progressPercentText">0%</span> 
</div> 
<div class="progress" style="height: 10px;"> 
<div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" id="sendingProgressBar" style="width: 0%"></div> 
</div> 
</div> 
</div> 
<!-- KHỐI BÊN DƯỚI: DANH SÁCH BỆNH NHÂN (TRÁI) & MẪU TIN NHẮN (PHẢI) --> 
<div class="row g-4"> 
<!-- CỘT TRÁI: DANH SÁCH BỆNH NHÂN --> 
<div class="col-lg-6"> 
<div class="card border-0 shadow-sm rounded-4 h-100">
<div class="card-header bg-white border-0 pt-3 px-3 px-md-4 pb-2 d-flex flex-wrap justify-content-between align-items-center gap-2"> 
<h5 class="fw-bold mb-0 text-primary">👥 Danh Sách Bệnh Nhân</h5> 
<div class="d-flex align-items-center gap-2"> 
<span class="badge bg-secondary" id="selectedCountBadge">Đã chọn: 0</span> 
<button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold hover-lift d-flex align-items-center gap-1" id="btnLocBN" onclick="locDanhSachBN()"> 
<span class="spinner-border spinner-border-sm d-none" id="locSpinner"></span> 
<span id="locBtnIcon">🔎</span> 
<span>Lọc danh sách</span> 
</button> 
</div> 
</div> 
<div class="card-body px-3 px-md-4 pt-1"> 
<!-- Thanh tìm kiếm --> 
<div class="mb-3 patient-search-control"><select class="form-select" id="searchPatient" placeholder="Tìm theo tên, số điện thoại hoặc mã bệnh nhân..." autocomplete="off"></select></div>
<!-- Bảng Danh Sách Bệnh Nhân --> 
<div class="table-responsive" style="max-height: 400px; overflow-y: auto;"> 
<table class="table align-middle mb-0"> 
<thead class="table-light sticky-top"> 
<tr> 
<th width="40" class="text-center"> 
<input class="form-check-input" type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll(this)" /> 
</th> 
<th>Họ & Tên</th> 
<th>Số điện thoại</th> 
<th class="text-end">Trạng thái</th> 
</tr> 
</thead> 
<tbody id="patientTableBody"> 
<!-- Chèn dữ liệu bệnh nhân mẫu qua JS để tương tác nhanh --> 
</tbody> 
</table> 
</div> 
</div> 
</div> 
</div>
<!-- CỘT PHẢI: SOẠN TIN NHẮN & XEM TRƯỚC --> 
<div class="col-lg-6"> 
<div class="card border-0 shadow-sm rounded-4 h-100"> 
<div class="card-header bg-white border-bottom pt-3 px-3 px-md-4 pb-0"> 
    <ul class="nav nav-tabs border-0" id="smsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold text-primary border-0 bg-transparent" id="bulk-tab" data-bs-toggle="tab" data-bs-target="#bulk" type="button" role="tab" aria-controls="bulk" aria-selected="true">📝 Soạn Tin Hàng Loạt</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-secondary border-0 bg-transparent" id="chat-tab" data-bs-toggle="tab" data-bs-target="#chat" type="button" role="tab" aria-controls="chat" aria-selected="false">💬 Trò Chuyện SMS</button>
        </li>
    </ul>
</div> 
<div class="card-body px-0 pt-0 pb-0"> 
<div class="tab-content h-100" id="smsTabContent">
    <!-- TAB 1: SOẠN TIN HÀNG LOẠT -->
    <div class="tab-pane fade show active p-3 p-md-4" id="bulk" role="tabpanel" aria-labelledby="bulk-tab">
        <!-- Chọn Mẫu nhanh --> 
        <div class="mb-3"> 
        <label for="templateSelect" class="form-label fw-semibold text-secondary small">MẪU TIN NHẮN NHANH</label> 
        <select class="form-select" id="templateSelect" onchange="loadTemplate()"> 
        <option value="custom">-- Tự soạn tin nhắn tự do --</option> 
        <option value="remind" selected>Nhắc lịch khám sức khỏe định kỳ</option> 
        <option value="result">Thông báo có kết quả xét nghiệm</option> 
        <option value="survey">Khảo sát ý kiến chất lượng dịch vụ</option> 
        </select> 
        </div> 
        <!-- Soạn thảo nội dung --> 
        <div class="mb-2"> 
        <div class="d-flex justify-content-between align-items-center mb-1"> 
        <label for="smsContent" class="form-label fw-semibold text-secondary small mb-0">NỘI DUNG TIN NHẮN</label> 
        <span class="text-muted small" id="charCountText">0 / 160 ký tự (0 tin)</span> 
        </div> 
        <textarea class="form-control" id="smsContent" rows="5" oninput="updateLivePreview()" placeholder="Nhập nội dung tin nhắn gửi tới bệnh nhân..."></textarea> 
        </div> 
        <!-- Nút chèn từ khóa nhanh --> 
        <div class="mb-3 d-flex flex-wrap gap-2 align-items-center"> 
        <span class="text-secondary small fw-semibold me-1">Chèn nhanh:</span> 
        <button type="button" class="btn tag-btn" onclick="insertTag('[Họ tên]')">👤 [Họ tên]</button> 
        <button type="button" class="btn tag-btn" onclick="insertTag('[Mã bệnh nhân]')">🆔 [Mã bệnh nhân]</button> 
        <button type="button" class="btn tag-btn" onclick="insertTag('[Thời gian]')">📅 [Thời gian]</button> 
        </div> 
        <!-- LIVE PREVIEW (XEM TRƯỚC SMS THỰC TẾ) --> 
        <div class="mb-2">
        <label class="form-label fw-semibold text-secondary small">XEM TRƯỚC TIN NHẮN GỬI THỰC TẾ</label> 
        <div class="preview-phone"> 
        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 text-secondary small"> 
        <span id="previewSender">Từ: <strong>HisSoft SMS</strong></span> 
        <span id="previewTargetPhone">Tới: Chưa chọn bệnh nhân</span> 
        </div> 
        <div class="d-flex flex-column align-items-start"> 
        <div class="preview-bubble" id="previewBubbleText"> 
        Vui lòng chọn bệnh nhân và soạn tin nhắn để xem nội dung thực tế được cá nhân hóa tại đây. 
        </div> 
        <span class="preview-bubble-meta" id="previewBubbleTime">Vừa xong</span> 
        </div> 
        </div> 
        </div> 
    </div>
    
    <!-- TAB 2: TRÒ CHUYỆN SMS -->
    <div class="tab-pane fade d-flex flex-column h-100" id="chat" role="tabpanel" aria-labelledby="chat-tab" style="min-height: 500px;">
        <div class="chat-header p-3 border-bottom bg-light d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="fas fa-user text-primary fs-5"></i>
            </div>
            <div>
                <h6 class="mb-0 fw-bold text-dark" id="chatPatientName">Chọn bệnh nhân để trò chuyện</h6>
                <small class="text-muted" id="chatPatientPhone">...</small>
            </div>
        </div>
        
        <div class="chat-history flex-grow-1 p-3 p-md-4" id="chatHistory" style="overflow-y: auto; background: #f8fafc; height: 350px;">
            <div class="text-center text-muted my-5">
                <i class="far fa-comments fs-1 mb-3 opacity-50"></i>
                <p>Lịch sử trò chuyện sẽ hiển thị ở đây</p>
            </div>
        </div>
        
        <div class="chat-input-area p-3 border-top bg-white">
            <form id="chatForm" onsubmit="sendDirectMessage(event)" class="d-flex gap-2">
                <input type="text" class="form-control rounded-pill px-3 py-2 bg-light border-0" id="directMessageInput" placeholder="Nhập tin nhắn..." disabled required>
                <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" id="btnSendDirect" disabled style="width: 42px; height: 42px; background: linear-gradient(135deg, #3854A4 0%, #2e4589 100%); border: none;">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </form>
        </div>
    </div>
</div>
</div> 
</div> 
</div> 
</div> 
</div> 
@section Scripts { 
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script><script src="~/js/gui-tin-nhan.js" asp-append-version="true"></script>
}
