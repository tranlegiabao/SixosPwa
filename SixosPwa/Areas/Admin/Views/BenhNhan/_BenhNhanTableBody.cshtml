@model SixosPwa.Areas.Admin.Models.BenhNhanListViewModel

@if (Model.Items.Count == 0)
{
    if (!Model.DaLoc)
    {
        <tr>
            <td colspan="3">
                <div class="table-empty py-5">
                    <div style="font-size: 36px; margin-bottom: 8px;">🏥</div>
                    <strong class="fs-6">Chưa chọn bộ lọc</strong>
                    <span class="text-muted mt-1">Vui lòng chọn cơ sở hoặc nhập CCCD / SĐT / Mã BN rồi nhấn nút <strong>Lọc</strong> để hiển thị danh sách bệnh nhân.</span>
                </div>
            </td>
        </tr>
    }
    else
    {
        <tr>
            <td colspan="3">
                <div class="table-empty">
                    <div>⌕</div>
                    <strong>Không tìm thấy bệnh nhân phù hợp</strong>
                    <span>Thử thay đổi từ khóa hoặc bộ lọc cơ sở.</span>
                </div>
            </td>
        </tr>
    }
}
else
{
    var danhMucGioiTinh = Model.DanhMucGioiTinh?.ToList() ?? new List<SixosPwa.Models.DMGioiTinh>
    {
        new SixosPwa.Models.DMGioiTinh { MaGioiTinh = "1", TenGioiTinh = "Nam" },
        new SixosPwa.Models.DMGioiTinh { MaGioiTinh = "2", TenGioiTinh = "Nữ" },
        new SixosPwa.Models.DMGioiTinh { MaGioiTinh = "3", TenGioiTinh = "Chưa xác định" }
    };

    <partial name="_BenhNhanRows" model="(Model.Items.ToList(), danhMucGioiTinh)" />
}
