@{
    var tenCoSo = Uri.UnescapeDataString(ViewData["TenCoSo"]?.ToString() ?? "Bệnh Viện ĐHYD");
    var diaChi = Uri.UnescapeDataString(ViewData["DiaChi"]?.ToString() ?? "215 Hồng Bàng, Phường Chợ Lớn");
    var type = ViewData["Type"]?.ToString() ?? "benhvien";
    var img = Uri.UnescapeDataString(ViewData["Img"]?.ToString() ?? "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=800&q=80");
}

<style>
    .app-nav { display: none !important; }
    .bottom-nav { display: none !important; }
    body { 
        background: url('/static/bg-hospital.png') no-repeat center center fixed !important; 
        background-size: cover !important;
        padding-top: 74px !important; 
        padding-bottom: 120px !important; 
        margin: 0 !important; 
        font-family: 'Inter', system-ui, sans-serif; 
    }

    .container, .container-fluid, .container-sm, .container-md, .container-lg, .container-xl {
        max-width: 100% !important; width: 100% !important;
        padding-left: 0 !important; padding-right: 0 !important;
        margin-left: 0 !important; margin-right: 0 !important;
    }
    :root { --ytv-primary: #1d4ed8; --ytv-secondary: #3b82f6; --ytv-text: #1e293b; }

    /* Header */
    .ytv-header {
        background: linear-gradient(135deg, #4285f4, #60a5fa);
        color: white; padding: 12px 30px;
        display: flex; align-items: center; justify-content: space-between;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        position: fixed; top: 0; left: 0; width: 100%; z-index: 1000; box-sizing: border-box;
    }
    .ytv-logo-area { display: flex; align-items: center; gap: 15px; text-decoration: none; color: white; }
    .ytv-logo-text { font-family: 'Times New Roman', serif; font-size: 26px; font-weight: 900; line-height: 1.1; }
    .ytv-header-title { text-align: center; flex-grow: 1; }
    .ytv-header-title h1 { margin: 0; font-size: 20px; font-weight: 700; color: white; }
    .ytv-header-title p { margin: 4px 0 0; font-size: 14px; opacity: 0.9; color: white; }
    .ytv-header-menu { font-size: 24px; cursor: pointer; color: white; position: relative; }
    
    .ytv-dropdown { display: none; position: absolute; top: 100%; right: 0; background: white; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.15); min-width: 240px; z-index: 9999; animation: fadeDown 0.2s ease; margin-top: 15px; }
    .ytv-dropdown.open { display: block; }
    @@keyframes fadeDown {
        from { opacity: 0; transform: translateY(-10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .ytv-dropdown a { display: flex; align-items: center; gap: 14px; padding: 15px 20px; color: #334155; font-size: 16px; font-weight: 600; text-decoration: none; border-bottom: 1px solid #f1f5f9; transition: all 0.2s; }
    .ytv-dropdown a:last-child { border-bottom: none; }
    .ytv-dropdown a:hover { background: #eff6ff; color: #1d4ed8; padding-left: 28px; }
    .ytv-dropdown a i { font-size: 20px; width: 26px; text-align: center; color: #3b82f6; }

    /* Layout */
    .ytv-main { display: flex; width: 100%; min-height: calc(100vh - 164px); align-items: flex-start; padding-left: 250px; box-sizing: border-box; }

    /* Sidebar */
    .ytv-sidebar {
        width: 250px; flex-shrink: 0; background: white;
        border-right: 1px solid #e2e8f0;
        display: flex; flex-direction: column; padding: 20px 0;
        position: fixed; top: 74px; left: 0; height: calc(100vh - 164px); overflow-y: auto; z-index: 100;
    }
    .ytv-sidebar-title {
        font-size: 11px; font-weight: 700; color: #94a3b8;
        text-transform: uppercase; letter-spacing: 1px;
        padding: 0 20px 10px; border-bottom: 1px solid #f1f5f9; margin-bottom: 8px;
    }
    .ytv-menu-item {
        display: flex; align-items: center; padding: 13px 20px; gap: 12px;
        color: #475569; font-size: 15px; font-weight: 500; text-decoration: none;
        transition: all 0.2s; border-left: 3px solid transparent; cursor: pointer;
    }
    .ytv-menu-item i { font-size: 17px; width: 22px; text-align: center; color: #94a3b8; }
    .ytv-menu-item:hover, .ytv-menu-item.active {
        background: #eff6ff; border-left-color: var(--ytv-secondary); color: var(--ytv-primary);
    }
    .ytv-menu-item:hover i, .ytv-menu-item.active i { color: var(--ytv-secondary); }

    /* Content Area */
    .ytv-content { flex: 1; background: transparent; padding: 30px; display: flex; flex-direction: column; gap: 20px; min-width: 0; max-width: 1050px; margin: 0 auto; }

    /* New Content Styles */
    .hospital-card {
        background: white;
        border-radius: 16px;
        display: flex;
        overflow: hidden;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
    }
    .hospital-card-img {
        width: 300px;
        object-fit: cover;
    }
    .hospital-card-content {
        padding: 24px 30px;
        flex: 1;
        position: relative;
    }
    .verified-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 13px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 20px;
        margin-bottom: 16px;
    }
    .verified-badge i { color: #10b981; }
    
    .hospital-title {
        font-size: 26px;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 8px 0;
    }
    .hospital-rating {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #64748b;
        margin-bottom: 20px;
    }
    .hospital-rating .score {
        color: #0f172a;
        font-weight: 600;
        font-size: 16px;
    }
    .hospital-rating .stars i { color: #f59e0b; font-size: 15px; }
    .hospital-rating .count { color: #2563eb; }

    .hospital-info-grid {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
        gap: 20px;
    }

    .hospital-details {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .detail-item {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #475569;
        font-size: 15px;
    }
    .detail-item i { width: 18px; color: #64748b; text-align: center; }
    .detail-item a { color: #2563eb; text-decoration: none; }

    .operating-hours-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        width: 220px;
        flex-shrink: 0;
        border: 1px solid #f1f5f9;
    }
    .oh-header { display: flex; align-items: center; gap: 8px; color: #475569; font-size: 13px; font-weight: 600; margin-bottom: 12px; }
    .oh-days { font-size: 14px; color: #0f172a; font-weight: 600; }
    .oh-time { font-size: 18px; color: #16a34a; font-weight: 700; margin-top: 4px; margin-bottom: 12px; }
    .oh-status { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #16a34a; font-weight: 600; }
    .status-dot { width: 8px; height: 8px; background: #16a34a; border-radius: 50%; }

    .hospital-actions { display: flex; gap: 16px; }
    .btn-primary { background: #1d4ed8; color: white; padding: 12px 20px; border-radius: 8px; font-weight: 600; font-size: 15px; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; border: none; cursor: pointer; transition: background 0.2s; flex: 1; }
    .btn-primary:hover { background: #1e40af; color: white; }
    .btn-outline { background: white; color: #1d4ed8; padding: 12px 20px; border-radius: 8px; font-weight: 600; font-size: 15px; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; border: 1px solid #93c5fd; cursor: pointer; transition: all 0.2s; flex: 1; }
    .btn-outline:hover { background: #eff6ff; }

    /* Stats Grid */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .stat-card { background: white; border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 16px; border: 1px solid #f1f5f9; box-shadow: 0 4px 10px -5px rgba(0,0,0,0.05); }
    .stat-icon { width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }
    .stat-icon.blue { background: #eff6ff; color: #3b82f6; }
    .stat-icon.green { background: #f0fdf4; color: #22c55e; }
    .stat-icon.purple { background: #faf5ff; color: #a855f7; }
    .stat-icon.orange { background: #fff7ed; color: #f97316; }
    .stat-info { display: flex; flex-direction: column; }
    .stat-info .value { margin: 0; font-size: 20px; font-weight: 800; color: #1e40af; }
    .stat-info .title { font-size: 14px; font-weight: 600; color: #334155; margin: 2px 0; }
    .stat-info .desc { font-size: 12px; color: #64748b; margin: 0; }

    /* Intro Section */
    .intro-section { background: white; border-radius: 16px; padding: 32px; display: flex; justify-content: space-between; align-items: center; border: 1px solid #f1f5f9; box-shadow: 0 4px 10px -5px rgba(0,0,0,0.05); }
    .intro-content { flex: 1; max-width: 600px; }
    .intro-title { display: flex; align-items: center; gap: 10px; font-size: 18px; font-weight: 700; color: #1d4ed8; margin-bottom: 20px; }
    .intro-content p { color: #475569; line-height: 1.8; font-size: 15px; margin-bottom: 16px; }
    .intro-image { width: 320px; height: auto; opacity: 0.9; mix-blend-mode: multiply; }

    /* Footer */
    .ytv-footer {
        background: #e0f2fe; 
        color: #334155;
        padding: 15px 40px;
        display: flex;
        flex-direction: column;
        border-top: 1px solid #bae6fd;
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        box-sizing: border-box;
    }
    .ytv-footer-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; }
    .ytv-footer-bottom { text-align: center; font-size: 13px; color: #64748b; border-top: 1px solid #bae6fd; padding-top: 10px; margin-top: 5px; }

    /* Login Modal Styles */
    .ytv-modal-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);
        display: none; align-items: center; justify-content: center;
        z-index: 2000; opacity: 0; transition: opacity 0.3s ease;
    }
    .ytv-modal-overlay.show { display: flex; opacity: 1; }
    .ytv-modal-content {
        background: white; border-radius: 20px; width: 100%; max-width: 420px; margin: 0 20px;
        padding: 40px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        transform: translateY(20px); transition: transform 0.3s ease; position: relative;
    }
    .ytv-modal-overlay.show .ytv-modal-content { transform: translateY(0); }
    .ytv-modal-close {
        position: absolute; top: 16px; right: 20px; background: none; border: none;
        font-size: 28px; color: #94a3b8; cursor: pointer; transition: color 0.2s; line-height: 1;
    }
    .ytv-modal-close:hover { color: #0f172a; }
    
    .login-step { display: none; }
    .login-step.active { display: block; animation: fadeIn 0.4s; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateX(10px); } to { opacity: 1; transform: translateX(0); } }

    .login-title { font-size: 24px; font-weight: 800; color: #0f172a; margin: 0 0 10px 0; text-align: center; }
    .login-desc { font-size: 14px; color: #64748b; margin-bottom: 30px; text-align: center; line-height: 1.6; }
    
    .input-group { margin-bottom: 24px; position: relative; }
    .input-group i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 18px; }
    .ytv-input {
        width: 100%; padding: 14px 16px 14px 44px; border: 2px solid #e2e8f0;
        border-radius: 12px; font-size: 16px; color: #0f172a; outline: none; transition: all 0.2s;
        box-sizing: border-box; font-family: inherit; font-weight: 500;
    }
    .ytv-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); }
    
    .btn-submit {
        width: 100%; background: #1d4ed8; color: white; border: none; border-radius: 12px;
        padding: 16px; font-size: 16px; font-weight: 700; cursor: pointer; transition: background 0.2s;
        box-shadow: 0 4px 12px rgba(29, 78, 216, 0.2);
    }
    .btn-submit:hover { background: #1e40af; transform: translateY(-1px); }
    
    .otp-inputs { display: flex; gap: 12px; justify-content: center; margin-bottom: 30px; }
    .otp-input {
        width: 50px; height: 60px; border: 2px solid #e2e8f0; border-radius: 12px;
        font-size: 24px; font-weight: 700; text-align: center; color: #0f172a;
        outline: none; transition: all 0.2s; background: #f8fafc;
    }
    .otp-input:focus { border-color: #3b82f6; background: white; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); }
    
    .resend-text { text-align: center; margin-top: 24px; font-size: 14px; color: #64748b; }
    .resend-link { color: #3b82f6; font-weight: 600; text-decoration: none; cursor: pointer; transition: color 0.2s; }
    .resend-link:hover { color: #1d4ed8; text-decoration: underline; }

    @@media (max-width: 992px) {
        .ytv-main { flex-direction: column; padding-left: 0; }
        .ytv-sidebar { position: relative; top: 0; left: 0; height: auto; z-index: 1; width: 100%; flex-direction: row; overflow-x: auto; padding: 10px 0; border-right: none; border-bottom: 1px solid #e2e8f0; }
        .ytv-menu-item { border-left: none; border-bottom: 3px solid transparent; white-space: nowrap; }
        .hospital-card { flex-direction: column; }
        .hospital-card-img { width: 100%; height: 250px; }
        .stats-grid { grid-template-columns: repeat(2, 1fr); }
        .intro-section { flex-direction: column; text-align: left; }
        .intro-image { margin-top: 24px; width: 100%; max-width: 400px; }
        .hospital-title-row { flex-direction: column; gap: 16px; }
        .operating-hours-box { width: 100%; }
        .hospital-actions { flex-direction: column; }
        .btn-primary, .btn-outline { max-width: 100%; }
    }
    @@media (max-width: 576px) {
        .stats-grid { grid-template-columns: 1fr; }
    }
</style>

