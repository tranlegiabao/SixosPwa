    }

    .store-img {
        width: 150px;
        height: auto;
        cursor: pointer;
    }

    .qr-img {
        width: 120px;
        height: auto;
        margin-top: 10px;
    }

    .tab-indicator {
        position: absolute;
        bottom: -5px;
        left: 0px;
        height: 2px;
        right: 0px;
        z-index: 0;
        background-color: #ccc;
    }

    .login_flex_992px {
        flex-direction: row;
    }

    .login_width100_992px {
        width: 50% !important;
    }

    .card.card-md {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 20px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3);
        padding: 0;
        width: 100%;
        max-width: 100vw;
        margin: 0;
    }

    .card-header {
        background: linear-gradient(90deg, #206bc4, #004085);
        color: white;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
