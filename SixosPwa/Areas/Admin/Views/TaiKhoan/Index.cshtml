<div class="page-header-row">
    <div><div class="page-kicker">QUẢN LÝ TRUY CẬP</div><h1 class="page-heading">Tài khoản</h1><p class="page-description">Kiểm soát người dùng và vai trò truy cập vào ứng dụng. Bấm vào tài khoản để mở danh sách hồ sơ bệnh nhân.</p></div>
    <a asp-action="Create" class="btn admin-btn-primary"><span>+</span> Tạo tài khoản</a>
</div>

<div class="admin-panel">
    <form method="get" class="filter-bar">
        <div class="search-control"><span>⌕</span><input type="search" name="q" value="@Model.Query" placeholder="Tìm theo số điện thoại..." aria-label="Tìm tài khoản" /></div>
        <select name="role" class="form-select filter-select admin-filter-select" aria-label="Lọc theo vai trò"><option value="">Tất cả vai trò</option><option value="Admin" selected="@(Model.Role == "Admin" ? "selected" : null)">Admin</option><option value="BenhNhan" selected="@(Model.Role == "BenhNhan" ? "selected" : null)">Bệnh nhân</option></select>
        <button class="btn admin-btn-secondary" type="submit">Lọc</button>
        @if (!string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.Role)) { <a asp-action="Index" class="clear-filter">Xóa lọc</a> }
    </form>
    <div class="table-meta"><span><strong>@Model.TotalItems.ToString("N0")</strong> tài khoản</span><span>Bấm vào từng dòng để mở/đóng danh sách hồ sơ</span></div>
    <div class="table-responsive">
        <table class="table admin-table align-middle mb-0">
            <thead><tr><th>Tài khoản</th><th>Vai trò</th><th>Mã định danh</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="4"><div class="table-empty"><div>⌕</div><strong>Không tìm thấy tài khoản</strong><span>Thử thay đổi từ khóa hoặc bộ lọc.</span></div></td></tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    hoSoTheoTaiKhoan.TryGetValue(item.Id, out var danhSachHoSo);
                    danhSachHoSo ??= new List<HoSoBenhNhanItemViewModel>();

                    <tr class="account-parent-row" id="account-row-@item.Id" onclick="toggleAccountDrawer(@item.Id, event)">
                        <td>
                            <div class="table-person">
                                <span class="mini-avatar">@(item.SDT.FirstOrDefault().ToString())</span>
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong>@item.SDT</strong>
                                        <span class="toggle-hoso-badge" id="badge-@item.Id" title="Bấm để xem @(danhSachHoSo.Count) hồ sơ">
                                            <span>@(danhSachHoSo.Count)</span> hồ sơ
                                            <span class="arrow-rot">▾</span>
                                        </span>
                                    </div>
                                    <small>Đăng nhập bằng số điện thoại — <span class="text-primary fw-bold">Xem hồ sơ</span></small>
                                </div>
                            </div>
                        </td>
                        <td><span class="role-badge role-@item.Role.ToLowerInvariant()">@item.Role</span></td>
                        <td class="text-muted">#@item.Id</td>
                        <td class="text-end" onclick="event.stopPropagation()">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="table-action">Chỉnh sửa <span>→</span></a>
                        </td>
                    </tr>

                    <!-- HÀNG DRAWER SỔ RA CÁC HỒ SƠ -->
                    <tr id="drawer-@item.Id" class="account-drawer-row" style="display: none;">
                        <td colspan="4" class="p-0 border-0">
                            <div class="account-drawer-box">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                                            <span>📂</span> Hồ sơ bệnh nhân thuộc tài khoản <strong>@item.SDT</strong>
                                            <span class="badge bg-primary text-white" id="count-label-@item.Id">@(danhSachHoSo.Count) hồ sơ</span>
                                        </h6>
                                        <small class="text-muted">Quản lý, xem, sửa hoặc xóa hồ sơ của thành viên trong tài khoản này</small>
                                    </div>
                                    <button type="button" class="btn btn-sm admin-btn-primary py-1 px-3" onclick="toggleFormThem(@item.Id)">
                                        <span>+</span> Thêm hồ sơ
                                    </button>
                                </div>

                                <!-- FORM THÊM HỒ SƠ MỚI -->
                                <div id="form-them-@item.Id" class="form-them-panel" style="display: none;">
                                    <div class="fw-bold text-primary mb-2" style="font-size: 13px;">➕ Thêm hồ sơ mới cho tài khoản @item.SDT</div>
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label mb-1" style="font-size: 11px;">Họ và tên <span class="text-danger">*</span></label>
                                            <input type="text" id="new-ten-@item.Id" class="form-control form-control-sm" placeholder="VD: Nguyễn Văn A" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label mb-1" style="font-size: 11px;">CCCD / Định danh</label>
                                            <input type="text" id="new-cccd-@item.Id" class="form-control form-control-sm font-monospace" placeholder="12 số CCCD" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label mb-1" style="font-size: 11px;">Số điện thoại</label>
                                            <input type="tel" id="new-sdt-@item.Id" class="form-control form-control-sm" placeholder="@item.SDT" value="@item.SDT" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label mb-1" style="font-size: 11px;">Ngày sinh</label>
                                            <input type="text" id="new-ngaysinh-@item.Id" class="form-control form-control-sm datepicker-input" placeholder="dd/mm/yyyy" />
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label mb-1" style="font-size: 11px;">Giới tính</label>
                                            <select id="new-gioitinh-@item.Id" class="form-select form-select-sm">
                                                @foreach (var gt in danhMucGioiTinh)
                                                {
                                                    <option value="@gt.MaGioiTinh">@gt.TenGioiTinh</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2 d-flex gap-1 justify-content-end">
                                            <button type="button" class="btn btn-sm btn-success px-3" onclick="taoHoSoMoi(@item.Id)">
                                                💾 Lưu
                                            </button>
                                            <button type="button" class="btn btn-sm btn-light border px-2" onclick="toggleFormThem(@item.Id)">
                                                ✕
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- BẢNG DANH SÁCH HỒ SƠ -->
                                <div class="nested-hoso-card">
                                    <div class="table-responsive">
                                        <table class="table nested-hoso-table align-middle">
                                            <thead>
                                                <tr>
                                                    <th style="width: 22%;">Họ và tên</th>
                                                    <th style="width: 17%;">CCCD / Định danh</th>
                                                    <th style="width: 14%;">Số điện thoại</th>
                                                    <th style="width: 12%;">Ngày sinh</th>
                                                    <th style="width: 10%;">Giới tính</th>
                                                    <th style="width: 12%;">Mã BN / Cơ sở</th>
                                                    <th style="width: 13%;" class="text-end">Thao tác</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbody-hoso-@item.Id">
                                                @if (danhSachHoSo.Count == 0)
                                                {
                                                    <tr class="empty-hoso-tr" id="empty-row-@item.Id">
                                                        <td colspan="7" class="text-center py-4 text-muted">
                                                            <div>📋</div>
                                                            <div>Chưa có hồ sơ bệnh nhân nào liên kết với tài khoản này.</div>
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    foreach (var hs in danhSachHoSo)
                                                    {
                                                        var ngaySinhStr = hs.NgaySinh?.ToString("dd/MM/yyyy") ?? "—";
                                                        var ngaySinhIso = hs.NgaySinh?.ToString("yyyy-MM-dd") ?? "";
                                                        var matchGt = danhMucGioiTinh.FirstOrDefault(x => x.MaGioiTinh == hs.GioiTinh);
                                                        var gioiTinhStr = matchGt != null ? matchGt.TenGioiTinh : (hs.GioiTinh == "1" ? "Nam" : (hs.GioiTinh == "2" ? "Nữ" : "Chưa xác định"));
                                                        var maBnStr = !string.IsNullOrEmpty(hs.MaBN) ? $"{hs.MaBN}" : (!string.IsNullOrEmpty(hs.TenCoSo) ? hs.TenCoSo : "Chưa nối");

                                                        <tr id="hoso-row-@hs.Id" data-id="@hs.Id" data-account-id="@item.Id"
                                                            data-ten="@hs.TenBN" data-cccd="@hs.CCCD" data-sdt="@hs.SDT"
                                                            data-ngaysinh="@ngaySinhIso" data-gioitinh="@hs.GioiTinh"
                                                            data-mabn="@hs.MaBN" data-tencoso="@hs.TenCoSo">
                                                            <!-- HỌ TÊN -->
                                                            <td>
                                                                <span class="val-ten fw-bold text-dark">@hs.TenBN</span>
                                                            </td>
                                                            <!-- CCCD -->
                                                            <td>
                                                                <span class="val-cccd font-monospace">@(string.IsNullOrEmpty(hs.CCCD) ? "—" : hs.CCCD)</span>
                                                            </td>
                                                            <!-- SĐT -->
                                                            <td>
                                                                <span class="val-sdt">@(string.IsNullOrEmpty(hs.SDT) ? "—" : hs.SDT)</span>
                                                            </td>
                                                            <!-- NGÀY SINH -->
                                                            <td>
                                                                <span class="val-ngaysinh">@ngaySinhStr</span>
                                                            </td>
                                                            <!-- GIỚI TÍNH -->
                                                            <td>
                                                                <span class="val-gioitinh">@gioiTinhStr</span>
                                                            </td>
                                                            <!-- MÃ BN / CƠ SỞ -->
                                                            <td>
                                                                <span class="badge bg-light text-secondary border">@maBnStr</span>
                                                            </td>
                                                            <!-- THAO TÁC: SỬA - LƯU - XOÁ -->
                                                            <td class="text-end">
                                                                <div class="hoso-action-group">
                                                                    <!-- NÚT SỬA (✏️) MỞ POPUP THEO MẪU -->
                                                                    <button type="button" class="btn-hoso-icon btn-hoso-edit" onclick="moModalSuaHoSo(@hs.Id, @item.Id)" title="Sửa hồ sơ">
                                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                                                    </button>

                                                                    <!-- NÚT XOÁ (🗑️) -->
                                                                    <button type="button" class="btn-hoso-icon btn-hoso-delete" onclick="xoaThongTinHoSo(@hs.Id, '@hs.TenBN', @item.Id)" title="Xóa hồ sơ">
                                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="new PaginationViewModel { Page = Model.Page, TotalPages = Model.TotalPages, Query = Model.Query, Role = Model.Role }" />
</div>

<!-- ==================== MODAL SỬA HỒ SƠ CHUẨN GIAO DIỆN THEO ẢNH USER ==================== -->
<div id="modalSuaHoSoBackdrop" class="modal-sua-hoso-backdrop" style="display: none;" onclick="dongModalSuaHoSo(event)">
    <div class="modal-sua-hoso-card" onclick="event.stopPropagation()">
        <div class="modal-sua-header">
            <button type="button" class="modal-sua-btn-back" onclick="dongModalSuaHoSo()" title="Đóng">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </button>
            <div>
                <h3 class="modal-sua-title">Sửa hồ sơ</h3>
                <span class="modal-sua-subtitle" id="modalSuaTenSubtitle">LÊ VIỆT HƯNG</span>
            </div>
        </div>

        <div class="modal-sua-body">
            <input type="hidden" id="modalSuaId" value="" />
            <input type="hidden" id="modalSuaAccountId" value="" />

            <!-- 1. Mã bệnh nhân tại cơ sở -->
            <div class="modal-hs-o">
                <label>Mã bệnh nhân tại cơ sở</label>
                <input id="modalSuaMaBN" disabled value="" placeholder="Chưa có mã tại cơ sở" />
                <div class="modal-hs-goi-y" id="modalSuaMaGoiY">
                    Mã nào không phải của bạn thì bấm <b>Gỡ nối</b> ở dưới — hồ sơ vẫn giữ nguyên.
                </div>
            </div>

            <!-- 2. Số căn cước * -->
            <div class="modal-hs-o">
                <label for="modalSuaCCCD">Số căn cước *</label>
                <input id="modalSuaCCCD" type="text" maxlength="20" placeholder="Số CCCD / Định danh" />
            </div>

            <!-- 3. Họ và tên * -->
            <div class="modal-hs-o">
                <label for="modalSuaTen">Họ và tên *</label>
                <input id="modalSuaTen" type="text" maxlength="100" placeholder="Họ và tên bệnh nhân" />
            </div>

            <!-- 4. Ngày sinh * -->
            <div class="modal-hs-o">
                <label for="modalSuaNgaySinh">Ngày sinh *</label>
                <input id="modalSuaNgaySinh" type="text" class="datepicker-input" placeholder="dd/mm/yyyy" />
            </div>

            <!-- 5. Giới tính * -->
            <div class="modal-hs-o">
                <label for="modalSuaGioiTinh">Giới tính *</label>
                <select id="modalSuaGioiTinh">
                    <option value="">— Chọn giới tính —</option>
                    @foreach (var gt in danhMucGioiTinh)
                    {
                        <option value="@gt.MaGioiTinh">@gt.TenGioiTinh</option>
                    }
                </select>
            </div>

            <!-- 6. Số điện thoại (không bắt buộc) -->
            <div class="modal-hs-o">
                <label for="modalSuaSDT">Số điện thoại <span style="font-weight:400;color:#64748b;">(không bắt buộc)</span></label>
                <input id="modalSuaSDT" type="tel" maxlength="20" placeholder="09xxxxxxxx" />
            </div>

            <!-- Gợi ý thông báo -->
            <div class="modal-hs-goi-y mb-3" id="modalSuaDaNoiNote" style="display: none;">
                Hồ sơ này đã nối với bệnh án tại cơ sở nên họ tên, ngày sinh, căn cước và giới tính lấy theo cơ sở. Muốn sửa thì báo cơ sở, hoặc gỡ nối trước.
            </div>

            <!-- Nút Lưu -->
            <button type="button" class="modal-hs-btn-submit" id="modalSuaBtnSave" onclick="luuThongTinModal()">Lưu</button>

            <!-- Khối Gỡ Nối (nếu có mã) -->
            <div id="modalSuaGoNoiCard" class="modal-hs-go-noi-card" style="display: none;">
                <div>
                    <strong id="modalSuaGoNoiMaText">100992</strong>
                    <span class="text-muted ms-1" style="font-size: 13px;">không phải mã của bạn?</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger font-weight-bold" onclick="goNoiModal()">Gỡ nối</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function() {
        khoiTaoDatePicker();
    });

    function khoiTaoDatePicker(scopeSelector) {
        const $targets = scopeSelector ? $(scopeSelector) : $('.datepicker-input');
        $targets.each(function() {
            const $this = $(this);
            if (!$this.data('DateTimePicker')) {
                $this.datetimepicker({
                    locale: "vi",
                    format: "DD/MM/YYYY",
                    useStrict: false,
                    widgetPositioning: {
                        horizontal: "auto",
                        vertical: "bottom",
                    },
                    extraFormats: ["DD/MM/YYYY", "DD-MM-YYYY", "YYYY-MM-DD", "YYYY"],
                    icons: {
                        date: "ti ti-calendar",
                        up: "ti ti-chevron-up",
                        down: "ti ti-chevron-down",
                        previous: "ti ti-chevron-left",
                        next: "ti ti-chevron-right",
                        time: "ti ti-alarm",
                        close: 'ti ti-x'
                    },
                    keyBinds: {
                        left: null,
                        right: null,
                    },
                    showClose: true
                });
            }
        });
    }

    // Bật/tắt mở rộng Drawer danh sách hồ sơ
    function toggleAccountDrawer(accountId, evt) {
        if (evt && (evt.target.closest('a') || evt.target.closest('button') || evt.target.closest('input') || evt.target.closest('select'))) {
            return;
        }

        const row = document.getElementById('account-row-' + accountId);
        const drawer = document.getElementById('drawer-' + accountId);
        if (!drawer || !row) return;

        if (drawer.style.display === 'none' || drawer.style.display === '') {
            drawer.style.display = 'table-row';
            row.classList.add('is-open');
            khoiTaoDatePicker('#drawer-' + accountId + ' .datepicker-input');
        } else {
            drawer.style.display = 'none';
            row.classList.remove('is-open');
        }
    }

    // Bật/tắt form thêm hồ sơ mới
    function toggleFormThem(accountId) {
        const f = document.getElementById('form-them-' + accountId);
        if (!f) return;
        const isShow = (f.style.display === 'none' || f.style.display === '');
        f.style.display = isShow ? 'block' : 'none';
        if (isShow) {
            khoiTaoDatePicker('#form-them-' + accountId + ' .datepicker-input');
        }
    }

    // ==================== MỞ MODAL SỬA HỒ SƠ THEO MẪU USER ====================
    function moModalSuaHoSo(id, accountId) {
        const tr = document.getElementById('hoso-row-' + id);
        if (!tr) return;

        const tenBN = tr.getAttribute('data-ten') || tr.querySelector('.val-ten')?.innerText?.trim();
        const cccd = tr.getAttribute('data-cccd') || '';
        const sdt = tr.getAttribute('data-sdt') || '';
        const ngaySinhIso = tr.getAttribute('data-ngaysinh') || '';
        const gioiTinh = tr.getAttribute('data-gioitinh') || '1';
        const maBN = tr.getAttribute('data-mabn') || '';
        const tenCoSo = tr.getAttribute('data-tencoso') || '';

        document.getElementById('modalSuaId').value = id;
        document.getElementById('modalSuaAccountId').value = accountId;
        document.getElementById('modalSuaTenSubtitle').innerText = tenBN;

        const inpMaBN = document.getElementById('modalSuaMaBN');
        const goNoiCard = document.getElementById('modalSuaGoNoiCard');
        const daNoiNote = document.getElementById('modalSuaDaNoiNote');
        const maGoiY = document.getElementById('modalSuaMaGoiY');

        if (maBN) {
            inpMaBN.value = `${maBN} ${tenCoSo ? `(${tenCoSo})` : ''}`;
            goNoiCard.style.display = 'flex';
            daNoiNote.style.display = 'block';
            maGoiY.style.display = 'block';
            document.getElementById('modalSuaGoNoiMaText').innerText = maBN;
        } else {
            inpMaBN.value = '';
            goNoiCard.style.display = 'none';
            daNoiNote.style.display = 'none';
            maGoiY.style.display = 'none';
        }

        document.getElementById('modalSuaCCCD').value = cccd;
        document.getElementById('modalSuaTen').value = tenBN;
        document.getElementById('modalSuaSDT').value = sdt;
        document.getElementById('modalSuaGioiTinh').value = gioiTinh;

        // Khởi tạo DateTimePicker cho Modal Sửa hồ sơ
        const $inpNgaySinh = $('#modalSuaNgaySinh');
        if ($inpNgaySinh.data('DateTimePicker')) {
            $inpNgaySinh.data('DateTimePicker').destroy();
        }

        let ngaySinhDisplay = '';
        if (ngaySinhIso) {
            const m = moment(ngaySinhIso, ['YYYY-MM-DD', 'YYYY/MM/DD', 'DD/MM/YYYY']);
            if (m.isValid()) {
                ngaySinhDisplay = m.format('DD/MM/YYYY');
            }
        }
        $inpNgaySinh.val(ngaySinhDisplay);
        khoiTaoDatePicker('#modalSuaNgaySinh');
        if (ngaySinhDisplay) {
            $inpNgaySinh.data('DateTimePicker').date(moment(ngaySinhDisplay, 'DD/MM/YYYY'));
        }

        document.getElementById('modalSuaHoSoBackdrop').style.display = 'flex';
    }

    function dongModalSuaHoSo(evt) {
        if (evt && evt.target !== document.getElementById('modalSuaHoSoBackdrop')) {
            return;
        }
        document.getElementById('modalSuaHoSoBackdrop').style.display = 'none';
    }

    // Lưu thông tin từ Modal
    async function luuThongTinModal() {
        const id = document.getElementById('modalSuaId').value;
        const accountId = document.getElementById('modalSuaAccountId').value;

        const tenBN = document.getElementById('modalSuaTen')?.value?.trim();
        const cccd = document.getElementById('modalSuaCCCD')?.value?.trim();
        const sdt = document.getElementById('modalSuaSDT')?.value?.trim();
        const ngaySinhRaw = document.getElementById('modalSuaNgaySinh')?.value?.trim();
        const gioiTinh = document.getElementById('modalSuaGioiTinh')?.value;

        if (!tenBN) {
            if (typeof showToast === 'function') showToast('Vui lòng nhập họ và tên bệnh nhân.', 'error');
            else alert('Vui lòng nhập họ và tên bệnh nhân.');
            return;
        }

        let ngaySinhIso = null;
        if (ngaySinhRaw) {
            const m = moment(ngaySinhRaw, ['DD/MM/YYYY', 'DD-MM-YYYY', 'YYYY-MM-DD']);
            if (m.isValid()) {
                ngaySinhIso = m.format('YYYY-MM-DD');
            } else {
                if (typeof showToast === 'function') showToast('Ngày sinh không hợp lệ (định dạng dd/mm/yyyy).', 'error');
                else alert('Ngày sinh không hợp lệ.');
                return;
            }
        }

        const btnSave = document.getElementById('modalSuaBtnSave');
        btnSave.disabled = true;
        btnSave.innerText = 'Đang lưu...';

        try {
            const resp = await fetch('/Admin/TaiKhoan/CapNhatHoSo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: parseInt(id),
                    idTaiKhoan: parseInt(accountId),
                    tenBN: tenBN,
                    cccd: cccd,
                    sdt: sdt,
                    ngaySinh: ngaySinhIso,
                    gioiTinh: gioiTinh
                })
            });

            const res = await resp.json();
            if (res.success) {
                const d = res.data;
                const tr = document.getElementById('hoso-row-' + id);
                if (tr) {
                    tr.setAttribute('data-ten', d.tenBN);
                    tr.setAttribute('data-cccd', d.cccd);
                    tr.setAttribute('data-sdt', d.sdt);
                    tr.setAttribute('data-ngaysinh', d.ngaySinh ? moment(d.ngaySinh).format('YYYY-MM-DD') : '');
                    tr.setAttribute('data-gioitinh', d.gioiTinh);

                    tr.querySelector('.val-ten').innerText = d.tenBN;
                    tr.querySelector('.val-cccd').innerText = d.cccd || '—';
                    tr.querySelector('.val-sdt').innerText = d.sdt || '—';
                    tr.querySelector('.val-ngaysinh').innerText = d.ngaySinhVn || (d.ngaySinh ? moment(d.ngaySinh).format('DD/MM/YYYY') : '—');
                    tr.querySelector('.val-gioitinh').innerText = d.gioiTinhVn || 'Khác';
                }

                document.getElementById('modalSuaHoSoBackdrop').style.display = 'none';

                if (typeof showToast === 'function') showToast(res.message || 'Đã lưu hồ sơ thành công.', 'success');
            } else {
                if (typeof showToast === 'function') showToast(res.message || 'Không thể lưu hồ sơ.', 'error');
                else alert(res.message);
            }
        } catch (e) {
            console.error(e);
            if (typeof showToast === 'function') showToast('Lỗi kết nối máy chủ khi lưu hồ sơ.', 'error');
        } finally {
            btnSave.disabled = false;
            btnSave.innerText = 'Lưu';
        }
    }

    function goNoiModal() {
        if (confirm('Bạn có chắc chắn muốn gỡ nối mã cơ sở này?')) {
            document.getElementById('modalSuaMaBN').value = '';
            document.getElementById('modalSuaGoNoiCard').style.display = 'none';
            document.getElementById('modalSuaDaNoiNote').style.display = 'none';
            document.getElementById('modalSuaMaGoiY').style.display = 'none';
            if (typeof showToast === 'function') showToast('Đã gỡ nối mã cơ sở.', 'success');
        }
    }

    // Xóa hồ sơ (AJAX)
    async function xoaThongTinHoSo(id, tenBN, accountId) {
        if (!confirm(`Bạn có chắc chắn muốn xóa hồ sơ "${tenBN}" này không?`)) {
            return;
        }

        try {
            const resp = await fetch('/Admin/TaiKhoan/XoaHoSo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id, idTaiKhoan: accountId })
            });

            const res = await resp.json();
            if (res.success) {
                const tr = document.getElementById('hoso-row-' + id);
                if (tr) {
                    tr.remove();
                }

                // Cập nhật số đếm hồ sơ trên badge
                capNhatSoLuongHoSo(accountId);

                if (typeof showToast === 'function') showToast(res.message || 'Đã xóa hồ sơ thành công.', 'success');
            } else {
                if (typeof showToast === 'function') showToast(res.message || 'Không thể xóa hồ sơ.', 'error');
                else alert(res.message);
            }
        } catch (e) {
            console.error(e);
            if (typeof showToast === 'function') showToast('Lỗi kết nối khi xóa hồ sơ.', 'error');
        }
    }

    // Tạo hồ sơ mới (AJAX)
    async function taoHoSoMoi(accountId) {
        const tenEl = document.getElementById('new-ten-' + accountId);
        const cccdEl = document.getElementById('new-cccd-' + accountId);
        const sdtEl = document.getElementById('new-sdt-' + accountId);
        const nsEl = document.getElementById('new-ngaysinh-' + accountId);
        const gtEl = document.getElementById('new-gioitinh-' + accountId);

        const tenBN = tenEl?.value?.trim();
        const cccd = cccdEl?.value?.trim();
        const sdt = sdtEl?.value?.trim();
        const ngaySinhRaw = nsEl?.value?.trim();
        const gioiTinh = gtEl?.value;

        if (!tenBN) {
            if (typeof showToast === 'function') showToast('Vui lòng nhập họ và tên hồ sơ.', 'error');
            else alert('Vui lòng nhập họ và tên hồ sơ.');
            return;
        }

        let ngaySinhIso = null;
        if (ngaySinhRaw) {
            const m = moment(ngaySinhRaw, ['DD/MM/YYYY', 'DD-MM-YYYY', 'YYYY-MM-DD']);
            if (m.isValid()) {
                ngaySinhIso = m.format('YYYY-MM-DD');
            } else {
                if (typeof showToast === 'function') showToast('Ngày sinh không hợp lệ (định dạng dd/mm/yyyy).', 'error');
                else alert('Ngày sinh không hợp lệ.');
                return;
            }
        }

        try {
            const resp = await fetch('/Admin/TaiKhoan/TaoHoSo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    idTaiKhoan: accountId,
                    tenBN: tenBN,
                    cccd: cccd,
                    sdt: sdt,
                    ngaySinh: ngaySinhIso,
                    gioiTinh: gioiTinh
                })
            });

            const res = await resp.json();
            if (res.success) {
                const d = res.data;
                const tbody = document.getElementById('tbody-hoso-' + accountId);
                const emptyRow = document.getElementById('empty-row-' + accountId);
                if (emptyRow) emptyRow.remove();

                const newRow = document.createElement('tr');
                newRow.id = 'hoso-row-' + d.id;
                newRow.setAttribute('data-id', d.id);
                newRow.setAttribute('data-account-id', accountId);
                newRow.setAttribute('data-ten', d.tenBN);
                newRow.setAttribute('data-cccd', d.cccd);
                newRow.setAttribute('data-sdt', d.sdt);
                newRow.setAttribute('data-ngaysinh', d.ngaySinh ? moment(d.ngaySinh).format('YYYY-MM-DD') : '');
                newRow.setAttribute('data-gioitinh', d.gioiTinh);

                const ngaySinhHienThi = d.ngaySinhVn || (d.ngaySinh ? moment(d.ngaySinh).format('DD/MM/YYYY') : '—');

                newRow.innerHTML = `
                    <td>
                        <span class="val-ten fw-bold text-dark">${d.tenBN}</span>
                    </td>
                    <td>
                        <span class="val-cccd font-monospace">${d.cccd || '—'}</span>
                    </td>
                    <td>
                        <span class="val-sdt">${d.sdt || '—'}</span>
                    </td>
                    <td>
                        <span class="val-ngaysinh">${ngaySinhHienThi}</span>
                    </td>
                    <td>
                        <span class="val-gioitinh">${d.gioiTinhVn || 'Khác'}</span>
                    </td>
                    <td>
                        <span class="badge bg-light text-secondary border">Chưa nối</span>
                    </td>
                    <td class="text-end">
                        <div class="hoso-action-group">
                            <button type="button" class="btn-hoso-icon btn-hoso-edit" onclick="moModalSuaHoSo(${d.id}, ${accountId})" title="Sửa hồ sơ">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </button>
                            <button type="button" class="btn-hoso-icon btn-hoso-delete" onclick="xoaThongTinHoSo(${d.id}, '${d.tenBN.replace(/'/g, "\\'")}', ${accountId})" title="Xóa hồ sơ">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                            </button>
                        </div>
                    </td>
                `;

                tbody.appendChild(newRow);

                // Reset form
                if (tenEl) tenEl.value = '';
                if (cccdEl) cccdEl.value = '';
                if (nsEl) {
                    nsEl.value = '';
                    if ($(nsEl).data('DateTimePicker')) {
                        $(nsEl).data('DateTimePicker').clear();
                    }
                }
                toggleFormThem(accountId);

                capNhatSoLuongHoSo(accountId);

                if (typeof showToast === 'function') showToast(res.message || 'Đã tạo hồ sơ mới thành công.', 'success');
            } else {
                if (typeof showToast === 'function') showToast(res.message || 'Không thể tạo hồ sơ.', 'error');
                else alert(res.message);
            }
        } catch (e) {
            console.error(e);
            if (typeof showToast === 'function') showToast('Lỗi kết nối khi tạo hồ sơ.', 'error');
        }
    }

    function capNhatSoLuongHoSo(accountId) {
        const tbody = document.getElementById('tbody-hoso-' + accountId);
        const rows = tbody ? tbody.querySelectorAll('tr[data-id]') : [];
        const count = rows.length;

        const badge = document.getElementById('badge-' + accountId);
        if (badge) {
            badge.innerHTML = `<span>${count}</span> hồ sơ <span class="arrow-rot">▾</span>`;
        }

        const countLabel = document.getElementById('count-label-' + accountId);
        if (countLabel) {
            countLabel.innerText = `${count} hồ sơ`;
        }

        if (count === 0 && tbody) {
            tbody.innerHTML = `
                <tr class="empty-hoso-tr" id="empty-row-${accountId}">
                    <td colspan="7" class="text-center py-4 text-muted">
                        <div>📋</div>
                        <div>Chưa có hồ sơ bệnh nhân nào liên kết với tài khoản này.</div>
                    </td>
                </tr>
            `;
        }
    }
</script>
}
