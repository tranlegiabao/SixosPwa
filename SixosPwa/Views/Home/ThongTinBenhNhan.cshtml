@model List<SixosPwa.Models.LichSuKham>
@{
    ViewData["Title"] = "Y TẾ VIỆT - Đăng Ký Khám Bệnh";
    Layout = "_Layout";
}
<style>
    /* Hide layout parts */
    .app-nav, .bottom-nav, .app-foot { display: none !important; }
    body { background-color: #f0f4f8; margin: 0; padding-bottom: 120px !important; font-family: 'Inter', sans-serif; }
    .container, main.container { max-width: 100% !important; padding: 0 !important; margin: 0 !important; }

    /* Layout Variables */
    :root {
        --ytv-primary: #3b82f6; /* Xanh dương nhạt */
        --ytv-secondary: #0ea5e9; /* Xanh biển sáng */
        --ytv-accent: #ffb703;
        --ytv-text: #334155;
        --ytv-bg: #f0f9ff;
    }

    /* HEADER */
    .ytv-header {
        background: linear-gradient(135deg, #3b82f6, #60a5fa);
        color: white;
        padding: 15px 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        border-bottom: 3px solid var(--ytv-secondary);
    }
    .ytv-logo-area {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .ytv-logo-circle {
        width: 60px;
        height: 60px;
        border: 2px solid white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: bold;
        background: rgba(255,255,255,0.1);
    }
    .ytv-logo-text {
        font-family: 'Times New Roman', Times, serif;
        font-size: 34px;
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: 1px;
        text-shadow: 1px 1px 3px rgba(255, 255, 255, 0.4);
    }
    .ytv-header-title {
        text-align: center;
    }
    .ytv-header-title h1 {
        font-size: 26px;
        font-weight: 700;
        margin: 0 0 5px 0;
        text-transform: uppercase;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    }
    .ytv-header-title p {
        font-size: 20px;
        margin: 0;
        color: #e0f2f1;
        font-style: italic;
    }
    .ytv-header-menu {
        font-size: 32px;
        cursor: pointer;
        padding: 10px;
        position: relative;
    }
    .ytv-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        right: 0;
        background: white;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.15);
        min-width: 240px;
        z-index: 9999;
        overflow: hidden;
        animation: fadeDown 0.2s ease;
    }
    .ytv-dropdown.open { display: block; }
    @@keyframes fadeDown {
        from { opacity: 0; transform: translateY(-10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .ytv-dropdown a {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px 20px;
        color: #334155;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s;
    }
    .ytv-dropdown a:last-child { border-bottom: none; }
    .ytv-dropdown a:hover {
        background: #eff6ff;
        color: var(--ytv-primary);
        padding-left: 28px;
    }
    .ytv-dropdown a i {
        font-size: 20px;
        width: 26px;
        text-align: center;
        color: var(--ytv-secondary);
    }

    /* MAIN CONTAINER */
    .ytv-main {
        display: flex;
        min-height: calc(100vh - 170px); /* 100px header + 70px footer */
        background: #f8fafc;
    }

    /* SIDEBAR */
    .ytv-sidebar {
        width: 300px;
        background: white;
        border-right: 1px solid #e2e8f0;
        box-shadow: 2px 0 10px rgba(0,0,0,0.03);
        display: flex;
        flex-direction: column;
        padding: 20px 0;
    }
    .ytv-menu-item {
        padding: 18px 25px;
        display: flex;
        align-items: center;
        gap: 15px;
        color: var(--ytv-primary);
        font-size: 18px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        border-left: 4px solid transparent;
    }
    .ytv-menu-item i {
        font-size: 22px;
        width: 30px;
        text-align: center;
        color: #64748b;
        transition: all 0.3s ease;
    }
    .ytv-menu-item:hover, .ytv-menu-item.active {
        background: #f1f5f9;
        border-left-color: var(--ytv-secondary);
        color: var(--ytv-primary);
    }
    .ytv-menu-item:hover i, .ytv-menu-item.active i {
        color: var(--ytv-secondary);
        transform: scale(1.1);
    }

    /* SLIDER AREA */
    .ytv-content {
        flex: 1;
        padding: 20px;
        display: flex;
        flex-direction: column;
    }
    .ytv-slider {
        width: 100%;
        height: 100%;
        min-height: 150px;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        position: relative;
    }
    .carousel-item {
        height: 100%;
        min-height: 150px;
    }
    .carousel-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* FOOTER */
    .ytv-footer {
        background: #e0f2fe; /* xanh nhạt */
        color: #334155;
        padding: 20px 30px 10px 30px;
        display: flex;
        flex-direction: column;
        border-top: 4px solid var(--ytv-primary);
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
    }
    .ytv-footer-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 20px;
    }
    .ytv-support-col {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .ytv-support-phones {
        font-size: 16px;
        font-weight: 500;
    }
    .ytv-support-phones span {
        color: var(--ytv-primary);
        font-weight: 700;
        font-size: 18px;
    }
    .ytv-contact-row {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 15px;
    }
    .ytv-social-btn-light {
        width: 36px;
        height: 36px;
        background: white;
        border: 1px solid #bae6fd;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: var(--ytv-primary);
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    .ytv-social-btn-light:hover {
        background: var(--ytv-primary);
        color: white;
        transform: translateY(-2px);
    }
    .ytv-policies-col {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        font-weight: 500;
        margin-top: 5px;
    }
    .ytv-policies-col a {
        color: #0f172a;
        text-decoration: none;
        transition: color 0.2s;
    }
    .ytv-policies-col a:hover {
        color: var(--ytv-primary);
    }
    .ytv-policies-col .separator {
        color: #94a3b8;
    }
    .ytv-footer-bottom {
        text-align: center;
        font-size: 14px;
        color: #64748b;
        border-top: 1px solid #bae6fd;
        padding-top: 15px;
    }

    /* RESPONSIVE */
    @@media (max-width: 992px) {
        .ytv-header { flex-direction: column; gap: 15px; text-align: center; }
        .ytv-main { flex-direction: column; }
        .ytv-sidebar { width: 100%; border-right: none; border-bottom: 1px solid #e2e8f0; flex-direction: row; overflow-x: auto; padding: 10px 0; }
        .ytv-menu-item { flex-direction: column; padding: 10px 20px; white-space: nowrap; border-left: none; border-bottom: 3px solid transparent; gap: 5px; font-size: 14px; }
        .ytv-menu-item.active, .ytv-menu-item:hover { border-bottom-color: var(--ytv-secondary); }
        .ytv-footer-top { flex-direction: column; gap: 20px; align-items: center; text-align: center; }
        .ytv-contact-row { justify-content: center; }
        .ytv-policies-col { justify-content: center; }
        .ytv-slider { min-height: 160px; }
        .carousel-item { min-height: 160px; }
    }
</style>

