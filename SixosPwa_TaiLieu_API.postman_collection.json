      },
      "response": []
    },
    {
      "name": "6. Lỗi - Tệp không phải PDF hợp lệ (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "X-Ma-CSKCB",
            "value": "{{ma_cskcb}}",
            "type": "text"
          },
          {
            "key": "X-Loai-Tai-Lieu",
            "value": "{{loai_tai_lieu}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maBenhNhan\": \"BN00123\",\n  \"filePdf\": \"SGVsbG8gd29ybGQgbm90IGEgcGRmIGZpbGU=\",\n  \"tenTaiLieu\": \"File giả mạo không phải PDF\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/tai-lieu/tiep-nhan",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
