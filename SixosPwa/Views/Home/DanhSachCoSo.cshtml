@{
    ViewData["Title"] = ViewData["Title"];
}

<style>
    /* Ẩn Layout mặc định */
    .app-nav { display: none !important; }
    .bottom-nav { display: none !important; }
    body { background-color: var(--ytv-bg); padding-bottom: 0 !important; margin: 0 !important; }

    /* Buoc Layout cha phai full width */
    body > *,
    .container, .container-fluid, .container-sm, .container-md, .container-lg, .container-xl, .container-xxl {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    /* Layout Variables */
    :root {
        --ytv-primary: #3b82f6;
        --ytv-secondary: #0ea5e9;
        --ytv-accent: #ffb703;
        --ytv-text: #334155;
        --ytv-bg: #f0f9ff;
    }

    /* HEADER */
    .ytv-header {
        background: linear-gradient(135deg, #3b82f6, #60a5fa);
        color: white;
        padding: 15px 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        position: relative;
    }
    .ytv-logo-area {
        display: flex;
        align-items: center;
        gap: 15px;
        text-decoration: none;
        color: white;
    }
    .ytv-logo-area:hover {
        color: white;
    }
    .ytv-logo-text {
        font-family: 'Times New Roman', Times, serif;
        font-size: 28px;
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: 1px;
        text-shadow: 1px 1px 3px rgba(255, 255, 255, 0.4);
    }
    .ytv-header-title {
        text-align: center;
        flex-grow: 1;
    }
    .ytv-header-title h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }
    .ytv-header-title p {
        margin: 5px 0 0 0;
        font-size: 14px;
        opacity: 0.9;
    }
    .ytv-menu-btn {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        font-size: 24px;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.3s;
    }
    .ytv-menu-btn:hover {
        background: rgba(255,255,255,0.3);
    }

    /* MAIN CONTAINER */
    .ytv-main {
        display: flex;
        width: 100%;
        min-height: calc(100vh - 140px);
        background: white;
    }

    /* MENU SIDEBAR */
    .ytv-sidebar {
        width: 220px;
        flex-shrink: 0;
        background: #f8fafc;
        border-right: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        padding: 10px 0;
    }
    .ytv-menu-item {
        display: flex;
        align-items: center;
        padding: 15px 20px;
        gap: 15px;
        color: var(--ytv-primary);
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        border-left: 4px solid transparent;
    }
    .ytv-menu-item i {
        font-size: 22px;
        width: 30px;
        text-align: center;
        color: #64748b;
        transition: all 0.3s ease;
    }
    .ytv-menu-item:hover, .ytv-menu-item.active {
        background: #f1f5f9;
        border-left-color: var(--ytv-secondary);
        color: var(--ytv-primary);
    }
    .ytv-menu-item:hover i, .ytv-menu-item.active i {
        color: var(--ytv-secondary);
        transform: scale(1.1);
    }

    /* KHU VUC SECTION */
    .ytv-khu-vuc {
        margin-top: 10px;
        padding: 15px 15px 10px 15px;
        border-top: 1px solid #e2e8f0;
    }
    .ytv-khu-vuc-title {
        font-size: 14px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .ytv-province-select {
        width: 100%;
        padding: 8px 12px;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        font-size: 14px;
        color: var(--ytv-text);
        margin-bottom: 10px;
        outline: none;
        transition: border-color 0.3s;
        background: white;
        cursor: pointer;
    }
    .ytv-province-select:focus {
        border-color: var(--ytv-primary);
    }
    .ytv-district-list {
        list-style: none;
        padding: 0;
        margin: 0;
        max-height: 200px;
        overflow-y: auto;
    }
    .ytv-district-list li {
        padding: 8px 12px;
        font-size: 13px;
        font-weight: 500;
        color: #475569;
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .ytv-district-list li:hover, .ytv-district-list li.active {
        color: var(--ytv-primary);
        background: #eff6ff;
    }

    /* RIGHT CONTENT */
    .ytv-content {
        flex: 1;
        padding: 30px;
        background: #ffffff;
    }
    .ytv-content-title {
        font-size: 24px;
        font-weight: 800;
        color: var(--ytv-primary);
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }
    .ytv-content-title-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .ytv-search-box {
        position: relative;
        width: 300px;
    }
    .ytv-search-box input {
        width: 100%;
        padding: 10px 15px 10px 40px;
        border: 1px solid #cbd5e1;
        border-radius: 20px;
        outline: none;
        font-size: 14px;
        transition: border-color 0.3s;
    }
    .ytv-search-box input:focus {
        border-color: var(--ytv-primary);
    }
    .ytv-search-box i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
    }
    .ytv-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }
    .ytv-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        transition: transform 0.3s, box-shadow 0.3s;
        display: flex;
        flex-direction: column;
    }
    .ytv-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        border-color: var(--ytv-secondary);
    }
    .ytv-card-img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        background: #f1f5f9;
    }
    .ytv-card-body {
        padding: 15px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .ytv-card-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--ytv-text);
        margin-bottom: 10px;
    }
    .ytv-card-address {
        font-size: 14px;
        color: #64748b;
        margin-bottom: 15px;
        display: flex;
        gap: 8px;
    }
    .ytv-card-address i {
        color: var(--ytv-secondary);
        margin-top: 3px;
    }
    .ytv-card-btn {
        margin-top: auto;
        display: block;
        width: 100%;
        padding: 10px;
        background: var(--ytv-primary);
        color: white;
        text-align: center;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.3s;
    }
    .ytv-card-btn:hover {
        background: var(--ytv-secondary);
        color: white;
    }

    /* FOOTER */
    .ytv-footer {
        background: #e0f2fe; 
        color: #334155;
        padding: 25px 30px 15px 30px;
        display: flex;
        flex-direction: column;
        border-top: 4px solid var(--ytv-primary);
    }
    .ytv-footer-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 20px;
    }
    .ytv-support-col {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .ytv-support-phones {
        font-size: 16px;
        font-weight: 500;
    }
    .ytv-support-phones span {
        color: var(--ytv-primary);
        font-weight: 700;
        font-size: 18px;
    }
    .ytv-policies-col {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        font-weight: 500;
        margin-top: 5px;
    }
    .ytv-policies-col a {
        color: #0f172a;
        text-decoration: none;
        transition: color 0.2s;
    }
    .ytv-policies-col a:hover {
        color: var(--ytv-primary);
    }
    .ytv-policies-col .separator {
        color: #94a3b8;
    }
    .ytv-footer-bottom {
        text-align: center;
        font-size: 14px;
        color: #64748b;
        border-top: 1px solid #bae6fd;
        padding-top: 15px;
    }

    /* RESPONSIVE */
    @@media (max-width: 992px) {
        .ytv-header { flex-direction: column; gap: 15px; text-align: center; }
        .ytv-main { flex-direction: column; }
        .ytv-sidebar { width: 100%; border-right: none; border-bottom: 1px solid #e2e8f0; padding: 15px; }
        .ytv-grid { grid-template-columns: repeat(2, 1fr); }
        .ytv-footer-top { flex-direction: column; gap: 20px; align-items: center; text-align: center; }
        .ytv-policies-col { justify-content: center; }
    }
    @@media (max-width: 576px) {
        .ytv-grid { grid-template-columns: 1fr; }
        .ytv-sidebar { padding: 10px; }
        .ytv-content { padding: 15px; }
        .ytv-search-box { width: 100%; }
        .ytv-content-title { flex-direction: column; align-items: flex-start; }
    }
</style>

<div class="ytv-header">
    <a href="/Home/ThongTinBenhNhan" class="ytv-logo-area">
        <img src="/static/logo-yte.png" alt="Logo" style="height: 50px; width: 50px; object-fit: contain; background: white; border-radius: 50%; padding: 5px;" />
        <div class="ytv-logo-text">Y TẾ<br>VIỆT</div>
    </a>
    <div class="ytv-header-title d-none d-md-block">
        <h1>Dịch Vụ Đăng Ký Khám Bệnh Online</h1>
        <p>Tiện lợi - Nhanh chóng - Chính xác</p>
    </div>
    <a href="/Home/ThongTinBenhNhan" class="ytv-menu-btn" title="Quay lại">
        <i class="fas fa-home"></i>
    </a>
</div>

<div class="ytv-main">
    <div class="ytv-sidebar">
        <!-- KHU VUC -->
        <div class="ytv-khu-vuc">
            <div class="ytv-khu-vuc-title">
                <i class="fas fa-map-marker-alt"></i> Khu vực
            </div>
            <select class="ytv-province-select" id="provinceSelect">
                <option value="">-- Chọn Tỉnh / TP --</option>
            </select>
            <ul class="ytv-district-list" id="districtList">
                <li class="active" data-code="">Tất cả quận huyện <i class="fas fa-check"></i></li>
            </ul>
        </div>
    </div>
    <div class="ytv-content">
        <div class="ytv-content-title">
            <div class="ytv-content-title-left">
                <span>Danh sách @ViewData["Title"]</span>
                <span class="badge bg-primary rounded-pill" style="font-size: 14px;"><span id="resultCount">0</span> cơ sở</span>
            </div>
            <div class="ytv-search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="Tìm kiếm tên cơ sở..." autocomplete="off" />
            </div>
        </div>
        
        <div class="ytv-grid" id="clinicGrid">
            <!-- Rendered by JS -->
        </div>
    </div>
</div>

<div class="ytv-footer">
    <div class="ytv-footer-top">
        <div class="ytv-support-col">
            <div class="ytv-support-phones" style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
                <div><i class="fas fa-headset me-2"></i> Hỗ trợ: <span>0901 82 88 96</span> - <span>0364 956 007</span></div>
                <div><i class="fas fa-envelope me-2"></i> Email: <a href="mailto:Sixossoft@gmail.com" style="color: var(--ytv-primary); font-weight: 600; text-decoration: none;">Sixossoft@gmail.com</a></div>
            </div>
        </div>
        
        <div class="ytv-policies-col">
            <a href="#">Chính sách bảo mật</a> <span class="separator">|</span>
            <a href="#">Điều khoản sử dụng</a> <span class="separator">|</span>
            <a href="#">Giải quyết khiếu nại</a> <span class="separator">|</span>
            <a href="#">Chính sách bảo hành</a>
        </div>
    </div>
    <div class="ytv-footer-bottom">
        Đơn vị phối hợp thực hiện: <strong>Công Ty Phần mềm Vũ Phong - SixOSSoft.com</strong>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let provinceData = [];
        let allClinics = [];
        const provinceSelect = document.getElementById("provinceSelect");
        const districtList = document.getElementById("districtList");
        const clinicGrid = document.getElementById("clinicGrid");
        const resultCount = document.getElementById("resultCount");
        const searchInput = document.getElementById("searchInput");
        const catName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Title"]?.ToString() ?? ""));

        const images = [
            "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=500&q=80",
            "https://images.unsplash.com/photo-1581594693702-fbdc51b2763b?w=500&q=80",
            "https://images.unsplash.com/photo-1538108149393-fbbd81895907?w=500&q=80",
            "https://images.unsplash.com/photo-1579684385127-1ef15d508118?w=500&q=80"
        ];

        // Danh sach co so mau
        const sampleNames = [
            "Bệnh viện Bạch Mai", "Bệnh viện Chợ Rẫy", "Bệnh viện Việt Đức",
            "Bệnh viện 115", "Bệnh viện Đại học Y Hà Nội", "Bệnh viện Nhi Trung Ương",
            "Bệnh viện Phụ Sản Trung Ương", "Bệnh viện K", "Bệnh viện Hữu Nghị",
            "Bệnh viện Quân Y 108", "Bệnh viện Quân Y 175", "Bệnh viện Từ Dũ",
            "Bệnh viện An Bình", "Bệnh viện Nhi Đồng 1", "Bệnh viện Nhi Đồng 2",
            "Bệnh viện Ung Bướu TP.HCM", "Bệnh viện Nhân Dân Gia Định", "Bệnh viện FV",
            "Bệnh viện Vinmec Times City", "Bệnh viện Vinmec Central Park",
            "Phòng khám Đa khoa Hà Đông", "Phòng khám Medlatec", "Phòng khám Thu Cúc",
            "Nha khoa Thẩm Mỹ Sài Gòn", "Nhà thuốc Long Châu", "Nhà thuốc Pharmacity"
        ];

        // Initial Empty State
        showEmptyState();

        // Search logic - gõ tên là tìm ngay
        searchInput.addEventListener("input", function() {
            const keyword = this.value.toLowerCase().trim();

            if (keyword.length === 0) {
                if (allClinics.length === 0) {
                    showEmptyState();
                } else {
                    renderClinics(allClinics);
                }
                return;
            }

            // Nếu chưa có dữ liệu tỉnh, tìm trong danh sách mẫu
            let searchPool = allClinics.length > 0 ? allClinics : sampleNames.map((name, i) => ({
                name,
                address: "Đang cập nhật",
                img: images[i % images.length]
            }));

            const filtered = searchPool.filter(c => c.name.toLowerCase().includes(keyword));
            renderClinics(filtered);
        });

        // Fetch 63 provinces
        fetch("https://provinces.open-api.vn/api/?depth=2")
            .then(res => res.json())
            .then(data => {
                provinceData = data;
                data.forEach(p => {
                    const opt = document.createElement("option");
                    opt.value = p.code;
                    opt.textContent = p.name;
                    provinceSelect.appendChild(opt);
                });
            })
            .catch(err => console.error("Lỗi lấy dữ liệu tỉnh thành: ", err));

        provinceSelect.addEventListener("change", function () {
            const selectedCode = this.value;
            if (!selectedCode) {
                districtList.innerHTML = `<li class="active" data-code="">Tất cả quận huyện <i class="fas fa-check text-primary"></i></li>`;
                allClinics = [];
                showEmptyState();
                return;
            }
            const selectedProvince = provinceData.find(p => p.code == selectedCode);
            renderDistricts(selectedProvince);
            generateMockClinics(selectedProvince.name, "Tất cả quận huyện");
        });

        function showEmptyState() {
            resultCount.textContent = "0";
            clinicGrid.style.display = "block";
            clinicGrid.innerHTML = `
                <div style="text-align: center; padding: 50px 20px; color: #64748b; background: #f8fafc; border-radius: 12px; border: 2px dashed #cbd5e1;">
                    <i class="fas fa-search-location" style="font-size: 48px; color: #94a3b8; margin-bottom: 15px;"></i>
                    <h3 style="font-size: 18px; font-weight: 600; color: #475569;">Vui lòng chọn khu vực hoặc tìm kiếm</h3>
                    <p style="margin: 0;">Hãy chọn Tỉnh / Thành phố bên trái, hoặc gõ tên cơ sở vào ô tìm kiếm</p>
                </div>
            `;
        }

        function renderClinics(list) {
            if (list.length === 0) {
                clinicGrid.style.display = "block";
                clinicGrid.innerHTML = `
                    <div style="text-align: center; padding: 50px 20px; color: #64748b; background: #f8fafc; border-radius: 12px; border: 2px dashed #cbd5e1;">
                        <i class="fas fa-search" style="font-size: 48px; color: #94a3b8; margin-bottom: 15px;"></i>
                        <h3 style="font-size: 18px; font-weight: 600; color: #475569;">Không tìm thấy kết quả</h3>
                        <p style="margin: 0;">Thử tìm với từ khóa khác nhé</p>
                    </div>`;
                resultCount.textContent = "0";
                return;
            }
            clinicGrid.style.display = "grid";
            resultCount.textContent = list.length;
            clinicGrid.innerHTML = list.map((c, i) => `
                <div class="ytv-card clinic-card">
                    <img src="${c.img}" alt="${c.name}" class="ytv-card-img" />
                    <div class="ytv-card-body">
                        <div class="ytv-card-title">${c.name}</div>
                        <div class="ytv-card-address">
                            <i class="fas fa-map-pin"></i>
                            <span class="address-text">${c.address}</span>
                        </div>
                        <a href="/Home/ChiTietCoSo?ten=${encodeURIComponent(c.name)}&diaChi=${encodeURIComponent(c.address)}&type=@(ViewData["Type"]?.ToString() ?? "benhvien")&img=${encodeURIComponent(c.img)}" class="ytv-card-btn">Xem chi tiết</a>
                    </div>
                </div>`).join("");
        }

        function renderDistricts(province) {
            districtList.innerHTML = `<li class="active" data-code="">Tất cả quận huyện <i class="fas fa-check text-primary"></i></li>`;
            if (province && province.districts) {
                province.districts.forEach(d => {
                    const li = document.createElement("li");
                    li.dataset.code = d.code;
                    li.textContent = d.name;
                    li.addEventListener("click", function() {
                        districtList.querySelectorAll("li").forEach(item => {
                            item.classList.remove("active");
                            const icon = item.querySelector("i");
                            if (icon) icon.remove();
                        });
                        this.classList.add("active");
                        this.innerHTML += ' <i class="fas fa-check text-primary"></i>';
                        generateMockClinics(province.name, d.name);
                    });
                    districtList.appendChild(li);
                });
            }
            districtList.firstElementChild.addEventListener("click", function() {
                districtList.querySelectorAll("li").forEach(item => {
                    item.classList.remove("active");
                    const icon = item.querySelector("i");
                    if (icon) icon.remove();
                });
                this.classList.add("active");
                this.innerHTML += ' <i class="fas fa-check text-primary"></i>';
                generateMockClinics(province.name, "Tất cả quận huyện");
            });
        }

        function generateMockClinics(provinceName, districtName) {
            const count = Math.floor(Math.random() * 5) + 2;
            allClinics = [];
            for (let i = 1; i <= count; i++) {
                const dName = districtName === "Tất cả quận huyện" ? "Quận " + (Math.floor(Math.random() * 10) + 1) : districtName;
                allClinics.push({
                    name: `${catName} Mẫu Số ${i}`,
                    address: `123 Đường Số ${i}, ${dName}, ${provinceName}`,
                    img: images[i % images.length]
                });
            }
            renderClinics(allClinics);
        }
    });
</script>
