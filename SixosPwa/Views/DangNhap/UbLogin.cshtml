<body class="bg-ccc">
@* px-lg-0: container-fluid cua Bootstrap co padding 12px moi ben, lam panel
   tim thut vao va de lo vien trang o hai mep man hinh. Kho dien thoai van
   giu padding do de noi dung co le. *@
<div class="container-fluid px-lg-0">
<div class="row g-0 ub-khung">

@{
    var trangChuUb = (string?)ViewBag.TrangChuDoiTac;
    var chiNhanh = ViewBag.ChiNhanh as IReadOnlyList<SixosPwa.Services.Partner.ChiNhanhDoiTac>
                   ?? (IReadOnlyList<SixosPwa.Services.Partner.ChiNhanhDoiTac>)Array.Empty<SixosPwa.Services.Partner.ChiNhanhDoiTac>();
    var hotline = string.Join(" - ", chiNhanh.Select(x => x.Hotline)
                                             .Where(x => !string.IsNullOrWhiteSpace(x))
                                             .Distinct());
}
@* --------------------------------------------------------------------------
   Panel quang ba cua doi tac — CHI hien tu kho may tinh (d-none d-lg-flex).
   Ban dien thoai co y giu mot cot nhu cu.

   Chep dang tu Views/HT_DangNhap/Login.cshtml cua ho (cot col-md-7, nen
   #393be7). Ba khac biet co chu dich:
     1. Anh quang ba tro THANG sang trang doi tac ({TrangChu}/Image/ImageLogin/)
        de ho doi anh thi ben minh tu theo, khong phai chep lai.
     2. Danh sach chi nhanh do MAY CHU do vao (cache 10 phut) thay vi JS goi
        /branches moi lan mo man.
     3. Khong co panel nay thi man van dung — no chi la trang tri.
   -------------------------------------------------------------------------- *@
@if (!string.IsNullOrWhiteSpace(trangChuUb))
{
    <div class="ub-panel col-lg-7 d-none d-lg-flex flex-column">
        <div class="ub-panel__dau">
            <img src="@(trangChuUb)/Image/Logo_DangNhap.png" alt="@ViewBag.TenCoSo" class="ub-panel__logo">
            @if (!string.IsNullOrWhiteSpace(hotline))
            {
                <div class="ub-panel__hotline">TỔNG ĐÀI TƯ VẤN: <span class="fw-bold">@hotline</span></div>
            }
        </div>

        <div id="ubCarousel" class="carousel slide ub-panel__anh" data-bs-ride="carousel" data-bs-interval="4000">
            <div class="carousel-inner">
                @for (var i = 8; i <= 9; i++)
                {
                    <div class="carousel-item @(i == 8 ? "active" : "")">
                        <img src="@(trangChuUb)/Image/ImageLogin/@(i).png" class="d-block w-100" alt="Chương trình khám">
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#ubCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Trước</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#ubCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Sau</span>
            </button>
        </div>

        @if (chiNhanh.Count > 0)
        {
            <div class="ub-panel__coso">
                @foreach (var cn in chiNhanh)
                {
                    <div class="ub-coso">
                        <div class="ub-coso__ten">@cn.Ten</div>
                        @if (!string.IsNullOrWhiteSpace(cn.DiaChi))
                        {
                            <div class="ub-coso__dong">@cn.DiaChi</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(cn.Hotline))
                        {
                            <div class="ub-coso__dong">@cn.Hotline</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(cn.GioLamViec))
                        {
                            <div class="ub-coso__dong">@cn.GioLamViec</div>
                        }
                    </div>
                }
            </div>
        }

        <footer class="ub-panel__chan">
            <div class="ub-panel__chan-tieude">LIÊN KẾT</div>
            <ul>
                <li><a href="#">Giới thiệu</a></li>
                <li><a href="#">Chính sách</a></li>
                <li><a href="#">Điều khoản đăng ký</a></li>
                <li><a href="#">Bảo mật</a></li>
            </ul>
        </footer>
    </div>
}
        <div id="login"
             class="login-modal col-12 bg-ccc d-flex align-items-center flex-column p-3">


            <div class="d-flex align-items-center flex-column justify-content-center">
                @* Anh trong DM_CSKCB.Logo thuong la anh VUONG co vien san. Boc trong
                   khung tron de vien do khong lo ra. *@
                <div class="logo ub-logo">
                    <img src="@(ViewBag.LogoCoSo ?? "/static/icon-192.png")" alt="@ViewBag.TenCoSo">
                </div>
                <h2 class="heading">Chào mừng bạn đến<br> Bệnh Viện Ung Bướu</h2>

            </div>



            <div class="tab position-relative" id="div_tab">

                <a id="loginWithID" href="#" class="fs-4">Đăng nhập bằng ID</a>
                <div class="tab-indicator"></div>
            </div>

            <div id="idLogin" style="min-height: 324px;">
                <div class="card-body">
                    <form id="login_formLogin">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label mb-1 mt-1 fs-4">Căn cước công dân/Hộ chiếu:</label>
                                <input type="text" autocomplete="off" class="form-control" name="username"
                                    placeholder="Nhập Căn cước/Hộ chiếu ">
                            </div>
                            <div class="col-12">
                                <label class="form-label mb-1 fs-4">Mật khẩu:</label>
                                <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu"
                                    autocomplete="off">
                            </div>
                        </div>
                        <div class="form-footer">
                            <div class="row g-3 align-items-center">
                                <div class="col-md-6 col-12 d-flex align-items-stretch">
                                    <div class="text-center flex-grow-1">
                                        <a id="btn__forgotPassword" href="/DangNhap/UbQuenMatKhau?coSo=@ViewBag.SlugCoSo"
                                            class="text-primary fw-semibold fs-4">Quên mật
                                            khẩu</a>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12 d-flex justify-content-md-end">
                                    <button type="submit" id="login_btnDangNhap"
                                        class="btn btn-primary w-100 w-md-auto d-md-inline-block">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round"
                                            class="icon icon-tabler icons-tabler-outline icon-tabler-key">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                            <path
                                                d="M16.555 3.843l3.602 3.602a2.877 2.877 0 0 1 0 4.069l-2.643 2.643a2.877 2.877 0 0 1 -4.069 0l-.301 -.301l-6.558 6.558a2 2 0 0 1 -1.239 .578l-.175 .008h-1.172a1 1 0 0 1 -.993 -.883l-.007 -.117v-1.172a2 2 0 0 1 .467 -1.284l.119 -.13l.414 -.414h2v-2h2v-2l2.144 -2.144l-.301 -.301a2.877 2.877 0 0 1 0 -4.069l2.643 -2.643a2.877 2.877 0 0 1 4.069 0z" />
                                            <path d="M15 9h.01" />
                                        </svg>
                                        Đăng nhập
                                    </button>
                                </div>
                            </div>

                        </div>
                    </form>

                    @* Nut cai PWA — phai co o CA luong doi tac, khong chi luong OTP.
                       CSS nam san trong site.css; pwa-install.js quyet dinh an/hien. *@
                    <partial name="_PwaInstall" />

                </div>
            </div>


            <div class="container_note">
                <div class="text-center text-black my-3 fs-4">
                    <span>Bạn chưa có tài khoản?</span>
                    <a href="/DangNhap/UbDangKy?coSo=@ViewBag.SlugCoSo@(string.IsNullOrWhiteSpace(ViewBag.ReturnUrl as string) ? "" : "&returnUrl=" + Uri.EscapeDataString((string)ViewBag.ReturnUrl))" class="text-primary fw-semibold">Đăng ký miễn phí</a>
                </div>

            </div>
            <div class="mt-4 text-center end-0">
                <a href="https://benhvienungbuou.vn/cac-goi-kham-chuyen-gia"
                   class="text-primary fw-semibold"
                   style="font-size: 18px;">
                    Các gói khám chuyên gia
                </a>
            </div>
        </div>
</div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/ub-hien-mat-khau.js" asp-append-version="true"
        data-nhan-hien="Hiện mật khẩu" data-nhan-an="Ẩn mật khẩu"></script>
<script src="~/js/pwa-install.js" asp-append-version="true"></script>
<script>
    (function () {
        const maCoSo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string?)ViewBag.MaCoSo));
        const returnUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string?)ViewBag.ReturnUrl));

        const form = document.getElementById('login_formLogin');
        const nut = document.getElementById('login_btnDangNhap');

        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            const cccd = form.querySelector('[name="username"]').value.trim();
            const matKhau = form.querySelector('[name="password"]').value;

            if (!cccd || !matKhau) {
                showToast('Vui lòng nhập đầy đủ thông tin!', 400);
                return;
            }

            const chuCu = nut.innerHTML;
            nut.disabled = true;
            nut.innerHTML = 'Đang đăng nhập...';

            try {
                const res = await fetch('/DangNhap/UbDangNhap', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        maCoSo: maCoSo,
                        cccd: cccd,
                        matKhau: matKhau,
                        returnUrl: returnUrl,
                        deviceId: localStorage.getItem('deviceId'),
                        deviceName: navigator.userAgent
                    })
                });
                const data = await res.json();

                if (!data.success) {
                    // Thong bao la cua CHINH doi tac tra ve — hien nguyen van.
                    showToast(data.message || 'Đăng nhập không thành công', 400);
                    return;
                }

                window.location.href = data.redirectUrl;
            } catch (err) {
                showToast('Không kết nối được, vui lòng thử lại', 500);
            } finally {
                nut.disabled = false;
                nut.innerHTML = chuCu;
            }
        });
    })();
</script>
</body>
</html>
