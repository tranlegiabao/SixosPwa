{
  "info": {
    "_postman_id": "8a716c52-7b24-4f8e-9087-f8234db6c3e1",
    "name": "SixosPwa - API Tiếp nhận & Phục vụ Tài liệu Y tế",
    "description": "Bộ sưu tập Postman với các Header được cấu hình trực tiếp (cho phép tự do sửa đổi giá trị, bật/tắt checkbox dễ dàng trong tab Headers của Postman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Tiếp nhận tài liệu thành công (Happy Path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Success is true\", function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "",
              "if (jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set(\"document_id\", jsonData.data.id);",
              "    console.log(\"Saved document_id:\", jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "test-api-key-cs2",
            "type": "text",
            "description": "Khóa bí mật của CSKCB (Bạn có thể sửa trực tiếp tại đây)"
          },
          {
            "key": "X-Ma-CSKCB",
            "value": "CS2",
            "type": "text",
            "description": "Mã cơ sở y tế (Bạn có thể sửa trực tiếp tại đây, ví dụ: CS2, 79423, ...)"
          },
          {
            "key": "X-Ma-CSKCB",
            "value": "79423",
            "type": "text",
            "disabled": true,
            "description": "Gợi ý: Cơ sở BV Ung Bướu CS1 (Tích vào checkbox để đổi nhanh)"
          },
          {
            "key": "X-Loai-Tai-Lieu",
            "value": "DON_THUOC",
            "type": "text",
            "description": "Loại tài liệu: Đơn thuốc (Sửa trực tiếp hoặc tích các dòng dưới)"
          },
          {
            "key": "X-Loai-Tai-Lieu",
            "value": "KET_QUA_XN",
            "type": "text",
            "disabled": true,
            "description": "Gợi ý: Kết quả xét nghiệm (Tích vào checkbox để đổi nhanh)"
          },
          {
            "key": "X-Loai-Tai-Lieu",
            "value": "CDHA",
            "type": "text",
            "disabled": true,
            "description": "Gợi ý: Chẩn đoán hình ảnh X-Quang/CT/MRI (Tích vào checkbox để đổi nhanh)"
          },
          {
            "key": "X-Loai-Tai-Lieu",
            "value": "GIAY_RA_VIEN",
            "type": "text",
            "disabled": true,
            "description": "Gợi ý: Giấy ra viện (Tích vào checkbox để đổi nhanh)"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maBenhNhan\": \"BN00123\",\n  \"cccd\": \"079090001234\",\n  \"sdt\": \"0901234567\",\n  \"hoTen\": \"Nguyễn Văn A\",\n  \"filePdf\": \"\",\n  \"tenTaiLieu\": \"Đơn thuốc điều trị ngoại trú ngày 08/09/2026\",\n  \"ngayKham\": \"2026-09-08T08:30:00\",\n  \"ghiChu\": \"Uống thuốc sau khi ăn, tái khám sau 2 tuần.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/tai-lieu/tiep-nhan",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "tai-lieu",
            "tiep-nhan"
          ]
        },
        "description": "Gửi tài liệu dạng PDF Base64 lên hệ thống. Tự do sửa đổi các Header trong tab Headers."
      },
      "response": []
    },
    {
      "name": "2. Xem / Tải file PDF vừa tạo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/tai-lieu/xem/{{document_id}}",
