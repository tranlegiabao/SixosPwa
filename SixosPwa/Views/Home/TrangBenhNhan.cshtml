@{
    Layout = null;
    ViewData["Title"] = "Trang bệnh nhân";
}

<!doctype html>
<html lang="vi">
<head>
    <title>@ViewBag.TenCoSo — HisSoft</title>
    <partial name="_CongHead" />
    <style>
        /*
            Bo cuc theo ho so "Patient Portal / Health Records": Minimalism & Swiss
            + Accessible. Ba the dich vu xep DOC het be ngang — tieng Viet dai nen
            the ngang moi du cho ten kem mot dong mo ta, va vung cham cao 56px.
            Khong co thanh tab day: ca trang chi co ba chuc nang, nhin het trong
            mot man, tab bar se chiem cho vinh vien ma khong dieu huong them gi.
        */
        :root {
            --bn-nen: #f5f7fa;
            --bn-the: #ffffff;
            --bn-vien: #dde4ed;
            --bn-chu: #12202e;
            --bn-chu-nhat: #66788a;
            --bn-xanh: #0d5bd4;
            --bn-xanh-nhat: #e6effc;
            --bn-luc: #12876f;
            --bn-do: #b3261e;
            --bn-do-nhat: #fdeceb;
        }

        body.bn-trang {
            background: #e9eef5;
            color: var(--bn-chu);
            margin: 0;
            min-height: 100vh;
            padding: 24px 12px;
            box-sizing: border-box;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        .bn-khung {
            width: 100%;
            max-width: 520px;
            margin: 0 auto;
            background: var(--bn-nen);
            border: 1px solid var(--bn-vien);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 12px 36px -8px rgba(18, 32, 46, 0.14), 0 4px 12px rgba(18, 32, 46, 0.06);
            padding-bottom: 24px;
        }

        @@media (max-width: 576px) {
            body.bn-trang {
                background: var(--bn-nen);
                padding: 0;
            }
            .bn-khung {
                max-width: 100%;
                border-radius: 0;
                border: none;
                box-shadow: none;
                min-height: 100vh;
            }
        }

        .bn-dau {
            background: var(--bn-xanh);
            color: #fff;
            padding: 18px 20px 22px;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 14px;
        }
        .bn-dau-chu {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
        }
        .bn-dau .bn-coso { font-size: 13px; opacity: .9; }
        .bn-dau .bn-chao { font-size: 20px; font-weight: 700; line-height: 1.3; }

        /* Loi ra khoi trang benh nhan. Vung cham 48px — cung chuan voi ba the dich
           vu ben duoi (56px), du rong cho ngon tay. */
        .bn-ra {
            flex: 0 0 auto;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            text-decoration: none;
        }
        .bn-ra img { width: 100%; height: 100%; object-fit: contain; padding: 4px; }

        .bn-danhtinh {
            background: var(--bn-the);
            border: 1px solid var(--bn-vien);
            border-left: 4px solid var(--bn-luc);
            border-radius: 10px;
            margin: -12px 16px 0;
            padding: 14px 16px;
            box-shadow: 0 2px 10px -6px rgba(18, 32, 46, .35);
        }
        .bn-danhtinh .bn-dong {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            font-size: 13.5px;
            padding: 3px 0;
        }
        .bn-danhtinh .bn-dong span:first-child { color: var(--bn-chu-nhat); }
        .bn-danhtinh .bn-dong span:last-child { font-weight: 600; }

        .bn-muc {
            font-size: 11px;
            letter-spacing: .12em;
            font-weight: 700;
            color: var(--bn-chu-nhat);
            padding: 20px 20px 8px;
        }

        .bn-luoi-dichvu {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            padding: 0 16px 14px;
        }

        .bn-o-vuong {
            background: linear-gradient(145deg, #0d5bd4 0%, #1e6de4 100%);
            color: #ffffff !important;
            border-radius: 16px;
            padding: 16px 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            text-decoration: none;
            transition: all .2s ease;
            box-shadow: 0 6px 18px -4px rgba(13, 91, 212, 0.28);
            min-height: 128px;
            box-sizing: border-box;
            border: 1px solid rgba(255, 255, 255, 0.15);
            position: relative;
            overflow: hidden;
        }

        .bn-badge {
            position: absolute;
            top: 10px;
            right: 12px;
            background: #ef4444;
            color: #ffffff;
            font-size: 11.5px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
            line-height: 1.3;
            z-index: 2;
            animation: bnBadgePulse 2s infinite;
        }
        @@keyframes bnBadgePulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.08); }
            100% { transform: scale(1); }
        }

        .bn-o-vuong:hover, .bn-o-vuong:focus-visible {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px -4px rgba(13, 91, 212, 0.42);
            color: #ffffff !important;
        }

        .bn-o-vuong:focus-visible { outline: 3px solid #ffffff; outline-offset: 2px; }

        .bn-o-vuong .bn-bieutuong {
            width: 46px;
            height: 46px;
            flex: 0 0 auto;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

        .bn-o-vuong .bn-noidung-the {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .bn-o-vuong .bn-ten {
            display: block;
            font-weight: 700;
            font-size: 14.5px;
            color: #ffffff;
            line-height: 1.3;
        }

        .bn-o-vuong .bn-mota {
            display: block;
            font-size: 11.5px;
            color: rgba(255, 255, 255, 0.85);
            margin-top: 4px;
            line-height: 1.3;
        }

        /* Mũi tên nhỏ góc dưới các ô vuông */
        .bn-o-vuong .bn-mui-ten {
            position: absolute;
            bottom: 8px;
            right: 12px;
            font-size: 18px;
            color: rgba(255, 255, 255, 0.75);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .18s ease;
        }

        .bn-o-vuong:hover .bn-mui-ten {
            transform: translateX(3px);
            color: #ffffff;
        }

        /* Hàng cuối: chiếm trọn 2 cột (full width) và cũng màu xanh */
        .bn-hang-cuoi {
            grid-column: span 2;
            flex-direction: row;
            text-align: left;
            align-items: center;
            justify-content: flex-start;
            gap: 14px;
            padding: 14px 18px;
            min-height: 64px;
        }

        .bn-hang-cuoi .bn-bieutuong {
            margin-bottom: 0;
            width: 42px;
            height: 42px;
        }

        .bn-hang-cuoi .bn-noidung-the {
            align-items: flex-start;
            flex: 1;
        }

        .bn-hang-cuoi .bn-mui-ten {
            position: static;
            font-size: 22px;
            color: rgba(255, 255, 255, 0.8);
            margin-left: auto;
            transition: transform .15s;
        }

        .bn-hang-cuoi:hover .bn-mui-ten {
            transform: translateX(3px);
            color: #ffffff;
        }

        .bn-canhbao {
            background: var(--bn-do-nhat);
            border: 1px solid var(--bn-do);
            border-radius: 10px;
            margin: 12px 16px 0;
            padding: 12px 14px;
            font-size: 13px;
            color: var(--bn-chu);
        }

        .bn-chan {
            padding: 20px;
            text-align: center;
            font-size: 12.5px;
            color: var(--bn-chu-nhat);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .bn-chan a { color: var(--bn-xanh); text-decoration: none; }
        .bn-chan a:hover { text-decoration: underline; }
    </style>
</head>
<body class="bn-trang">

    <div class="bn-khung">

        @*
            Logo la LOI RA DUY NHAT khoi trang nay: tu 2026-08-27 "/" day nguoc benh
            nhan da dang nhap ve day, nen tro logo ve "/" la nut chet. Tro thang toi
            danh sach co so cung nhom. Xem ADR 0016.
        *@
        <header class="bn-dau">
            <a class="bn-ra" href="/Home/DanhSachCoSo-@ViewBag.MaNhomCS" title="Xem các cơ sở khác">
                <img src="@(ViewBag.LogoCoSo ?? "/static/icon-192.png")" alt="@ViewBag.TenCoSo" />
            </a>
            <div class="bn-dau-chu">
                <span class="bn-coso">@ViewBag.TenCoSo</span>
                <span class="bn-chao">Xin chào @ViewBag.TenBenhNhan</span>
            </div>
        </header>

        <section class="bn-danhtinh">
            <div class="bn-dong"><span>Mã CSKCB</span><span>@ViewBag.MaCoSo</span></div>
            <div class="bn-dong"><span>CCCD</span><span>@ViewBag.CccdCheBot</span></div>
            <div class="bn-dong"><span>Điện thoại</span><span>@ViewBag.DienThoai</span></div>
        </section>

        @if (ViewBag.CoLoiKetNoi == true)
        {
            <div class="bn-canhbao">
                Chưa kết nối được với hệ thống của cơ sở. Bạn vẫn xem được thông tin ở đây,
                nhưng các dịch vụ đặt lịch và tra cứu hồ sơ tạm thời chưa dùng được.
            </div>
        }

        <div class="bn-muc">DỊCH VỤ</div>

        <div class="bn-luoi-dichvu">
            <!-- 1. Lịch hẹn (Ô vuông xanh) -->
            <div class="bn-o-vuong" role="button" tabindex="0" onclick="moModalLichHen()" onkeydown="if(event.key==='Enter') moModalLichHen()" style="cursor: pointer;">
                <span class="bn-bieutuong" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </span>
                <span class="bn-noidung-the">
                    <span class="bn-ten">Lịch hẹn</span>
                    <span class="bn-mota">Xem ngày nhắc hẹn khám</span>
                </span>
                <span class="bn-mui-ten" aria-hidden="true">›</span>
            </div>

            @* Loi vao *Ho so cua toi* (ADR 0019). Hien tu ho so DAU TIEN, khong
               phai tu ho so thu hai: muon them nguoi than thi phai vao duoc man
               nay da — an di cho toi khi co 2 ho so la vong luan quan. *@
            @if (ViewBag.SoHoSo != null && (int)ViewBag.SoHoSo >= 1)
            {
                <a class="bn-o-vuong" href="/benh-nhan/ho-so">
                    @if ((int)ViewBag.SoHoSo > 1)
                    {
                        <span class="bn-badge" title="@ViewBag.SoHoSo hồ sơ">@ViewBag.SoHoSo</span>
                    }
                    <span class="bn-bieutuong" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </span>
                    <span class="bn-noidung-the">
                        <span class="bn-ten">Hồ sơ của tôi</span>
                        <span class="bn-mota">
                            @if (ViewBag.SoHoSo != null && (int)ViewBag.SoHoSo > 1)
                            {
                                <text>Đang xem: @ViewBag.TenBenhNhan</text>
                            }
                            else
                            {
                                <text>Thêm hồ sơ cho người thân</text>
                            }
                        </span>
                    </span>
                    <span class="bn-mui-ten" aria-hidden="true">›</span>
                </a>
            }

            <!-- 2. Đơn thuốc (Ô vuông xanh) -->
            <a class="bn-o-vuong" href="/benh-nhan/tai-lieu?nhom=don-thuoc">
                @if (ViewBag.SoLuongDonThuoc != null && (int)ViewBag.SoLuongDonThuoc > 0)
                {
                    <span class="bn-badge" title="@ViewBag.SoLuongDonThuoc đơn thuốc">@ViewBag.SoLuongDonThuoc</span>
                }
                <span class="bn-bieutuong" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path>
                        <path d="m8.5 8.5 7 7"></path>
                    </svg>
                </span>
                <span class="bn-noidung-the">
                    <span class="bn-ten">Đơn thuốc</span>
                    <span class="bn-mota">Toa thuốc điện tử</span>
                </span>
                <span class="bn-mui-ten" aria-hidden="true">›</span>
            </a>

            <!-- 3. Kết quả khám bệnh (Ô vuông xanh) -->
            <a class="bn-o-vuong" href="/benh-nhan/tai-lieu?nhom=ket-qua-kham">
                @if (ViewBag.SoLuongKetQuaKham != null && (int)ViewBag.SoLuongKetQuaKham > 0)
                {
                    <span class="bn-badge" title="@ViewBag.SoLuongKetQuaKham kết quả khám">@ViewBag.SoLuongKetQuaKham</span>
                }
                <span class="bn-bieutuong" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <path d="m9 15 2 2 4-4"></path>
                    </svg>
                </span>
                <span class="bn-noidung-the">
                    <span class="bn-ten">Kết quả khám</span>
                    <span class="bn-mota">Tra cứu xét nghiệm, chẩn đoán</span>
                </span>
                <span class="bn-mui-ten" aria-hidden="true">›</span>
            </a>

            <!-- 4. Quản lý hóa đơn (Ô vuông xanh) -->
            <a class="bn-o-vuong" href="/benh-nhan/sap-co?muc=quan-ly-hoa-don">
                <span class="bn-bieutuong" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"></path>
                        <line x1="8" y1="7" x2="16" y2="7"></line>
                        <line x1="8" y1="11" x2="16" y2="11"></line>
                        <line x1="8" y1="15" x2="13" y2="15"></line>
                    </svg>
                </span>
                <span class="bn-noidung-the">
                    <span class="bn-ten">Quản lý hóa đơn</span>
                    <span class="bn-mota">Chi phí và thanh toán</span>
                </span>
                <span class="bn-mui-ten" aria-hidden="true">›</span>
            </a>

            <!-- 5. Kế hoạch điều trị (Hàng cuối màu xanh - full width) -->
            <a class="bn-o-vuong bn-hang-cuoi" href="/benh-nhan/sap-co?muc=ke-hoach-dieu-tri">
                <span class="bn-bieutuong" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                        <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                        <path d="M12 11h4"></path>
                        <path d="M12 16h4"></path>
                        <path d="M8 11h.01"></path>
                        <path d="M8 16h.01"></path>
                    </svg>
                </span>
                <span class="bn-noidung-the">
                    <span class="bn-ten">Kế hoạch điều trị</span>
                    <span class="bn-mota">Lộ trình điều trị, phác đồ và hướng dẫn theo dõi</span>
                </span>
                <span class="bn-mui-ten" aria-hidden="true">›</span>
            </a>
        </div>

        <footer class="bn-chan">
            <div>Hỗ trợ: <a href="tel:0901878896">0901 87 88 96</a></div>
            <div>
                @if (ViewBag.DungManDoiTac != true)
                {
                    <a href="/DangNhap/DoiMatKhau?coSo=@ViewBag.MaCoSo">Đổi mật khẩu</a>
                    <text>&nbsp;·&nbsp;</text>
                }
                <a href="/DangNhap/DangXuat">Đăng xuất</a>
            </div>
        </footer>

    </div>

    <!-- ==================== POPUP THÔNG BÁO LỊCH KHÁM (PHONG CÁCH VIETCOMBANK) ==================== -->
    <div id="modalLichHen" class="vcb-overlay" style="display: none;" onclick="xuLyBamNgoaiModal(event)" role="dialog" aria-modal="true" aria-labelledby="vcbTieuDe">
        <div class="vcb-hop" onclick="event.stopPropagation()">
            
            <!-- Top App Bar -->
            <div class="vcb-top-bar">
                <button type="button" class="vcb-nut-back" onclick="dongModalLichHen()" aria-label="Quay lại">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                </button>
                <h2 id="vcbTieuDe" class="vcb-tieude-chinh">Thông tin lịch khám</h2>
                <button type="button" class="vcb-nut-doc-tat-ca" onclick="danhDauTatCaDaDoc()" title="Đánh dấu tất cả đã đọc">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span class="vcb-badge-so-chua-doc" id="vcbBadgeChuaDoc">2</span>
                </button>
            </div>

            <!-- Thanh điều hướng tuần / tháng (Date Range Navigator) -->
            <div class="vcb-tuan-navigator">
                <div class="vcb-tuan-chinh">
                    <button type="button" class="vcb-btn-mui-ten" onclick="chuyenKhoangThoiGian(-1)" aria-label="Trước">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                    <div class="vcb-tuan-chuoi" id="vcbChuoiKhoangNgay">
                        07/09/2026 đến 13/09/2026
                    </div>
                    <button type="button" class="vcb-btn-mui-ten" onclick="chuyenKhoangThoiGian(1)" aria-label="Sau">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
                <!-- Nút mở menu chọn các tuần trong tháng -->
                <div class="vcb-nut-tatca-wrap">
                    <button type="button" class="vcb-btn-xem-tat-ca" id="vcbBtnXemTatCa" onclick="moSheetChonTuan()">
                        <span class="vcb-tatca-icon">📅</span>
                        <span id="vcbTextTatCa">Xem tất cả các tuần trong tháng</span>
                        <span class="vcb-tatca-arrow">▼</span>
                    </button>
                </div>
            </div>

            <!-- Ô tìm kiếm thông báo -->
            <div class="vcb-tim-kiem-wrap">
                <div class="vcb-tim-kiem-khung">
                    <span class="vcb-icon-search" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" id="vcbInputTimKiem" class="vcb-input-search" placeholder="Tìm kiếm thông báo" oninput="timKiemThongBaoVcb(this.value)" />
                </div>
            </div>

            <!-- Danh sách các thẻ thông báo (Cards feed) -->
            <div class="vcb-danh-sach-wrap" id="vcbDanhSachThongBao">
                <!-- Dynamic cards rendered by JS -->
            </div>

            <!-- Popup / Bottom Sheet Chọn Tuần hoặc Cả Tháng -->
            <div id="vcbSheetChonTuan" class="vcb-sheet-overlay" style="display: none;" onclick="dongSheetChonTuan()">
                <div class="vcb-sheet-hop" onclick="event.stopPropagation()">
                    <div class="vcb-sheet-dau">
                        <div>
                            <h3 class="vcb-sheet-tieude">Chọn thời gian xem lịch</h3>
                            <div class="vcb-sheet-phude" id="vcbSheetTenThang">Tháng 09/2026</div>
                        </div>
