@model CoSoYTeEditViewModel

<div class="col-md-8">
    <label asp-for="NgayLamViec" class="form-label">Ngày hoạt động</label>
    <select asp-for="NgayLamViec" class="form-select">
        <option value="">Chọn ngày hoạt động</option>
        <option value="Thứ 2 - Chủ nhật">Thứ 2 - Chủ nhật</option>
        <option value="Thứ 2 - Thứ 7">Thứ 2 - Thứ 7</option>
        <option value="Thứ 2 - Thứ 6">Thứ 2 - Thứ 6</option>
        <option value="Thứ 7 - Chủ nhật">Thứ 7 - Chủ nhật</option>
    </select>
    <span asp-validation-for="NgayLamViec" class="text-danger field-error"></span>
</div>
<div class="col-md-4">
    <label asp-for="GioMoCua" class="form-label">Giờ mở cửa</label>
    @* KHONG dat step tren input type="time": jQuery Validate doc thang thuoc tinh
       step cua HTML5 lam mot luat kiem, ma phuong thuc step cua no chi nhan
       text/number/range (jquery.validate.js:1514) — gap "time" la NEM Error ngay
       giua $.validator.form(), lam dut luon lenh submit => bam Luu khong an gi.
       Nam sua *@
    <input asp-for="GioMoCua" class="form-control" type="time" />
    <span asp-validation-for="GioMoCua" class="text-danger field-error"></span>
</div>
<div class="col-md-4">
    <label asp-for="GioDongCua" class="form-label">Giờ đóng cửa</label>
    <input asp-for="GioDongCua" class="form-control" type="time" />
    <span asp-validation-for="GioDongCua" class="text-danger field-error"></span>
</div>
