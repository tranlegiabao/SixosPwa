                    <div class="promo-card-overlay">
                        <span class="promo-badge">💎 VIP</span>
                        <p class="promo-title">Nha Khoa Kim</p>
                        <p class="promo-sub">Niềng răng · Implant · Tẩy trắng · Răng sứ</p>
                    </div>
                </div>

                <!-- 4. Mắt -->
                <div class="promo-card" onclick="openPromo('Trung Tâm Mắt Sáng', 'Khám & điều trị cận thị, loạn thị. Phẫu thuật Lasik giá tốt nhất TP.HCM.')">
                    <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=640&q=80" alt="Khám mắt" loading="lazy">
                    <div class="promo-card-overlay">
                        <span class="promo-badge">🌟 Chuyên Sâu</span>
                        <p class="promo-title">Trung Tâm Mắt Sáng</p>
                        <p class="promo-sub">Cận · Loạn thị · Lasik · Kính áp tròng</p>
                    </div>
                </div>

                <!-- 5. Da liễu -->
                <div class="promo-card" onclick="openPromo('Viện Da Liễu SkinCare', 'Điều trị mụn, nám, sẹo. Trẻ hóa da bằng công nghệ Laser tiên tiến nhất.')">
                    <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=640&q=80" alt="Da liễu" loading="lazy">
                    <div class="promo-card-overlay">
                        <span class="promo-badge">✨ Làm Đẹp</span>
                        <p class="promo-title">Viện Da Liễu SkinCare</p>
                        <p class="promo-sub">Mụn · Nám · Sẹo · Laser · Trẻ hóa da</p>
                    </div>
                </div>

                <!-- 6. Sản phụ khoa -->
                <div class="promo-card" onclick="openPromo('Phòng Khám Sản Phụ Khoa MomCare', 'Siêu âm thai, khám tiền sản, chăm sóc mẹ bầu và sau sinh toàn diện.')">
