        object-fit: contain;
        background: transparent;
        border-radius: 10px;
        filter: drop-shadow(0 2px 6px rgba(0,0,0,0.1));
    }

    @@media (max-width: 767.98px) {
        .text-center.mb-4.d-md-none {
            background: linear-gradient(90deg, #206bc4, #004085);
            border-radius: 14px 14px 0 0;
            margin-bottom: 0rem !important;
            margin-top: 0rem !important;
            padding-bottom: 0 !important;
            padding-top: 8px !important;
            box-shadow: 0 4px 16px rgba(32,107,196,0.18);
        }
        .text-center.mb-4.d-md-none img {
            background: transparent !important;
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            padding: 6px 6px 0 6px;
            margin-bottom: 0 !important;
            display: block;
        }
        .card-header {
            background: linear-gradient(90deg, #206bc4, #004085) !important;
            border-top-left-radius: 0 !important;
            border-top-right-radius: 0 !important;
        }
    }

    @@media (max-width: 767.98px) {
        .text-center.mb-4.d-md-none img {
            padding-top: 10px !important;
            padding-bottom: 10px !important;
        }

        .card.card-md{
			margin-top: 645px;
        }
    }

    /* --- Sua cho ban dien thoai (SixosPwa la PWA cai tren may) -------------
       Khuon goc can giua theo chieu doc bang min-height:100vh + align-items:center.
       Tren dien thoai the nay cao hon man hinh, nen phan can giua day noi dung
       xuong va mo dau trang bang mot khoang trang ~500px.
       Luu y: trong .cshtml, truy van media phai viet HAI dau a-cong. Razor coi
       mot dau la bieu thuc C#, ke ca khi no nam trong comment CSS nhu the nay. */
    @@media (max-width: 767.98px) {
        body {
            display: block;
            min-height: auto;
            background-attachment: scroll;
        }

        .container-fluid > .row {
            min-height: auto;
        }
    }
</style>
</head>
<body>
<div class="container-fluid">
<div class="row">
<div class="col-12 d-flex align-items-center justify-content-center">
            <div class="card card-md">
                <div class="text-center mb-4 d-md-none">
                    <a href="/" class="navbar-brand navbar-brand-autodark">
                        <img src="@(ViewBag.LogoCoSo ?? "/static/icon-192.png")" height="56" alt="@ViewBag.TenCoSo">
                    </a>
                </div>
                <div class="card-header">
                    <h2 class="text-center w-100 mb-0 py-2">QUÊN MẬT KHẨU</h2>
                </div>
                <div class="card-body">
                    <form id="quenMk_form" onsubmit="return false;">
                        <div class="row g-3">
                             <div class="col-12">
                                <label for="SoCccd" class="form-label required mb-1 mt-1">Số căn cước công dân/Hộ chiếu</label>
                                <input type="text" class="form-control text-start" id="SoCccd" name="SoCccd" placeholder="Nhập số căn cước công dân/Hộ chiếu" required />
                            </div> 
                            <div class="col-12">
                                <label for="EmailOrSdt" class="form-label mb-1 required mt-1">Email hoặc Số điện thoại</label>
                                <input type="text" class="form-control" id="EmailOrSdt" name="EmailOrSdt" placeholder="Nhập Email hoặc Số điện thoại" required />
                            </div>
                        </div>
                        <div class="form-footer">
                            <div class="row g-3 align-items-center">
                                <div class="col-md-6 col-12">
                                    <div class="text-center my-3">
                                        <a href="/DangNhap/Login?coSo=@ViewBag.SlugCoSo" class="btn btn-secondary w-100 w-md-auto">Quay lại đăng nhập</a>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12 d-flex justify-content-md-end">
                                    <button type="submit" id="btn_ForgotPassword" class="btn btn-primary w-100 w-md-auto">Gửi xác nhận</button>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div class="side-info-mobile d-md-none mt-4">
                        <div class="mb-3 card-mobile">
                            <div class="side-info-title"><svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-calendar-clock"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10.5 21h-4.5a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v3" /><path d="M16 3v4" /><path d="M8 3v4" /><path d="M4 11h10" /><path d="M18 18m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" /><path d="M18 16.5v1.5l.5 .5" /></svg> Lịch làm việc</div>
                            <div class="lich-lam-viec-cards">
                                <div class="card-lich mb-2">
                                <div class="fw-bold text-primary">Thứ 2 - 6</div>
                                <div class="lich-time-row-group">
                                    <div class="lich-buoi-row mb-1">
                                        <span class="lich-label-sang">Sáng:</span>
                                        <span class="lich-time-sang">5:00–12:00</span>
                                    </div>
                                    <div class="lich-buoi-row chieu-row mb-1">
                                        <span class="lich-label-sang">Chiều:</span>
                                        <span class="lich-time-chieu">13:00–16:30</span>
                                        <span class="lich-time-chieu text-end" style="width: 100%">16:30–19:00</span>
                                        
                                    </div>
                                </div>
                                </div>
                                <div class="card-lich mb-2">
                                <div class="fw-bold text-success">Thứ 7</div>
                                <div class="lich-time-row-group">
                                    <span class="lich-time-sang">7:30–11:30</span>
                                    <span class="lich-note d-block">(Cơ sở 2 chỉ khám Thứ 7)</span>
                                </div>
                                </div>
                                <div class="card-lich">
                                <div class="fw-bold text-danger">Chủ nhật</div>
                                <div class="lich-time-row-group">
                                    <span class="lich-time-sang">7:30–11:30</span>
                                </div>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3 card-mobile">
                            <div class="side-info-title"><svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-map-pin"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" /></svg> Địa chỉ</div>
                            <div class="side-info-branch">Cơ sở 1</div>
                            <ul class="mb-1 mt-2 text-start" style="list-style:none; padding-left:0;">
                                <li class="side-info-li">6 Nguyễn Huy Lượng, P.14, Q.Bình Thạnh, Tp.HCM.</li>
                                <li class="side-info-li">47 Nguyễn Huy Lượng, P.14, Q.Bình Thạnh, Tp.HCM.</li>
                            </ul>
                            <div class="side-info-branch mt-2">Cơ sở 2</div>
                            <ul class="mb-1 mt-2 text-start" style="list-style:none; padding-left:0;">
                                <li class="side-info-li">12 Đường 400, KP3, P.Tân Phú, Tp.Thủ Đức.</li> 
                            </ul>
                            <div class="side-info-title side-info-title-phone"><svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-phone"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" /></svg> Điện thoại</div>
                            <div class="side-info-phone">(028) 3841 2637</div>
                        </div>
                        
                        
                    </div>
                </div>
            </div>
        </div>
</div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        const maCoSo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.MaCoSo));

        const form = document.getElementById('quenMk_form');
        const nut = document.getElementById('btn_ForgotPassword');

        async function gui() {
            const cccd = document.getElementById('SoCccd').value.trim();
            const emailHoacSdt = document.getElementById('EmailOrSdt').value.trim();

            if (!cccd || !emailHoacSdt) {
                showToast('Vui lòng nhập đầy đủ thông tin!', 400);
                return;
            }

            const chuCu = nut.innerHTML;
            nut.disabled = true;
            nut.innerHTML = 'Đang gửi...';

            try {
                const res = await fetch('/DangNhap/UbGuiQuenMatKhau', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        maCoSo: maCoSo,
                        cccd: cccd,
                        emailHoacSdt: emailHoacSdt
                    })
                });
                const data = await res.json();

                // Thong bao la cua CHINH doi tac tra ve — hien nguyen van.
                showToast(data.message || (data.success ? 'Đã gửi' : 'Không gửi được'),
                          data.success ? 200 : 400);

                if (data.success) {
                    // Buoc 2 nam TREN TRANG CUA DOI TAC: duong dan ho gui tro ve
                    // host cua ho, khong tro ve day duoc (ADR 0014). Noi that de
                    // benh nhan biet phai lam gi tiep.
                    form.querySelectorAll('input, button').forEach(function (o) { o.disabled = true; });
                    const bao = document.createElement('div');
                    bao.className = 'alert alert-success mt-3 mb-0 text-start';
                    bao.textContent = 'Vui lòng kiểm tra tin nhắn hoặc email để mở đường dẫn '
                        + 'đặt lại mật khẩu. Đặt xong, quay lại đây đăng nhập bằng mật khẩu mới.';
                    form.appendChild(bao);
                }
            } catch (err) {
                showToast('Không kết nối được, vui lòng thử lại', 500);
            } finally {
                nut.disabled = false;
                nut.innerHTML = chuCu;
            }
        }

        nut.addEventListener('click', gui);
        form.addEventListener('submit', function (e) { e.preventDefault(); gui(); });
    })();
</script>
</body>
</html>
