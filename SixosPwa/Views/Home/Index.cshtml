                    <div class="promo-card-overlay">
                        <span class="promo-badge">👂 Chuyên Khoa</span>
                        <p class="promo-title">Phòng Khám Tai Mũi Họng ENT</p>
                        <p class="promo-sub">Viêm xoang · Khàn giọng · Amidan</p>
                    </div>
                </div>

