<!-- Login Modal -->
<div class="ytv-modal-overlay" id="loginModal">
    <div class="ytv-modal-content">
        <button class="ytv-modal-close" onclick="closeLoginModal()">&times;</button>
        
        <!-- Step 1: Phone Input -->
        <div class="login-step active" id="stepPhone">
            <h2 class="login-title">Đăng nhập</h2>
            <p class="login-desc">Vui lòng nhập số điện thoại của bạn để đăng nhập hoặc tạo tài khoản mới.</p>
            
            <div class="input-group">
                <i class="fas fa-phone-alt"></i>
                <input type="tel" id="phoneNumber" class="ytv-input" placeholder="Nhập số điện thoại..." autocomplete="off">
            </div>
            
            <button class="btn-submit" onclick="sendOTP()">Gửi mã OTP</button>
        </div>
        
        <!-- Step 2: OTP Input -->
        <div class="login-step" id="stepOTP">
            <h2 class="login-title">Xác thực OTP</h2>
            <p class="login-desc">Mã xác thực gồm 4 số đã được gửi đến số <br><strong id="displayPhone" style="color:#0f172a; font-size: 16px;"></strong></p>
            
            <div class="otp-inputs" id="otpContainer">
                <input type="text" class="otp-input" maxlength="1" onkeyup="moveToNext(this, event)">
                <input type="text" class="otp-input" maxlength="1" onkeyup="moveToNext(this, event)">
                <input type="text" class="otp-input" maxlength="1" onkeyup="moveToNext(this, event)">
                <input type="text" class="otp-input" maxlength="1" onkeyup="moveToNext(this, event)">
            </div>
            
            <button class="btn-submit" onclick="verifyOTP()">Xác nhận</button>
            <div class="resend-text">
                Chưa nhận được mã? <a class="resend-link" onclick="sendOTP()">Gửi lại</a>
            </div>
        </div>
    </div>
</div>

<div class="ytv-footer">
    <div class="ytv-footer-top">
        <div style="font-size:15px;font-weight:600;color:#1e293b;display:flex;align-items:center;gap:8px;">
            <i class="fas fa-headset" style="color:#64748b;"></i> Hỗ trợ: <span style="color:#3b82f6;">19008198</span>
        </div>
    </div>
