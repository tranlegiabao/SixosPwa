@model CoSoYTeEditViewModel

<!-- Summernote Lite -->
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">

<div class="col-12">
    <div class="form-section-title">Nội dung quảng cáo</div>
    <p class="form-description">Nhập nội dung hiển thị tương ứng với từng mục trên trang quảng cáo cơ sở.</p>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="QcNoiDung" class="form-label">Nội dung quảng cáo</label>
            <textarea asp-for="QcNoiDung" class="form-control rich-editor" rows="5"></textarea>
        </div>
        <div class="col-md-6">
            <label class="form-label">Ảnh đại diện quảng cáo</label>
            @await Html.PartialAsync("_QuangCaoImageSourceField", Model)
        </div>
    </div>

    <div class="form-section-title mt-4">Nội dung giới thiệu</div>
    <p class="form-description">Nhập nội dung hiển thị tương ứng với từng mục trên trang giới thiệu cơ sở.</p>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="NoiDungGioiThieu" class="form-label">Giới thiệu</label>
            <textarea asp-for="NoiDungGioiThieu" class="form-control rich-editor" rows="5"></textarea>
        </div>
        <div class="col-md-6">
            <label asp-for="NoiDungDichVu" class="form-label">Dịch vụ</label>
            <textarea asp-for="NoiDungDichVu" class="form-control rich-editor" rows="5"></textarea>
        </div>
        <div class="col-md-6">
            <label asp-for="NoiDungDoiNgu" class="form-label">Đội ngũ</label>
            <textarea asp-for="NoiDungDoiNgu" class="form-control rich-editor" rows="5"></textarea>
        </div>
        <div class="col-md-6">
            <label asp-for="NoiDungTrangThietBi" class="form-label">Trang thiết bị</label>
            <textarea asp-for="NoiDungTrangThietBi" class="form-control rich-editor" rows="5"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="NoiDungLienHe" class="form-label">Liên hệ</label>
            <textarea asp-for="NoiDungLienHe" class="form-control rich-editor" rows="4"></textarea>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof $ !== 'undefined' && $.fn.summernote) {
            $('.rich-editor').summernote({
                height: 250,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'underline', 'clear']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture', 'video']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ],
                callbacks: {
                    onImageUpload: function(files) {
                        for(let i=0; i < files.length; i++) {
                            uploadImage(files[i], this);
                        }
                    }
                }
            });

            function uploadImage(file, editor) {
                let data = new FormData();
                data.append("file", file);
                $.ajax({
                    url: '/Admin/CoSoYTe/UploadImage',
                    cache: false,
                    contentType: false,
                    processData: false,
                    data: data,
                    type: "post",
                    success: function(response) {
                        $(editor).summernote('insertImage', response.url);
                    },
                    error: function(jqXHR, textStatus, errorThrown) {
                        alert("Lỗi upload ảnh: " + (jqXHR.responseText || errorThrown));
                    }
                });
            }
        }
    });
</script>
