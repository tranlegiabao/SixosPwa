        /* Hiệu ứng trượt ngang khi vuốt chuyển tháng */
        @@keyframes vcbSlideLeft {
            0% { transform: translateX(50px); opacity: 0.2; }
            100% { transform: translateX(0); opacity: 1; }
        }

        @@keyframes vcbSlideRight {
            0% { transform: translateX(-50px); opacity: 0.2; }
            100% { transform: translateX(0); opacity: 1; }
        }

        .vcb-slide-left {
            animation: vcbSlideLeft 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .vcb-slide-right {
            animation: vcbSlideRight 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>

    <script>
        // Danh sách thông báo lịch khám mô phỏng chuẩn phong cách thông báo tài khoản
        (function() {
            const homNay = new Date();
            const nam = homNay.getFullYear();
            const thang = String(homNay.getMonth() + 1).padStart(2, '0');
            const ngay = String(homNay.getDate()).padStart(2, '0');

            window.danhSachThongBaoLich = [
                // 1. HẸN CẬN KỀ / HÔM NAY (MÀU ĐỎ)
                {
                    id: 1,
                    thoiGianHienThi: "Hôm nay • 08:30",
