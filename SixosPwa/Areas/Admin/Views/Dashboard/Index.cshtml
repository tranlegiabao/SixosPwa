@model SixosPwa.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Quản lý dữ liệu";
}

<style>
    .admin-content {
        padding: 15px 15px var(--admin-footer-space) 15px !important;
        max-width: 100% !important;
    }
    .textarea-container {
        max-width: 990px;
    }
</style>

<div class="card shadow-sm border-0 rounded-3 w-100 h-100" style="border: 1px solid #e2e8f0 !important; background: #ffffff;">
    <div class="card-body p-4 p-lg-5">
        <form asp-action="SaveContent" method="post" id="dashboardContentForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="contentFacilityId" name="FacilityId" value="@Model.SelectedFacilityId" />
            <input type="hidden" id="contentTopicId" name="TopicId" value="@Model.SelectedTopicId" />
        <div class="row gx-4 gx-lg-5 mb-4">
            <div class="col-md-5">
                <div class="d-flex align-items-center mb-4">
                    <label class="form-label mb-0 me-3 fw-bold text-nowrap text-secondary" style="min-width: 130px; font-size: 15px;">Nhóm KH</label>
                    <select id="cboNhomKH" class="form-select border-secondary-subtle" onchange="window.updatePKDropdown && window.updatePKDropdown()">
                        <option value="">-- Chọn nhóm --</option>
                        @foreach (var item in Model.NhomCSList)
                        {
                            <option value="@item.ID" data-loaics="@item.LoaiCS" selected="@(Model.SelectedNhomCSId == item.ID ? "selected" : null)">@item.TenLoaiCS</option>
                        }
                    </select>
                </div>
                
                <div class="d-flex align-items-center mb-0">
                    <label class="form-label mb-0 me-3 fw-bold text-nowrap text-secondary" style="min-width: 130px; font-size: 15px;">PK từ nhóm KH</label>
                    <select id="cboPhongKham" class="form-select border-secondary-subtle" disabled onchange="window.onPhongKhamChange && window.onPhongKhamChange()">
                        <option value="">-- Chọn phòng khám --</option>
                        @foreach (var item in Model.FacilityList)
                        {
                            <option value="@item.Id" data-loaics="@item.LoaiCS" selected="@(Model.SelectedFacilityId == item.Id ? "selected" : null)">@item.TenCoSo</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-7">
                <div class="d-flex align-items-center">
                    <label class="form-label mb-0 me-3 fw-bold text-nowrap text-secondary" style="min-width: 70px; font-size: 15px;">Chủ đề</label>
                    <select id="cboChuDe" class="form-select me-3 border-secondary-subtle" disabled>
                        <option value="">-- Chọn chủ đề --</option>
                        @foreach (var item in Model.ChuDeList)
                        {
                            <option value="@item.ID" selected="@(Model.SelectedTopicId == item.ID ? "selected" : null)">@item.TenChuDe</option>
                        }
                    </select>
                    <button type="submit" id="saveDashboardContent" class="btn btn-primary px-4 fw-bold shadow-sm">Lưu</button>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-12 textarea-container">
                <textarea id="summernote" class="form-control" name="NoiDung">@Model.NoiDung</textarea>
            </div>
        </div>
        </form>
    </div>
</div>

<style>
    /* Customize Summernote to look cleaner */
    .note-editor.note-frame {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
    }
    .note-editor .note-toolbar {
        background-color: #f8fafc;
        border-bottom: 1px solid #cbd5e1;
        padding: 8px 15px;
    }
    .note-editor .note-statusbar {
        background-color: #f8fafc;
    }
    .note-editor .note-editable {
        color: #000000;
    }
</style>

@section Scripts {
<!-- Include jQuery if not already included in layout -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Summernote Lite -->
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

<script>
    var dashboardContentUrl = '@Url.Action("GetContent", "Dashboard", new { area = "Admin" })';
    var initialNhomId = '@Model.SelectedNhomCSId';
    var initialFacilityId = '@Model.SelectedFacilityId';
    var initialTopicId = '@Model.SelectedTopicId';

    $(document).ready(function() {
        $('#summernote').summernote({
            tabsize: 2,
            height: 450,
            toolbar: [
                ['para', ['ul', 'ol', 'paragraph']],
                ['style', ['bold', 'underline', 'italic']],
                ['fontsize', ['fontsize']],
                ['color', ['color']],
                ['history', ['undo', 'redo']],
                ['height', ['height']],
                ['table', ['table']]
            ],
            fontSizes: ['8', '9', '10', '11', '12', '14', '16', '18', '24', '36', '48', '64']
        });
    });

    function setDashboardContent(content) {
        if ($('#summernote').next('.note-editor').length) {
            $('#summernote').summernote('code', content || '');
        } else {
            $('#summernote').val(content || '');
        }
    }

    function ensureDefaultBlackHtml(content) {
        var html = (content || '').trim();
        if (!html) return '';

        var parsed = document.createElement('div');
        parsed.innerHTML = html;
        var firstElement = parsed.firstElementChild;
        var firstStyle = firstElement ? (firstElement.getAttribute('style') || '') : '';
        if (parsed.children.length === 1
            && firstElement
            && firstElement.tagName.toLowerCase() === 'div'
            && /(^|;)\s*color\s*:/i.test(firstStyle)) {
            return html;
        }

        var wrapper = document.createElement('div');
        wrapper.style.color = '#000000';
        wrapper.innerHTML = html;
        return wrapper.outerHTML;
    }

    async function loadDashboardContent() {
        var facilityId = document.getElementById("cboPhongKham")?.value;
        var topicId = document.getElementById("cboChuDe")?.value;
        var facilityHidden = document.getElementById("contentFacilityId");
        var topicHidden = document.getElementById("contentTopicId");
        if (facilityHidden) facilityHidden.value = facilityId || "";
        if (topicHidden) topicHidden.value = topicId || "";

        if (!facilityId || !topicId) {
            setDashboardContent('');
            return;
        }

        try {
            var response = await fetch(dashboardContentUrl + '?facilityId=' + encodeURIComponent(facilityId) + '&topicId=' + encodeURIComponent(topicId), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!response.ok) throw new Error('Không tải được nội dung.');
            var data = await response.json();
            setDashboardContent(data.noiDung || '');
        } catch (error) {
            setDashboardContent('');
            if (typeof showToast === 'function') showToast(error.message, 'error');
        }
    }

    var originalPKOptions = [];

    function backupOptions() {
        if (originalPKOptions.length > 0) return;
        var cboPhongKham = document.getElementById("cboPhongKham");
        if (cboPhongKham) {
            var hasDbOptions = false;
            var optionsToBackup = [];
            for (var i = 0; i < cboPhongKham.options.length; i++) {
                var opt = cboPhongKham.options[i];
                if (opt.value !== "") {
                    hasDbOptions = true;
                }
                optionsToBackup.push({
                    value: opt.value,
                    text: opt.text,
                    loaiCS: opt.getAttribute("data-loaics")
                });
            }
            if (hasDbOptions) {
                originalPKOptions = optionsToBackup;
            }
        }
    }

    window.updatePKDropdown = function() {
        var cboNhomKH = document.getElementById("cboNhomKH");
        var cboPhongKham = document.getElementById("cboPhongKham");
        var cboChuDe = document.getElementById("cboChuDe");
        
        if(!cboNhomKH || !cboPhongKham || !cboChuDe) return;

        // Backup options from DOM on first run
        backupOptions();

        var selectedOpt = cboNhomKH.options[cboNhomKH.selectedIndex];
        var loaiCS = selectedOpt ? selectedOpt.getAttribute("data-loaics") : null;
        if (loaiCS) loaiCS = loaiCS.trim().toLowerCase();

        var placeholderOption = { value: "", text: "-- Chọn phòng khám --" };

        if (!loaiCS || loaiCS === "") {
            // Update cboPhongKham DOM & TomSelect
            updateSelectUI(cboPhongKham, [placeholderOption], true);
            
            // Disable cboChuDe
            cboChuDe.value = "";
            cboChuDe.disabled = true;
            if (cboChuDe.tomselect) {
                cboChuDe.tomselect.clear();
                cboChuDe.tomselect.disable();
            }
        } else {
            // Filter matched options from backup
            var matched = [];
            if (originalPKOptions.length > 0) {
                matched = originalPKOptions.filter(function(opt) {
                    if (opt.value === "") return false;
                    return opt.loaiCS && opt.loaiCS.trim().toLowerCase() === loaiCS;
                });
            }
            
            var newOptions = [placeholderOption].concat(matched);
            updateSelectUI(cboPhongKham, newOptions, false);
        }
        loadDashboardContent();
    };

    function updateSelectUI(selectEl, options, isDisabled) {
        // 1. Update standard select element
        selectEl.innerHTML = "";
        options.forEach(function(opt) {
            var newOpt = document.createElement("option");
            newOpt.value = opt.value;
            newOpt.text = opt.text;
            if (opt.loaiCS) {
                newOpt.setAttribute("data-loaics", opt.loaiCS);
            }
            selectEl.appendChild(newOpt);
        });
        selectEl.value = "";
        selectEl.disabled = isDisabled;

        // 2. Sync with TomSelect if initialized on this element
        if (selectEl.tomselect) {
            var ts = selectEl.tomselect;
            
            ts.clearOptions();
            ts.clear();
            
            options.forEach(function(opt) {
                ts.addOption({
                    value: opt.value,
                    text: opt.text
                });
            });
            
            if (isDisabled) {
                ts.disable();
            } else {
                ts.enable();
            }
        }
    }

    window.onPhongKhamChange = function() {
        var cboPhongKham = document.getElementById("cboPhongKham");
        var cboChuDe = document.getElementById("cboChuDe");
        if (cboPhongKham && cboChuDe) {
            var isDisabled = (cboPhongKham.value === "");
            cboChuDe.disabled = isDisabled;
            if (cboChuDe.tomselect) {
                if (isDisabled) {
                    cboChuDe.tomselect.clear();
                    cboChuDe.tomselect.disable();
                } else {
                    cboChuDe.tomselect.enable();
                }
            }
        }
        loadDashboardContent();
    };

    document.addEventListener("DOMContentLoaded", function() {
        var cboNhomKH = document.getElementById("cboNhomKH");
        var cboPhongKham = document.getElementById("cboPhongKham");
        var cboChuDe = document.getElementById("cboChuDe");
        if (cboNhomKH && initialNhomId) cboNhomKH.value = initialNhomId;
        window.updatePKDropdown();
        if (cboPhongKham && initialFacilityId) {
            cboPhongKham.value = initialFacilityId;
            window.onPhongKhamChange();
        }
        if (cboChuDe && initialTopicId) cboChuDe.value = initialTopicId;
        if (cboChuDe) cboChuDe.addEventListener('change', loadDashboardContent);
        loadDashboardContent();

        var form = document.getElementById('dashboardContentForm');
        if (form) {
            form.addEventListener('submit', function(event) {
                var facilityId = document.getElementById('cboPhongKham')?.value;
                var topicId = document.getElementById('cboChuDe')?.value;
                if (!facilityId || !topicId) {
                    event.preventDefault();
                    if (typeof showToast === 'function') showToast('Vui lòng chọn cơ sở y tế và chủ đề.', 'warning');
                    return;
                }
                document.getElementById('summernote').value = ensureDefaultBlackHtml(
                    $('#summernote').summernote('code'));
                document.getElementById('contentFacilityId').value = facilityId;
                document.getElementById('contentTopicId').value = topicId;
            });
        }
    });
    if (document.readyState === "complete" || document.readyState === "interactive") {
        window.updatePKDropdown();
    }
</script>
}
