                    <a href="/DangNhap/UbLogin?coSo=@ViewBag.SlugCoSo" class="text-primary fw-bold ms-1">Đăng nhập</a>
                </div>

                <div class="card-body">
                    <form id="registrationForm">
                       


                <div class="mb-3">
                            <div class="input-icon">
                                <span class="input-icon-addon text-primary">
                                    <svg style="width: 1.5rem !important; height: 1.5rem !important;"
                                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="icon icon-tabler icons-tabler-outline icon-tabler-id">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path
                                            d="M3 4m0 3a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v10a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3z" />
                                        <path d="M9 10m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                                        <path d="M15 8l2 0" />
                                        <path d="M15 12l2 0" />
                                        <path d="M7 16l10 0" />
                                    </svg>
                                </span>
                                <input style="padding-left: 2.5rem !important; padding: 1.3rem;" type="text"
                                    class="form-control p-3" placeholder="Số căn cước/Hộ chiếu" maxlength="12" name="SoCccd"
                                    autocomplete="off">
                            </div>
                        </div>


                        
                        <div class="mb-3">
                            <div class="input-icon">
                                <span class="input-icon-addon text-primary">
                                    <svg style="width: 1.5rem !important; height: 1.5rem !important;"
                                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        fill="currentColor"
                                        class="icon icon-tabler icons-tabler-filled icon-tabler-phone">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path
