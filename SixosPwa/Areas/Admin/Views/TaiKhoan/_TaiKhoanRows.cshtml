@model (List<SixosPwa.Models.TaiKhoan> Items, Dictionary<long, List<SixosPwa.Areas.Admin.Models.HoSoBenhNhanItemViewModel>> HoSoTheoTaiKhoan, List<SixosPwa.Models.DMGioiTinh> DanhMucGioiTinh)

@if (Model.Items != null)
{
    foreach (var item in Model.Items)
    {
        Model.HoSoTheoTaiKhoan.TryGetValue(item.Id, out var danhSachHoSo);
        <partial name="_TaiKhoanRow" model="(item, danhSachHoSo ?? new List<SixosPwa.Areas.Admin.Models.HoSoBenhNhanItemViewModel>(), Model.DanhMucGioiTinh)" />
    }
}
