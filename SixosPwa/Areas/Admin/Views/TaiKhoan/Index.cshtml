@model TaiKhoanListViewModel
@using Microsoft.EntityFrameworkCore
@inject SixosPwa.Data.ApplicationDbContext _db
@{
    ViewData["Title"] = "Tài khoản";

    // Lấy danh mục giới tính từ CSDL DaotaoHIS (DM_GioiTinh) an toàn
    var danhMucGioiTinh = new List<SixosPwa.Models.DMGioiTinh>();
    try
    {
        var conn = _db.Database.GetDbConnection();
        if (conn.State != System.Data.ConnectionState.Open) conn.Open();
        using var cmd = conn.CreateCommand();
        cmd.CommandText = "SELECT MaGioiTinh, TenGioiTinh FROM DM_GioiTinh";
        using var reader = cmd.ExecuteReader();
        while (reader.Read())
        {
            danhMucGioiTinh.Add(new SixosPwa.Models.DMGioiTinh
            {
                MaGioiTinh = reader[0]?.ToString() ?? "",
                TenGioiTinh = reader[1]?.ToString() ?? ""
            });
        }
    }
    catch
    {
        // Bỏ qua lỗi và dùng fallback
    }
    if (danhMucGioiTinh.Count == 0)
    {
        danhMucGioiTinh = new List<SixosPwa.Models.DMGioiTinh>
        {
            new SixosPwa.Models.DMGioiTinh { MaGioiTinh = "1", TenGioiTinh = "Nam" },
            new SixosPwa.Models.DMGioiTinh { MaGioiTinh = "2", TenGioiTinh = "Nữ" },
            new SixosPwa.Models.DMGioiTinh { MaGioiTinh = "3", TenGioiTinh = "Chưa xác định" }
        };
    }

    // Lấy dữ liệu hồ sơ nếu model chưa có (Đọc an toàn trực tiếp từ SQL để tránh xung đột kiểu dữ liệu)
    var hoSoTheoTaiKhoan = Model.HoSoTheoTaiKhoan;
    if (hoSoTheoTaiKhoan == null || hoSoTheoTaiKhoan.Count == 0)
    {
        var tempDict = new Dictionary<long, List<HoSoBenhNhanItemViewModel>>();
        try
        {
            var conn = _db.Database.GetDbConnection();
            if (conn.State != System.Data.ConnectionState.Open) conn.Open();
            using var cmd = conn.CreateCommand();
            cmd.CommandText = @"
                SELECT b.ID, b.IDTaiKhoan, b.TenBN, b.CCCD, b.SDT, b.Email, b.DiaChi, b.NgaySinh, 
                       CAST(b.GioiTinh AS VARCHAR(10)) AS GioiTinhStr,
                       cs.MaBN, kcb.TenCoSo,
                       cs.ID AS IdHoSoCoSo, cs.IDCoSo
                FROM DM_BenhNhan b
                LEFT JOIN DM_BenhNhanCoSo cs ON b.ID = cs.IDBenhNhan
                LEFT JOIN DM_CSKCB kcb ON cs.IDCoSo = kcb.ID
            ";
            using var reader = cmd.ExecuteReader();
            var allLoaded = new List<(long Id, long? IdTaiKhoan, string TenBN, string CCCD, string SDT, string? Email, string? DiaChi, DateTime? NgaySinh, string? GioiTinh, string? MaBN, string? TenCoSo, long? IdHoSoCoSo, long? IdCoSo)>();
            while (reader.Read())
            {
                var id = Convert.ToInt64(reader["ID"]);
                var idTaiKhoan = reader["IDTaiKhoan"] != DBNull.Value ? (long?)Convert.ToInt64(reader["IDTaiKhoan"]) : null;
                var tenBN = reader["TenBN"]?.ToString() ?? "";
                var cccd = reader["CCCD"]?.ToString() ?? "";
                var sdt = reader["SDT"]?.ToString() ?? "";
                var email = reader["Email"] != DBNull.Value ? reader["Email"]?.ToString() : null;
                var diaChi = reader["DiaChi"] != DBNull.Value ? reader["DiaChi"]?.ToString() : null;
                var ngaySinh = reader["NgaySinh"] != DBNull.Value ? (DateTime?)Convert.ToDateTime(reader["NgaySinh"]) : null;
                var gioiTinh = reader["GioiTinhStr"] != DBNull.Value ? reader["GioiTinhStr"]?.ToString() : null;
                var maBN = reader["MaBN"] != DBNull.Value ? reader["MaBN"]?.ToString() : null;
                var tenCoSo = reader["TenCoSo"] != DBNull.Value ? reader["TenCoSo"]?.ToString() : null;

                var idHoSoCoSo = reader["IdHoSoCoSo"] != DBNull.Value ? (long?)Convert.ToInt64(reader["IdHoSoCoSo"]) : null;
                var idCoSo = reader["IDCoSo"] != DBNull.Value ? (long?)Convert.ToInt64(reader["IDCoSo"]) : null;

                allLoaded.Add((id, idTaiKhoan, tenBN, cccd, sdt, email, diaChi, ngaySinh, gioiTinh, maBN, tenCoSo, idHoSoCoSo, idCoSo));
            }

            foreach (var tk in Model.Items)
            {
                var list = new List<HoSoBenhNhanItemViewModel>();
                var matched = allLoaded.Where(p => p.IdTaiKhoan == tk.Id || (p.IdTaiKhoan == null && !string.IsNullOrEmpty(tk.SDT) && p.SDT == tk.SDT)).ToList();

                var grouped = matched.GroupBy(x => x.Id);
                foreach (var g in grouped)
                {
                    // Mot ho so co the co NHIEU dong `DM_BenhNhanCoSo` (mot dong tu khai +
                    // mot dong da noi ma). Uu tien dong DA CO MA — do moi la dong ma nut
                    // *Go noi* phai thao.
                    var first = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.MaBN));
                    if (first.Id == 0) first = g.First();
                    list.Add(new HoSoBenhNhanItemViewModel
                    {
                        Id = first.Id,
                        IdTaiKhoan = tk.Id,
                        TenBN = first.TenBN,
                        CCCD = first.CCCD,
                        SDT = first.SDT,
                        Email = first.Email,
                        DiaChi = first.DiaChi,
                        NgaySinh = first.NgaySinh,
                        GioiTinh = first.GioiTinh,
                        MaBN = first.MaBN,
                        TenCoSo = first.TenCoSo,
                        IdHoSoCoSo = first.IdHoSoCoSo,
                        IdCoSo = first.IdCoSo,
                        SoCoSo = g.Count(x => !string.IsNullOrEmpty(x.MaBN))
                    });
                }
                tempDict[tk.Id] = list;
            }
        }
        catch
        {
            // Bỏ qua lỗi kết nối và tạo danh sách rỗng
            foreach (var tk in Model.Items)
            {
                tempDict[tk.Id] = new List<HoSoBenhNhanItemViewModel>();
            }
        }
        hoSoTheoTaiKhoan = tempDict;
    }
}

