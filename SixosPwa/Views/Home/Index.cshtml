                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    }

    <!-- KHỐI 5: TRẠNG THÁI PWA -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-light">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <span class="hello__dot"></span>
                <small class="text-muted" id="modeStandalone">Ứng dụng PWA Khám Sức Khỏe đang hoạt động hoàn hảo trên thiết bị của bạn.</small>
            </div>
            <small class="text-muted">HisSoft Medical PWA &copy; 2026</small>
        </div>
    </div>
</div>

}

<!-- MODAL ĐĂNG KÝ KHÁM MỚI -->
<div class="modal fade" id="modalDangKyKham" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalLabel">📋 Đặt Lịch Khám Sức Khỏe Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formBooking" onsubmit="event.preventDefault(); submitBooking();">
                    <div class="mb-3">
                        <label class="form-label font-semibold">Chọn Gói / Chuyên Khoa Khám</label>
                        <select class="form-select form-select-lg" id="cboGoiKham" required>
                            <option value="Gói Khám Sức Khỏe Cơ Bản">Gói Khám Sức Khỏe Cơ Bản (1.500.000đ)</option>
                            <option value="Gói Khám Sức Khỏe Toàn Diện" selected>Gói Khám Sức Khỏe Toàn Diện (3.200.000đ)</option>
                            <option value="Gói Tầm Soát VIP">Gói Tầm Soát VIP (5.800.000đ)</option>
                            <option value="Khám Chuyên Khoa Nội">Khám Chuyên Khoa Nội Tổng Quát</option>
                            <option value="Khám Mắt - Tai Mũi Họng">Khám Mắt - Tai Mũi Họng</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label font-semibold">Chọn Ngày Khám</label>
                            <input type="date" class="form-control form-control-lg" id="txtNgayKham" value="2026-08-15" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label font-semibold">Chọn Giờ Khám</label>
                            <select class="form-select form-select-lg" id="cboGioKham" required>
                                <option value="08:00 AM">08:00 AM</option>
                                <option value="09:00 AM" selected>09:00 AM</option>
                                <option value="10:00 AM">10:00 AM</option>
                                <option value="14:00 PM">14:00 PM</option>
                                <option value="15:00 PM">15:00 PM</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-semibold">Ghi Chú Triệu Chứng / Tiền Sử</label>
                        <textarea class="form-control" id="txtGhiChu" rows="2" placeholder="Ví dụ: Khám định kỳ công ty, tiền sử dị ứng thuốc..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm">
                        ✅ Xác Nhận Đăng Ký Lịch Khám
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function sendSmsDemo() {
            try {
                const response = await fetch('/Home/GuiTinNhan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        message: "test api gửi tin nhắn",
                        danhSachNguoiNhan: ["@ViewData["UserName"]"]
                    })
                });

                const data = await response.json();
                if (data.success) {
                    const toastEl = document.getElementById('bookingToast');
                    document.getElementById('toastMessage').innerHTML = `💬 <strong>Gửi tin thành công!</strong><br/>${data.message}<br/><small class="text-white-50">${data.details}</small>`;
                    const toast = new bootstrap.Toast(toastEl);
                    toast.show();
                } else {
                    alert("Lỗi: " + data.message);
                }
            } catch (err) {
                console.error(err);
                alert("Lỗi kết nối máy chủ!");
            }
        }

        function selectPackage(packageName) {
            document.getElementById('cboGoiKham').value = packageName;
            var myModal = new bootstrap.Modal(document.getElementById('modalDangKyKham'));
            myModal.show();
        }

        function submitBooking() {
            const goiKham = document.getElementById('cboGoiKham').value;
            const ngayKham = document.getElementById('txtNgayKham').value;
            const gioKham = document.getElementById('cboGioKham').value;

            // Đóng Modal
            const modalEl = document.getElementById('modalDangKyKham');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            // Hiển thị Toast thông báo
            const toastEl = document.getElementById('bookingToast');
            document.getElementById('toastMessage').innerHTML = `🎉 <strong>Đăng ký thành công!</strong><br/>${goiKham} vào ${gioKham} ngày ${ngayKham}. Nhân viên y tế sẽ gọi xác nhận!`;
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        function showAppointmentDetail() {
            alert("📋 CHI TIẾT PHIẾU HẸN KHÁM:\n\n- Mã Phiếu: KSK-2026-9902\n- Gói Khám: Khám Sức Khỏe Tổng Quát\n- Thời gian: 08:30 AM - 15/08/2026\n- Địa điểm: Phòng 302, Lầu 3, Bệnh viện HisSoft.\n\nVui lòng mang theo CCCD và thẻ BHYT khi tới khám.");
        }

        function cancelAppointment() {
            if (confirm("Bạn có chắc chắn muốn hủy lịch khám này không?")) {
                alert("Đã hủy lịch khám thành công!");
            }
        }

        function viewReport(maPhieu) {
            alert(`📄 Đang mở Hồ sơ Kết quả Khám sức khỏe mã phiếu [${maPhieu}]...\nChỉ số sức khỏe bình thường, không phát hiện bất thường.`);
        }
    </script>
}

