@{
    ViewData["ChanTrangCong"] = true;
    var tenCoSo = Uri.UnescapeDataString(ViewData["TenCoSo"]?.ToString() ?? "Bệnh Viện ĐHYD");
    var diaChi = Uri.UnescapeDataString(ViewData["DiaChi"]?.ToString() ?? "215 Hồng Bàng, Phường Chợ Lớn");
    var type = ViewData["Type"]?.ToString() ?? "benhvien";
    var img = Uri.UnescapeDataString(ViewData["Img"]?.ToString() ?? "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=800&q=80");
    var logo = Uri.UnescapeDataString(ViewData["Logo"]?.ToString() ?? "https://tse1.mm.bing.net/th/id/OIP.JgUNpJPll-8BkzE3XN6LggHaHa?r=0&pid=Api&P=0&h=180");
    var coSoYTe = ViewData["CoSoYTe"] as DMCSKCB;
    OperatingHours? parsedOperatingHours = null;
    if (coSoYTe != null
        && !string.IsNullOrWhiteSpace(coSoYTe.NgayLamViec)
        && coSoYTe.GioMoCua.HasValue
        && coSoYTe.GioDongCua.HasValue)
    {
        parsedOperatingHours = new OperatingHours(
            coSoYTe.NgayLamViec!,
            coSoYTe.GioMoCua.Value.ToString(@"hh\:mm"),
            coSoYTe.GioDongCua.Value.ToString(@"hh\:mm"));
    }

    if (parsedOperatingHours == null)
        OperatingHours.TryParse(ViewData["TGLamViec"]?.ToString(), out parsedOperatingHours);

    var operatingHours = parsedOperatingHours ?? OperatingHours.Default;
    var noiDungCskcb = ViewData["NoiDungCskcb"] as IReadOnlyDictionary<string, string>
        ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var noiDungGioiThieu = noiDungCskcb.GetValueOrDefault(NDCSKCB.GioiThieu);
    var noiDungDichVu = noiDungCskcb.GetValueOrDefault(NDCSKCB.DichVu);
    var noiDungDoiNgu = noiDungCskcb.GetValueOrDefault(NDCSKCB.DoiNgu);
    var noiDungTrangThietBi = noiDungCskcb.GetValueOrDefault(NDCSKCB.TrangThietBi);
    var noiDungLienHe = noiDungCskcb.GetValueOrDefault(NDCSKCB.LienHe);
}

