                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>13/08/2026 09:30</td>
                                <td>@ViewData["UserName"]</td>
                                <td>0901234567</td>
                                <td>Cảm ơn bạn đã đăng ký dịch vụ.</td>
                                <td><span class="badge bg-success-subtle text-success">Thành công</span></td>
                            </tr>
                            <tr>
                                <td>12/08/2026 14:15</td>
                                <td>@ViewData["UserName"]</td>
                                <td>0987654321</td>
                                <td>Nhắc nhở: Lịch khám vào ngày mai.</td>
                                <td><span class="badge bg-success-subtle text-success">Thành công</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
    <!-- KHỐI 2: LỊCH KHÁM SẮP TỚI & THÔNG BÁO -->
    <div class="row g-4 mb-4">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-primary">📅 Lịch Khám Sức Khỏe Sắp Tới</h5>
                    <span class="badge bg-success">Đã xác nhận</span>
                </div>
                <div class="card-body px-4">
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="fw-bold text-dark mb-1">Gói Khám Sức Khỏe Tổng Quát Định Kỳ</h6>
                                <p class="small text-muted mb-2">Bác sĩ: <strong>BS. CKI Trần Văn Nam</strong> &bull; Khoa Khám bệnh</p>
                                <div class="d-flex align-items-center gap-3 text-secondary small">
                                    <span>🕒 <strong>08:30 AM</strong></span>
                                    <span>📆 <strong>15/08/2026</strong></span>
                                    <span>📍 <strong>Phòng 302 - Lầu 3</strong></span>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                <button class="btn btn-sm btn-outline-primary rounded-pill w-100 mb-1" onclick="showAppointmentDetail()">Xem Phiếu Hẹn</button>
                                <button class="btn btn-sm btn-link text-danger text-decoration-none w-100" onclick="cancelAppointment()">Hủy Lịch</button>
                            </div>
