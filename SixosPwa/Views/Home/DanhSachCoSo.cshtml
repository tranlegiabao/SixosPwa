    </a>
</div>

<div class="ytv-main">
    <div class="ytv-sidebar">
        <!-- KHU VUC -->
        <div class="ytv-khu-vuc">
            <div class="ytv-khu-vuc-title">
                <i class="fas fa-map-marker-alt"></i> Khu vực
            </div>
            <!-- Hidden original select to maintain JS compatibility -->
            <select class="ytv-province-select" id="provinceSelect" style="display:none;">
                <option value="">-- Chọn Tỉnh / TP --</option>
            </select>
            
            <!-- Custom Searchable Dropdown -->
            <div class="ytv-custom-select-container" id="customProvinceContainer">
                <div class="ytv-custom-select-trigger" id="customProvinceTrigger">
                    <span>-- Chọn Tỉnh / TP --</span>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="ytv-custom-select-dropdown">
                    <div class="ytv-custom-select-search">
                        <input type="text" id="customProvinceSearch" placeholder="Tìm nhanh (hn, hcm, bd, vt...)" autocomplete="off" />
                        <i class="fas fa-search"></i>
                    </div>
                    <ul class="ytv-custom-select-options" id="customProvinceOptions">
                        <li data-value="" class="selected">-- Chọn Tỉnh / TP --</li>
                    </ul>
                </div>
            </div>
            <ul class="ytv-district-list" id="districtList">
                <li class="active" data-code="">Tất cả quận huyện <i class="fas fa-check"></i></li>
            </ul>
        </div>
    </div>
    <div class="ytv-content">
        <div class="ytv-content-title">
            <div class="ytv-content-title-left">
                <span>Danh sách @ViewData["Title"]</span>
                <span class="badge bg-primary rounded-pill" style="font-size: 14px; display: none !important;"><span id="resultCount">0</span> cơ sở</span>
            </div>
            <div class="ytv-search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="Tìm kiếm tên cơ sở..." autocomplete="off" />
            </div>
        </div>
        
        <div class="ytv-grid" id="clinicGrid">
            <!-- Rendered by JS -->
        </div>
    </div>
</div>

