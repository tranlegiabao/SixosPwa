@model PaginationViewModel
@if (Model.TotalPages > 1)
{
    <nav class="admin-pagination" aria-label="Phân trang">
        @if (Model.Page > 1)
        {
            <a asp-route-page="1" asp-route-q="@Model.Query" asp-route-role="@Model.Role" asp-route-loaiCS="@Model.LoaiCS" asp-route-maCoSo="@Model.MaCoSo" asp-route-cccd="@Model.CCCD" asp-route-sdt="@Model.SDT" asp-route-maBN="@Model.MaBN" aria-label="Trang đầu">&laquo;</a>
            <a asp-route-page="@(Model.Page - 1)" asp-route-q="@Model.Query" asp-route-role="@Model.Role" asp-route-loaiCS="@Model.LoaiCS" asp-route-maCoSo="@Model.MaCoSo" asp-route-cccd="@Model.CCCD" asp-route-sdt="@Model.SDT" asp-route-maBN="@Model.MaBN" aria-label="Trang trước">&lsaquo;</a>
        }
        else
        {
            <span class="disabled">&laquo;</span>
            <span class="disabled">&lsaquo;</span>
        }

        <span class="pagination-current">Trang <strong> @Model.Page</strong>/<strong>@Model.TotalPages</strong></span>

        @if (Model.Page < Model.TotalPages)
        {
            <a asp-route-page="@(Model.Page + 1)" asp-route-q="@Model.Query" asp-route-role="@Model.Role" asp-route-loaiCS="@Model.LoaiCS" asp-route-maCoSo="@Model.MaCoSo" asp-route-cccd="@Model.CCCD" asp-route-sdt="@Model.SDT" asp-route-maBN="@Model.MaBN" aria-label="Trang sau">&rsaquo;</a>
            <a asp-route-page="@Model.TotalPages" asp-route-q="@Model.Query" asp-route-role="@Model.Role" asp-route-loaiCS="@Model.LoaiCS" asp-route-maCoSo="@Model.MaCoSo" asp-route-cccd="@Model.CCCD" asp-route-sdt="@Model.SDT" asp-route-maBN="@Model.MaBN" aria-label="Trang cuối">&raquo;</a>
        }
        else
        {
            <span class="disabled">&rsaquo;</span>
            <span class="disabled">&raquo;</span>
        }
    </nav>
}
