          ],
          "path": [
            "api",
            "v1",
            "tai-lieu",
            "xem",
            "{{document_id}}"
          ]
        },
        "description": "Tải stream tệp PDF trực tiếp từ máy chủ FTP. Có thể sửa số ID trên URL để xem tài liệu khác."
      },
      "response": []
    },
