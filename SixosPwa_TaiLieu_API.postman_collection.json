    {
      "name": "2. Kiểm Tra Nhận Hồ Sơ (/api/v1/ho-so)",
      "item": [
        {
          "name": "2.1 Hỏi theo lô mã bệnh nhân đã có hồ sơ tại cổng (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Success is true\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Response contains daCoNguoiNhan list and soDaHoi\", function () {",
                  "    pm.expect(jsonData.data).to.have.property(\"daCoNguoiNhan\");",
                  "    pm.expect(jsonData.data).to.have.property(\"soDaHoi\");",
                  "    pm.expect(jsonData.data.soDaHoi).to.eql(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "test-api-key-cs2",
                "type": "text",
                "description": "Sửa trực tiếp API Key tại đây"
              },
              {
                "key": "X-API-Key",
                "value": "THUNGHIEM-DOT2-20260908-a7f3c1",
                "type": "text",
                "disabled": true,
                "description": "Gợi ý: Khóa thử nghiệm cơ sở 75265"
              },
