                    </form>

                    @* Nut cai PWA — phai co o CA luong doi tac, khong chi luong OTP.
                       CSS nam san trong site.css; pwa-install.js quyet dinh an/hien. *@
                    <partial name="_PwaInstall" />
                </div>



            </div>
        </div>
        <div class="col-12 p-3 d-none" id="otpCol">
            <div class="h-100 d-flex justify-content-center">
                <div class="w-75 text-center">
                    <img src="@(ViewBag.LogoCoSo ?? "/static/icon-192.png")"
                        alt="UNGBUOU logo" class="d-block mx-auto mb-3" style="max-width: 50px;">
                    <h2 class="text-center fw-bold mb-4">Tạo tài khoản UNGBUOU để truy cập vào tất cả các dịch vụ của
                        UNGBUOU</h2>
                    <h1 class="text-center mb-md-8 mt-md-10 fw-bold mb-4 mt-5">XÁC THỰC TÀI KHOẢN</h1>
                    <div class="d-flex justify-content-center mb-4">
                        <p class="text-center mb-0 me-1" id="register_textNotiCode"></p>
                    </div>
                    <div class="d-flex justify-content-center mb-5 gap-3" id="register_otpInputs">
                        <input type="text" class="form-control text-center input_XacThuc" 
                            maxlength="1">
                        <input type="text" class="form-control text-center input_XacThuc" 
                            maxlength="1">
                        <input type="text" class="form-control text-center input_XacThuc" 
                            maxlength="1">
                        <input type="text" class="form-control text-center input_XacThuc" 
                            maxlength="1">
                    </div>

                    <div class="text-center d-flex flex-column align-items-start">
                        <button class="btn text-primary mb-3 p-2"
                            style="width: 200px; background-color: transparent; border: none;"
                            id="register_btnSendCodeAgain">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-refresh">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" />
                                <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" />
                            </svg>
                            Gửi lại mã xác thực
                        </button>
                    </div>

                    <div class="text-center d-flex flex-column align-items-center">
                        <button class="btn btn-primary w-50 p-2" id="register_btnCheckCode">Tiếp tục</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

</div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/ub-hien-mat-khau.js" asp-append-version="true"
        data-nhan-hien="Hiện mật khẩu" data-nhan-an="Ẩn mật khẩu"></script>
<script src="~/js/pwa-install.js" asp-append-version="true"></script>
<script>
    (function () {
        const maCoSo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.MaCoSo));
        const returnUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.ReturnUrl));

        const form = document.getElementById('registrationForm');
        const cotDangKy = document.getElementById('registrationCol');
        const cotOtp = document.getElementById('otpCol');
        const btnLayMa = document.getElementById('register_btnGetCode');
        const btnKiemMa = document.getElementById('register_btnCheckCode');
        const btnGuiLai = document.getElementById('register_btnSendCodeAgain');
        const dongBaoMa = document.getElementById('register_textNotiCode');
        const oMa = Array.from(document.querySelectorAll('#register_otpInputs .input_XacThuc'));

        // Giu lai de con gui kem khi bam "Gui lai ma".
        let hoSo = null;

        function docForm() {
            const oEmail = form.querySelector('[name="Email"]');
            return {
                cccd: form.querySelector('[name="SoCccd"]').value.trim(),
                dienThoai: form.querySelector('[name="DienThoai"]').value.trim(),
                email: oEmail ? oEmail.value.trim() : null,
                matKhau: document.getElementById('password_send').value,
                nhapLai: document.getElementById('confirm_password_send').value,
                // 1 = Zalo, 3 = SMS — khop switch ben doi tac.
                kenh: Number((form.querySelector('[name="register_xacThuc"]:checked') || {}).value || 3)
            };
        }

        async function xinMa(hienCotOtp) {
            const t = hoSo || docForm();

            if (!t.cccd || !t.dienThoai) {
                showToast('Vui lòng nhập số căn cước và điện thoại!', 400);
                return;
            }
            if (!t.matKhau || t.matKhau.length < 6) {
                showToast('Mật khẩu phải có ít nhất 6 ký tự!', 400);
                return;
            }
            if (t.matKhau !== t.nhapLai) {
                showToast('Mật khẩu nhập lại không khớp!', 400);
                return;
            }

            const res = await fetch('/DangNhap/UbTaoTaiKhoan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    maCoSo: maCoSo,
                    cccd: t.cccd,
                    dienThoai: t.dienThoai,
                    email: t.email,
                    matKhau: t.matKhau,
                    kenh: t.kenh
                })
            });
            const data = await res.json();

            if (!data.success) {
                // Thong bao la cua CHINH doi tac tra ve — hien nguyen van.
                showToast(data.message || 'Không tạo được tài khoản', 400);
                return;
            }

            hoSo = t;
            showToast(data.message || 'Đã gửi mã xác thực', 200);

            if (hienCotOtp) {
                cotDangKy.classList.add('d-none');
                cotOtp.classList.remove('d-none');
                if (dongBaoMa) {
                    dongBaoMa.textContent = (t.kenh === 1 ? 'Mã xác thực đã gửi qua Zalo tới số '
                                                          : 'Mã xác thực đã gửi tới số ') + t.dienThoai;
                }
                if (oMa.length) oMa[0].focus();
            }
        }

        document.querySelectorAll('#register_btnGetCode, #register_btnGetCodeMobile').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                const chuCu = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = 'Đang gửi...';
                try { await xinMa(true); }
                catch (err) { showToast('Không kết nối được, vui lòng thử lại', 500); }
                finally { btn.disabled = false; btn.innerHTML = chuCu; }
            });
        });

        if (btnGuiLai) {
            btnGuiLai.addEventListener('click', async function () {
                btnGuiLai.disabled = true;
                try { await xinMa(false); }
                catch (err) { showToast('Không kết nối được, vui lòng thử lại', 500); }
                finally { btnGuiLai.disabled = false; }
            });
        }

        // Bon o mot chu so: go xong nhay o ke tiep, xoa thi lui lai.
        oMa.forEach(function (o, i) {
            o.addEventListener('input', function () {
                o.value = o.value.replace(/[^0-9]/g, '').slice(0, 1);
                if (o.value && i < oMa.length - 1) oMa[i + 1].focus();
            });
            o.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace' && !o.value && i > 0) oMa[i - 1].focus();
            });
        });

        btnKiemMa.addEventListener('click', async function () {
            const ma = oMa.map(function (o) { return o.value; }).join('');
            if (ma.length !== 4) {
                showToast('Vui lòng nhập đủ 4 số!', 400);
                return;
            }
            if (!hoSo) {
                showToast('Phiên đăng ký đã hết hạn, vui lòng đăng ký lại', 400);
                return;
            }

            const chuCu = btnKiemMa.innerHTML;
            btnKiemMa.disabled = true;
            btnKiemMa.innerHTML = 'Đang xác thực...';

            try {
                const res = await fetch('/DangNhap/UbXacThucMa', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        maCoSo: maCoSo,
                        cccd: hoSo.cccd,
                        ma: ma,
                        returnUrl: returnUrl,
                        deviceId: localStorage.getItem('deviceId'),
                        deviceName: navigator.userAgent
                    })
                });
                const data = await res.json();

                if (!data.success) {
                    showToast(data.message || 'Mã xác thực không đúng', 400);
                    return;
                }

                window.location.href = data.redirectUrl;
            } catch (err) {
                showToast('Không kết nối được, vui lòng thử lại', 500);
            } finally {
                btnKiemMa.disabled = false;
                btnKiemMa.innerHTML = chuCu;
            }
        });
    })();
</script>
</body>
</html>
