@{
    ViewData["Title"] = ViewData["Title"];
}

<style>
    /* Ẩn Layout mặc định */
    .app-nav { display: none !important; }
    .bottom-nav { display: none !important; }
    body { background-color: var(--ytv-bg); padding-bottom: 0 !important; }

    /* Layout Variables */
    :root {
        --ytv-primary: #3b82f6;
        --ytv-secondary: #0ea5e9;
        --ytv-accent: #ffb703;
        --ytv-text: #334155;
        --ytv-bg: #f0f9ff;
    }

    /* HEADER */
    .ytv-header {
        background: linear-gradient(135deg, #3b82f6, #60a5fa);
        color: white;
        padding: 15px 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        position: relative;
    }
    .ytv-logo-area {
        display: flex;
        align-items: center;
        gap: 15px;
        text-decoration: none;
        color: white;
    }
    .ytv-logo-area:hover {
        color: white;
    }
    .ytv-logo-text {
        font-family: 'Times New Roman', Times, serif;
        font-size: 28px;
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: 1px;
        text-shadow: 1px 1px 3px rgba(255, 255, 255, 0.4);
    }
    .ytv-header-title {
        text-align: center;
        flex-grow: 1;
    }
    .ytv-header-title h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }
    .ytv-header-title p {
        margin: 5px 0 0 0;
        font-size: 14px;
        opacity: 0.9;
    }
    .ytv-menu-btn {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        font-size: 24px;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.3s;
    }
    .ytv-menu-btn:hover {
        background: rgba(255,255,255,0.3);
    }

    /* MAIN CONTAINER */
    .ytv-main {
        display: flex;
        max-width: 1400px;
        margin: 0 auto;
        min-height: calc(100vh - 200px);
        background: white;
        box-shadow: 0 0 20px rgba(0,0,0,0.05);
    }

    /* FILTER SIDEBAR */
    .ytv-sidebar {
        width: 280px;
        background: #f8fafc;
        border-right: 1px solid #e2e8f0;
        padding: 20px;
        display: flex;
        flex-direction: column;
    }
    .ytv-filter-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--ytv-primary);
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .ytv-filter-select {
        width: 100%;
        padding: 10px 15px;
        border: 2px solid #cbd5e1;
        border-radius: 8px;
        font-size: 15px;
        color: var(--ytv-text);
        margin-bottom: 20px;
        outline: none;
        transition: border-color 0.3s;
        appearance: none;
        background: white url('data:image/svg+xml;utf8,<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 10L12 15L17 10" stroke="%23334155" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat right 10px center/20px;
    }
    .ytv-filter-select:focus {
        border-color: var(--ytv-primary);
    }
    .ytv-filter-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .ytv-filter-list li {
        padding: 12px 15px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 15px;
        font-weight: 500;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .ytv-filter-list li:hover, .ytv-filter-list li.active {
        color: var(--ytv-primary);
        background: #f1f5f9;
        padding-left: 20px;
    /* RIGHT CONTENT */
    .ytv-content {
        flex: 1;
        padding: 30px;
        background: #ffffff;
    }
    .ytv-content-title {
        font-size: 24px;
        font-weight: 800;
        color: var(--ytv-primary);
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }
    .ytv-content-title-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .ytv-search-box {
        position: relative;
        width: 300px;
    }
    .ytv-search-box input {
        width: 100%;
        padding: 10px 15px 10px 40px;
        border: 1px solid #cbd5e1;
        border-radius: 20px;
        outline: none;
        font-size: 14px;
        transition: border-color 0.3s;
    }
    .ytv-search-box input:focus {
        border-color: var(--ytv-primary);
    }
    .ytv-search-box i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
    }
    .ytv-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }
    .ytv-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        transition: transform 0.3s, box-shadow 0.3s;
        display: flex;
        flex-direction: column;
    }
    .ytv-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        border-color: var(--ytv-secondary);
    }
    .ytv-card-img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        background: #f1f5f9;
    }
    .ytv-card-body {
        padding: 15px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .ytv-card-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--ytv-text);
        margin-bottom: 10px;
    }
    .ytv-card-address {
        font-size: 14px;
        color: #64748b;
        margin-bottom: 15px;
        display: flex;
        gap: 8px;
    }
    .ytv-card-address i {
        color: var(--ytv-secondary);
        margin-top: 3px;
    }
    .ytv-card-btn {
        margin-top: auto;
        display: block;
        width: 100%;
        padding: 10px;
        background: var(--ytv-primary);
        color: white;
        text-align: center;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.3s;
    }
    .ytv-card-btn:hover {
        background: var(--ytv-secondary);
        color: white;
    }

    /* FOOTER */
    .ytv-footer {
        background: #e0f2fe; 
        color: #334155;
        padding: 25px 30px 15px 30px;
        display: flex;
        flex-direction: column;
        border-top: 4px solid var(--ytv-primary);
    }
    .ytv-footer-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 20px;
    }
    .ytv-support-col {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .ytv-support-phones {
        font-size: 16px;
        font-weight: 500;
    }
    .ytv-support-phones span {
        color: var(--ytv-primary);
        font-weight: 700;
        font-size: 18px;
    }
    .ytv-policies-col {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        font-weight: 500;
        margin-top: 5px;
    }
    .ytv-policies-col a {
        color: #0f172a;
        text-decoration: none;
        transition: color 0.2s;
    }
    .ytv-policies-col a:hover {
        color: var(--ytv-primary);
    }
    .ytv-policies-col .separator {
        color: #94a3b8;
    }
    .ytv-footer-bottom {
        text-align: center;
        font-size: 14px;
        color: #64748b;
        border-top: 1px solid #bae6fd;
        padding-top: 15px;
    }

    /* RESPONSIVE */
    @@media (max-width: 992px) {
        .ytv-header { flex-direction: column; gap: 15px; text-align: center; }
        .ytv-main { flex-direction: column; }
        .ytv-sidebar { width: 100%; border-right: none; border-bottom: 1px solid #e2e8f0; padding: 15px; }
        .ytv-grid { grid-template-columns: repeat(2, 1fr); }
        .ytv-footer-top { flex-direction: column; gap: 20px; align-items: center; text-align: center; }
        .ytv-policies-col { justify-content: center; }
    }
    @@media (max-width: 576px) {
        .ytv-grid { grid-template-columns: 1fr; }
        .ytv-sidebar { padding: 10px; }
        .ytv-content { padding: 15px; }
        .ytv-search-box { width: 100%; }
        .ytv-content-title { flex-direction: column; align-items: flex-start; }
    }
</style>

<div class="ytv-header">
    <a href="/Home/ThongTinBenhNhan" class="ytv-logo-area">
        <img src="/static/logo-yte.png" alt="Logo" style="height: 50px; width: 50px; object-fit: contain; background: white; border-radius: 50%; padding: 5px;" />
        <div class="ytv-logo-text">Y TẾ<br>VIỆT</div>
    </a>
    <div class="ytv-header-title d-none d-md-block">
        <h1>Dịch Vụ Đăng Ký Khám Bệnh Online</h1>
        <p>Tiện lợi - Nhanh chóng - Chính xác</p>
    </div>
    <a href="/Home/ThongTinBenhNhan" class="ytv-menu-btn" title="Quay lại">
        <i class="fas fa-home"></i>
    </a>
</div>

<div class="ytv-main">
    <div class="ytv-sidebar">
        <div class="ytv-filter-title">
            <i class="fas fa-map-marker-alt"></i> Khu vực
        </div>
        <select class="ytv-filter-select" id="provinceSelect">
            <option value="">-- Chọn Tỉnh / Thành phố --</option>
            <!-- JS will populate 63 provinces here -->
        </select>
        
        <ul class="ytv-filter-list" id="districtList">
            <li class="active" data-code="">Tất cả quận huyện <i class="fas fa-check text-primary"></i></li>
        </ul>
    </div>
    <div class="ytv-content">
        <div class="ytv-content-title">
            <div class="ytv-content-title-left">
                <span>Danh sách @ViewData["Title"]</span>
                <span class="badge bg-primary rounded-pill" style="font-size: 14px;"><span id="resultCount">0</span> cơ sở</span>
            </div>
            <div class="ytv-search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="Tìm kiếm tên cơ sở..." autocomplete="off" />
            </div>
        </div>
        
        <div class="ytv-grid" id="clinicGrid">
            <!-- Rendered by JS -->
        </div>
    </div>
</div>

<div class="ytv-footer">
    <div class="ytv-footer-top">
        <div class="ytv-support-col">
            <div class="ytv-support-phones" style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
                <div><i class="fas fa-headset me-2"></i> Hỗ trợ: <span>0901 82 88 96</span> - <span>0364 956 007</span></div>
                <div><i class="fas fa-envelope me-2"></i> Email: <a href="mailto:Sixossoft@gmail.com" style="color: var(--ytv-primary); font-weight: 600; text-decoration: none;">Sixossoft@gmail.com</a></div>
            </div>
        </div>
        
        <div class="ytv-policies-col">
            <a href="#">Chính sách bảo mật</a> <span class="separator">|</span>
            <a href="#">Điều khoản sử dụng</a> <span class="separator">|</span>
            <a href="#">Giải quyết khiếu nại</a> <span class="separator">|</span>
            <a href="#">Chính sách bảo hành</a>
        </div>
    </div>
    <div class="ytv-footer-bottom">
        Đơn vị phối hợp thực hiện: <strong>Công Ty Phần mềm Vũ Phong - SixOSSoft.com</strong>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let provinceData = [];
        const provinceSelect = document.getElementById("provinceSelect");
        const districtList = document.getElementById("districtList");
        const clinicGrid = document.getElementById("clinicGrid");
        const resultCount = document.getElementById("resultCount");
        const searchInput = document.getElementById("searchInput");

        // Initial Empty State
        showEmptyState();

        // Search logic
        searchInput.addEventListener("input", function() {
            const keyword = this.value.toLowerCase().trim();
            const cards = clinicGrid.querySelectorAll('.clinic-card');
            let visibleCount = 0;
            
            // If empty state is currently showing, don't try to search
            if (cards.length === 0) return;

            cards.forEach(card => {
                const title = card.querySelector('.ytv-card-title').textContent.toLowerCase();
                if (title.includes(keyword)) {
                    card.style.display = "flex";
                    visibleCount++;
                } else {
                    card.style.display = "none";
                }
            });
            resultCount.textContent = visibleCount;
        });

        // Fetch 63 provinces and their districts from open API
        fetch("https://provinces.open-api.vn/api/?depth=2")
            .then(res => res.json())
            .then(data => {
                provinceData = data;
                // Populate province dropdown
                data.forEach(p => {
                    const opt = document.createElement("option");
                    opt.value = p.code;
                    opt.textContent = p.name;
                    provinceSelect.appendChild(opt);
                });
            })
            .catch(err => console.error("Lỗi lấy dữ liệu tỉnh thành: ", err));

        provinceSelect.addEventListener("change", function () {
            const selectedCode = this.value;
            if (!selectedCode) {
                districtList.innerHTML = `<li class="active" data-code="">Tất cả quận huyện <i class="fas fa-check text-primary"></i></li>`;
                showEmptyState();
                return;
            }

            const selectedProvince = provinceData.find(p => p.code == selectedCode);
            renderDistricts(selectedProvince);
            generateMockClinics(selectedProvince.name, "Tất cả quận huyện");
        });

        function showEmptyState() {
            resultCount.textContent = "0";
            clinicGrid.style.display = "block"; // override grid to show full width message
            clinicGrid.innerHTML = `
                <div style="text-align: center; padding: 50px 20px; color: #64748b; background: #f8fafc; border-radius: 12px; border: 2px dashed #cbd5e1;">
                    <i class="fas fa-search-location" style="font-size: 48px; color: #94a3b8; margin-bottom: 15px;"></i>
                    <h3 style="font-size: 18px; font-weight: 600; color: #475569;">Vui lòng chọn khu vực</h3>
                    <p style="margin: 0;">Hãy chọn Tỉnh / Thành phố bên trái để xem danh sách @ViewData["Title"]</p>
                </div>
            `;
        }

        function renderDistricts(province) {
            districtList.innerHTML = `<li class="active" data-code="">Tất cả quận huyện <i class="fas fa-check text-primary"></i></li>`;
            
            if (province && province.districts) {
                province.districts.forEach(d => {
                    const li = document.createElement("li");
                    li.dataset.code = d.code;
                    li.textContent = d.name;
                    
                    li.addEventListener("click", function() {
                        // Remove active class from all
                        districtList.querySelectorAll("li").forEach(item => {
                            item.classList.remove("active");
                            const icon = item.querySelector("i");
                            if (icon) icon.remove();
                        });
                        
                        // Add active to clicked
                        this.classList.add("active");
                        this.innerHTML += ' <i class="fas fa-check text-primary"></i>';
                        
                        generateMockClinics(province.name, d.name);
                    });
                    
                    districtList.appendChild(li);
                });
            }
            
            // Re-bind click event for the "Tất cả" option
            districtList.firstElementChild.addEventListener("click", function() {
                 districtList.querySelectorAll("li").forEach(item => {
                    item.classList.remove("active");
                    const icon = item.querySelector("i");
                    if (icon) icon.remove();
                });
                this.classList.add("active");
                this.innerHTML += ' <i class="fas fa-check text-primary"></i>';
                generateMockClinics(province.name, "Tất cả quận huyện");
            });
        }

        // Simulate fetching clinics for a specific location
        function generateMockClinics(provinceName, districtName) {
            clinicGrid.style.display = "grid"; // restore grid layout
            // Random number of clinics between 2 and 6
            const count = Math.floor(Math.random() * 5) + 2;
            resultCount.textContent = count;
            
            let html = "";
            const catName = "@ViewData["Title"]";
            const images = [
                "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=500&q=80",
                "https://images.unsplash.com/photo-1581594693702-fbdc51b2763b?w=500&q=80",
                "https://images.unsplash.com/photo-1538108149393-fbbd81895907?w=500&q=80",
                "https://images.unsplash.com/photo-1579684385127-1ef15d508118?w=500&q=80"
            ];
            
            for (let i = 1; i <= count; i++) {
                const randomImg = images[i % images.length];
                const dName = districtName === "Tất cả quận huyện" ? "Quận " + (Math.floor(Math.random() * 10) + 1) : districtName;
                
                html += `
                <div class="ytv-card clinic-card">
                    <img src="${randomImg}" alt="Cơ sở ${i}" class="ytv-card-img" />
                    <div class="ytv-card-body">
                        <div class="ytv-card-title">${catName} Mẫu Số ${i}</div>
                        <div class="ytv-card-address">
                            <i class="fas fa-map-pin"></i> 
                            <span class="address-text">123 Đường Số ${i}, ${dName}, ${provinceName}</span>
                        </div>
                        <a href="/Home/Index" class="ytv-card-btn">Đăng ký khám</a>
                    </div>
                </div>`;
            }
            clinicGrid.innerHTML = html;
        }
    });
</script>
