    /* Floating Action Button (FAB) */
    .fab-btn {
        position: fixed;
        top: 50%;
        right: 24px;
        transform: translateY(-50%);
        z-index: 1005; /* Above the footer and header */
        background: #ffffff;
        color: #1d4ed8 !important;
        border: 2.5px solid #1d4ed8;
        width: 70px;
        height: 160px;
        border-radius: 40px; /* Vertical oval */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
