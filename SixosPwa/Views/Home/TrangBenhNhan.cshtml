                    loai: "nhac-hen",
                    daDoc: false,
                    noiDung: `Lịch nhắc hẹn: Lịch khám định kỳ Mắt - Phòng 302 của quý khách vào 14:00 ngày 07/09/${nam}. ThS.BS. Hoàng Minh Tuấn phụ trách.`,
                    loiDan: "Kiểm tra thị lực định kỳ và đo nhãn áp.",
