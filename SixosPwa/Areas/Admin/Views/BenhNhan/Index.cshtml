@model BenhNhanListViewModel
@{
    ViewData["Title"] = "Bệnh nhân";
    string MaskPhone(string? phone) => string.IsNullOrWhiteSpace(phone) ? "Chưa cập nhật" : phone.Length < 7 ? "••••" : phone[..3] + "••••" + phone[^2..];
}
<div class="page-header-row"><div><div class="page-kicker">DỮ LIỆU KHÁCH HÀNG</div><h1 class="page-heading">Bệnh nhân</h1><p class="page-description">Tra cứu hồ sơ đăng ký theo phạm vi đối tác. Màn hình này chỉ đọc.</p></div><span class="readonly-badge">Chỉ xem</span></div>
<div class="admin-panel"><form method="get" class="filter-bar"><div class="search-control admin-search-control"><span>⌕</span><select class="admin-query-select" data-query-name="q" data-initial-value="@Model.Query" placeholder="Tìm mã, tên hoặc số điện thoại..." aria-label="Tìm bệnh nhân"></select><input type="hidden" name="q" value="@Model.Query" /></div><div class="search-control admin-search-control partner-filter"><span>⌕</span><select class="admin-query-select" data-query-name="maDT" data-initial-value="@Model.MaDT" placeholder="Mã đối tác" aria-label="Lọc theo mã đối tác"></select><input type="hidden" name="maDT" value="@Model.MaDT" /></div><button class="btn admin-btn-secondary" type="submit">Tìm kiếm</button>@if (!string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.MaDT)) { <a asp-action="Index" class="clear-filter">Xóa lọc</a> }</form>
    <div class="privacy-strip"><span>◉</span><div><strong>Dữ liệu được bảo vệ</strong><small>Số điện thoại được che một phần trong danh sách để giảm lộ thông tin cá nhân.</small></div></div>
    <div class="table-meta"><span><strong>@Model.TotalItems.ToString("N0")</strong> bệnh nhân</span><span>Trang @Model.Page / @Model.TotalPages</span></div>
    <div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead><tr><th>Bệnh nhân</th><th>Liên hệ</th><th>Đối tác</th><th class="text-end">Mã hồ sơ</th></tr></thead><tbody>
    @if (Model.Items.Count == 0) { <tr><td colspan="4"><div class="table-empty"><div>◌</div><strong>Không tìm thấy bệnh nhân</strong><span>Thử thay đổi từ khóa hoặc mã đối tác.</span></div></td></tr> }
    else { foreach (var item in Model.Items) { <tr><td><div class="table-person"><span class="mini-avatar avatar-green">@(item.TenBN.FirstOrDefault().ToString())</span><div><strong>@item.TenBN</strong><small>@(item.Email ?? "Chưa có email")</small></div></div></td><td><div class="contact-stack"><span>@MaskPhone(item.SDT)</span><small>@(item.DiaChi ?? "Chưa cập nhật địa chỉ")</small></div></td><td><span class="type-badge">@item.MaDT</span></td><td class="text-end text-muted">#@item.Id</td></tr> } }
    </tbody></table></div><partial name="_Pagination" model="new PaginationViewModel { Page = Model.Page, TotalPages = Model.TotalPages, Query = Model.Query, MaDT = Model.MaDT }" />
</div>
