@model CoSoYTeEditViewModel
@{ ViewData["Title"] = "Chỉnh sửa cơ sở y tế"; }
<div class="page-header-row"><div><div class="page-kicker">CƠ SỞ Y TẾ #@Model.Id</div><h1 class="page-heading">Chỉnh sửa cơ sở</h1><p class="page-description">Cập nhật nội dung hiển thị và trạng thái xác minh.</p></div><a asp-action="Index" class="back-link">← Quay lại danh sách</a></div>
<div class="admin-panel form-panel"><form asp-action="Edit" method="post" class="admin-form"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div><div class="form-section-title">Thông tin hiển thị</div><div class="row g-3"><div class="col-md-4"><label asp-for="MaCoSo" class="form-label">Mã cơ sở</label><input asp-for="MaCoSo" class="form-control" /><span asp-validation-for="MaCoSo" class="text-danger field-error"></span></div><div class="col-md-8"><label asp-for="TenCoSo" class="form-label">Tên cơ sở <span>*</span></label><input asp-for="TenCoSo" class="form-control" /><span asp-validation-for="TenCoSo" class="text-danger field-error"></span></div><div class="col-md-4"><label asp-for="LoaiCS" class="form-label">Loại hình</label><select asp-for="LoaiCS" class="form-select"><option value="">Chưa phân loại</option><option value="benhvien">Bệnh viện</option><option value="pkdk">Phòng khám</option><option value="nhakhoa">Nha khoa</option><option value="phongmach">Phòng mạch</option><option value="nhathuoc">Nhà thuốc</option></select></div><div class="col-md-8"><label asp-for="TGLamViec" class="form-label">Giờ làm việc</label><input asp-for="TGLamViec" class="form-control" /></div><div class="col-12"><label asp-for="DiaChi" class="form-label">Địa chỉ</label><textarea asp-for="DiaChi" class="form-control" rows="2"></textarea></div><div class="col-md-8"><label asp-for="Img" class="form-label">URL hình ảnh</label><input asp-for="Img" class="form-control" type="url" /><span asp-validation-for="Img" class="text-danger field-error"></span></div><div class="col-md-4"><label asp-for="QuangCao" class="form-label">Mức ưu tiên quảng cáo</label><input asp-for="QuangCao" class="form-control" type="number" min="0" step="1" /></div><div class="col-12"><div class="form-check form-switch"><input asp-for="XacMinh" class="form-check-input" /><label asp-for="XacMinh" class="form-check-label">Đã xác minh và cho phép hiển thị</label></div></div></div><div class="form-actions"><a asp-action="Index" class="btn admin-btn-secondary">Hủy</a><button type="submit" class="btn admin-btn-primary">Lưu thay đổi</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
