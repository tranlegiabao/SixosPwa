        height: 200px;
    }

    .note {
        margin-bottom: 10px;
    }

    .note a {
        color: #007bff;
        text-decoration: none;
    }

    .note a:hover {
        text-decoration: underline;
    }



    .footer a {
        color: #007bff;
        text-decoration: none;
    }

    .footer a:hover {
        text-decoration: underline;
    }

    .new-tag {
        background-color: red;
        color: white;
