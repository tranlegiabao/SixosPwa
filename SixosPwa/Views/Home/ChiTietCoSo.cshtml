@{
    var tenCoSo = Uri.UnescapeDataString(ViewData["TenCoSo"]?.ToString() ?? "Cơ sở y tế");
    var diaChi = Uri.UnescapeDataString(ViewData["DiaChi"]?.ToString() ?? "Đang cập nhật");
    var type = ViewData["Type"]?.ToString() ?? "benhvien";
    var img = Uri.UnescapeDataString(ViewData["Img"]?.ToString() ?? "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=800&q=80");
}

<style>
    .app-nav { display: none !important; }
    .bottom-nav { display: none !important; }
    body { background: #f0f9ff; padding-bottom: 0 !important; margin: 0 !important; }
    .container, .container-fluid, .container-sm, .container-md, .container-lg, .container-xl {
        max-width: 100% !important; width: 100% !important;
        padding-left: 0 !important; padding-right: 0 !important;
        margin-left: 0 !important; margin-right: 0 !important;
    }
    :root { --ytv-primary: #3b82f6; --ytv-secondary: #0ea5e9; --ytv-text: #334155; }

    .ytv-header {
        background: linear-gradient(135deg, #3b82f6, #60a5fa);
        color: white; padding: 15px 30px;
        display: flex; align-items: center; justify-content: space-between;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .ytv-logo-area { display: flex; align-items: center; gap: 15px; text-decoration: none; color: white; }
    .ytv-logo-text { font-family: 'Times New Roman', serif; font-size: 28px; font-weight: 900; line-height: 1.05; }
    .ytv-header-title { text-align: center; flex-grow: 1; }
    .ytv-header-title h1 { margin: 0; font-size: 22px; font-weight: 700; }
    .ytv-header-title p { margin: 5px 0 0; font-size: 14px; opacity: 0.9; }
    .ytv-menu-btn {
        background: rgba(255,255,255,0.2); color: white; font-size: 22px;
        width: 45px; height: 45px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        text-decoration: none; transition: background 0.3s;
    }
    .ytv-menu-btn:hover { background: rgba(255,255,255,0.35); color: white; }

    .ytv-main { display: flex; width: 100%; min-height: calc(100vh - 140px); }

    .ytv-sidebar {
        width: 220px; flex-shrink: 0; background: white;
        border-right: 1px solid #e2e8f0; display: flex; flex-direction: column; padding: 20px 0;
    }
    .ytv-sidebar-title {
        font-size: 11px; font-weight: 700; color: #94a3b8;
        text-transform: uppercase; letter-spacing: 1px;
        padding: 0 20px 10px; border-bottom: 1px solid #f1f5f9; margin-bottom: 8px;
    }
    .ytv-menu-item {
        display: flex; align-items: center; padding: 13px 20px; gap: 12px;
        color: #475569; font-size: 15px; font-weight: 500; text-decoration: none;
        transition: all 0.2s; border-left: 3px solid transparent; cursor: pointer;
    }
    .ytv-menu-item i { font-size: 17px; width: 22px; text-align: center; color: #94a3b8; }
    .ytv-menu-item:hover, .ytv-menu-item.active {
        background: #eff6ff; border-left-color: var(--ytv-secondary); color: var(--ytv-primary);
    }
    .ytv-menu-item:hover i, .ytv-menu-item.active i { color: var(--ytv-secondary); }

    .ytv-content { flex: 1; background: #f8fafc; padding: 30px; display: flex; flex-direction: column; gap: 25px; }

    .co-so-info-card {
        background: white; border-radius: 16px; overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06); display: flex;
    }
    .co-so-img { width: 280px; flex-shrink: 0; object-fit: cover; }
    .co-so-info-body { padding: 30px; flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 12px; }
    .co-so-name { font-size: 26px; font-weight: 800; color: var(--ytv-primary); line-height: 1.2; }
    .co-so-address { font-size: 15px; color: #64748b; display: flex; align-items: flex-start; gap: 8px; }
    .co-so-address i { color: var(--ytv-secondary); margin-top: 3px; }
    .co-so-tags { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 5px; }
    .co-so-tag {
        background: #eff6ff; color: var(--ytv-primary); font-size: 13px; font-weight: 600;
        padding: 5px 14px; border-radius: 20px; border: 1px solid #bfdbfe;
    }

    .action-buttons { display: flex; gap: 20px; flex-wrap: wrap; }
    .btn-dat-lich {
        display: flex; align-items: center; gap: 12px;
        padding: 18px 40px;
        background: linear-gradient(135deg, #3b82f6, #0ea5e9);
        color: white; font-size: 18px; font-weight: 700; border-radius: 50px;
        text-decoration: none; box-shadow: 0 6px 20px rgba(59,130,246,0.35);
        transition: all 0.3s;
    }
    .btn-dat-lich:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(59,130,246,0.45); color: white; }
    .btn-goi-dien {
        display: flex; align-items: center; gap: 12px;
        padding: 18px 40px;
        background: white; color: var(--ytv-primary); font-size: 18px; font-weight: 700;
        border-radius: 50px; text-decoration: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08); border: 2px solid #bfdbfe; transition: all 0.3s;
    }
    .btn-goi-dien:hover { transform: translateY(-3px); background: #eff6ff; color: var(--ytv-primary); }

    .tab-content-area {
        background: white; border-radius: 16px; padding: 30px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06); min-height: 200px;
    }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    .tab-panel h2 { font-size: 20px; font-weight: 700; color: var(--ytv-primary); margin-bottom: 15px; padding-bottom: 12px; border-bottom: 2px solid #e0f2fe; }
    .tab-panel p { color: #64748b; line-height: 1.8; font-size: 15px; }

    .ytv-footer { background: #e0f2fe; color: #334155; padding: 25px 30px 15px; display: flex; flex-direction: column; border-top: 4px solid var(--ytv-primary); }
    .ytv-footer-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; flex-wrap: wrap; gap: 20px; }
    .ytv-policies-col { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-weight: 500; }
    .ytv-policies-col a { color: #0f172a; text-decoration: none; }
    .ytv-policies-col a:hover { color: var(--ytv-primary); }
    .ytv-policies-col .separator { color: #94a3b8; }
    .ytv-footer-bottom { text-align: center; font-size: 14px; color: #64748b; border-top: 1px solid #bae6fd; padding-top: 15px; }

    @@media (max-width: 768px) {
        .ytv-main { flex-direction: column; }
        .ytv-sidebar { width: 100%; flex-direction: row; overflow-x: auto; padding: 10px 0; border-right: none; border-bottom: 1px solid #e2e8f0; }
        .ytv-menu-item { border-left: none; border-bottom: 3px solid transparent; white-space: nowrap; }
        .co-so-info-card { flex-direction: column; }
        .co-so-img { width: 100%; height: 200px; }
        .action-buttons { flex-direction: column; }
    }
</style>

<div class="ytv-header">
    <a href="/Home/ThongTinBenhNhan" class="ytv-logo-area">
        <img src="/static/logo-yte.png" alt="Logo" style="height:50px;width:50px;object-fit:contain;background:white;border-radius:50%;padding:5px;" />
        <div class="ytv-logo-text">Y TẾ<br>VIỆT</div>
    </a>
    <div class="ytv-header-title">
        <h1>@tenCoSo</h1>
        <p>Thông tin chi tiết cơ sở y tế</p>
    </div>
    <a href="/Home/DanhSachCoSo?type=@type" class="ytv-menu-btn" title="Quay lại">
        <i class="fas fa-arrow-left"></i>
    </a>
</div>

<div class="ytv-main">
    <div class="ytv-sidebar">
        <div class="ytv-sidebar-title">Danh mục</div>
        <a class="ytv-menu-item active" onclick="showTab('gioi-thieu', this)">
            <i class="fas fa-info-circle"></i> Giới thiệu
        </a>
        <a class="ytv-menu-item" onclick="showTab('dich-vu', this)">
            <i class="fas fa-stethoscope"></i> Dịch vụ
        </a>
        <a class="ytv-menu-item" onclick="showTab('doi-ngu', this)">
            <i class="fas fa-user-md"></i> Đội ngũ bác sĩ
        </a>
        <a class="ytv-menu-item" onclick="showTab('tin-tuc', this)">
            <i class="fas fa-newspaper"></i> Tin tức
        </a>
    </div>

    <div class="ytv-content">
        <div class="co-so-info-card">
            <img src="@img" class="co-so-img" alt="@tenCoSo" />
            <div class="co-so-info-body">
                <div class="co-so-name">@tenCoSo</div>
                <div class="co-so-address">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>@diaChi</span>
                </div>
                <div class="co-so-tags">
                    <span class="co-so-tag"><i class="fas fa-clock me-1"></i> 7:00 - 17:00</span>
                    <span class="co-so-tag"><i class="fas fa-star me-1"></i> 4.8 ★</span>
                    <span class="co-so-tag"><i class="fas fa-check-circle me-1"></i> Đã xác minh</span>
                </div>
            </div>
        </div>

        <div class="action-buttons">
            <a href="/DangNhap/Login" class="btn-dat-lich">
                <i class="fas fa-user-plus"></i> Đăng ký
            </a>
            <a href="/DangNhap/Login" class="btn-goi-dien">
                <i class="fas fa-sign-in-alt"></i> Đăng nhập
            </a>
        </div>

        <div class="tab-content-area">
            <div id="gioi-thieu" class="tab-panel active">
                <h2><i class="fas fa-info-circle me-2"></i>Giới thiệu</h2>
                <p>@tenCoSo là một trong những cơ sở y tế uy tín hàng đầu tại khu vực. Được thành lập từ nhiều năm qua, chúng tôi luôn cam kết mang lại dịch vụ chăm sóc sức khỏe chất lượng cao nhất cho người dân.</p>
                <p>Với đội ngũ bác sĩ chuyên khoa giỏi, trang thiết bị hiện đại và quy trình khám bệnh chuyên nghiệp, chúng tôi tự hào là địa chỉ tin cậy cho hàng triệu bệnh nhân.</p>
            </div>
            <div id="dich-vu" class="tab-panel">
                <h2><i class="fas fa-stethoscope me-2"></i>Dịch vụ</h2>
                <p>✅ Khám ngoại trú và nội trú<br>✅ Xét nghiệm máu, nước tiểu, sinh hóa<br>✅ Siêu âm, X-quang, CT scan, MRI<br>✅ Phẫu thuật nội soi và mổ mở<br>✅ Phục hồi chức năng<br>✅ Tư vấn sức khỏe trực tuyến</p>
            </div>
            <div id="doi-ngu" class="tab-panel">
                <h2><i class="fas fa-user-md me-2"></i>Đội ngũ bác sĩ</h2>
                <p>Đội ngũ bác sĩ tại @tenCoSo gồm hơn 50 bác sĩ chuyên khoa với trình độ từ Thạc sĩ đến Tiến sĩ, được đào tạo tại các trường Đại học Y uy tín trong và ngoài nước.</p>
            </div>
            <div id="tin-tuc" class="tab-panel">
                <h2><i class="fas fa-newspaper me-2"></i>Tin tức</h2>
                <p>📰 Cập nhật những tin tức mới nhất về sức khỏe, hoạt động của cơ sở và các chương trình khám bệnh miễn phí đang được triển khai.</p>
            </div>
        </div>
    </div>
</div>

<div class="ytv-footer">
    <div class="ytv-footer-top">
        <div style="font-size:16px;font-weight:500;">
            <div><i class="fas fa-headset me-2"></i> Hỗ trợ: <span style="color:var(--ytv-primary);font-weight:700;font-size:18px;">19008198</span></div>
        </div>
    </div>
    <div class="ytv-footer-bottom">
        Đơn vị phối hợp thực hiện: <strong>Công Ty Phần mềm Vũ Phong - SixOSSoft.com</strong>
    </div>
</div>

<script>
    function showTab(tabId, el) {
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.ytv-menu-item').forEach(m => m.classList.remove('active'));
        document.getElementById(tabId).classList.add('active');
        el.classList.add('active');
    }
</script>
