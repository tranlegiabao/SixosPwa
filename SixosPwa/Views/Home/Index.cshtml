                    <div class="promo-card-overlay">
                        <span class="promo-badge">❤️ Chuyên Gia</span>
                        <p class="promo-title">Trung Tâm Tim Mạch HeartCare</p>
                        <p class="promo-sub">Tầm soát tim · Đặt stent · Nhịp tim</p>
                    </div>
                </div>

                <!-- 8. Tai mũi họng -->
                <div class="promo-card" onclick="openPromo('Phòng Khám Tai Mũi Họng ENT', 'Điều trị viêm xoang, viêm họng, ù tai, khàn giọng.')">
