        /* Khach (chua dang nhap): tu tablet len sidebar da co san danh muc co
           so roi, nut ☰ luc do chi con dan tai khoan trong (khong con gi de
           dang nhap tu day) nen an han — khong phai an co dieu kien theo noi
           dung, la an vi khong con noi dung gi dang mo.
           BAT BUOC visibility:hidden, KHONG duoc display:none: .ytv-header la
           flex justify-content:space-between 3 con (logo/tieu de/nut menu) —
           bo nut menu khoi flow thi tieu de mat doi trong, giat sang han phai. */
        @@media (min-width: 768px) {
            .ytv-header-menu { visibility: hidden !important; }
        }
    </style>
}

<div class="ytv-header">
