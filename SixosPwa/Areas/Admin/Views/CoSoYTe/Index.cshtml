@model CoSoYTeListViewModel
@{
    ViewData["Title"] = "Cơ sở y tế";
    string TypeName(string? type) => type switch { "benhvien" => "Bệnh viện", "pkdk" => "Phòng khám", "nhakhoa" => "Nha khoa", "phongmach" => "Phòng mạch", "nhathuoc" => "Nhà thuốc", _ => "Chưa phân loại" };
}
<div class="page-header-row"><div><div class="page-kicker">NỘI DUNG ỨNG DỤNG</div><h1 class="page-heading">Cơ sở y tế</h1><p class="page-description">Quản lý những địa điểm người dùng có thể tìm kiếm và đăng ký khám.</p></div><a asp-action="Create" class="btn admin-btn-primary"><span>+</span> Thêm cơ sở</a></div>
<div class="admin-panel"><form method="get" class="filter-bar"><div class="search-control"><span>⌕</span><input type="search" name="q" value="@Model.Query" placeholder="Tìm mã hoặc tên cơ sở..." aria-label="Tìm cơ sở y tế" /></div><select name="loaiCS" class="form-select filter-select admin-filter-select" aria-label="Lọc loại cơ sở"><option value="">Tất cả loại</option><option value="benhvien" selected="@(Model.LoaiCS == "benhvien" ? "selected" : null)">Bệnh viện</option><option value="pkdk" selected="@(Model.LoaiCS == "pkdk" ? "selected" : null)">Phòng khám</option><option value="nhakhoa" selected="@(Model.LoaiCS == "nhakhoa" ? "selected" : null)">Nha khoa</option><option value="phongmach" selected="@(Model.LoaiCS == "phongmach" ? "selected" : null)">Phòng mạch</option><option value="nhathuoc" selected="@(Model.LoaiCS == "nhathuoc" ? "selected" : null)">Nhà thuốc</option></select><button class="btn admin-btn-secondary" type="submit">Lọc</button>@if (!string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.LoaiCS)) { <a asp-action="Index" class="clear-filter">Xóa lọc</a> }</form>
    <div class="table-meta"><span><strong>@Model.TotalItems.ToString("N0")</strong> cơ sở y tế</span><span>Chỉ cơ sở đang hiển thị mới lên cổng công khai</span></div>
    <div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead><tr><th>Cơ sở</th><th>Loại hình</th><th>Địa chỉ</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
    @if (Model.Items.Count == 0) { <tr><td colspan="5"><div class="table-empty"><div>+</div><strong>Chưa có cơ sở phù hợp</strong><span>Hãy thêm cơ sở đầu tiên hoặc đổi bộ lọc.</span></div></td></tr> }
    else { foreach (var item in Model.Items) { <tr><td><div class="table-person">@if (!string.IsNullOrWhiteSpace(item.Img)) { <img class="facility-thumb" src="@item.Img" alt="" loading="lazy" /> } else { <span class="facility-thumb facility-placeholder">+</span> }<div><strong>@(item.TenCoSo ?? "Chưa đặt tên")</strong><small>@(item.MaCoSo ?? "Chưa có mã")</small></div></div></td><td><span class="type-badge">@TypeName(item.IdNhomCS.HasValue ? Model.MaNhomTheoId.GetValueOrDefault(item.IdNhomCS.Value) : null)</span></td><td class="text-muted text-truncate-cell">@(item.DiaChi ?? "Chưa cập nhật")</td><td><span class="active-status @(item.Active ? "" : "status-muted")"><i></i>@(item.Active ? "Đang hiển thị" : "Đang ẩn")</span></td><td class="text-end"><div class="table-actions"><a asp-action="Edit" asp-route-id="@item.Id" class="table-action table-action-edit table-action-icon-button" title="Chỉnh sửa" aria-label="Chỉnh sửa"><svg class="table-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-4"></path><path d="m10 15 1.4-4.2L17.8 4.4a2 2 0 0 1 2.8 2.8l-6.4 6.4L10 15Z"></path><path d="m16.4 5.8 2.8 2.8"></path></svg></a><form asp-action="Delete" method="post" data-confirm-facility-delete="Xóa cơ sở này cùng toàn bộ hồ sơ và lịch sử khám của bệnh nhân thuộc cơ sở? Thao tác không thể hoàn tác."><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="confirmed" value="false" /><input type="hidden" name="q" value="@Model.Query" /><input type="hidden" name="loaiCS" value="@Model.LoaiCS" /><input type="hidden" name="page" value="@Model.Page" />@Html.AntiForgeryToken()<button type="submit" class="table-action table-action-danger table-action-icon-button" title="Xóa" aria-label="Xóa"><svg class="table-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M6 7l1 14h10l1-14"></path><path d="M9 7V4h6v3"></path></svg></button></form></div></td></tr> } }
    </tbody></table></div><partial name="_Pagination" model="new PaginationViewModel { Page = Model.Page, TotalPages = Model.TotalPages, Query = Model.Query, LoaiCS = Model.LoaiCS }" />
</div>
