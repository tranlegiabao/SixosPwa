                    loiDan: "Vui lòng nhịn ăn sáng để làm xét nghiệm máu và lấy kết quả trong buổi sáng.",
                    chuyenKhoa: "Khoa Nội Tiết"
                },
                {
                    id: 2,
                    thoiGianHienThi: "Hôm qua • 21:31",
                    ngayIso: `${nam}-09-07`,
                    loai: "nhac-hen",
                    daDoc: false, // Chưa đọc -> Sáng + chữ MỚI
                    noiDung: `Lịch nhắc hẹn: Lịch khám định kỳ Mắt - Phòng 302 của quý khách vào 14:00 ngày 07/09/${nam}. ThS.BS. Hoàng Minh Tuấn phụ trách.`,
                    loiDan: "Kiểm tra thị lực định kỳ và đo nhãn áp.",
                    chuyenKhoa: "Khoa Mắt"
                },
                {
                    id: 3,
                    thoiGianHienThi: "06/09/2026 • 21:30",
                    ngayIso: `${nam}-09-06`,
                    loai: "tai-kham",
                    daDoc: true, // Đã đọc -> Tối hơn tí + tick xanh
                    noiDung: `Thông báo khám: Quý khách đã hoàn thành lịch hẹn khám Tim Mạch lúc 09:30 ngày 06/09/${nam}. BSCKII. Lê Thị Mai. Toa thuốc đã được cập nhật vào hồ sơ.`,
                    loiDan: "Tái khám sau 1 tháng hoặc khi có biểu hiện tức ngực.",
                    chuyenKhoa: "Khoa Tim Mạch"
                },
                {
                    id: 4,
                    thoiGianHienThi: "06/09/2026 • 19:01",
                    ngayIso: `${nam}-09-06`,
                    loai: "nhac-hen",
                    daDoc: true, // Đã đọc -> Tối hơn tí + tick xanh
                    noiDung: `Lịch hẹn khám: Bệnh viện tiếp nhận yêu cầu đặt lịch khám tổng quát ngày 06/09/${nam} lúc 08:00 tại Phòng 101.`,
                    loiDan: "Đến trước 15 phút để lấy số thứ tự ưu tiên.",
                    chuyenKhoa: "Khám Tổng Quát"
                },
                {
                    id: 5,
                    thoiGianHienThi: "02/09/2026 • 08:00",
                    ngayIso: `${nam}-09-02`,
                    loai: "tai-kham",
                    daDoc: true, // Đã đọc -> Tối hơn tí + tick xanh
                    noiDung: `Lịch hẹn khám: Nhắc lịch khám sức khỏe định kỳ lúc 08:00 ngày 02/09/${nam}. Bác sĩ phụ trách: BSCKI. Trần Văn Bình.`,
                    loiDan: "Mang theo sổ khám và thẻ BHYT.",
                    chuyenKhoa: "Khám Tổng Quát"
                }
            ];
        })();

        let cheDoXemTatCaThang = false; // false: Xem theo tuần, true: Xem tất cả các tuần trong tháng
        let offsetThoiGian = 0; // offset tuần (hoặc offset tháng)
        let customKhoangChon = null; // Khi chọn tuần cụ thể từ sheet
        let tuKhoaTimKiemVcb = '';

        function formatIso(dt) {
            const y = dt.getFullYear();
            const m = String(dt.getMonth() + 1).padStart(2, '0');
            const d = String(dt.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function formatVn(dt) {
            const d = String(dt.getDate()).padStart(2, '0');
            const m = String(dt.getMonth() + 1).padStart(2, '0');
            const y = dt.getFullYear();
            return `${d}/${m}/${y}`;
        }

        // Tạo danh sách tất cả các tuần trong tháng
        function layCacTuanTrongThang(nam, thang1Indexed) {
            const firstDayOfMonth = new Date(nam, thang1Indexed - 1, 1);
            const lastDayOfMonth = new Date(nam, thang1Indexed, 0);
            
            const weeks = [];
            let currentMonday = new Date(firstDayOfMonth);
            const dayOfWeek = currentMonday.getDay();
            const diffToMonday = (dayOfWeek === 0 ? -6 : 1) - dayOfWeek;
            currentMonday.setDate(currentMonday.getDate() + diffToMonday);
            currentMonday.setHours(0, 0, 0, 0);

            let weekIndex = 1;
            while (currentMonday <= lastDayOfMonth || (currentMonday.getMonth() === thang1Indexed - 1)) {
                const currentSunday = new Date(currentMonday);
                currentSunday.setDate(currentMonday.getDate() + 6);
                currentSunday.setHours(23, 59, 59, 999);

                if (currentSunday >= firstDayOfMonth && currentMonday <= lastDayOfMonth) {
                    weeks.push({
                        tenTuan: `Tuần ${weekIndex}`,
                        monday: new Date(currentMonday),
                        sunday: new Date(currentSunday),
                        mondayIso: formatIso(currentMonday),
                        sundayIso: formatIso(currentSunday),
                        chuoiHienThi: `${formatVn(currentMonday)} đến ${formatVn(currentSunday)}`
                    });
                    weekIndex++;
                }

                currentMonday.setDate(currentMonday.getDate() + 7);
                if (currentMonday > lastDayOfMonth && currentMonday.getMonth() !== thang1Indexed - 1) {
                    break;
                }
            }
            return weeks;
        }

        function layKhoangThoiGian(offset) {
            if (customKhoangChon) {
                return customKhoangChon;
            }

            const homNay = new Date();

            if (cheDoXemTatCaThang) {
                // Chế độ xem cả tháng: Lấy từ ngày 1 đến ngày cuối tháng
                const targetMonth = new Date(homNay.getFullYear(), homNay.getMonth() + offset, 1);
                const startMonth = new Date(targetMonth.getFullYear(), targetMonth.getMonth(), 1);
                const endMonth = new Date(targetMonth.getFullYear(), targetMonth.getMonth() + 1, 0);
                endMonth.setHours(23, 59, 59, 999);

                const mStr = String(startMonth.getMonth() + 1).padStart(2, '0');
                const yStr = startMonth.getFullYear();

                return {
                    startIso: formatIso(startMonth),
                    endIso: formatIso(endMonth),
                    chuoiHienThi: `Tháng ${mStr}/${yStr} (01/${mStr} đến ${String(endMonth.getDate()).padStart(2, '0')}/${mStr}/${yStr})`
                };
            } else {
                // Chế độ xem theo tuần: Lấy Thứ Hai đến Chủ Nhật
                const dayOfWeek = homNay.getDay();
                const diffToMonday = (dayOfWeek === 0 ? -6 : 1) - dayOfWeek;
                
                const monday = new Date(homNay);
                monday.setDate(homNay.getDate() + diffToMonday + (offset * 7));
                monday.setHours(0, 0, 0, 0);

                const sunday = new Date(monday);
                sunday.setDate(monday.getDate() + 6);
                sunday.setHours(23, 59, 59, 999);

                return {
                    startIso: formatIso(monday),
                    endIso: formatIso(sunday),
                    chuoiHienThi: `${formatVn(monday)} đến ${formatVn(sunday)}`
                };
            }
        }

        function moSheetChonTuan() {
            const homNay = new Date();
            const nam = homNay.getFullYear();
            const thang = homNay.getMonth() + 1;
            
            const sheetTenThang = document.getElementById('vcbSheetTenThang');
            if (sheetTenThang) {
                sheetTenThang.innerText = `Tháng ${String(thang).padStart(2, '0')}/${nam}`;
            }

            const danhsachContainer = document.getElementById('vcbSheetDanhSachTuan');
            if (!danhsachContainer) return;

            const cacTuan = layCacTuanTrongThang(nam, thang);
            const khoangHienTai = layKhoangThoiGian(offsetThoiGian);
            const dsNotif = window.danhSachThongBaoLich;

            const startThangIso = `${nam}-${String(thang).padStart(2, '0')}-01`;
            const endThangIso = formatIso(new Date(nam, thang, 0));
            const soLuongCaThang = dsNotif.filter(x => x.ngayIso >= startThangIso && x.ngayIso <= endThangIso).length;

            let html = `
                <!-- Tùy chọn 1: Xem tất cả các tuần trong tháng -->
                <div class="vcb-sheet-item tat-ca ${cheDoXemTatCaThang ? 'active' : ''}" onclick="chonTuSheet('tat-ca-thang')">
                    <div class="vcb-sheet-item-trai">
                        <span class="vcb-sheet-icon">🌟</span>
                        <div>
                            <div class="vcb-sheet-ten">Xem tất cả các tuần trong tháng</div>
                            <div class="vcb-sheet-khoang">01/${String(thang).padStart(2,'0')} đến ${String(new Date(nam, thang, 0).getDate()).padStart(2,'0')}/${String(thang).padStart(2,'0')}/${nam}</div>
                        </div>
                    </div>
                    <span class="vcb-sheet-dem">${soLuongCaThang} lịch hẹn</span>
                </div>
            `;

            // Tùy chọn từng tuần
            const homNayIso = formatIso(homNay);
            cacTuan.forEach((tuan, idx) => {
                const isActive = !cheDoXemTatCaThang && (khoangHienTai.startIso === tuan.mondayIso);
                const isTuanNay = (homNayIso >= tuan.mondayIso && homNayIso <= tuan.sundayIso);
                const soLuongTuan = dsNotif.filter(x => x.ngayIso >= tuan.mondayIso && x.ngayIso <= tuan.sundayIso).length;

                html += `
                    <div class="vcb-sheet-item ${isActive ? 'active' : ''}" onclick="chonTuSheet('tuan', '${tuan.mondayIso}', '${tuan.sundayIso}', '${tuan.chuoiHienThi}')">
                        <div class="vcb-sheet-item-trai">
                            <span class="vcb-sheet-icon">📅</span>
                            <div>
                                <div class="vcb-sheet-ten">
                                    ${tuan.tenTuan}
                                    ${isTuanNay ? '<span class="vcb-sheet-badge-nay">Tuần này</span>' : ''}
                                </div>
                                <div class="vcb-sheet-khoang">${tuan.chuoiHienThi}</div>
                            </div>
                        </div>
                        <span class="vcb-sheet-dem">${soLuongTuan} lịch hẹn</span>
                    </div>
                `;
            });

            danhsachContainer.innerHTML = html;
            document.getElementById('vcbSheetChonTuan').style.display = 'flex';
        }

        function dongSheetChonTuan() {
            document.getElementById('vcbSheetChonTuan').style.display = 'none';
        }

        function chonTuSheet(loai, mondayIso, sundayIso, chuoiHienThi) {
            if (loai === 'tat-ca-thang') {
                cheDoXemTatCaThang = true;
                customKhoangChon = null;
                offsetThoiGian = 0;
                
                const btn = document.getElementById('vcbBtnXemTatCa');
                const textEl = document.getElementById('vcbTextTatCa');
                if (btn) btn.classList.add('active');
                if (textEl) textEl.innerText = 'Đang xem tất cả tháng (Bấm để chọn lại)';
            } else {
                cheDoXemTatCaThang = false;
                customKhoangChon = {
                    startIso: mondayIso,
                    endIso: sundayIso,
                    chuoiHienThi: chuoiHienThi
                };

                const btn = document.getElementById('vcbBtnXemTatCa');
                const textEl = document.getElementById('vcbTextTatCa');
                if (btn) btn.classList.remove('active');
                if (textEl) textEl.innerText = 'Xem tất cả các tuần trong tháng';
            }

            dongSheetChonTuan();
            capNhatKhoangThoiGianUi();
            renderDanhSachVcb();
        }

        function capNhatKhoangThoiGianUi() {
            const khoang = layKhoangThoiGian(offsetThoiGian);
            const el = document.getElementById('vcbChuoiKhoangNgay');
            if (el) {
                el.innerText = khoang.chuoiHienThi;
            }
        }

        function chuyenKhoangThoiGian(direction) {
            customKhoangChon = null; // Khi bấm nút mũi tên thì chuyển theo tuần tự
            offsetThoiGian += direction;
            capNhatKhoangThoiGianUi();
            renderDanhSachVcb();
        }

        function capNhatBadgeChuaDoc() {
            const soChuaDoc = window.danhSachThongBaoLich.filter(x => !x.daDoc).length;
            const badgeEl = document.getElementById('vcbBadgeChuaDoc');
            
            if (badgeEl) {
                badgeEl.innerText = soChuaDoc;
                badgeEl.style.display = soChuaDoc > 0 ? 'inline-block' : 'none';
            }
        }

        function renderDanhSachVcb() {
            const container = document.getElementById('vcbDanhSachThongBao');
            if (!container) return;

            const khoang = layKhoangThoiGian(offsetThoiGian);
            let ds = window.danhSachThongBaoLich;

            // 1. Lọc theo khoảng thời gian đang chọn (tuần hoặc toàn bộ tháng)
            ds = ds.filter(x => x.ngayIso >= khoang.startIso && x.ngayIso <= khoang.endIso);

            // 2. Lọc theo Từ khóa tìm kiếm nếu có
            if (tuKhoaTimKiemVcb.trim() !== '') {
                const kw = tuKhoaTimKiemVcb.toLowerCase();
                ds = ds.filter(x => x.noiDung.toLowerCase().includes(kw) || 
                                    x.thoiGianHienThi.toLowerCase().includes(kw) || 
                                    (x.loiDan && x.loiDan.toLowerCase().includes(kw)));
            }

            container.innerHTML = '';

            if (ds.length === 0) {
                const thongBaoRong = cheDoXemTatCaThang 
                    ? "Không có thông báo lịch hẹn nào trong tháng này"
                    : "Không có thông báo lịch hẹn trong tuần này";
                container.innerHTML = `<div class="vcb-trang-rong">${thongBaoRong}</div>`;
                capNhatBadgeChuaDoc();
                return;
            }

            ds.forEach(item => {
                const card = document.createElement('div');
                // Chưa đọc: class 'chua-doc' (Sáng + Chữ MỚI) | Đã đọc: class 'da-doc' (Tối hơn tí + Tick xanh)
                card.className = `vcb-the-thong-bao ${item.daDoc ? 'da-doc' : 'chua-doc'}`;
                card.setAttribute('role', 'button');
                card.setAttribute('tabindex', '0');
                
                // Khi nhấn vào xem -> Đánh dấu đã đọc và chuyển màu tối hơn
                card.onclick = () => xuLyXemThongBao(item.id);
                card.onkeydown = (e) => { if (e.key === 'Enter') xuLyXemThongBao(item.id); };

                const badgeHtml = !item.daDoc 
                    ? `<span class="vcb-badge-moi">MỚI</span>` 
                    : `<span class="vcb-tick-da-doc" title="Đã xem">✔✔</span>`;

                card.innerHTML = `
                    <div class="vcb-the-dau">
                        <span class="vcb-thoi-gian">${item.thoiGianHienThi}</span>
                        ${badgeHtml}
                    </div>
                    <div class="vcb-noi-dung-text">
                        ${item.noiDung}
                    </div>
                    ${item.loiDan ? `
                        <div class="vcb-loi-dan-box">
                            <strong>📌 Lời dặn:</strong> ${item.loiDan}
                        </div>
                    ` : ''}
                    <div class="vcb-the-chan">
                        <span class="vcb-khoa-bac-si">🏥 ${item.chuyenKhoa}</span>
                        <span>${item.daDoc ? 'Đã xem' : 'Chạm để xem'}</span>
                    </div>
                `;

                container.appendChild(card);
            });

            capNhatBadgeChuaDoc();
        }

        // Khi người dùng bấm vào xem thẻ thông báo
        function xuLyXemThongBao(id) {
            const item = window.danhSachThongBaoLich.find(x => x.id === id);
            if (item) {
                // Đổi trạng thái thành ĐÃ ĐỌC (Tối hơn một tí, mất chữ MỚI)
                item.daDoc = true;
                renderDanhSachVcb();
            }
        }

        // Đánh dấu tất cả đã đọc
        function danhDauTatCaDaDoc() {
            window.danhSachThongBaoLich.forEach(item => item.daDoc = true);
            renderDanhSachVcb();
        }

        function timKiemThongBaoVcb(value) {
            tuKhoaTimKiemVcb = value;
            renderDanhSachVcb();
        }

        function moModalLichHen() {
            capNhatKhoangThoiGianUi();
            renderDanhSachVcb();
            document.getElementById('modalLichHen').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function dongModalLichHen() {
            document.getElementById('modalLichHen').style.display = 'none';
            document.body.style.overflow = '';
        }

        function xuLyBamNgoaiModal(e) {
            if (e.target.id === 'modalLichHen') {
                dongModalLichHen();
            }
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (document.getElementById('vcbSheetChonTuan') && document.getElementById('vcbSheetChonTuan').style.display === 'flex') {
                    dongSheetChonTuan();
                } else {
                    dongModalLichHen();
                }
            }
        });
    </script>
</body>
</html>
