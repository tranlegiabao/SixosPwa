@section Scripts {
    <script>
        async function sendSmsDemo() {
            try {
                const response = await fetch('/Home/GuiTinNhan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        message: "test api gửi tin nhắn",
                        danhSachNguoiNhan: ["@ViewData["UserName"]"]
                    })
                });

                const data = await response.json();
                if (data.success) {
                    const toastEl = document.getElementById('bookingToast');
                    document.getElementById('toastMessage').innerHTML = `💬 <strong>Gửi tin thành công!</strong><br/>${data.message}<br/><small class="text-white-50">${data.details}</small>`;
                    const toast = new bootstrap.Toast(toastEl);
                    toast.show();
                } else {
                    alert("Lỗi: " + data.message);
                }
            } catch (err) {
                console.error(err);
                alert("Lỗi kết nối máy chủ!");
            }
        }

        function selectPackage(packageName) {
            document.getElementById('cboGoiKham').value = packageName;
            var myModal = new bootstrap.Modal(document.getElementById('modalDangKyKham'));
            myModal.show();
        }

        function submitBooking() {
            const goiKham = document.getElementById('cboGoiKham').value;
            const ngayKham = document.getElementById('txtNgayKham').value;
            const gioKham = document.getElementById('cboGioKham').value;

            // Đóng Modal
            const modalEl = document.getElementById('modalDangKyKham');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            // Hiển thị Toast thông báo
            const toastEl = document.getElementById('bookingToast');
            document.getElementById('toastMessage').innerHTML = `🎉 <strong>Đăng ký thành công!</strong><br/>${goiKham} vào ${gioKham} ngày ${ngayKham}. Nhân viên y tế sẽ gọi xác nhận!`;
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        function showAppointmentDetail() {
            alert("📋 CHI TIẾT PHIẾU HẸN KHÁM:\n\n- Mã Phiếu: KSK-2026-9902\n- Gói Khám: Khám Sức Khỏe Tổng Quát\n- Thời gian: 08:30 AM - 15/08/2026\n- Địa điểm: Phòng 302, Lầu 3, Bệnh viện HisSoft.\n\nVui lòng mang theo CCCD và thẻ BHYT khi tới khám.");
        }

        function cancelAppointment() {
            if (confirm("Bạn có chắc chắn muốn hủy lịch khám này không?")) {
                alert("Đã hủy lịch khám thành công!");
            }
        }

        function viewReport(maPhieu) {
            alert(`📄 Đang mở Hồ sơ Kết quả Khám sức khỏe mã phiếu [${maPhieu}]...\nChỉ số sức khỏe bình thường, không phát hiện bất thường.`);
        }

        // ============================================
        // PROMO CARDS — Mở modal chi tiết cơ sở y tế
        // ============================================
        function openPromo(title, description) {
            document.getElementById('promoModalTitle').textContent = title;
            document.getElementById('promoModalBody').textContent = description;
            var modal = new bootstrap.Modal(document.getElementById('promoModal'));
            modal.show();
        }

        // ============================================
        // PROMO DOTS — Chấm cuộn theo track
        // ============================================
        (function initPromoDots() {
            const track = document.getElementById('promoTrack');
            const dotsContainer = document.getElementById('promoDots');
            if (!track || !dotsContainer) return;

            const cards = track.querySelectorAll('.promo-card');
            const total = cards.length;

            // Tạo dots
            for (let i = 0; i < total; i++) {
                const dot = document.createElement('span');
                if (i === 0) dot.classList.add('active');
                dotsContainer.appendChild(dot);
            }

            const dots = dotsContainer.querySelectorAll('span');

            // Cập nhật dot active khi cuộn
            track.addEventListener('scroll', () => {
                const scrollLeft = track.scrollLeft;
                const cardWidth = cards[0].offsetWidth + 14; // 14 = gap
                const activeIndex = Math.round(scrollLeft / cardWidth);
                dots.forEach((d, idx) => {
                    d.classList.toggle('active', idx === activeIndex);
                });
                // Ẩn/hiện mũi tên khi ở đầu/cuối
                const arrowLeft = document.getElementById('promoArrowLeft');
                const arrowRight = document.getElementById('promoArrowRight');
                if (arrowLeft) arrowLeft.style.opacity = scrollLeft <= 10 ? '0.35' : '1';
                if (arrowRight) arrowRight.style.opacity = scrollLeft >= track.scrollWidth - track.clientWidth - 10 ? '0.35' : '1';
            }, { passive: true });

            // Ẩn mũi tên trái ban đầu
            const initArrowLeft = document.getElementById('promoArrowLeft');
            if (initArrowLeft) initArrowLeft.style.opacity = '0.35';
        })();

        // ============================================
        // PROMO SCROLL — Nút mũi tên trái/phải
        // ============================================
        function promoScroll(dir) {
            const track = document.getElementById('promoTrack');
            if (!track) return;
            const cards = track.querySelectorAll('.promo-card');
            if (!cards.length) return;
            const cardWidth = cards[0].offsetWidth + 14; // 14px gap
            track.scrollBy({ left: dir * cardWidth, behavior: 'smooth' });
        }
    </script>
}

