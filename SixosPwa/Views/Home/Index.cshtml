            <h5 class="fw-bold text-dark mb-0">📜 Lịch Sử Kết Quả Khám Bệnh</h5>
        </div>
        <div class="card-body px-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Phiếu</th>
                            <th>Ngày Khám</th>
