@model SixosPwa.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Quản lý dữ liệu";
}

<style>
    .admin-content {
        padding: 15px 15px var(--admin-footer-space) 15px !important;
        max-width: 100% !important;
    }
    .textarea-container {
        max-width: 990px;
    }
</style>

<div class="card shadow-sm border-0 rounded-3 w-100 h-100" style="border: 1px solid #e2e8f0 !important; background: #ffffff;">
    <div class="card-body p-4 p-lg-5">
    @* Nam sua 2026-08-22: truoc day nut "Luu" khong nam trong form nao va khong co
       action POST -> noi dung soan xong bay mat. Boc form + antiforgery. *@
    <form id="frmNoiDungCoSo" asp-area="Admin" asp-controller="Dashboard" asp-action="SaveContent" method="post">
        @Html.AntiForgeryToken()
        <div class="row gx-4 gx-lg-5 mb-4">
            <div class="col-md-5">
                <div class="d-flex align-items-center mb-4">
                    <label class="form-label mb-0 me-3 fw-bold text-nowrap text-secondary" style="min-width: 130px; font-size: 15px;">Nhóm KH</label>
                    <select id="cboNhomKH" class="form-select border-secondary-subtle" onchange="window.updatePKDropdown && window.updatePKDropdown()">
                        <option value="">-- Chọn nhóm --</option>
                        @foreach (var item in Model.NhomCSList)
                        {
                            <option value="@item.ID" data-loaics="@item.LoaiCS">@item.TenLoaiCS</option>
                        }
                    </select>
                </div>
                
                <div class="d-flex align-items-center mb-0">
                    <label class="form-label mb-0 me-3 fw-bold text-nowrap text-secondary" style="min-width: 130px; font-size: 15px;">PK từ nhóm KH</label>
                    <select id="cboPhongKham" name="FacilityId" class="form-select border-secondary-subtle" disabled onchange="window.onPhongKhamChange && window.onPhongKhamChange()">
                        <option value="">-- Chọn phòng khám --</option>
                        @foreach (var item in Model.FacilityList)
                        {
                            <option value="@item.Id" data-loaics="@item.LoaiCS">@item.TenCoSo</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-7">
                <div class="d-flex align-items-center">
                    <label class="form-label mb-0 me-3 fw-bold text-nowrap text-secondary" style="min-width: 70px; font-size: 15px;">Chủ đề</label>
                    <select id="cboChuDe" name="TopicId" class="form-select me-3 border-secondary-subtle" disabled onchange="window.napNoiDung && window.napNoiDung()">
                        <option value="">-- Chọn chủ đề --</option>
                        @foreach (var item in Model.ChuDeList)
                        {
                            <option value="@item.ID">@item.TenChuDe</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">Lưu</button>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-12 textarea-container">
                <textarea id="tinyNoiDung" class="form-control" name="NoiDung"></textarea>
            </div>
        </div>
    </form>
    </div>
</div>

@section Scripts {
@* Nam sua 2026-08-22: bo jQuery CDN (layout da nap o _AdminLayout.cshtml:99 - nap lai
   lam mat binding cua TomSelect) va bo Summernote CDN. Doi sang TinyMCE SELF-HOST vi
   app chay noi bo, khong duoc phu thuoc CDN. Thu vien chep tu TTTBSixOs (v6.4.2). *@
<script src="~/dist/libs/tinymce/tinymce.min.js"></script>

<script>
    var SELECTED_FACILITY_ID = '@(Model.SelectedFacilityId?.ToString() ?? "")';
    var SELECTED_TOPIC_ID = '@(Model.SelectedTopicId?.ToString() ?? "")';

    // Khuon init bam theo TTTBSixOs/Views/Home/ThemThongBao.cshtml:24-49.
    // Khac biet: TTTB KHONG co upload anh, phan images_upload_handler la viet moi.
    tinymce.init({
        selector: '#tinyNoiDung',
        height: 450,
        menubar: false,
        branding: false,
        promotion: false,
        license_key: 'gpl',
        // Khong dat language: 'vi' - ban chep tu TTTB KHONG co thu muc langs/,
        // dat vao se 404 va TinyMCE nem canh bao. Giao dien giu tieng Anh.
        plugins: 'advlist autolink lists link image table code',
        toolbar: 'undo redo | bold italic underline | bullist numlist | ' +
                 'alignleft aligncenter alignright | table image link | ' +
                 'forecolor backcolor removeformat | code',
        // Chan dan anh base64 - se lam phinh cot NoiDung (nvarchar(max)) va
        // vuot ValueLengthLimit (~4 MB) cua model binder khi POST.
        paste_data_images: false,
        automatic_uploads: true,
        // init la BAT DONG BO: neu khoiPhucLuaChon() chay truoc khi editor san sang
        // thi tinymce.get() tra null va noi dung cu khong duoc nap. Goi lai o day.
        init_instance_callback: function () {
            if (window.napNoiDung) window.napNoiDung();
        },
        images_upload_handler: function (blobInfo) {
            return new Promise(function (resolve, reject) {
                var form = new FormData();
                form.append('file', blobInfo.blob(), blobInfo.filename());
                var token = document.querySelector('#frmNoiDungCoSo input[name="__RequestVerificationToken"]');
                if (token) form.append('__RequestVerificationToken', token.value);

                fetch('@Url.Action("UploadImage", "Dashboard", new { area = "Admin" })', {
                    method: 'POST',
                    body: form
                })
                .then(function (res) { return res.json(); })
                .then(function (json) {
                    // TinyMCE doi khoa "location". Loi thi tra khoa "error".
                    if (json && json.location) { resolve(json.location); }
                    else { reject({ message: (json && json.error) || 'Tải ảnh thất bại.', remove: true }); }
                })
                .catch(function () { reject({ message: 'Không kết nối được máy chủ.', remove: true }); });
            });
        }
    });

    // BAT BUOC: khong triggerSave thi textarea van rong -> luu ra chuoi trong.
    document.getElementById('frmNoiDungCoSo').addEventListener('submit', function () {
        tinymce.triggerSave();
    });

    // Nap lai noi dung da luu vao editor khi doi phong kham / chu de.
    window.napNoiDung = function () {
        var pk = document.getElementById('cboPhongKham');
        var cd = document.getElementById('cboChuDe');
        var ed = tinymce.get('tinyNoiDung');
        if (!pk || !cd || !ed) return;
        if (!pk.value || !cd.value) { ed.setContent(''); return; }

        fetch('@Url.Action("GetContent", "Dashboard", new { area = "Admin" })'
              + '?facilityId=' + encodeURIComponent(pk.value)
              + '&topicId=' + encodeURIComponent(cd.value))
            .then(function (res) { return res.ok ? res.json() : { noiDung: '' }; })
            .then(function (json) { ed.setContent((json && json.noiDung) || ''); })
            .catch(function () {
                if (window.showToast) showToast('Không tải được nội dung đã lưu.', 'danger');
            });
    };

    var originalPKOptions = [];

    function backupOptions() {
        if (originalPKOptions.length > 0) return;
        var cboPhongKham = document.getElementById("cboPhongKham");
        if (cboPhongKham) {
            var hasDbOptions = false;
            var optionsToBackup = [];
            for (var i = 0; i < cboPhongKham.options.length; i++) {
                var opt = cboPhongKham.options[i];
                if (opt.value !== "") {
                    hasDbOptions = true;
                }
                optionsToBackup.push({
                    value: opt.value,
                    text: opt.text,
                    loaiCS: opt.getAttribute("data-loaics")
                });
            }
            if (hasDbOptions) {
                originalPKOptions = optionsToBackup;
            }
        }
    }

    window.updatePKDropdown = function() {
        var cboNhomKH = document.getElementById("cboNhomKH");
        var cboPhongKham = document.getElementById("cboPhongKham");
        var cboChuDe = document.getElementById("cboChuDe");
        
        if(!cboNhomKH || !cboPhongKham || !cboChuDe) return;

        // Backup options from DOM on first run
        backupOptions();

        var selectedOpt = cboNhomKH.options[cboNhomKH.selectedIndex];
        var loaiCS = selectedOpt ? selectedOpt.getAttribute("data-loaics") : null;
        if (loaiCS) loaiCS = loaiCS.trim().toLowerCase();

        var placeholderOption = { value: "", text: "-- Chọn phòng khám --" };

        if (!loaiCS || loaiCS === "") {
            // Update cboPhongKham DOM & TomSelect
            updateSelectUI(cboPhongKham, [placeholderOption], true);
            
            // Disable cboChuDe
            cboChuDe.value = "";
            cboChuDe.disabled = true;
            if (cboChuDe.tomselect) {
                cboChuDe.tomselect.clear();
                cboChuDe.tomselect.disable();
            }
        } else {
            // Filter matched options from backup
            var matched = [];
            if (originalPKOptions.length > 0) {
                matched = originalPKOptions.filter(function(opt) {
                    if (opt.value === "") return false;
                    return opt.loaiCS && opt.loaiCS.trim().toLowerCase() === loaiCS;
                });
            }
            
            var newOptions = [placeholderOption].concat(matched);
            updateSelectUI(cboPhongKham, newOptions, false);
        }
    };

    function updateSelectUI(selectEl, options, isDisabled) {
        // 1. Update standard select element
        selectEl.innerHTML = "";
        options.forEach(function(opt) {
            var newOpt = document.createElement("option");
            newOpt.value = opt.value;
            newOpt.text = opt.text;
            if (opt.loaiCS) {
                newOpt.setAttribute("data-loaics", opt.loaiCS);
            }
            selectEl.appendChild(newOpt);
        });
        selectEl.value = "";
        selectEl.disabled = isDisabled;

        // 2. Sync with TomSelect if initialized on this element
        if (selectEl.tomselect) {
            var ts = selectEl.tomselect;
            
            ts.clearOptions();
            ts.clear();
            
            options.forEach(function(opt) {
                ts.addOption({
                    value: opt.value,
                    text: opt.text
                });
            });
            
            if (isDisabled) {
                ts.disable();
            } else {
                ts.enable();
            }
        }
    }

    window.onPhongKhamChange = function() {
        var cboPhongKham = document.getElementById("cboPhongKham");
        var cboChuDe = document.getElementById("cboChuDe");
        if (cboPhongKham && cboChuDe) {
            var isDisabled = (cboPhongKham.value === "");
            cboChuDe.disabled = isDisabled;
            if (cboChuDe.tomselect) {
                if (isDisabled) {
                    cboChuDe.tomselect.clear();
                    cboChuDe.tomselect.disable();
                } else {
                    cboChuDe.tomselect.enable();
                }
            }
        }
        // Nam sua 2026-08-22: doi phong kham thi nap lai noi dung tuong ung.
        if (window.napNoiDung) window.napNoiDung();
    };

    // Nam sua 2026-08-22: sau khi Luu (POST-redirect-GET) phai chon lai dung
    // phong kham / chu de cu, neu khong admin phai chon lai tu dau moi lan luu.
    // Phai chay SAU updatePKDropdown vi ham do reset selectEl.value = "".
    function khoiPhucLuaChon() {
        if (!SELECTED_FACILITY_ID) return;

        var cboNhomKH = document.getElementById("cboNhomKH");
        var cboPhongKham = document.getElementById("cboPhongKham");
        var cboChuDe = document.getElementById("cboChuDe");
        if (!cboNhomKH || !cboPhongKham || !cboChuDe) return;

        // Tim nhom KH chua phong kham nay (dua vao ban sao goc truoc khi bi loc).
        var pkGoc = originalPKOptions.filter(function (o) { return o.value === SELECTED_FACILITY_ID; })[0];
        if (pkGoc && pkGoc.loaiCS) {
            for (var i = 0; i < cboNhomKH.options.length; i++) {
                var ls = cboNhomKH.options[i].getAttribute("data-loaics");
                if (ls && ls.trim().toLowerCase() === pkGoc.loaiCS.trim().toLowerCase()) {
                    cboNhomKH.selectedIndex = i;
                    if (cboNhomKH.tomselect) cboNhomKH.tomselect.setValue(cboNhomKH.value, true);
                    break;
                }
            }
            window.updatePKDropdown();
        }

        cboPhongKham.value = SELECTED_FACILITY_ID;
        if (cboPhongKham.tomselect) cboPhongKham.tomselect.setValue(SELECTED_FACILITY_ID, true);

        cboChuDe.disabled = false;
        if (cboChuDe.tomselect) cboChuDe.tomselect.enable();
        if (SELECTED_TOPIC_ID) {
            cboChuDe.value = SELECTED_TOPIC_ID;
            if (cboChuDe.tomselect) cboChuDe.tomselect.setValue(SELECTED_TOPIC_ID, true);
        }

        if (window.napNoiDung) window.napNoiDung();
    }

    function khoiTaoManHinh() {
        window.updatePKDropdown();
        khoiPhucLuaChon();
    }

    document.addEventListener("DOMContentLoaded", khoiTaoManHinh);
    if (document.readyState === "complete" || document.readyState === "interactive") {
        khoiTaoManHinh();
    }
</script>
}

