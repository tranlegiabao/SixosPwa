<script>
    function toggleMenu() {
        var menu = document.getElementById("dropdownMenu");
        menu.classList.toggle("open");
    }

    // ===== AUTO-PLAY AD CAROUSEL =====
    document.addEventListener("DOMContentLoaded", function() {
        var slides = document.querySelectorAll('.ad-slide');
        var dotsEl = document.getElementById('adDots');
        var current = 0;
        var timer = null;
        var total = slides.length;

        // Tạo dots
        for (var i = 0; i < total; i++) {
            var d = document.createElement('span');
            d.style.cssText = 'width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,0.45);display:inline-block;cursor:pointer;transition:all .3s;';
            if (i === 0) { d.style.background = '#fff'; d.style.width = '24px'; d.style.borderRadius = '4px'; }
            (function(idx) {
                d.addEventListener('click', function() { goTo(idx); resetTimer(); });
            })(i);
            dotsEl.appendChild(d);
        }
        var dots = dotsEl.querySelectorAll('span');

        function goTo(idx) {
            slides[current].style.opacity = '0';
            dots[current].style.background = 'rgba(255,255,255,0.45)';
            dots[current].style.width = '8px';
            dots[current].style.borderRadius = '50%';
            current = (idx + total) % total;
            slides[current].style.opacity = '1';
            dots[current].style.background = '#fff';
            dots[current].style.width = '24px';
            dots[current].style.borderRadius = '4px';
        }

        function startTimer() {
            timer = setInterval(function() { goTo(current + 1); }, 3500);
        }
        function resetTimer() {
            clearInterval(timer);
            startTimer();
        }
        startTimer();

        // Gán nút mũi tên
        window.adNext = function() { goTo(current + 1); resetTimer(); };
        window.adPrev = function() { goTo(current - 1); resetTimer(); };

        // Close dropdown khi click ngoài
        var menuBtn = document.getElementById("menuBtn");
        if (menuBtn) {
            menuBtn.addEventListener("mouseleave", function() {
                var menu = document.getElementById("dropdownMenu");
                if (menu) menu.classList.remove("open");
            });
        }
    });

    window.onclick = function(event) {
        if (!event.target.closest('#menuBtn')) {
            var dropdowns = document.getElementsByClassName("ytv-dropdown");
            for (var i = 0; i < dropdowns.length; i++) {
                if (dropdowns[i].classList.contains('open')) dropdowns[i].classList.remove('open');
            }
        }
    }

    function ttnOpen(title, desc) {
        alert('🏥 ' + title + '\n\n' + desc + '\n\nHotline đặt lịch: 0901 87 88 96');
    }
</script>
