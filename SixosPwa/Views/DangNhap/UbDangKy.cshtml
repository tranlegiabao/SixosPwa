        border-color: #206bc4;
        box-shadow: 0 0 0 0.25rem rgba(32, 107, 196, 0.25);
        background-color: #f8faff;
    }

    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .btn-primary {
        background: linear-gradient(180deg, #0f62c9 0%, #064497 100%);
        border: 1.5px solid transparent;
        font-weight: 600;
        font-size: 1rem;
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        color: #fff;
        transition: all 0.2s ease;
        box-shadow: 0 4px 14px rgba(6, 68, 151, 0.28);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-primary:hover {
        background: linear-gradient(180deg, #0d54ae 0%, #043477 100%);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(6, 68, 151, 0.38);
    }

    .btn-outline-primary {
        background-color: transparent;
        border: 1.5px solid transparent;
        color: #0f62c9 !important;
        font-weight: 700;
        font-size: 1rem;
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-outline-primary:hover {
        background-color: transparent;
        border-color: #0f62c9;
        color: #0f62c9 !important;
    }

    .text-primary {
        color: #206bc4 !important;
        font-weight: 700 !important;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .text-primary:hover {
        color: #004085 !important;
        text-decoration: underline;
    }

    .fw-semibold.text-primary {
        color: #fff !important;
    }

    .fw-semibold.text-primary a,
    a.fw-semibold.text-primary,
    a.text-primary {
        color: #206bc4 !important;
        background: none !important;
        text-shadow: none !important;
    }

    .form-footer {
        margin-top: 1.5rem;
    }

    .side-image-col {
        background: linear-gradient(rgba(32, 107, 196, 0.8), rgba(0, 64, 133, 0.8)), url('https://benhvienungbuou.vn/wp-content/uploads/2023/02/DSC04179-scaled.jpg') no-repeat center center;
        background-size: cover;
        border-radius: 20px 0 0 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        position: relative;
        min-width: 0;
        max-width: 100%;
        width: 100%;
        height: auto;
        max-height: 97vh;
        overflow-y: auto;
        margin-right: 8px;
        padding: 0;
        flex: 1 1 0;
    }

    .row.g-3 {
        --bs-gutter-x: 1.5rem;
        --bs-gutter-y: 1rem;
    }

    .form-control.password-input-style {
        background-color: #e6f0ff;
        border-color: #a0c3f5;
    }

    .form-control.password-input-style:focus {
        background-color: #d9e7ff;
        border-color: #0056b3;
        box-shadow: 0 0 0 0.25rem rgba(0, 86, 179, 0.25);
    }

    .form-label.password-label-style {
        color: #004085;
        font-weight: 700;
    }

    .text-white.p-4 {
        padding: 6px 2px 6px 2px !important;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        background: rgba(32, 107, 196, 0.10);
        border-radius: 18px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
        display: block;
        max-height: 97vh;
        overflow-y: auto;
    }



    .display-6 {
        margin-bottom: 8px !important;
    }

    .info__branch {
        background-color: #4d72ff;
        border: 5px solid #a0caef;
    }

    .cbGioiTinh .ts-control {
        padding-left: 2.5rem !important;
        padding: 1rem !important;
    }

    #autoCarousel .carousel-control-prev,
    #autoCarousel .carousel-control-next {
        width: 40px;
        height: 40px;
        top: 50%;
        transform: translateY(-50%);
        background: #fff;
        border-radius: 50%;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
        opacity: 0.95;
        border: 1px solid #206bc4;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
    }

    #autoCarousel .carousel-control-prev {
        right: auto;
    }

    #autoCarousel .carousel-control-next {
        left: auto;
    }

    #autoCarousel .carousel-control-prev-icon,
    #autoCarousel .carousel-control-next-icon {
        background-size: 70% 70%;
        filter: none;
        background-color: transparent;
        width: 40px;
        height: 40px;
    }

    #autoCarousel .carousel-control-prev-icon {
        background-image: url('data:image/svg+xml;utf8,<svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M15 6l-6 6l6 6" /></svg>');
    }

    #autoCarousel .carousel-control-next-icon {
        background-image: url('data:image/svg+xml;utf8,<svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6" /></svg>');
    }

    #autoCarousel .carousel-control-prev,
    #autoCarousel .carousel-control-next {
        display: none;
    }

    #autoCarousel:hover .carousel-control-prev,
    #autoCarousel:hover .carousel-control-next {
        display: flex;
    }

    .carousel-inner {
        width: 90%;
    }

    .carousel {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .input_XacThuc {
height: 50px;
width: 50px;
        }

      .sticky-top {
            display: none !important;
        }

    @@media (max-width: 768px) {


        #div_ads {
            display: none !important;
        }

        #div_date {
            margin-bottom: 16px;
        }

       .sticky-top {
            display: block !important;
        }

        .custom-header {
            width: 100%;
            background: #2d47d4;
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            @* padding: 18px 36px 14px 36px; *@
            box-shadow: 0 4px 24px rgba(44, 71, 212, 0.08);
            /* height: 15vh; */
            /* margin-bottom: 2vh; */
        }

        .header-left {
            display: flex;
            align-items: flex-start;
            flex-direction: column;
        }

        .card-body {
            padding: 0.5rem 1.3rem !important;
        }

     

        .input_XacThuc {
height: 70px;
width: 70px;
        }

        .register-model {
            justify-content: flex-start;
        }

    }

    /* --- Sua cho ban dien thoai (SixosPwa la PWA cai tren may) -------------
       Khuon goc chia hai nut theo ti le 3/9 — vua o kho may tinh, nhung o kho
       390px thi cot Quay lai chi con ~97px va chu bi vo hai dong. Noi cot thanh
       4/8 va cam ngat dong; tu breakpoint md tro len giu nguyen ti le cua ho.
       Luu y: trong .cshtml, truy van media phai viet HAI dau a-cong — Razor coi
       mot dau la bieu thuc C#, ke ca khi no nam trong comment CSS nhu the nay. */
    @@media (max-width: 767.98px) {
        .form-footer .btn {
            white-space: nowrap;
        }
    }
</style>
</head>
<body class="bg-ccc">
@* px-lg-0: container-fluid cua Bootstrap co padding 12px moi ben, lam panel
   tim thut vao va de lo vien trang o hai mep man hinh. Kho dien thoai van
   giu padding do de noi dung co le. *@
<div class="container-fluid px-lg-0">
<div class="row g-0 ub-khung">

@{
    var trangChuUb = (string?)ViewBag.TrangChuDoiTac;
    var chiNhanh = ViewBag.ChiNhanh as IReadOnlyList<SixosPwa.Services.Partner.ChiNhanhDoiTac>
                   ?? (IReadOnlyList<SixosPwa.Services.Partner.ChiNhanhDoiTac>)Array.Empty<SixosPwa.Services.Partner.ChiNhanhDoiTac>();
    var hotline = string.Join(" - ", chiNhanh.Select(x => x.Hotline)
                                             .Where(x => !string.IsNullOrWhiteSpace(x))
                                             .Distinct());
}
@* --------------------------------------------------------------------------
   Panel quang ba cua doi tac — CHI hien tu kho may tinh (d-none d-lg-flex).
   Ban dien thoai co y giu mot cot nhu cu.

   Chep dang tu Views/HT_DangNhap/Login.cshtml cua ho (cot col-md-7, nen
   #393be7). Ba khac biet co chu dich:
     1. Anh quang ba tro THANG sang trang doi tac ({TrangChu}/Image/ImageLogin/)
        de ho doi anh thi ben minh tu theo, khong phai chep lai.
     2. Danh sach chi nhanh do MAY CHU do vao (cache 10 phut) thay vi JS goi
        /branches moi lan mo man.
     3. Khong co panel nay thi man van dung — no chi la trang tri.
   -------------------------------------------------------------------------- *@
@if (!string.IsNullOrWhiteSpace(trangChuUb))
{
    <div class="ub-panel col-lg-7 d-none d-lg-flex flex-column">
        <div id="ubCarousel" class="carousel slide ub-panel__anh" data-bs-ride="carousel" data-bs-interval="4000">
            <div class="carousel-inner">
                @for (var i = 8; i <= 9; i++)
                {
                    <div class="carousel-item @(i == 8 ? "active" : "")">
                        <img src="@(trangChuUb)/Image/ImageLogin/@(i).png" class="d-block w-100" alt="Chương trình khám">
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#ubCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Trước</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#ubCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Sau</span>
            </button>
        </div>

        @if (chiNhanh.Count > 0)
        {
            <div class="ub-panel__coso">
                @foreach (var cn in chiNhanh)
                {
                    <div class="ub-coso">
                        <div class="ub-coso__ten">
                            <span class="ub-coso__ten-icon">🏥</span>
                            <span>@cn.Ten</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(cn.DiaChi))
                        {
                            <div class="ub-coso__dong">
                                <svg xmlns="http://www.w3.org/2000/svg" class="ub-coso__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="9.5" stroke-width="1.5" />
                                    <path d="M12 6.5a3 3 0 0 1 3 3c0 2.2 -3 6.5 -3 6.5s-3 -4.3 -3 -6.5a3 3 0 0 1 3 -3z" />
                                    <circle cx="12" cy="9.5" r="1" fill="currentColor" />
                                </svg>
                                <span>@cn.DiaChi</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(cn.Hotline))
                        {
                            <div class="ub-coso__dong">
                                <svg xmlns="http://www.w3.org/2000/svg" class="ub-coso__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="9.5" stroke-width="1.5" />
                                    <path d="M8.5 9.5a0.8 .8 0 0 1 .8 -.8h1.2a.8 .8 0 0 1 .8 .6l.4 1.5a.8 .8 0 0 1 -.2 .8l-.7 .7a5.5 5.5 0 0 0 2.4 2.4l.7 -.7a.8 .8 0 0 1 .8 -.2l1.5 .4a.8 .8 0 0 1 .6 .8v1.2a.8 .8 0 0 1 -.8 .8c-4.2 0 -7.5 -3.3 -7.5 -7.5z" />
                                </svg>
                                <span>@cn.Hotline</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(cn.GioLamViec))
                        {
                            <div class="ub-coso__dong">
                                <svg xmlns="http://www.w3.org/2000/svg" class="ub-coso__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="9.5" stroke-width="1.5" />
                                    <polyline points="12 8 12 12 14.5 13.5" />
                                </svg>
                                <span>@cn.GioLamViec</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <footer class="ub-panel__chan">
            <div class="ub-panel__chan-tieude">LIÊN KẾT</div>
            <ul>
                <li><a href="#">Giới thiệu</a></li>
                <li><a href="#">Chính sách</a></li>
                <li><a href="#">Điều khoản đăng ký</a></li>
                <li><a href="#">Bảo mật</a></li>
            </ul>
        </footer>
    </div>
}
        <div class="register-model col-12 col-lg-5 bg-white d-flex align-items-center flex-column p-0"
            id="registrationCol">
            <!-- HEADER CHO MOBILE -->
            <div class="ub-mobile-header d-lg-none">
                <div class="ub-mobile-header__top">
                    <div class="ub-mobile-header__logo">
                        <img src="@(ViewBag.LogoCoSo ?? "/static/icon-192.png")" alt="@ViewBag.TenCoSo">
                    </div>
                    <div class="ub-mobile-header__info">
                        <div class="ub-mobile-header__ten">@ViewBag.TenCoSo</div>
                        <div class="ub-mobile-header__sub">Thành phố Hồ Chí Minh</div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(hotline))
                {
                    <div class="ub-mobile-header__hotline">
                        TỔNG ĐÀI TƯ VẤN: @hotline
                    </div>
                }
            </div>

            <div class="w-100 p-3">
                <div class="d-none d-lg-block">
                    <div class="ub-logo mb-3">
