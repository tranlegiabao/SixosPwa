@model (SixosPwa.Models.TaiKhoan Item, List<SixosPwa.Areas.Admin.Models.HoSoBenhNhanItemViewModel> DanhSachHoSo, List<SixosPwa.Models.DMGioiTinh> DanhMucGioiTinh)
@{
    var item = Model.Item;
    var danhSachHoSo = Model.DanhSachHoSo ?? new List<SixosPwa.Areas.Admin.Models.HoSoBenhNhanItemViewModel>();
    var danhMucGioiTinh = Model.DanhMucGioiTinh ?? new List<SixosPwa.Models.DMGioiTinh>
    {
        new SixosPwa.Models.DMGioiTinh { MaGioiTinh = "1", TenGioiTinh = "Nam" },
        new SixosPwa.Models.DMGioiTinh { MaGioiTinh = "2", TenGioiTinh = "Nữ" },
        new SixosPwa.Models.DMGioiTinh { MaGioiTinh = "3", TenGioiTinh = "Chưa xác định" }
    };
}

<tr class="account-parent-row" id="account-row-@item.Id" onclick="toggleAccountDrawer(@item.Id, event)">
    <td>
        <div class="table-person">
            <span class="mini-avatar">@(item.SDT.FirstOrDefault().ToString())</span>
            <div>
                <strong>@item.SDT</strong>
                <div><small class="text-muted">Đăng nhập bằng số điện thoại</small></div>
            </div>
        </div>
    </td>
    <td>
        <span class="badge-so-hoso-count" id="badge-count-@item.Id" title="Số lượng: @(danhSachHoSo.Count) hồ sơ">
            @(danhSachHoSo.Count)
        </span>
    </td>
    <td><span class="role-badge role-@item.Role.ToLowerInvariant()">@item.Role</span></td>
    <td class="text-muted">#@item.Id</td>
</tr>

<!-- HÀNG DRAWER SỔ RA CÁC HỒ SƠ -->
<tr id="drawer-@item.Id" class="account-drawer-row" style="display: none;">
    <td colspan="4" class="p-0 border-0">
        <div class="account-drawer-box">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <h6 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                        <span>📂</span> Hồ sơ bệnh nhân thuộc tài khoản <strong>@item.SDT</strong>
                        <span class="badge bg-primary text-white" id="count-label-@item.Id">@(danhSachHoSo.Count) hồ sơ</span>
                    </h6>
                    <small class="text-muted">Quản lý, xem, sửa hoặc xóa hồ sơ của thành viên trong tài khoản này</small>
                </div>
                <button type="button" class="btn btn-sm admin-btn-primary py-1 px-3" onclick="toggleFormThem(@item.Id)">
                    <span>+</span> Thêm hồ sơ
                </button>
            </div>

            <!-- FORM THÊM HỒ SƠ MỚI -->
            <div id="form-them-@item.Id" class="form-them-panel" style="display: none;">
                <div class="fw-bold text-primary mb-2" style="font-size: 13px;">➕ Thêm hồ sơ mới cho tài khoản @item.SDT</div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label mb-1" style="font-size: 11px;">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" id="new-ten-@item.Id" class="form-control form-control-sm" placeholder="VD: Nguyễn Văn A" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1" style="font-size: 11px;">CCCD / Định danh <span class="text-danger">*</span></label>
                        <input type="text" id="new-cccd-@item.Id" class="form-control form-control-sm font-monospace" placeholder="12 số CCCD" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1" style="font-size: 11px;">Số điện thoại</label>
                        <input type="tel" id="new-sdt-@item.Id" class="form-control form-control-sm" placeholder="@item.SDT" value="@item.SDT" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1" style="font-size: 11px;">Ngày sinh</label>
                        <input type="text" id="new-ngaysinh-@item.Id" class="form-control form-control-sm datepicker-input" placeholder="dd/mm/yyyy" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label mb-1" style="font-size: 11px;">Giới tính</label>
                        <select id="new-gioitinh-@item.Id" class="form-select form-select-sm">
                            @foreach (var gt in danhMucGioiTinh)
                            {
                                <option value="@gt.MaGioiTinh">@gt.TenGioiTinh</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-1 justify-content-end">
                        <button type="button" class="btn btn-sm btn-success px-3" onclick="taoHoSoMoi(@item.Id)">
                            💾 Lưu
                        </button>
                        <button type="button" class="btn btn-sm btn-light border px-2" onclick="toggleFormThem(@item.Id)">
                            ✕
                        </button>
                    </div>
                </div>
            </div>

            <!-- BẢNG DANH SÁCH HỒ SƠ -->
            <div class="nested-hoso-card">
                <div class="table-responsive">
                    <table class="table nested-hoso-table align-middle">
                        <thead>
                            <tr>
                                <th style="width: 22%;">Họ và tên</th>
                                <th style="width: 17%;" class="text-center">CCCD / Định danh</th>
                                <th style="width: 14%;" class="text-center">Số điện thoại</th>
                                <th style="width: 12%;" class="text-center">Ngày sinh</th>
                                <th style="width: 10%;" class="text-center">Giới tính</th>
                                <th style="width: 12%;" class="text-center">Mã BN / Cơ sở</th>
                                <th style="width: 13%;" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-hoso-@item.Id">
                            @if (danhSachHoSo.Count == 0)
                            {
                                <tr class="empty-hoso-tr" id="empty-row-@item.Id">
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <div>📋</div>
                                        <div>Chưa có hồ sơ bệnh nhân nào liên kết với tài khoản này.</div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var hs in danhSachHoSo)
                                {
                                    var ngaySinhStr = hs.NgaySinh?.ToString("dd/MM/yyyy") ?? "—";
                                    var ngaySinhIso = hs.NgaySinh?.ToString("yyyy-MM-dd") ?? "";
                                    var matchGt = danhMucGioiTinh.FirstOrDefault(x => x.MaGioiTinh == hs.GioiTinh);
                                    var gioiTinhStr = matchGt != null ? matchGt.TenGioiTinh : (hs.GioiTinh == "1" ? "Nam" : (hs.GioiTinh == "2" ? "Nữ" : "Chưa xác định"));
                                    var maBnStr = !string.IsNullOrEmpty(hs.MaBN) ? $"{hs.MaBN}" : (!string.IsNullOrEmpty(hs.TenCoSo) ? hs.TenCoSo : "Chưa nối");

                                    <tr id="hoso-row-@hs.Id" data-id="@hs.Id" data-account-id="@item.Id"
                                        data-ten="@hs.TenBN" data-cccd="@hs.CCCD" data-sdt="@hs.SDT"
                                        data-ngaysinh="@ngaySinhIso" data-gioitinh="@hs.GioiTinh"
                                        data-mabn="@hs.MaBN" data-tencoso="@hs.TenCoSo"
                                        data-idhosocoso="@hs.IdHoSoCoSo" data-idcoso="@hs.IdCoSo">
                                        <!-- HỌ TÊN -->
                                        <td>
                                            <span class="val-ten fw-bold text-dark">@hs.TenBN</span>
                                        </td>
                                        <!-- CCCD -->
                                        <td class="text-center">
                                            <span class="val-cccd font-monospace">@(string.IsNullOrEmpty(hs.CCCD) ? "—" : hs.CCCD)</span>
                                        </td>
                                        <!-- SĐT -->
                                        <td class="text-center">
                                            <span class="val-sdt">@(string.IsNullOrEmpty(hs.SDT) ? "—" : hs.SDT)</span>
                                        </td>
                                        <!-- NGÀY SINH -->
                                        <td class="text-center">
                                            <span class="val-ngaysinh">@ngaySinhStr</span>
                                        </td>
                                        <!-- GIỚI TÍNH -->
                                        <td class="text-center">
                                            <span class="val-gioitinh">@gioiTinhStr</span>
                                        </td>
                                        <!-- MÃ BN / CƠ SỞ -->
                                        <td class="text-center">
                                            <span class="val-mabn badge bg-light text-secondary border">@maBnStr</span>
                                        </td>
                                        <!-- THAO TÁC: SỬA - LƯU - XOÁ -->
                                        <td class="text-center">
                                            <div class="hoso-action-group">
                                                <!-- NÚT SỬA (✏️) MỞ POPUP THEO MẪU -->
                                                <button type="button" class="btn-hoso-icon btn-hoso-edit" onclick="moModalSuaHoSo(@hs.Id, @item.Id)" title="Sửa hồ sơ">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                                </button>

                                                <!-- NÚT XOÁ (🗑️) -->
                                                <button type="button" class="btn-hoso-icon btn-hoso-delete" onclick="xoaThongTinHoSo(@hs.Id, '@hs.TenBN', @item.Id)" title="Xóa hồ sơ">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </td>
</tr>
