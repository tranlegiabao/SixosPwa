                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true" style="width: 3rem; height: 3rem; background-color: rgba(0,0,0,0.5); border-radius: 50%;"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }
            else
            {
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="para-card-wrapper">
                            <div class="para-card" style="background-image: url('https://img.freepik.com/free-photo/beautiful-young-female-doctor-looking-camera-office_1301-7807.jpg?w=1380');">
                                <div class="para-card-content">
                                    <h3 class="para-card-title">Bệnh viện đa khoa chất lượng cao</h3>
                                    <p class="para-card-text">Dịch vụ khám chữa bệnh hàng đầu với đội ngũ bác sĩ chuyên khoa giàu kinh nghiệm.</p>
                                    <a href="/Home/DanhSachCoSo-benhvien" class="para-card-btn">Đăng ký khám</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="para-card-wrapper">
                            <div class="para-card" style="background-image: url('https://img.freepik.com/free-photo/doctor-working-with-laptop-clinic_23-2149196328.jpg?w=1380');">
                                <div class="para-card-content">
                                    <h3 class="para-card-title">Chăm sóc sức khỏe gia đình bạn</h3>
                                    <p class="para-card-text">Đặt lịch nhanh chóng, tiết kiệm thời gian chờ đợi, nhận kết quả online tiện lợi.</p>
                                    <a href="/Home/DanhSachCoSo-benhvien" class="para-card-btn">Đăng ký khám</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="para-card-wrapper">
                            <div class="para-card" style="background-image: url('https://img.freepik.com/free-photo/modern-hospital-building_1127-2856.jpg?w=1380');">
                                <div class="para-card-content">
                                    <h3 class="para-card-title">Hệ thống cơ sở y tế hiện đại</h3>
                                    <p class="para-card-text">Liên kết các bệnh viện, phòng khám, nhà thuốc uy tín trên toàn quốc.</p>
                                    <a href="/Home/DanhSachCoSo-benhvien" class="para-card-btn">Đăng ký khám</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#mainSlider" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true" style="width: 3rem; height: 3rem; background-color: rgba(0,0,0,0.5); border-radius: 50%;"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true" style="width: 3rem; height: 3rem; background-color: rgba(0,0,0,0.5); border-radius: 50%;"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }
        </div>
    </div>
</div>

