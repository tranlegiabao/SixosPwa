@{
    Layout = null;
    ViewData["Title"] = "Đang chuyển tới cơ sở";
}

<!doctype html>
<html lang="vi">
<head>
    <title>Đang chuyển tới @ViewBag.TenCoSo — HisSoft</title>
    <partial name="_CongHead" />
    <style>
        .khoi-cho { text-align: center; padding: 8px 0; }
        .khoi-cho .spinner-border { width: 3rem; height: 3rem; }
    </style>
</head>
<body class="page-center">

    <main class="auth">
        <div class="auth__brand">
            <img src="~/static/icon-192.png" alt="HisSoft" width="72" height="72" />
            <h1>Đang chuyển tới cơ sở</h1>
            <p>@ViewBag.TenCoSo</p>
        </div>

        <div class="card auth__card">
            <div class="card-body">

                <div class="khoi-cho" id="khoiCho">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Đang xử lý</span>
                    </div>
                    <p class="mb-0">Đang kết nối tới @ViewBag.TenCoSo…</p>
                </div>

            </div>
        </div>

        <p class="auth__foot">
            Nếu không tự chuyển,
            <a href="@ViewBag.TrangChu" class="text-decoration-none">bấm vào đây</a>.
        </p>
    </main>

    @*
        BAT BUOC la form POST TOP-LEVEL, KHONG duoc dung fetch/AJAX va cung KHONG
        duoc dung iframe an. Ly do (ADR 0003):
        - Ben doi tac dung app.UseCors(AllowAnyOrigin) ma AllowAnyOrigin khong di
          cung AllowCredentials => fetch khong dat duoc cookie.
        - Iframe lien site bi chinh sach cookie ben thu ba chan (Safari chan han).

        Dinh chinh 2026-08-24 (ADR 0003): bo popup, POST NGAY TRONG TAB DANG DUNG.
        Sau POST tab da roi SixosPwa nen KHONG con ep dieu huong tiep toi dich
        chinh xac duoc nua (script khong con song) — CHAP NHAN DICH MO, de doi tac
        tu dan qua man con lai cua ho. Luon dung 1 buoc (UbGateway.cs:197 "CHI MOT
        BUOC" — da bo phuong an nhieu buoc vi cookie doi tac la SameSite=Lax).
    *@
    @{
        var cacBuoc = (IReadOnlyList<SixosPwa.Services.Partner.BuocBanGiao>)ViewBag.CacBuoc;
        var buoc0 = cacBuoc[0];
    }
    <form id="buoc0" method="post" action="@buoc0.Action">
        @foreach (var truong in buoc0.Truong)
        {
            <input type="hidden" name="@truong.Key" value="@truong.Value" />
        }
    </form>

    <script>
        // Doi mot nhip de benh nhan kip thay man "Dang ket noi toi..." truoc khi
        // tab roi SixosPwa — POST xong la sang han trang doi tac, khong quay lai.
        const CHO_TRUOC_KHI_POST_MS = 600;

        setTimeout(function () {
            document.getElementById('buoc0').submit();
        }, CHO_TRUOC_KHI_POST_MS);
    </script>
</body>
</html>
