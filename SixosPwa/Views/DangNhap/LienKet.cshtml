@{
    Layout = null;
    ViewData["Title"] = "Liên kết hồ sơ";
}

<!doctype html>
<html lang="vi">
<head>
    <title>Liên kết hồ sơ — HisSoft</title>
    <partial name="_CongHead" />
    <style>
        .buoc-2 { display: none; }
        .ma-lien-ket {
            letter-spacing: 0.35rem;
            font-size: 1.35rem;
            text-align: center;
            font-weight: 600;
        }
    </style>
</head>
<body class="page-center">

    <main class="auth">
        <div class="auth__brand">
            <img src="~/static/icon-192.png" alt="HisSoft" width="72" height="72" />
            <h1>Liên kết hồ sơ</h1>
            <p>Chỉ làm một lần duy nhất</p>
        </div>

        <div class="card auth__card">
            <div class="card-body">

                @* Man nay CHI hien cho benh nhan da co san tai khoan ben co so tu
                   truoc ma SixosPwa chua biet mat khau. Lien ket xong thi tu lan
                   sau di thang, khong hoi lai (V9). *@
                <div class="alert alert-light border small mb-3">
                    Bạn đã có hồ sơ tại <strong>@ViewBag.TenCoSo</strong>.
                    Hãy xác nhận để liên kết hồ sơ đó với tài khoản này —
                    <strong>những lần sau sẽ vào thẳng, không hỏi lại</strong>.
                </div>

                <!-- BƯỚC 1: NHẬN MÃ TỪ CƠ SỞ -->
                <form id="formBuoc1" class="buoc-1" onsubmit="event.preventDefault(); guiMa();">
                    <div class="mb-3">
                        <label class="form-label" for="cccd">Số Căn cước công dân</label>
                        <input type="text" class="form-control" id="cccd" readonly value="@ViewBag.Cccd" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="dienThoai">Số điện thoại nhận mã</label>
                        <input type="text" class="form-control form-control-lg" id="dienThoai"
                               inputmode="numeric" maxlength="20" value="@ViewBag.DienThoai" required />
                        <div class="form-text">
                            Phải là số điện thoại bạn đã đăng ký tại cơ sở, nếu không cơ sở sẽ không tìm thấy hồ sơ.
                        </div>
                    </div>

                    <button type="submit" id="btnGuiMa" class="btn btn-primary w-100 py-2 fw-bold">
                        Nhận mã xác thực
                    </button>
                </form>

                <!-- BƯỚC 2: NHẬP MÃ + ĐẶT MẬT KHẨU -->
                <form id="formBuoc2" class="buoc-2" onsubmit="event.preventDefault(); xacNhan();">
                    <div class="mb-3">
                        <label class="form-label" for="ma">Mã xác thực</label>
                        <input type="text" class="form-control form-control-lg ma-lien-ket" id="ma"
                               inputmode="numeric" maxlength="6" autocomplete="one-time-code" required />
                        <div class="form-text">Mã do <strong>@ViewBag.TenCoSo</strong> gửi tới bạn.</div>
                    </div>

                    @* Khong hoi mat khau nua: man nay chi hien voi co so CO API, ma
                       o do may chu tu sinh mat khau ngau nhien roi cat lai. Benh
                       nhan chi can nhap ma xac thuc. *@

                    <button type="submit" id="btnXacNhan" class="btn btn-success w-100 py-2 fw-bold mb-2">
                        Xác nhận liên kết
                    </button>

                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="quayLai()">
                        &larr; Nhận lại mã
                    </button>
                </form>

            </div>
        </div>

        <p class="auth__foot">
            <a href="/DangNhap/Login?coSo=@ViewBag.SlugCoSo" class="text-decoration-none">&larr; Quay lại đăng nhập</a>
        </p>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const maCoSo = '@(ViewBag.MaCoSo as string ?? "")';
        const cccd = '@(ViewBag.Cccd as string ?? "")';

        function quayLai() {
            document.querySelector('.buoc-1').style.display = 'block';
            document.querySelector('.buoc-2').style.display = 'none';
        }

        async function guiMa() {
            const dienThoai = document.getElementById('dienThoai').value.trim();
            if (!dienThoai) {
                showToast('Vui lòng nhập số điện thoại!', 400);
                return;
            }

            const btn = document.getElementById('btnGuiMa');
            btn.disabled = true;
            btn.innerText = 'Đang gửi...';

            try {
                const phanHoi = await fetch('/DangNhap/GuiMaLienKet', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ maCoSo: maCoSo, cccd: cccd, dienThoai: dienThoai })
                });

                const duLieu = await phanHoi.json();
                if (duLieu.success) {
                    showToast(duLieu.message, 200);
                    document.querySelector('.buoc-1').style.display = 'none';
                    document.querySelector('.buoc-2').style.display = 'block';
                    document.getElementById('ma').focus();
                } else {
                    showToast(duLieu.message, 400);
                }
            } catch (loi) {
                showToast('Không kết nối được máy chủ, vui lòng thử lại!', 500);
            } finally {
                btn.disabled = false;
                btn.innerText = 'Nhận mã xác thực';
            }
        }

        async function xacNhan() {
            const ma = document.getElementById('ma').value.trim();
            const dienThoai = document.getElementById('dienThoai').value.trim();

            if (!ma) {
                showToast('Vui lòng nhập mã xác thực!', 400);
                return;
            }

            const btn = document.getElementById('btnXacNhan');
            btn.disabled = true;
            btn.innerText = 'Đang liên kết...';

            try {
                const phanHoi = await fetch('/DangNhap/XacNhanLienKet', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        maCoSo: maCoSo, cccd: cccd, dienThoai: dienThoai,
                        ma: ma
                    })
                });

                const duLieu = await phanHoi.json();
                if (duLieu.success) {
                    window.location.href = duLieu.redirectUrl;
                    return;
                }

                showToast(duLieu.message, 400);
            } catch (loi) {
                showToast('Không kết nối được máy chủ, vui lòng thử lại!', 500);
            } finally {
                btn.disabled = false;
                btn.innerText = 'Xác nhận liên kết';
            }
        }
    </script>
</body>
</html>
