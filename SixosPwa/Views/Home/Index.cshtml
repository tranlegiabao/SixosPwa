@section Scripts {
    <script>
        // Set default date for booking picker to tomorrow
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        document.getElementById('bookDate').valueAsDate = tomorrow;

        // Toast Helper
        function showToast(message, bgClass = 'bg-teal') {
            const toastEl = document.getElementById('appToast');
            const toastMsg = document.getElementById('toastMessage');
            toastEl.className = `toast align-items-center text-white border-0 shadow-lg ${bgClass}`;
            toastMsg.innerHTML = `<i class="bi bi-check-circle-fill fs-5"></i> ${message}`;
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        // Toggle Floating CS Chat Box
        function toggleCsChat() {
            const box = document.getElementById('csChatBox');
            box.classList.toggle('show');
            if (box.classList.contains('show')) {
                document.getElementById('csInput').focus();
            }
        }

        function openCsChat() {
            const box = document.getElementById('csChatBox');
            if (!box.classList.contains('show')) {
                box.classList.add('show');
            }
            document.getElementById('csInput').focus();
        }

        // Send CS Message Chat Simulation
        function sendCsMessage() {
            const input = document.getElementById('csInput');
            const val = input.value.trim();
            if (!val) return;

            appendMsg(val, 'user');
            input.value = '';

            // Simulated AI Response
            setTimeout(() => {
                let botReply = 'Cảm ơn bạn đã liên hệ! Trung tâm CSKH HisSoft đang hỗ trợ bạn. Vui lòng cho biết thêm thông tin hoặc chọn mục tư vấn nhanh.';
                
                const textLower = val.toLowerCase();
                if (textLower.includes('giờ') || textLower.includes('thời gian')) {
                    botReply = '🕒 Bệnh viện HisSoft làm việc từ 07:00 đến 17:00 (Thứ 2 - Thứ 7). Cấp cứu & Khám vi giáp trực 24/7.';
                } else if (textLower.includes('bhyt') || textLower.includes('bảo hiểm')) {
                    botReply = '💳 Thẻ BHYT của bạn (GD479201920) còn hạn đến 12/2027 và được hưởng 80% chi phí khám chữa bệnh theo tuyến.';
                } else if (textLower.includes('lịch') || textLower.includes('đặt khám')) {
                    botReply = '📅 Bạn có thể bấm nút "Đăng Ký Khám Mới" phía trên để chọn bác sĩ và giờ khám ưu tiên nhé!';
                } else if (textLower.includes('tổng đài') || textLower.includes('gặp')) {
                    botReply = '🎧 Tổng đài viên CSKH đang gọi lại theo số điện thoại đăng ký của bạn trong 2 phút nữa...';
                }

                appendMsg(botReply, 'bot');
            }, 700);
        }

        function sendQuickReply(text) {
            document.getElementById('csInput').value = text;
            sendCsMessage();
        }

        function appendMsg(text, sender) {
            const body = document.getElementById('csChatBody');
            const div = document.createElement('div');
            div.className = `cs-msg ${sender === 'user' ? 'cs-msg-user' : 'cs-msg-bot'}`;
            div.innerHTML = text;
            body.appendChild(div);
            body.scrollTop = body.scrollHeight;
        }

        // Submit Booking Form
        function submitBooking(e) {
            e.preventDefault();
            const specialty = document.getElementById('bookSpecialty').value;
            const time = document.getElementById('bookTime').value;
            const date = document.getElementById('bookDate').value;
            
            const modalEl = document.getElementById('modalDangKyKham');
            const modal = bootstrap.Modal.getInstance(modalEl);
            modal.hide();

            showToast(`🎉 Đăng ký khám chuyên khoa <strong>${specialty}</strong> ngày ${date} (${time}) thành công! Phiếu hẹn đã tạo.`);
        }

        // Submit NPS Survey
        function submitNps(e) {
            e.preventDefault();
            const form = document.getElementById('npsForm');
            form.innerHTML = `
                <div class="alert alert-success p-4 rounded-4 text-center border-0 mb-0">
                    <i class="bi bi-heart-fill fs-1 text-danger mb-2 d-block"></i>
                    <h5 class="fw-bold">Cảm Ơn Đóng Góp Ý Kiến Của Bạn!</h5>
                    <p class="mb-0 text-muted small">Đánh giá của bạn đã được chuyển trực tiếp tới Ban Quản Lý Chất Lượng Dịch Vụ HisSoft.</p>
                </div>
            `;
        }

        // Package selection
        function selectPackage(packageName) {
            document.getElementById('bookSpecialty').value = 'Chẩn đoán hình ảnh';
            const modal = new bootstrap.Modal(document.getElementById('modalDangKyKham'));
            modal.show();
        }

        // Show ticket QR
        function showTicketQrModal() {
            const modal = new bootstrap.Modal(document.getElementById('modalQrId'));
            modal.show();
        }

        // Cancel appointment demo
        function cancelAppointment() {
            if (confirm('Bạn có chắc chắn muốn yêu cầu đổi hoặc hủy lịch khám này không?')) {
                showToast('Yêu cầu đổi lịch khám đã được gửi tới bộ phận CSKH.', 'bg-warning text-dark');
            }
        }

        // Scroll to NPS
        function scrollToNps() {
            document.getElementById('npsSection').scrollIntoView({ behavior: 'smooth' });
        }
    </script>
}
