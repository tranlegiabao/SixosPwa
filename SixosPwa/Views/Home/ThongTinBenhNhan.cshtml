         aria-label="Mở menu" aria-haspopup="true" aria-expanded="false" aria-controls="dropdownMenu">
        <i class="fas fa-bars" aria-hidden="true"></i>
        <div class="ytv-dropdown" id="dropdownMenu" role="menu" aria-label="Menu">
            @* Nhom 1 - loai co so: CHI hien tren dien thoai.
               Tu tablet tro len da co san o sidebar than trang nen an di, khoi lap. *@
            <div class="ytv-dropdown-coso">
                <a href="/Home/DanhSachCoSo-benhvien" role="menuitem">
                    <i class="fas fa-hospital bieu-tuong-benh-vien" aria-hidden="true"></i> Bệnh viện
                </a>
                <a href="/Home/DanhSachCoSo-pkdk" role="menuitem">
                    <i class="fas fa-clinic-medical bieu-tuong-phong-kham" aria-hidden="true"></i> Phòng khám đa khoa
                </a>
                <a href="/Home/DanhSachCoSo-nhakhoa" role="menuitem">
                    <i class="fas fa-tooth bieu-tuong-nha-khoa" aria-hidden="true"></i> Nha khoa
                </a>
                <a href="/Home/DanhSachCoSo-phongmach" role="menuitem">
                    <i class="fas fa-stethoscope bieu-tuong-phong-mach" aria-hidden="true"></i> Phòng mạch
