<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] — HisSoft</title>

    <partial name="_PwaHead" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-nav shadow-sm py-2">
        <div class="container">
            <a class="app-nav__brand text-white text-decoration-none d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                <img src="~/static/icon-192.png" alt="HisSoft" width="36" height="36" class="rounded-2" />
                <span class="fs-5">HisSoft Medical</span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-controller="DangNhap" asp-action="DangXuat">
                    🚪 Đăng xuất
                </a>
            </div>
        </div>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="container app-foot">
        &copy; @DateTime.Now.Year Sixos &mdash; khuôn mẫu SixosPwa
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pwa-install.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
