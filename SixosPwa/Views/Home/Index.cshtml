                            <td><button class="btn btn-sm btn-light border" onclick="viewReport('KSK-8812')">📄 Xem Chi Tiết</button></td>
                        </tr>
                        <tr>
                            <td><strong class="text-primary">KSK-7741</strong></td>
                            <td>12/01/2026</td>
