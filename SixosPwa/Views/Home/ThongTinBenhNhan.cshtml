@model List<SixosPwa.Models.LichSuKham>
@{
    ViewData["Title"] = "Y TẾ VIỆT - Đăng Ký Khám Bệnh";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/thong-tin-benh-nhan.css" asp-append-version="true" />

<div class="ytv-header">
    <div class="ytv-logo-area">
        <img src="/static/logo-yte.png" alt="Logo" class="ytv-logo-image" />
        <div class="ytv-logo-text">Y TẾ<br>VIỆT</div>
    </div>
    <div class="ytv-header-title">
        <h1>Dịch Vụ Đăng Ký Khám Bệnh Online</h1>
        <p>Tiện lợi - Nhanh chóng - Chính xác</p>
    </div>
    <div class="ytv-header-menu" id="menuBtn" onclick="toggleMenu()">
        <i class="fas fa-bars"></i>
        <div class="ytv-dropdown" id="dropdownMenu">
            <a href="/Home/DanhSachCoSo?type=benhvien">
                <i class="fas fa-hospital bieu-tuong-benh-vien"></i> Bệnh viện
            </a>
            <a href="/Home/DanhSachCoSo?type=pkdk">
                <i class="fas fa-clinic-medical bieu-tuong-phong-kham"></i> Phòng khám đa khoa
            </a>
            <a href="/Home/DanhSachCoSo?type=nhakhoa">
                <i class="fas fa-tooth bieu-tuong-nha-khoa"></i> Nha khoa
            </a>
            <a href="/Home/DanhSachCoSo?type=phongmach">
                <i class="fas fa-stethoscope bieu-tuong-phong-mach"></i> Phòng mạch
            </a>
            <a href="/Home/DanhSachCoSo?type=nhathuoc">
                <i class="fas fa-pills bieu-tuong-nha-thuoc"></i> Nhà thuốc
            </a>
        </div>
    </div>
</div>

<div class="ytv-main">
    <div class="ytv-sidebar">
        <a href="/Home/DanhSachCoSo-benhvien" class="ytv-menu-item">
            <i class="fas fa-hospital ytv-icon bieu-tuong-benh-vien"></i>
            Bệnh viện
        </a>
        <a href="/Home/DanhSachCoSo-pkdk" class="ytv-menu-item">
            <i class="fas fa-clinic-medical ytv-icon bieu-tuong-phong-kham"></i>
            Phòng khám đa khoa
        </a>
        <a href="/Home/DanhSachCoSo-nhakhoa" class="ytv-menu-item">
            <i class="fas fa-tooth ytv-icon bieu-tuong-nha-khoa"></i>
            Nha khoa
        </a>
        <a href="/Home/DanhSachCoSo-phongmach" class="ytv-menu-item">
            <i class="fas fa-stethoscope ytv-icon bieu-tuong-phong-mach"></i>
            Phòng mạch
        </a>
        <a href="/Home/DanhSachCoSo-nhathuoc" class="ytv-menu-item">
            <i class="fas fa-pills ytv-icon bieu-tuong-nha-thuoc"></i>
            Nhà thuốc
        </a>
    </div>
    
    <div class="ytv-content">
        <!-- Bootstrap Carousel for Slider -->
        <div id="mainSlider" class="carousel slide ytv-slider" data-bs-ride="carousel" data-bs-interval="3000">
            @{
                var topCSKCB = ViewData["TopCSKCB"] as List<SixosPwa.Models.TopCSKCBQC> ?? new List<SixosPwa.Models.TopCSKCBQC>();
            }
            @if (topCSKCB.Any())
            {
                <div class="carousel-indicators">
                    @for (int i = 0; i < topCSKCB.Count; i++)
                    {
                        <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                    }
                </div>
                <div class="carousel-inner">
                    @for (int i = 0; i < topCSKCB.Count; i++)
                    {
                        var item = topCSKCB[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="para-card-wrapper">
                                <div class="para-card" style="background-image: url('@(string.IsNullOrEmpty(item.Img) ? "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=800&q=80" : item.Img)');">
                                    <div class="para-card-content">
                                        <h3 class="para-card-title">@item.TenCoSo</h3>
                                        <p class="para-card-text">@item.NoiDung</p>
                                        <a href="/Home/ChiTietCoSo?ten=@System.Net.WebUtility.UrlEncode(item.TenCoSo)" class="para-card-btn">Đăng ký khám</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#mainSlider" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon ytv-carousel-control-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
                    <span class="carousel-control-next-icon ytv-carousel-control-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }
            else
            {
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="para-card-wrapper">
                            <div class="para-card" style="background-image: url('https://img.freepik.com/free-photo/beautiful-young-female-doctor-looking-camera-office_1301-7807.jpg?w=1380');">
                                <div class="para-card-content">
                                    <h3 class="para-card-title">Bệnh viện đa khoa chất lượng cao</h3>
                                    <p class="para-card-text">Dịch vụ khám chữa bệnh hàng đầu với đội ngũ bác sĩ chuyên khoa giàu kinh nghiệm.</p>
                                    <a href="/Home/DanhSachCoSo-benhvien" class="para-card-btn">Đăng ký khám</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="para-card-wrapper">
                            <div class="para-card" style="background-image: url('https://img.freepik.com/free-photo/doctor-working-with-laptop-clinic_23-2149196328.jpg?w=1380');">
                                <div class="para-card-content">
                                    <h3 class="para-card-title">Chăm sóc sức khỏe gia đình bạn</h3>
                                    <p class="para-card-text">Đặt lịch nhanh chóng, tiết kiệm thời gian chờ đợi, nhận kết quả online tiện lợi.</p>
                                    <a href="/Home/DanhSachCoSo-benhvien" class="para-card-btn">Đăng ký khám</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="para-card-wrapper">
                            <div class="para-card" style="background-image: url('https://img.freepik.com/free-photo/modern-hospital-building_1127-2856.jpg?w=1380');">
                                <div class="para-card-content">
                                    <h3 class="para-card-title">Hệ thống cơ sở y tế hiện đại</h3>
                                    <p class="para-card-text">Liên kết các bệnh viện, phòng khám, nhà thuốc uy tín trên toàn quốc.</p>
                                    <a href="/Home/DanhSachCoSo-benhvien" class="para-card-btn">Đăng ký khám</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#mainSlider" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon ytv-carousel-control-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
                            <span class="carousel-control-next-icon ytv-carousel-control-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }
        </div>
    </div>

    <div class="ytv-company-info" aria-label="Thông tin Công Ty Công Nghệ và Giải Pháp Phần Mềm SixOs">
    <div class="ytv-company-name">
        Công Ty Công Nghệ và<br />
        Giải Pháp Phần Mềm SixOs
    </div>

    <div class="ytv-company-list">
        <ul>
            <li>Phần mềm lập trình theo yêu cầu</li>
            <li>Cho thuê theo yêu cầu</li>
        </ul>
    </div>

    <div class="ytv-company-list">
        <ul>
            <li>Server dự phòng</li>
            <li>Sao lưu dữ liệu</li>
        </ul>
    </div>

    <div class="ytv-company-rolling" aria-label="Các giải pháp phần mềm">
        <a class="ytv-company-service is-active" href="https://sixossoft.com/phan-mem-quan-ly-tong-the-benh-vien" target="_blank" rel="noopener noreferrer" aria-hidden="false" tabindex="0">
            <img class="ytv-company-service-icon" src="/static/bieu-tuong/benh-vien.svg" alt="" aria-hidden="true" />
            <ul><li>Phần mềm quản lý bệnh viện</li></ul>
        </a>
        <a class="ytv-company-service" href="https://sixossoft.com/phan-mem-quan-ly-phong-kham-da-khoa" target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1">
            <img class="ytv-company-service-icon" src="/static/bieu-tuong/phong-kham.svg" alt="" aria-hidden="true" />
            <ul><li>Phần mềm quản lý phòng khám đa khoa</li></ul>
        </a>
        <a class="ytv-company-service" href="https://sixossoft.com/phan-mem-quan-ly-nha-khoa" target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1">
            <img class="ytv-company-service-icon" src="/static/bieu-tuong/nha-khoa.svg" alt="" aria-hidden="true" />
            <ul><li>Phần mềm quản lý nha khoa</li></ul>
        </a>
        <a class="ytv-company-service" href="https://sixossoft.com/phan-mem-quan-ly-ban-hang" target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1">
            <img class="ytv-company-service-icon" src="/static/bieu-tuong/nha-thuoc.svg" alt="" aria-hidden="true" />
            <ul><li>Phần mềm quản lý thuốc</li></ul>
        </a>
    </div>
    </div>
</div>

<div class="ytv-footer">
    <div class="ytv-footer-top">
        <div class="ytv-support-col">
            <div class="ytv-support-phones ytv-support-contacts">
                <div><i class="fas fa-headset me-2"></i> Hỗ trợ: <span>0901 87 88 96</span> - <span>0364 956 007</span></div>
                <div><i class="fas fa-envelope me-2"></i> Email: <a href="mailto:Sixossoft@gmail.com" class="ytv-email-link">sixossoft@gmail.com</a></div>
            </div>
        </div>
        
        <div class="ytv-policies-col">
            <a href="#" onclick="showPolicy('baomat')">Chính sách bảo mật</a> <span class="separator">|</span>
            <a href="#" onclick="showPolicy('dieukhoan')">Điều khoản sử dụng</a> <span class="separator">|</span>
            <a href="#" onclick="showPolicy('khieunai')">Giải quyết khiếu nại</a> <span class="separator">|</span>
            <a href="#" onclick="showPolicy('baohanh')">Chính sách bảo hành</a>
        </div>
    </div>
</div>

<script src="~/js/thong-tin-benh-nhan.js" asp-append-version="true"></script>

<!-- Policy Modal -->
<div class="modal fade" id="policyModal" tabindex="-1" aria-labelledby="policyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="policyModalLabel">Chính sách</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body ytv-policy-body" id="policyModalBody">
        <!-- Content injected via JS -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>
