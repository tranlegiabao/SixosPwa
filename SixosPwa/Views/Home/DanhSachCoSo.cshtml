@{
    ViewData["Title"] = ViewData["Title"];
}

<style>
    /* Ẩn Layout mặc định */
    .app-nav { display: none !important; }
    .bottom-nav { display: none !important; }
    body { background-color: var(--ytv-bg); padding-bottom: 120px !important; margin: 0 !important; }

    /* Buoc Layout cha phai full width */
    body > *,
    .container, .container-fluid, .container-sm, .container-md, .container-lg, .container-xl, .container-xxl {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    /* Layout Variables */
    :root {
        --ytv-primary: #3b82f6;
        --ytv-secondary: #0ea5e9;
        --ytv-accent: #ffb703;
        --ytv-text: #334155;
        --ytv-bg: #f0f9ff;
    }

    /* HEADER */
    .ytv-header {
        background: linear-gradient(135deg, #3b82f6, #60a5fa);
        color: white;
        padding: 15px 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        position: relative;
    }
    .ytv-logo-area {
        display: flex;
        align-items: center;
        gap: 15px;
        text-decoration: none;
        color: white;
    }
    .ytv-logo-area:hover {
        color: white;
    }
    .ytv-logo-text {
        font-family: 'Times New Roman', Times, serif;
        font-size: 34px;
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: 1px;
        text-shadow: 1px 1px 3px rgba(255, 255, 255, 0.4);
    }
    .ytv-header-title {
        text-align: center;
        flex-grow: 1;
    }
    .ytv-header-title h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }
    .ytv-header-title p {
        margin: 5px 0 0 0;
        font-size: 19px;
        opacity: 0.9;
    }
    .ytv-menu-btn {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        font-size: 24px;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.3s;
    }
    .ytv-menu-btn:hover {
        background: rgba(255,255,255,0.3);
    }

    /* MAIN CONTAINER */
    .ytv-main {
        display: flex;
        width: 100%;
        min-height: calc(100vh - 140px);
        background: white;
    }

    /* MENU SIDEBAR */
    .ytv-sidebar {
        width: 220px;
        flex-shrink: 0;
        background: #f8fafc;
        border-right: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        padding: 10px 0;
    }
    .ytv-menu-item {
        display: flex;
        align-items: center;
        padding: 15px 20px;
        gap: 15px;
        color: var(--ytv-primary);
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        border-left: 4px solid transparent;
    }
    .ytv-menu-item i {
        font-size: 22px;
        width: 30px;
        text-align: center;
        color: #64748b;
        transition: all 0.3s ease;
    }
    .ytv-menu-item:hover, .ytv-menu-item.active {
        background: #f1f5f9;
        border-left-color: var(--ytv-secondary);
        color: var(--ytv-primary);
    }
    .ytv-menu-item:hover i, .ytv-menu-item.active i {
        color: var(--ytv-secondary);
        transform: scale(1.1);
    }

    /* KHU VUC SECTION */
    .ytv-khu-vuc {
        margin-top: 10px;
        padding: 15px 15px 10px 15px;
        border-top: 1px solid #e2e8f0;
    }
    .ytv-khu-vuc-title {
        font-size: 14px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .ytv-province-select {
        display: none !important;
    }
    
    /* CUSTOM SEARCHABLE SELECT */
    .ytv-custom-select-container {
        position: relative;
        width: 100%;
        margin-bottom: 10px;
    }
    .ytv-custom-select-trigger {
        width: 100%;
        padding: 8px 12px;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        font-size: 14px;
        color: var(--ytv-text);
        outline: none;
        background: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: border-color 0.3s;
    }
    .ytv-custom-select-trigger:hover, .ytv-custom-select-container.open .ytv-custom-select-trigger {
        border-color: var(--ytv-primary);
    }
    .ytv-custom-select-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        margin-top: 4px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        z-index: 1000;
        overflow: hidden;
    }
    .ytv-custom-select-container.open .ytv-custom-select-dropdown {
        display: block;
    }
    .ytv-custom-select-search {
        position: relative;
        padding: 8px;
        border-bottom: 1px solid #f1f5f9;
        background: #f8fafc;
    }
    .ytv-custom-select-search input {
        width: 100%;
        padding: 6px 30px 6px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 13px;
        outline: none;
    }
    .ytv-custom-select-search input:focus {
        border-color: var(--ytv-primary);
    }
    .ytv-custom-select-search i {
        position: absolute;
        right: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 12px;
    }
    .ytv-custom-select-options {
        list-style: none;
        padding: 0;
        margin: 0;
        max-height: 220px;
        overflow-y: auto;
    }
    .ytv-custom-select-options li {
        padding: 8px 12px;
        font-size: 13px;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s;
    }
    .ytv-custom-select-options li:hover, .ytv-custom-select-options li.selected {
        background: #eff6ff;
        color: var(--ytv-primary);
        font-weight: 600;
    }

    .ytv-district-list {
        list-style: none;
        padding: 0;
        margin: 0;
        max-height: 200px;
        overflow-y: auto;
    }
    .ytv-district-list li {
        padding: 8px 12px;
        font-size: 13px;
        font-weight: 500;
        color: #475569;
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .ytv-district-list li:hover, .ytv-district-list li.active {
        color: var(--ytv-primary);
        background: #eff6ff;
    }

    /* RIGHT CONTENT */
    .ytv-content {
        flex: 1;
        padding: 30px;
        background: #ffffff;
    }
    .ytv-content-title {
        font-size: 24px;
        font-weight: 800;
        color: var(--ytv-primary);
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }
    .ytv-content-title-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .ytv-search-box {
        position: relative;
        width: 300px;
    }
    .ytv-search-box input {
        width: 100%;
        padding: 10px 15px 10px 40px;
        border: 1px solid #cbd5e1;
        border-radius: 20px;
        outline: none;
        font-size: 14px;
        transition: border-color 0.3s;
    }
    .ytv-search-box input:focus {
        border-color: var(--ytv-primary);
    }
    .ytv-search-box i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
    }
    .ytv-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }
    .ytv-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        transition: transform 0.3s, box-shadow 0.3s;
        display: flex;
        flex-direction: column;
    }
    .ytv-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        border-color: var(--ytv-secondary);
    }
    .ytv-card-img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        background: #f1f5f9;
    }
    .ytv-card-body {
        padding: 15px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .ytv-card-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--ytv-text);
        margin-bottom: 10px;
    }
    .ytv-card-address {
        font-size: 14px;
        color: #64748b;
        margin-bottom: 15px;
        display: flex;
        gap: 8px;
    }
    .ytv-card-address i {
        color: var(--ytv-secondary);
        margin-top: 3px;
    }
    .ytv-card-btn {
        margin-top: auto;
        display: block;
        width: 100%;
        padding: 10px;
        background: var(--ytv-primary);
        color: white;
        text-align: center;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.3s;
    }
    .ytv-card-btn:hover {
        background: var(--ytv-secondary);
        color: white;
    }

    /* FOOTER */
    .ytv-footer {
        background: #e0f2fe; 
        color: #334155;
        padding: 20px 30px 10px 30px;
        display: flex;
        flex-direction: column;
        border-top: 4px solid var(--ytv-primary);
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
    }
    .ytv-footer-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 20px;
    }
    .ytv-support-col {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .ytv-support-phones {
        font-size: 16px;
        font-weight: 500;
    }
    .ytv-support-phones span {
        color: var(--ytv-primary);
        font-weight: 700;
        font-size: 18px;
    }
    .ytv-policies-col {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        font-weight: 500;
        margin-top: 5px;
    }
    .ytv-policies-col a {
        color: #0f172a;
        text-decoration: none;
        transition: color 0.2s;
    }
    .ytv-policies-col a:hover {
        color: var(--ytv-primary);
    }
    .ytv-policies-col .separator {
        color: #94a3b8;
    }
    .ytv-footer-bottom {
        text-align: center;
        font-size: 14px;
        color: #64748b;
        border-top: 1px solid #bae6fd;
        padding-top: 15px;
    }

    /* RESPONSIVE */
    @@media (max-width: 992px) {
        .ytv-header { flex-direction: column; gap: 15px; text-align: center; }
        .ytv-main { flex-direction: column; }
        .ytv-sidebar { width: 100%; border-right: none; border-bottom: 1px solid #e2e8f0; padding: 15px; }
        .ytv-grid { grid-template-columns: repeat(2, 1fr); }
        .ytv-footer-top { flex-direction: column; gap: 20px; align-items: center; text-align: center; }
        .ytv-policies-col { justify-content: center; }
    }
    @@media (max-width: 576px) {
        .ytv-grid { grid-template-columns: 1fr; }
        .ytv-sidebar { padding: 10px; }
        .ytv-content { padding: 15px; }
        .ytv-search-box { width: 100%; }
        .ytv-content-title { flex-direction: column; align-items: flex-start; }
    }
</style>

<div class="ytv-header">
    <a href="/Home/ThongTinBenhNhan" class="ytv-logo-area">
        <img src="/static/logo-yte.png" alt="Logo" style="height: 65px; width: 65px; object-fit: cover; background: white; border-radius: 50%; padding: 0;" />
        <div class="ytv-logo-text">Y TẾ<br>VIỆT</div>
    </a>
    <div class="ytv-header-title d-none d-md-block">
        <h1>Dịch Vụ Đăng Ký Khám Bệnh Online</h1>
        <p>Tiện lợi - Nhanh chóng - Chính xác</p>
