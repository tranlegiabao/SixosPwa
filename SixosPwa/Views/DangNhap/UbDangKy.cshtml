                                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        fill="currentColor"
                                        class="icon icon-tabler icons-tabler-filled icon-tabler-shield-lock">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path
                                            d="M11.998 2l.118 .007l.059 .008l.061 .013l.111 .034a.993 .993 0 0 1 .217 .112l.104 .082l.255 .218a11 11 0 0 0 7.189 2.537l.342 -.01a1 1 0 0 1 1.005 .717a13 13 0 0 1 -9.208 16.25a1 1 0 0 1 -.502 0a13 13 0 0 1 -9.209 -16.25a1 1 0 0 1 1.005 -.717a11 11 0 0 0 7.531 -2.527l.263 -.225l.096 -.075a.993 .993 0 0 1 .217 -.112l.112 -.034a.97 .97 0 0 1 .119 -.021l.115 -.007zm.002 7a2 2 0 0 0 -1.995 1.85l-.005 .15l.005 .15a2 2 0 0 0 .995 1.581v1.769l.007 .117a1 1 0 0 0 1.993 -.117l.001 -1.768a2 2 0 0 0 -1.001 -3.732z" />
                                    </svg>
                                </span>
                                <input type="password" style="padding-left: 2.5rem !important; padding: 1.3rem;"
                                    class="form-control p-3" placeholder="Mật khẩu*" id="password_send"
                                    autocomplete="off">
                            </div>
                        </div>
                        <div class="mb-2">
                            <div class="input-icon">
                                <span class="input-icon-addon text-primary">
                                    <svg style="width: 1.5rem !important; height: 1.5rem !important;"
                                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        fill="currentColor"
                                        class="icon icon-tabler icons-tabler-filled icon-tabler-shield-lock">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path
                                            d="M11.998 2l.118 .007l.059 .008l.061 .013l.111 .034a.993 .993 0 0 1 .217 .112l.104 .082l.255 .218a11 11 0 0 0 7.189 2.537l.342 -.01a1 1 0 0 1 1.005 .717a13 13 0 0 1 -9.208 16.25a1 1 0 0 1 -.502 0a13 13 0 0 1 -9.209 -16.25a1 1 0 0 1 1.005 -.717a11 11 0 0 0 7.531 -2.527l.263 -.225l.096 -.075a.993 .993 0 0 1 .217 -.112l.112 -.034a.97 .97 0 0 1 .119 -.021l.115 -.007zm.002 7a2 2 0 0 0 -1.995 1.85l-.005 .15l.005 .15a2 2 0 0 0 .995 1.581v1.769l.007 .117a1 1 0 0 0 1.993 -.117l.001 -1.768a2 2 0 0 0 -1.001 -3.732z" />
                                    </svg>
                                </span>
                                <input type="password" style="padding-left: 2.5rem !important; padding: 1.3rem;"
                                    class="form-control p-3" placeholder="Nhập lại mật khẩu*" id="confirm_password_send"
                                    autocomplete="off">
                            </div>
                        </div>
                        <div class="fw-bold">
                            <label class="form-label mb-2 fw-bold fs-4">Gửi mã xác thực qua:</label>
                            <div>
                                <label class="form-check">
                                    <input class="form-check-input" type="radio" name="register_xacThuc" checked
                                           value="3">
                                    <span class="form-check-label fs-4">SMS</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="radio" name="register_xacThuc"
                                        value="1">
                                    <span class="form-check-label fs-4">Zalo</span>
                                </label>
                                <label class="form-check d-none">
                                    <input class="form-check-input" type="radio" name="register_xacThuc" value="2">
                                    <span class="form-check-label fs-4">Email</span>
                                </label>
                            </div>
                        <div class="form-footer mt-2">
                            <!-- Mobile -->
                            <div class="d-md-none text-center my-4 py-2">
                                <a href="/DangNhap/UbLogin?coSo=@ViewBag.SlugCoSo" class="text-primary fw-bold text-decoration-none" style="font-size: 1.05rem;">
                                    Quay lại
                                </a>
                            </div>
                            <div class="d-md-none mb-3">
                                <button type="button" class="btn btn-primary w-100 py-2"
                                        id="register_btnGetCodeMobile">
                                    <span>Tiếp tục</span>
                                </button>
                            </div>

                            <!-- Desktop -->
                            <div class="d-none d-md-flex row g-3">
                                <div class="col-6">
                                    <a href="/DangNhap/UbLogin?coSo=@ViewBag.SlugCoSo" class="btn btn-outline-primary w-100">
                                        Quay lại
                                    </a>
                                </div>
                                <div class="col-6">
                                    <button type="button" class="btn btn-primary w-100"
                                            id="register_btnGetCode">
                                        <span>Tiếp tục</span>
                                    </button>
                                </div>
