@model DoiTacListViewModel
@{
    ViewData["Title"] = "Đối tác";
}
<div class="page-header-row"><div><div class="page-kicker">QUẢN LÝ HỆ SINH THÁI</div><h1 class="page-heading">Đối tác</h1><p class="page-description">Quản lý các đơn vị đang kết nối và cung cấp dữ liệu cho ứng dụng.</p></div><a asp-action="Create" class="btn admin-btn-primary"><span>+</span> Thêm đối tác</a></div>
<div class="admin-panel">
    <form method="get" class="filter-bar"><div class="search-control admin-search-control"><span>⌕</span><select class="admin-query-select" data-query-name="q" data-initial-value="@Model.Query" placeholder="Tìm mã, tên hoặc số điện thoại..." aria-label="Tìm đối tác"></select><input type="hidden" name="q" value="@Model.Query" /></div><button class="btn admin-btn-secondary" type="submit">Tìm kiếm</button>@if (!string.IsNullOrWhiteSpace(Model.Query)) { <a asp-action="Index" class="clear-filter">Xóa lọc</a> }</form>
    <div class="table-meta"><span><strong>@Model.TotalItems.ToString("N0")</strong> đối tác</span><span>Thông tin nhạy cảm được bảo vệ</span></div>
    <div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead><tr><th>Đối tác</th><th>Liên hệ</th><th>Thương hiệu</th><th class="text-end">Thao tác</th></tr></thead><tbody>
    @if (Model.Items.Count == 0) { <tr><td colspan="4"><div class="table-empty"><div>◇</div><strong>Chưa có đối tác phù hợp</strong><span>Hãy thử từ khóa khác.</span></div></td></tr> }
    else { foreach (var item in Model.Items) { <tr><td><div class="table-person"><span class="mini-avatar avatar-purple">@(item.TenDT.FirstOrDefault().ToString())</span><div><strong>@item.TenDT</strong><small>@item.MaDT</small></div></div></td><td><div class="contact-stack"><span>@(item.SDT ?? "Chưa cập nhật")</span><small>@(item.Email ?? "Chưa có email")</small></div></td><td>@(string.IsNullOrWhiteSpace(item.BrandName) ? "—" : item.BrandName)</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="table-action">Chỉnh sửa <span>→</span></a></td></tr> } }
    </tbody></table></div>
    <partial name="_Pagination" model="new PaginationViewModel { Page = Model.Page, TotalPages = Model.TotalPages, Query = Model.Query }" />
</div>
