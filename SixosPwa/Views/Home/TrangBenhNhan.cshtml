@{
    Layout = null;
    ViewData["Title"] = "Trang bệnh nhân";
    var rawTen = (ViewBag.TenBenhNhan as string)?.Trim() ?? "";
    var tenChao = rawTen;
    if (!string.IsNullOrWhiteSpace(rawTen))
    {
        var parts = rawTen.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 0)
        {
            var lastWord = parts[parts.Length - 1];
            if (!long.TryParse(lastWord, out _))
            {
                tenChao = lastWord.ToUpper();
            }
        }
    }
}

<!doctype html>
<html lang="vi">
<head>
    <title>@ViewBag.TenCoSo — Cổng Bệnh Nhân</title>
    <partial name="_CongHead" />
    <link rel="stylesheet" href="~/css/BenhNhan/trang-benh-nhan.css" asp-append-version="true" />
</head>
<body class="bn-trang">

    <!-- Ambient Medical Background Illustrations (matching reference design) -->
    <!-- Left Leaves Motif -->
    <svg class="bn-bg-decor bn-bg-decor-left" viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M40 300C30 240 60 170 110 130C160 90 230 80 280 60" stroke="#38bdf8" stroke-width="4" stroke-linecap="round" opacity="0.3" />
        <path d="M80 260C40 220 20 170 30 120C40 70 80 30 140 20C170 60 160 120 120 160C90 190 80 230 80 260Z" fill="url(#gradLeaf1)" opacity="0.5" />
        <path d="M140 200C110 160 100 110 120 70C140 30 190 10 240 20C250 60 230 110 190 140C160 165 145 185 140 200Z" fill="url(#gradLeaf2)" opacity="0.4" />
        <path d="M190 140C180 100 190 60 220 30C250 5 290 5 320 20C320 60 290 90 260 110C230 130 205 135 190 140Z" fill="url(#gradLeaf1)" opacity="0.35" />
        <defs>
            <linearGradient id="gradLeaf1" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#0284c7" />
            </linearGradient>
            <linearGradient id="gradLeaf2" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#7dd3fc" />
                <stop offset="100%" stop-color="#0369a1" />
            </linearGradient>
        </defs>
    </svg>

    <!-- Right Stethoscope & Heart Motif -->
    <svg class="bn-bg-decor bn-bg-decor-right" viewBox="0 0 380 380" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M260 180 C260 140 220 120 190 150 C160 120 120 140 120 180 C120 230 190 280 190 280 C190 280 260 230 260 180 Z" fill="url(#gradHeart)" opacity="0.45" />
        <path d="M145 195 L170 195 L180 170 L195 220 L205 185 L215 195 L235 195" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.9" />
        <path d="M110 230 C90 260 90 310 140 330 C190 350 250 320 270 270 C290 220 270 160 270 160" stroke="#38bdf8" stroke-width="5" stroke-linecap="round" fill="none" opacity="0.4" />
        <circle cx="270" cy="330" r="14" fill="#bae6fd" opacity="0.7" stroke="#0284c7" stroke-width="4" />
        <circle cx="75" cy="230" r="8" fill="#38bdf8" opacity="0.6" />
        <defs>
            <linearGradient id="gradHeart" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#0284c7" />
            </linearGradient>
        </defs>
    </svg>

    <!-- Floating Medical Plus Icons -->
    <svg class="bn-bg-decor bn-bg-plus-1" viewBox="0 0 24 24" fill="#0284c7">
        <path d="M19 10.5h-5.5V5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v5.5H5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5h5.5V19c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-5.5H19c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5z"/>
    </svg>
    <svg class="bn-bg-decor bn-bg-plus-2" viewBox="0 0 24 24" fill="#0284c7">
        <path d="M19 10.5h-5.5V5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v5.5H5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5h5.5V19c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-5.5H19c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5z"/>
    </svg>
    <svg class="bn-bg-decor bn-bg-plus-3" viewBox="0 0 24 24" fill="#0284c7">
        <path d="M19 10.5h-5.5V5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v5.5H5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5h5.5V19c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-5.5H19c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5z"/>
    </svg>
    <svg class="bn-bg-decor bn-bg-plus-4" viewBox="0 0 24 24" fill="#0284c7">
        <path d="M19 10.5h-5.5V5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v5.5H5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5h5.5V19c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-5.5H19c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5z"/>
    </svg>

    <!-- Main Container Card (Phone shell) -->
    <div class="bn-khung">

        <!-- Top Header with Hospital background image & bottom wave -->
        <div class="bn-dau-wrap">
            <!-- Header Content -->
            <header class="bn-dau">
                <div class="bn-dau-trai">
                    <a class="bn-logo-emblem" href="/Home/DanhSachCoSo-@ViewBag.MaNhomCS" title="Xem các cơ sở khác">
                        @if (!string.IsNullOrEmpty(ViewBag.LogoCoSo))
                        {
                            <img src="@ViewBag.LogoCoSo" alt="@ViewBag.TenCoSo" />
                        }
                        else
                        {
                            <!-- Default Shield Heart Emblem -->
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                                <path d="M12 2L4 5V11.09C4 16.14 7.41 20.85 12 22C16.59 20.85 20 16.14 20 11.09V5L12 2Z" fill="#0284c7" />
                                <path d="M12 7V17M7 12H17" stroke="#ffffff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        }
                    </a>
                    <div class="bn-dau-chu">
                        <span class="bn-coso">@ViewBag.TenCoSo</span>
                        <span class="bn-chao">Xin chào @tenChao 👋</span>
                        <span class="bn-slogan">Sức khỏe của bạn là ưu tiên của chúng tôi</span>
                    </div>
                </div>

                <div class="bn-dau-phai">
                    <!-- Nút Hamburger Menu -->
                    <button type="button" class="bn-nut-menu" onclick="toggleBnMenu(event)" title="Menu tùy chọn">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>

                    <div id="bnMenuDropdown" class="bn-menu-dropdown" onclick="event.stopPropagation()">
                        <a class="bn-menu-item dangxuat" href="/DangNhap/DangXuat">
                            <span>🚪</span>
                            <span>Đăng xuất</span>
                        </a>
                    </div>
                </div>
            </header>

            <!-- Decorative wave separating header and card body -->
            <svg class="bn-header-wave" viewBox="0 0 500 24" preserveAspectRatio="none" fill="#ffffff">
                <path d="M0,0 C150,22 350,22 500,0 L500,24 L0,24 Z" />
            </svg>
        </div>

        <!-- Patient Info Card with Leaf accents -->
        <div class="bn-card-container">
            <!-- Decorative leaves on sides of patient card -->
            <svg class="bn-leaf-decor-left" viewBox="0 0 38 38" fill="none">
                <path d="M8 32C6 24 10 16 18 10C24 6 32 4 36 2C36 8 32 18 24 24C18 28 12 30 8 32Z" fill="#bbf7d0" opacity="0.9"/>
                <path d="M14 26C12 20 16 14 22 10C26 7 32 6 36 4C36 8 32 16 26 20C22 23 18 25 14 26Z" fill="#86efac" opacity="0.75"/>
            </svg>
            <svg class="bn-leaf-decor-right" viewBox="0 0 44 44" fill="none">
                <path d="M36 38C38 30 34 20 26 14C20 9 10 6 4 4C4 12 10 22 18 28C24 33 30 36 36 38Z" fill="#bbf7d0" opacity="0.9"/>
                <path d="M30 32C32 25 28 18 22 12C16 8 10 6 6 4C6 10 12 18 18 24C22 28 26 30 30 32Z" fill="#86efac" opacity="0.75"/>
            </svg>

            <!-- Patient Info Section -->
            <section class="bn-danhtinh-card">
                <!-- Hàng đầu: Avatar + Mã hồ sơ (Trái) & Hồ sơ của tôi (Phải) -->
                <div class="bn-danhtinh-hang-dau">
                    <div class="bn-danhtinh-avatar-wrap">
                        <div class="bn-avatar-relative">
                            <div class="bn-avatar-bn">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                </svg>
                            </div>
                            <!-- Small Camera Icon Badge -->
                            <div class="bn-avatar-camera" title="Ảnh đại diện">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                    <circle cx="12" cy="13" r="4"></circle>
                                </svg>
                            </div>
                        </div>

                        <div class="bn-mahoso-block">
                            <span class="bn-nhan-mahoso">Mã bệnh nhân</span>
                            <span class="bn-giatri-mahoso">@(string.IsNullOrWhiteSpace(ViewBag.MaBN as string) ? "########" : ViewBag.MaBN)</span>
                        </div>
                    </div>

                    <a class="bn-the-hoso-top" href="/benh-nhan/ho-so" title="Xem & quản lý hồ sơ của tôi">
                        <div class="bn-icon-hoso">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <span class="bn-ten-hoso">Hồ sơ của tôi</span>
                        <span class="bn-arrow-hoso">›</span>
                    </a>
                </div>

                <!-- Hàng dưới: CCCD, Điện thoại, Họ và tên (Trái) & Trạng thái (Phải) -->
                <div class="bn-danhtinh-hang-duoi">
                    <div class="bn-danhtinh-thongtin-list">
                        <div class="bn-dong-phu">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            <span>CCCD: <strong>@(ViewBag.CccdCheBot ?? "—")</strong></span>
                        </div>
                        <div class="bn-dong-phu">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            <span>Điện thoại: <strong>@(ViewBag.DienThoai ?? "—")</strong></span>
                        </div>
                        <div class="bn-dong-phu">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            <span>Họ và tên: <strong>@ViewBag.TenBenhNhan</strong></span>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Incomplete Profile Alert Card (Orange Theme) -->
        @if (ViewBag.HoSoThieuTruong == true && ViewBag.IdHoSoDangXem != null)
        {
            <div class="bn-hoanthien-box">
                <div class="bn-hoanthien-icon-trai">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <path d="M12 2L4 5V11.09C4 16.14 7.41 20.85 12 22C16.59 20.85 20 16.14 20 11.09V5L12 2Z" fill="#ffedd5" stroke="#ea580c" stroke-width="1.8"/>
                        <path d="M12 16C12 16 16 13.5 16 11C16 9.5 14.8 8.5 13.5 8.5C12.7 8.5 12.3 9 12 9.5C11.7 9 11.3 8.5 10.5 8.5C9.2 8.5 8 9.5 8 11C8 13.5 12 16 12 16Z" fill="#ea580c"/>
                    </svg>
                </div>
                <div class="bn-hoanthien-noidung">
                    <div class="bn-hoanthien-text">
                        Hồ sơ của bạn còn thiếu họ tên, ngày sinh hoặc giới tính nên cơ sở chưa tìm được bệnh án cũ của bạn.
                    </div>
                    <a href="/benh-nhan/ho-so/sua?id=@ViewBag.IdHoSoDangXem" class="bn-hoanthien-link">
                        <span>Hoàn thiện hồ sơ</span>
                        <span>→</span>
                    </a>
                </div>
                <div class="bn-hoanthien-icon-phai">
                    <svg width="34" height="34" viewBox="0 0 40 40" fill="none">
                        <rect x="8" y="6" width="24" height="30" rx="4" fill="#ffffff" stroke="#fb923c" stroke-width="2"/>
                        <rect x="14" y="2" width="12" height="6" rx="2" fill="#ea580c"/>
                        <circle cx="20" cy="5" r="1.5" fill="#ffffff"/>
                        <path d="M14 18h12M14 24h8" stroke="#fed7aa" stroke-width="2.5" stroke-linecap="round"/>
                        <circle cx="28" cy="28" r="6" fill="#ea580c"/>
                        <path d="M28 25v6M25 28h6" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </div>
            </div>
        }

        <!-- Token form for Anti-forgery -->
        <form id="formDaXemLich" style="display:none;">@Html.AntiForgeryToken()</form>

        @if (ViewBag.CoLoiKetNoi == true)
        {
            <div class="bn-canhbao">
                Chưa kết nối được với hệ thống của cơ sở. Bạn vẫn xem được thông tin ở đây,
                nhưng các dịch vụ đặt lịch và tra cứu hồ sơ tạm thời chưa dùng được.
            </div>
        }

        <!-- Section Header "DỊCH VỤ" -->
        <div class="bn-tieude-dichvu-wrap">
            <div class="bn-tieude-dichvu">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
                <span>DỊCH VỤ</span>
            </div>
            <span class="bn-tieude-slogan">Chăm sóc sức khỏe – Đồng hành cùng bạn ♡</span>
        </div>

        <!-- Services Grid (2x2) -->
        <div class="bn-luoi-dichvu">
            <!-- 1. Lịch khám của tôi -->
            @if (ViewBag.HienOLichKham == true)
            {
                <div class="bn-the-dv bn-dv-lichhen" role="button" tabindex="0" onclick="moModalLichHen()" onkeydown="if(event.key==='Enter') moModalLichHen()" style="cursor: pointer;">
                    <span class="bn-dv-badge" id="bnLichHenBadge" title="Lịch chưa xem" style="display:none;">0</span>
                    <div class="bn-the-dv-top">
                        <div class="bn-dv-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                                <circle cx="8" cy="14" r="1" fill="currentColor"></circle>
                                <circle cx="12" cy="14" r="1" fill="currentColor"></circle>
                                <circle cx="16" cy="14" r="1" fill="currentColor"></circle>
                            </svg>
                        </div>
                        <span class="bn-dv-ten">Lịch khám của tôi</span>
                        <span class="bn-dv-mota">Hẹn sắp tới và những lần đã khám</span>
                    </div>
                    <div class="bn-the-dv-bottom">
                        <div class="bn-dv-btn-arrow">›</div>
                    </div>
                    <!-- Watermark Calendar & Clock -->
                    <svg class="bn-dv-watermark" viewBox="0 0 60 60" fill="none">
                        <rect x="8" y="12" width="40" height="38" rx="8" fill="#bae6fd" opacity="0.45" stroke="#0284c7" stroke-width="2"/>
                        <rect x="8" y="12" width="40" height="12" rx="4" fill="#0284c7" opacity="0.55"/>
                        <rect x="14" y="8" width="5" height="8" rx="2.5" fill="#0369a1"/>
                        <rect x="37" y="8" width="5" height="8" rx="2.5" fill="#0369a1"/>
                        <circle cx="18" cy="34" r="2.5" fill="#0284c7" opacity="0.6"/>
                        <circle cx="28" cy="34" r="2.5" fill="#0284c7" opacity="0.6"/>
                        <circle cx="38" cy="34" r="2.5" fill="#0284c7" opacity="0.6"/>
                        <circle cx="44" cy="44" r="11" fill="#ffffff" stroke="#0284c7" stroke-width="2.5"/>
                        <polyline points="44 38 44 44 48 44" stroke="#0284c7" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </div>
            }

            <!-- 2. Đơn thuốc -->
            <a class="bn-the-dv bn-dv-donthuoc" href="/benh-nhan/tai-lieu?nhom=don-thuoc">
                <div class="bn-the-dv-top">
                    <div class="bn-dv-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path>
                            <path d="m8.5 8.5 7 7"></path>
                        </svg>
                    </div>
                    <span class="bn-dv-ten">Đơn thuốc</span>
                    <span class="bn-dv-mota">Xem thuốc đã kê</span>
                </div>
                <div class="bn-the-dv-bottom">
                    <div class="bn-dv-btn-arrow">›</div>
                </div>
                <!-- Watermark Pill Capsule & Bottle -->
                <svg class="bn-dv-watermark" viewBox="0 0 60 60" fill="none">
                    <rect x="24" y="16" width="26" height="34" rx="6" fill="#a7f3d0" opacity="0.5" stroke="#10b981" stroke-width="2"/>
                    <rect x="28" y="10" width="18" height="6" rx="2" fill="#059669" opacity="0.65"/>
                    <circle cx="37" cy="33" r="7" fill="#ffffff"/>
                    <path d="M37 29v8M33 33h8" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
                    <rect x="6" y="36" width="22" height="12" rx="6" transform="rotate(-30 6 36)" fill="#6ee7b7" opacity="0.75" stroke="#059669" stroke-width="1.8"/>
                    <circle cx="12" cy="48" r="3" fill="#10b981" opacity="0.6"/>
                    <circle cx="20" cy="50" r="3.5" fill="#34d399" opacity="0.6"/>
                </svg>
            </a>

            <!-- 3. Kết quả khám -->
            <a class="bn-the-dv bn-dv-ketquakham" href="/benh-nhan/tai-lieu?nhom=ket-qua-kham">
                <div class="bn-the-dv-top">
                    <div class="bn-dv-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <span class="bn-dv-ten">Kết quả khám</span>
                    <span class="bn-dv-mota">Xem kết quả xét nghiệm, chẩn đoán</span>
                </div>
                <div class="bn-the-dv-bottom">
                    <div class="bn-dv-btn-arrow">›</div>
                </div>
                <!-- Watermark Clipboard Checklist with Heart -->
                <svg class="bn-dv-watermark" viewBox="0 0 60 60" fill="none">
                    <rect x="12" y="12" width="36" height="42" rx="6" fill="#fed7aa" opacity="0.5" stroke="#f97316" stroke-width="2"/>
                    <rect x="20" y="6" width="20" height="8" rx="3" fill="#ea580c" opacity="0.65"/>
                    <polyline points="20 28 23 31 29 25" stroke="#ea580c" stroke-width="2" stroke-linecap="round"/>
                    <line x1="32" y1="28" x2="42" y2="28" stroke="#f97316" stroke-width="2" stroke-linecap="round"/>
                    <polyline points="20 38 23 41 29 35" stroke="#ea580c" stroke-width="2" stroke-linecap="round"/>
                    <line x1="32" y1="38" x2="42" y2="38" stroke="#f97316" stroke-width="2" stroke-linecap="round"/>
                    <path d="M40 48c0-2.5 3-4.5 4.5-2 1.5-2.5 4.5-.5 4.5 2 0 3-4.5 5.5-4.5 5.5S40 51 40 48z" fill="#f97316" opacity="0.75"/>
                </svg>
            </a>

            <!-- 4. Quản lý hóa đơn -->
            <a class="bn-the-dv bn-dv-hoadon" href="/benh-nhan/sap-co?muc=quan-ly-hoa-don">
                <div class="bn-the-dv-top">
                    <div class="bn-dv-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"></path>
                            <line x1="8" y1="7" x2="16" y2="7"></line>
                            <line x1="8" y1="11" x2="16" y2="11"></line>
                            <line x1="8" y1="15" x2="13" y2="15"></line>
                        </svg>
                    </div>
                    <span class="bn-dv-ten">Quản lý hóa đơn</span>
                    <span class="bn-dv-mota">Chi tiết thanh toán, bảo hiểm</span>
                </div>
                <div class="bn-the-dv-bottom">
                    <div class="bn-dv-btn-arrow">›</div>
                </div>
                <!-- Watermark Bill & Coin -->
                <svg class="bn-dv-watermark" viewBox="0 0 60 60" fill="none">
                    <path d="M12 12v38l4-2 4 2 4-2 4 2 4-2 4 2V12l-4 2-4-2-4 2-4-2-4 2-4-2z" fill="#ddd6fe" opacity="0.55" stroke="#8b5cf6" stroke-width="2"/>
                    <line x1="18" y1="22" x2="30" y2="22" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round"/>
                    <line x1="18" y1="28" x2="28" y2="28" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round"/>
                    <circle cx="40" cy="42" r="10" fill="#a78bfa" opacity="0.8" stroke="#7c3aed" stroke-width="2"/>
                    <text x="40" y="47" font-size="14" font-weight="900" fill="#ffffff" text-anchor="middle" font-family="sans-serif">$</text>
                </svg>
            </a>

            <!-- 5. Kế hoạch điều trị (Nha khoa) -->
            @if (string.Equals(ViewBag.MaNhomCS as string, "nhakhoa", StringComparison.OrdinalIgnoreCase))
            {
                <a class="bn-the-dv bn-dv-kehoach" href="/benh-nhan/sap-co?muc=ke-hoach-dieu-tri">
                    <div class="bn-dv-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <line x1="12" y1="8" x2="12" y2="14"></line>
                            <line x1="9" y1="11" x2="15" y2="11"></line>
                        </svg>
                    </div>
                    <div class="bn-dv-info">
                        <span class="bn-dv-ten">Kế hoạch điều trị</span>
                        <span class="bn-dv-mota">Lộ trình điều trị, phục hồi và hướng dẫn theo dõi</span>
                    </div>
                    <div class="bn-kehoach-decor">
                        <svg class="bn-kehoach-ecg" viewBox="0 0 100 30" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M0 15 L25 15 L35 5 L45 25 L55 10 L65 20 L75 15 L100 15" />
                        </svg>
                        <span class="bn-kehoach-arrow">›</span>
                    </div>
                </a>
            }
        </div>

        <!-- Support Hotline Banner & Footer Wrapper (Fixed bottom on mobile) -->
        <div class="bn-footer-wrapper">
            <!-- Support Hotline Banner with Nurse Avatar -->
            <div class="bn-hotline-banner">
                <div class="bn-hotline-trai">
                    <div class="bn-nurse-avatar-wrap">
                        <svg width="42" height="42" viewBox="0 0 44 44" fill="none">
                            <circle cx="22" cy="22" r="21" fill="#e0f2fe" stroke="#bae6fd" stroke-width="1.5"/>
                            <!-- Nurse Hair -->
                            <path d="M14 18c0-6 4-10 8-10s8 4 8 10c0 4-1 6-2 7H16c-1-1-2-3-2-7z" fill="#1e293b"/>
                            <!-- Nurse Face -->
                            <circle cx="22" cy="18" r="6.5" fill="#fed7aa"/>
                            <!-- Hair bangs -->
                            <path d="M16 16c1-2 3-3 6-3s5 1 6 3c-2-1-4-1.5-6-1.5s-4 .5-6 1.5z" fill="#0f172a"/>
                            <!-- Eyes & Smile -->
                            <circle cx="20" cy="18" r="0.8" fill="#0f172a"/>
                            <circle cx="24" cy="18" r="0.8" fill="#0f172a"/>
                            <path d="M21 21c.5.5 1.5.5 2 0" stroke="#ea580c" stroke-width="0.8" stroke-linecap="round"/>
                            <!-- White Scrub / Lab Coat -->
                            <path d="M12 36c1-8 5-11 10-11s9 3 10 11H12z" fill="#ffffff"/>
                            <path d="M18 25l4 5 4-5" stroke="#0284c7" stroke-width="1.2" fill="none"/>
                            <!-- Stethoscope / Medical chart -->
                            <rect x="18" y="29" width="8" height="10" rx="1.5" fill="#0284c7"/>
                            <line x1="20" y1="32" x2="24" y2="32" stroke="#ffffff" stroke-width="1"/>
                            <line x1="20" y1="35" x2="23" y2="35" stroke="#ffffff" stroke-width="1"/>
                        </svg>
                        <div class="bn-nurse-heart">
                            <svg width="9" height="9" viewBox="0 0 24 24" fill="#0284c7">
                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="bn-hotline-info">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <span>Hỗ trợ: <a href="tel:0901259192">0901 25 91 92</a></span>
                    </div>
                </div>
            </div>

            <!-- Footer with City Skyline Silhouette -->
            <footer class="bn-chan">
                <!-- City Skyline SVG Silhouette -->
                <svg class="bn-chan-skyline" viewBox="0 0 160 38" fill="#0284c7">
                    <rect x="10" y="16" width="14" height="22" rx="1"/>
                    <rect x="28" y="8" width="18" height="30" rx="1"/>
                    <rect x="50" y="20" width="12" height="18" rx="1"/>
                    <rect x="66" y="12" width="16" height="26" rx="1"/>
                    <rect x="86" y="4" width="20" height="34" rx="1"/>
                    <rect x="110" y="14" width="14" height="24" rx="1"/>
                    <rect x="128" y="10" width="18" height="28" rx="1"/>
                    <rect x="150" y="22" width="10" height="16" rx="1"/>
                </svg>

                <div class="bn-lienket-phu">
                    <a href="https://sixossoft.com/" target="_blank" rel="noopener noreferrer" title="SixOsSoft">Đơn vị phối hợp</a>
                    <span class="bn-gach-chan">|</span>
                    <a href="/benh-nhan/sap-co?muc=ho-tro">Hỗ trợ người bệnh</a>
                    <span class="bn-gach-chan">|</span>
                    <a href="/" class="bn-yte-viet-brand" title="Về Trang chủ Y Tế Việt" style="text-decoration: none;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="#ef4444"/>
                            <path d="M12 6.5v5m-2.5-2.5h5" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                        <strong>Y TẾ VIỆT</strong>
                    </a>
                </div>
            </footer>
        </div>
    </div>


    <!-- ==================== POPUP THÔNG BÁO LỊCH KHÁM (PHONG CÁCH VIETCOMBANK) ==================== -->
    <div id="modalLichHen" class="vcb-overlay" style="display: none;" onclick="xuLyBamNgoaiModal(event)" role="dialog" aria-modal="true" aria-labelledby="vcbTieuDe">
        <div class="vcb-hop" onclick="event.stopPropagation()">
            
            <!-- Top App Bar -->
            <div class="vcb-top-bar">
                <button type="button" class="vcb-nut-back" onclick="dongModalLichHen()" aria-label="Quay lại">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                </button>
                <h2 id="vcbTieuDe" class="vcb-tieude-chinh">Lịch khám của tôi</h2>
                <button type="button" class="vcb-nut-doc-tat-ca" onclick="danhDauTatCaDaDoc()" title="Đánh dấu tất cả đã đọc">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span class="vcb-badge-so-chua-doc" id="vcbBadgeChuaDoc" style="display:none;"></span>
                </button>
            </div>

            @* Thanh điều hướng tuần / tháng (Date Range Navigator).
               🔴 KHÁC BẢN CŨ MỘT ĐIỂM DUY NHẤT, và đó là điểm sinh ra lỗi 09/09:
               mở ô ra thì mặc định là **TẤT CẢ**, không lọc gì. Bản cũ mặc định lọc
               theo TUẦN HIỆN TẠI ⇒ hẹn tái khám (thường cách 1–3 tháng) không bao giờ
               rơi vào đó ⇒ ô rỗng, mà panel vẫn in "Bạn chưa có lịch hẹn tái khám nào
               sắp tới" — dịch im lặng thành "không có hẹn", đúng cái ADR 0025 cấm.
               Đo thật: hẹn 22/10/2026 bị giấu, tiến 6 tuần mới thấy.
               Bấm ‹ › là VÀO chế độ lọc tuần (người dùng chủ động), và khi đó luôn có
               bảng *Đang xem … / Bỏ lọc* ở dưới để thoát ra. *@
            <div class="vcb-tuan-navigator">
                <div class="vcb-tuan-chinh">
                    <button type="button" class="vcb-btn-mui-ten" onclick="chuyenKhoangThoiGian(-1)" aria-label="Trước">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                    <div class="vcb-tuan-chuoi" id="vcbChuoiKhoangNgay">Tất cả lịch khám</div>
                    <button type="button" class="vcb-btn-mui-ten" onclick="chuyenKhoangThoiGian(1)" aria-label="Sau">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
                <!-- Nút mở lịch tháng toàn diện (màn lịch tháng của nhánh bk) -->
                <div class="vcb-nut-tatca-wrap">
                    <button type="button" class="vcb-btn-xem-tat-ca" id="vcbBtnXemTatCa" onclick="moModalLichThang()">
                        <span class="vcb-tatca-icon">📅</span>
                        <span id="vcbTextTatCa">Xem tất cả các tuần trong tháng</span>
                        <span class="vcb-tatca-arrow">▼</span>
                    </button>
                </div>
            </div>

            @* Bang cho biet DANH SACH DANG BI LOC theo mot ngay. Bat buoc phai co: da
               cho loc thi phai co cho noi "dang loc" va mot nut bo loc, khong thi lap
               lai dung cai bay tuan — nguoi dung tuong minh khong co hen. *@
            <div class="vcb-dang-loc" id="vcbDangLoc" style="display:none;">
                <span id="vcbDangLocChu"></span>
                <button type="button" class="vcb-bo-loc" onclick="boLocNgay()">Bỏ lọc</button>
            </div>

            <!-- Ô tìm kiếm -->
            <div class="vcb-tim-kiem-wrap">
                <div class="vcb-tim-kiem-khung">
                    <span class="vcb-icon-search" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" id="vcbInputTimKiem" class="vcb-input-search" placeholder="Tìm trong lịch khám" oninput="timKiemThongBaoVcb(this.value)" />
                </div>
            </div>

            <!-- Danh sách các thẻ thông báo (Cards feed) -->
            <div class="vcb-danh-sach-wrap" id="vcbDanhSachThongBao">
                <!-- Dynamic cards rendered by JS -->
            </div>

            <!-- ==================== GIAO DIỆN LỊCH THÁNG (CHUẨN THEO ẢNH USER) ==================== -->
            <div id="vcbModalLichThang" class="vcb-cal-overlay" style="display: none;">
                <div class="vcb-cal-hop">
                    <!-- Top Bar Lịch Tháng -->
                    <div class="vcb-cal-top-bar">
                        <button type="button" class="vcb-cal-btn-icon" onclick="dongModalLichThang()" title="Quay lại danh sách">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                        </button>
                        
                        <!-- Vùng chuyển tháng ở giữa với 2 cánh bấm cực rộng -->
                        <div class="vcb-cal-thang-container">
                            <!-- Vùng bấm bên trái: Bấm bất cứ đâu vùng này -> Về tháng trước -->
                            <div class="vcb-cal-vung-chuyen vung-trai" onclick="chuyenThangLich(-1, 'right')" title="Bấm để xem tháng trước">
                                <span class="vcb-cal-nav-arrow">‹</span>
                            </div>

                            <!-- Tiêu đề Tháng -->
                            <span class="vcb-cal-tieude-thang" id="vcbCalTieuDeThang">TH09</span>

                            <!-- Vùng bấm bên phải: Bấm bất cứ đâu vùng này -> Sang tháng sau -->
                            <div class="vcb-cal-vung-chuyen vung-phai" onclick="chuyenThangLich(1, 'left')" title="Bấm để xem tháng sau">
                                <span class="vcb-cal-nav-arrow">›</span>
                            </div>
                        </div>

                        <div class="vcb-cal-top-phai" style="width: 38px;"></div>
                    </div>

                    <!-- Chú thích màu sắc (Legend) -->
                    <div class="vcb-cal-legend">
                        <div class="vcb-cal-legend-item">
                            <span class="vcb-cal-dot dot-can-ke"></span>
                            <span>Cận kề / Hôm nay</span>
                        </div>
                        <div class="vcb-cal-legend-item">
                            <span class="vcb-cal-dot dot-co-hen"></span>
                            <span>Ngày hẹn</span>
                        </div>
                        <div class="vcb-cal-legend-item">
                            <span class="vcb-cal-dot dot-da-qua"></span>
                            <span>Đã qua</span>
                        </div>
                    </div>

                    <!-- Hàng Thứ (T.2 -> CN) -->
                    <div class="vcb-cal-thu-grid">
                        <div class="vcb-cal-thu-col">T.2</div>
                        <div class="vcb-cal-thu-col">T.3</div>
                        <div class="vcb-cal-thu-col">T.4</div>
                        <div class="vcb-cal-thu-col">T.5</div>
                        <div class="vcb-cal-thu-col">T.6</div>
                        <div class="vcb-cal-thu-col">T.7</div>
                        <div class="vcb-cal-thu-col cn">CN</div>
                    </div>

                    <!-- Lưới các ô ngày trong tháng -->
                    <div class="vcb-cal-ngay-grid" id="vcbCalNgayGrid">
                        <!-- Rendered by JS -->
                    </div>
                </div>
            </div>

            <!-- Popup Chọn Tuần (Dự phòng) -->
            <div id="vcbSheetChonTuan" class="vcb-sheet-overlay" style="display: none;" onclick="dongSheetChonTuan()">
                <div class="vcb-sheet-hop" onclick="event.stopPropagation()">
                    <div class="vcb-sheet-dau">
                        <div>
                            <h3 class="vcb-sheet-tieude">Chọn thời gian xem lịch</h3>
                            <div class="vcb-sheet-phude" id="vcbSheetTenThang">Tháng 09/2026</div>
                        </div>
                        <button type="button" class="vcb-sheet-nut-dong" onclick="dongSheetChonTuan()">✕</button>
                    </div>
                    <div class="vcb-sheet-danhsach" id="vcbSheetDanhSachTuan">
                        <!-- Dynamic week cards rendered by JS -->
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ==================== STYLES & SCRIPT PHONG CÁCH THÔNG BÁO VIETCOMBANK ==================== -->

    <script src="~/js/BenhNhan/trang-benh-nhan.js" asp-append-version="true"></script>
</body>
</html>
