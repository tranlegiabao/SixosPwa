    // Dang nhap khu Admin ky CA HAI cookie — AdminAuthentication.Scheme VA cookie
    // mac dinh, kem Role="Admin" (Areas/Admin/Controllers/DangNhapController.cs:113-121).
    // Nen o trang benh nhan, admin trong y het mot nguoi da dang nhap binh thuong.
    // Phai re rieng: admin KHONG co claim Cccd/MaCoSo nen "Ho so benh nhan" se roi
    // vao nhanh du phong cua DiTiep va da ve /benh-nhan rong khong ten.
    var laAdmin = daDangNhap && User.IsInRole("Admin");
}
@if (!daDangNhap)
{
