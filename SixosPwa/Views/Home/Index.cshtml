@{
    ViewData["Title"] = "Trung Tâm CSKH & Cổng Thông Tin Bệnh Nhân";
}

<!-- TOAST THÔNG BÁO TƯƠNG TÁC -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1080">
    <div id="appToast" class="toast align-items-center text-white bg-teal border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2" id="toastMessage">
                <i class="bi bi-check-circle-fill fs-5"></i> Thao tác thành công!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="health-portal">
    <!-- 1. BANNER XIN CHÀO & TÀI KHOẢN BỆNH NHÂN VIP -->
    <div class="glass-header p-4 p-md-5 mb-4 shadow-sm">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-white text-dark fw-bold px-3 py-1 rounded-pill">
                        <i class="bi bi-shield-check text-teal me-1"></i> BHYT: GD479201920 (Còn hạn)
                    </span>
                    <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill">
                        <i class="bi bi-star-fill me-1"></i> Thẻ VIP Care
                    </span>
                </div>
                <h1 class="h2 fw-extrabold mb-1">Xin chào, <span class="text-warning">@ViewData["UserName"]</span> 👋</h1>
                <p class="mb-0 text-white-50 fs-6">
                    Mã Bệnh nhân: <strong class="text-white">BN-2026-8892</strong> &bull; Hồ sơ sức khỏe cá nhân được cập nhật 2 giờ trước.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <button type="button" class="btn btn-warning fw-bold text-dark rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalDangKyKham">
                        <i class="bi bi-calendar-plus-fill me-1"></i> Đặt Khám Nhanh
                    </button>
                    <button type="button" class="btn btn-outline-light rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalQrId">
                        <i class="bi bi-qr-code-scan me-1"></i> Thẻ QR Bệnh Nhân
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. THANH THAO TÁC NHANH CSKH (QUICK ACTION GRID) -->
    <div class="mb-4">
        <h5 class="fw-bold text-main mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-grid-fill text-teal"></i> Thao Tác Chăm Sóc Nhanh
        </h5>
        <div class="row g-3">
            <div class="col-6 col-md-4 col-lg-2">
                <div class="quick-action-btn" data-bs-toggle="modal" data-bs-target="#modalDangKyKham">
                    <div class="quick-action-icon">
                        <i class="bi bi-calendar2-check-fill"></i>
                    </div>
                    <span class="fw-bold fs-7 text-center">Đặt Lịch Khám</span>
                    <small class="text-muted" style="font-size: 0.72rem;">Trực tuyến / Tại chỗ</small>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="quick-action-btn" onclick="openCsChat();">
                    <div class="quick-action-icon" style="background: rgba(2, 132, 199, 0.1); color: #0284c7;">
                        <i class="bi bi-chat-dots-fill"></i>
                    </div>
                    <span class="fw-bold fs-7 text-center">Hỏi Trợ Lý AI</span>
                    <small class="text-muted" style="font-size: 0.72rem;">Hỗ trợ CSKH 24/7</small>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="quick-action-btn" data-bs-toggle="modal" data-bs-target="#modalKetQuaXetNghiem">
                    <div class="quick-action-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i class="bi bi-file-earmark-medical-fill"></i>
                    </div>
                    <span class="fw-bold fs-7 text-center">KQ Xét Nghiệm</span>
                    <small class="text-muted" style="font-size: 0.72rem;">Tra cứu mới nhất</small>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="quick-action-btn" data-bs-toggle="modal" data-bs-target="#modalDonThuoc">
                    <div class="quick-action-icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                        <i class="bi bi-capsule"></i>
                    </div>
                    <span class="fw-bold fs-7 text-center">Đơn Thuốc Số</span>
                    <small class="text-muted" style="font-size: 0.72rem;">Liều dùng & Nhắc nhở</small>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="quick-action-btn" onclick="scrollToNps();">
                    <div class="quick-action-icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <span class="fw-bold fs-7 text-center">Đánh Giá CSKH</span>
                    <small class="text-muted" style="font-size: 0.72rem;">Góp ý dịch vụ</small>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="tel:115" class="quick-action-btn border-danger text-decoration-none">
                    <div class="quick-action-icon bg-danger-subtle text-danger">
                        <i class="bi bi-telephone-outbound-fill"></i>
                    </div>
                    <span class="fw-bold fs-7 text-center text-danger">Cấp Cứu 115</span>
                    <small class="text-muted" style="font-size: 0.72rem;">Đường dây khẩn cấp</small>
                </a>
            </div>
        </div>
    </div>

    <!-- 3. CHỈ SỐ SINH HIỆU SỨC KHỎE CÁ NHÂN -->
    <div class="mb-4">
        <h5 class="fw-bold text-main mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-heart-pulse-fill text-danger"></i> Chỉ Số Sinh Hiệu Mới Nhất
        </h5>
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="hc-card p-3 h-100 border-start border-4 border-danger">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">Huyết Áp</span>
                        <i class="bi bi-activity text-danger fs-5"></i>
                    </div>
                    <div class="fw-bold fs-4 text-main mb-1">120/80 <small class="fs-6 text-muted">mmHg</small></div>
                    <span class="badge bg-success-subtle text-success rounded-pill">Bình thường</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hc-card p-3 h-100 border-start border-4 border-primary">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">Nhịp Tim</span>
                        <i class="bi bi-heart-fill text-primary fs-5"></i>
                    </div>
                    <div class="fw-bold fs-4 text-main mb-1">72 <small class="fs-6 text-muted">bpm</small></div>
                    <span class="badge bg-primary-subtle text-primary rounded-pill">Ổn định</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hc-card p-3 h-100 border-start border-4 border-success">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">Chỉ Số BMI</span>
                        <i class="bi bi-person-badge-fill text-success fs-5"></i>
                    </div>
                    <div class="fw-bold fs-4 text-main mb-1">21.5 <small class="fs-6 text-muted">(62kg)</small></div>
                    <span class="badge bg-success-subtle text-success rounded-pill">Cân đối</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hc-card p-3 h-100 border-start border-4 border-warning">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">Đường Huyết</span>
                        <i class="bi bi-droplet-fill text-warning fs-5"></i>
                    </div>
                    <div class="fw-bold fs-4 text-main mb-1">95 <small class="fs-6 text-muted">mg/dL</small></div>
                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill">An toàn</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. LỊCH KHÁM SẮP TỚI & HÀNH TRÌNH CHĂM SÓC -->
    <div class="row g-4 mb-4">
        <!-- Lịch khám sắp tới -->
        <div class="col-lg-7">
            <div class="hc-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-main d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-event-fill text-teal"></i> Lịch Khám Định Kỳ Sắp Tới
                    </h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                        <i class="bi bi-check-circle-fill me-1"></i> Đã Xác Nhận
                    </span>
                </div>

                <div class="p-3 rounded-3 mb-3 bg-body-tertiary border">
                    <div class="row align-items-center g-3">
                        <div class="col-md-8">
                            <span class="badge bg-teal text-white mb-2" style="font-size: 0.72rem;">Chuyên Khoa Nội Tổng Quát</span>
                            <h6 class="fw-bold text-main mb-1">Gói Khám Sức Khỏe Định Kỳ Toàn Diện</h6>
                            <p class="small text-muted mb-2">
                                <i class="bi bi-person-circle me-1"></i> Bác sĩ: <strong>BS. CKI Trần Văn Nam</strong>
                            </p>
                            <div class="d-flex flex-wrap align-items-center gap-3 text-secondary small">
                                <span><i class="bi bi-clock-fill text-teal me-1"></i> <strong>08:30 AM</strong></span>
                                <span><i class="bi bi-calendar3 text-teal me-1"></i> <strong>15/08/2026</strong></span>
                                <span><i class="bi bi-geo-alt-fill text-teal me-1"></i> <strong>Phòng 302 - Lầu 3</strong></span>
                            </div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <button class="btn btn-sm btn-primary rounded-pill w-100 mb-2" onclick="showTicketQrModal()">
                                <i class="bi bi-qr-code me-1"></i> Phiếu Hẹn QR
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill w-100" onclick="cancelAppointment()">
                                <i class="bi bi-x-circle me-1"></i> Hủy / Đổi Lịch
                            </button>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info py-2 px-3 mb-0 small rounded-3 d-flex align-items-center gap-2 border-0">
                    <i class="bi bi-info-circle-fill text-info fs-5"></i>
                    <div>
                        <strong>Lưu ý từ Bác sĩ:</strong> Vui lòng nhịn ăn sáng trước 8 tiếng để xét nghiệm máu chuẩn xác nhất.
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline Hành trình Chăm sóc Bệnh nhân -->
        <div class="col-lg-5">
            <div class="hc-card h-100 p-4">
                <h5 class="fw-bold mb-3 text-main d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-teal"></i> Nhật Ký Chăm Sóc Sức Khỏe
                </h5>

                <div class="care-timeline mt-3">
                    <div class="care-timeline-item">
                        <div class="care-timeline-dot"></div>
                        <div class="fw-bold small text-teal">15/08/2026 (Sắp tới)</div>
                        <div class="fw-bold text-main">Tái khám Sức khỏe Tổng quát</div>
                        <p class="small text-muted mb-0">Đã đăng ký nhắc lịch qua Zalo & SMS.</p>
                    </div>

                    <div class="care-timeline-item">
                        <div class="care-timeline-dot" style="background: #10b981; box-shadow: 0 0 0 2px #10b981;"></div>
                        <div class="fw-bold small text-success">05/05/2026 (Đã xong)</div>
                        <div class="fw-bold text-main">Xét nghiệm Máu & Sinh hóa</div>
                        <p class="small text-muted mb-1">Chỉ số bình thường, Bác sĩ khuyên duy trì tập thể thao.</p>
                        <button class="btn btn-xs btn-soft-primary py-1 px-2 text-decoration-none rounded-2" data-bs-toggle="modal" data-bs-target="#modalKetQuaXetNghiem" style="font-size: 0.75rem;">
                            <i class="bi bi-eye-fill me-1"></i> Xem Kết Quả
                        </button>
                    </div>

                    <div class="care-timeline-item">
                        <div class="care-timeline-dot" style="background: #64748b; box-shadow: 0 0 0 2px #64748b;"></div>
                        <div class="fw-bold small text-muted">10/01/2026</div>
                        <div class="fw-bold text-main">Tiêm vắc xin Cúm Mùa 2026</div>
                        <p class="small text-muted mb-0">Hoàn thành mũi 1 tại Trung tâm Vắc-xin HisSoft.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. GÓI DỊCH VỤ CSKH & CHĂM SÓC SỨC KHỎE NỔI BẬT -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold text-main mb-1">🩺 Gói Chăm Sóc Sức Khỏe Gia Đình</h4>
                <p class="text-muted small mb-0">Các gói dịch vụ y tế được đăng ký nhiều nhất trong tháng</p>
            </div>
            <button class="btn btn-sm btn-outline-teal rounded-pill px-3" onclick="openCsChat();">
                <i class="bi bi-headset me-1"></i> Tư vấn chọn gói
            </button>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="hc-card hc-card-hover p-4 d-flex flex-column h-100 border-top border-4 border-teal">
                    <span class="badge bg-teal-subtle text-teal rounded-pill w-fit mb-2">Phổ thông</span>
                    <h5 class="fw-bold text-main">Khám Sức Khỏe Cơ Bản</h5>
                    <h4 class="text-teal fw-extrabold mb-3">1.500.000 <small class="fs-6 text-muted">VNĐ</small></h4>
                    <ul class="list-unstyled small text-muted mb-4 flex-grow-1">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-teal me-2"></i> Khám Nội tổng quát & Sinh hiệu</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-teal me-2"></i> Công thức máu 24 chỉ số</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-teal me-2"></i> Siêu âm tổng quát bụng</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-teal me-2"></i> Chụp X-Quang Phổi thẳng</li>
                    </ul>
                    <button class="btn btn-outline-teal w-100 rounded-pill fw-bold" onclick="selectPackage('Gói Cơ Bản')">
                        Đăng Ký Khám
                    </button>
                </div>
            </div>

            <div class="col-md-4">
                <div class="hc-card hc-card-hover p-4 d-flex flex-column h-100 border-top border-4 border-primary position-relative overflow-hidden">
                    <span class="position-absolute top-0 end-0 bg-warning text-dark font-weight-bold px-3 py-1 fs-7 rounded-bl" style="border-bottom-left-radius: 0.8rem;">
                        🔥 Được chọn nhiều nhất
                    </span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill w-fit mb-2">Chuyên sâu</span>
                    <h5 class="fw-bold text-main">Khám Tổng Quát Nâng Cao</h5>
                    <h4 class="text-primary fw-extrabold mb-3">3.200.000 <small class="fs-6 text-muted">VNĐ</small></h4>
                    <ul class="list-unstyled small text-muted mb-4 flex-grow-1">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i> Bao gồm toàn bộ Gói Cơ Bản</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i> Tầm soát Đái tháo đường & Gút</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i> Đo Điện tim ECG & Siêu âm Tim</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i> Nội soi Tai Mũi Họng vi giáp</li>
                    </ul>
                    <button class="btn btn-primary w-100 rounded-pill fw-bold shadow-sm" onclick="selectPackage('Gói Nâng Cao')">
                        Đăng Ký Khám
                    </button>
                </div>
            </div>

            <div class="col-md-4">
                <div class="hc-card hc-card-hover p-4 d-flex flex-column h-100 border-top border-4 border-warning">
                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill w-fit mb-2">Vip Care</span>
                    <h5 class="fw-bold text-main">Tầm Soát Ung Thư VIP</h5>
                    <h4 class="text-warning-emphasis fw-extrabold mb-3">6.800.000 <small class="fs-6 text-muted">VNĐ</small></h4>
                    <ul class="list-unstyled small text-muted mb-4 flex-grow-1">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Bao gồm Gói Nâng Cao</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Xét nghiệm Marker tầm soát 6 loại Ung thư</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Chụp MRI / CT Scanner theo chỉ định</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Bác sĩ Trưởng khoa trực tiếp tư vấn</li>
                    </ul>
                    <button class="btn btn-outline-warning text-dark w-100 rounded-pill fw-bold" onclick="selectPackage('Gói VIP Tầm Soát')">
                        Đăng Ký Khám
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. PHẦN ĐÁNH GIÁ CHẤT LƯỢNG CSKH (NPS SATISFACTION SURVEY) -->
    <div class="hc-card p-4 p-md-5 mb-4" id="npsSection">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <h4 class="fw-bold text-main mb-2">⭐ Đánh Giá Trải Nghiệm Khách Hàng (NPS)</h4>
                <p class="text-muted mb-0">Ý kiến đóng góp của bạn giúp Bệnh viện HisSoft nâng cao chất lượng phục vụ mỗi ngày.</p>
            </div>
            <div class="col-lg-6">
                <form id="npsForm" onsubmit="submitNps(event)">
                    <div class="mb-3 text-center text-lg-start">
                        <label class="form-label text-muted small mb-1">Mức độ hài lòng của bạn trong lần khám gần nhất:</label>
                        <div>
                            <div class="star-rating">
                                <input type="radio" id="star5" name="rating" value="5" required />
                                <label for="star5" title="Rất hài lòng">★</label>
                                <input type="radio" id="star4" name="rating" value="4" />
                                <label for="star4" title="Hài lòng">★</label>
                                <input type="radio" id="star3" name="rating" value="3" />
                                <label for="star3" title="Bình thường">★</label>
                                <input type="radio" id="star2" name="rating" value="2" />
                                <label for="star2" title="Chưa hài lòng">★</label>
                                <input type="radio" id="star1" name="rating" value="1" />
                                <label for="star1" title="Rất kém">★</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <textarea class="form-control rounded-3" id="npsComment" rows="2" placeholder="Nhập nhận xét hoặc góp ý dịch vụ (Thái độ bác sĩ, thời gian chờ, CSKH...)..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-teal rounded-pill px-4 fw-bold">
                        <i class="bi bi-send-fill me-1"></i> Gửi Đánh Giá CSKH
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- 7. WIDGET TRỢ LÝ AI & CHAT CSKH FLOATING (GÓC DƯỚI BÊN PHẢI) -->
<!-- ========================================================================= -->
<div class="cs-chat-widget">
    <!-- Nút tròn mở chat -->
    <button class="cs-chat-trigger" id="csChatTrigger" onclick="toggleCsChat()">
        <i class="bi bi-chat-heart-fill"></i>
        <span class="cs-chat-badge">1</span>
    </button>

    <!-- Khung hộp chat -->
    <div class="cs-chat-box" id="csChatBox">
        <div class="cs-chat-header">
            <div class="d-flex align-items-center gap-2">
                <div class="position-relative">
                    <img src="~/static/icon-192.png" alt="HisSoft CSKH" width="34" height="34" class="rounded-circle bg-white p-1" />
                    <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-light rounded-circle"></span>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-white fs-6">Trợ Lý CSKH HisSoft AI</h6>
                    <small class="text-white-50" style="font-size: 0.72rem;">● Đang trực tuyến 24/7</small>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" onclick="toggleCsChat()"></button>
        </div>

        <div class="cs-chat-body" id="csChatBody">
            <div class="cs-msg cs-msg-bot">
                👋 Xin chào <strong>@ViewData["UserName"]</strong>! Tôi là Trợ lý CSKH Y Tế HisSoft. Bạn cần hỗ trợ thông tin gì hôm nay?
            </div>
        </div>

        <div class="cs-chat-quick-replies">
            <span class="cs-chip" onclick="sendQuickReply('Giờ làm việc khám bệnh?')">🕒 Giờ làm việc</span>
